{
  "$defs": {
    "BenchmarkAttemptIdentity": {
      "additionalProperties": false,
      "properties": {
        "attempt_id": {
          "type": "string"
        },
        "campaign_id": {
          "type": "string"
        },
        "run": {
          "$ref": "#/$defs/BenchmarkRunIdentity"
        },
        "tool_id": {
          "type": "string"
        }
      },
      "required": [
        "campaign_id",
        "run",
        "attempt_id",
        "tool_id"
      ],
      "type": "object"
    },
    "BenchmarkEvidenceReference": {
      "additionalProperties": false,
      "properties": {
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "size_bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "uri": {
          "pattern": "^study://[^/].+$",
          "type": "string"
        }
      },
      "required": [
        "uri",
        "sha256",
        "size_bytes"
      ],
      "type": "object"
    },
    "BenchmarkRunIdentity": {
      "additionalProperties": false,
      "properties": {
        "domain": {
          "type": "string"
        },
        "run_id": {
          "type": "string"
        },
        "stage_id": {
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "domain",
        "stage_id"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "campaign_registry_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "case_ids": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "catalog_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "decision": {
      "$ref": "#/$defs/BenchmarkEvidenceReference"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/BenchmarkEvidenceReference"
      },
      "type": "array"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "publication_id": {
      "type": "string"
    },
    "published_at_utc": {
      "type": "string"
    },
    "report": {
      "$ref": "#/$defs/BenchmarkEvidenceReference"
    },
    "repository_commit": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "run": {
      "$ref": "#/$defs/BenchmarkRunIdentity"
    },
    "run_definition_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "schema_version": {
      "const": "bijux.benchmark.publication_receipt.v1",
      "type": "string"
    },
    "selected_attempts": {
      "items": {
        "$ref": "#/$defs/BenchmarkAttemptIdentity"
      },
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "publication_id",
    "published_at_utc",
    "run",
    "case_ids",
    "selected_attempts",
    "repository_commit",
    "catalog_sha256",
    "run_definition_sha256",
    "campaign_registry_sha256",
    "report",
    "decision",
    "evidence",
    "limitations"
  ],
  "title": "BenchmarkPublicationReceipt",
  "type": "object"
}
