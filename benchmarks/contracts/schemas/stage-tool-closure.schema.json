{
  "$defs": {
    "BenchmarkStageToolClosureDisposition": {
      "enum": [
        "aligned",
        "missing_domain_binding"
      ],
      "type": "string"
    },
    "BenchmarkStageToolClosureRow": {
      "additionalProperties": false,
      "properties": {
        "artifact_delivery": {
          "type": "string"
        },
        "benchmark_run_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "closure": {
          "$ref": "#/$defs/BenchmarkStageToolClosureDisposition"
        },
        "domain": {
          "type": "string"
        },
        "domain_declared": {
          "type": "boolean"
        },
        "product_support": {
          "type": "string"
        },
        "protocol_disposition": {
          "$ref": "#/$defs/BenchmarkStageToolProtocolDisposition"
        },
        "redistribution_permitted": {
          "type": "boolean"
        },
        "stage_id": {
          "type": "string"
        },
        "tool_id": {
          "type": "string"
        }
      },
      "required": [
        "domain",
        "stage_id",
        "tool_id",
        "product_support",
        "artifact_delivery",
        "redistribution_permitted",
        "domain_declared",
        "protocol_disposition",
        "closure"
      ],
      "type": "object"
    },
    "BenchmarkStageToolClosureSource": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "type": "object"
    },
    "BenchmarkStageToolClosureSummary": {
      "additionalProperties": false,
      "properties": {
        "aligned_pair_count": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "benchmark_pair_count": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "catalog_pair_count": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "domain_pair_count": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "drift_pair_count": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "external_artifact_pair_count": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "qualification_only_pair_count": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "stage_count": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "supported_tool_count": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "supported_tool_count",
        "stage_count",
        "catalog_pair_count",
        "domain_pair_count",
        "aligned_pair_count",
        "drift_pair_count",
        "benchmark_pair_count",
        "qualification_only_pair_count",
        "external_artifact_pair_count"
      ],
      "type": "object"
    },
    "BenchmarkStageToolProtocolDisposition": {
      "enum": [
        "benchmark_required",
        "qualification_only"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "rows": {
      "items": {
        "$ref": "#/$defs/BenchmarkStageToolClosureRow"
      },
      "type": "array"
    },
    "schema_version": {
      "const": "bijux.benchmark.stage_tool_closure.v1",
      "type": "string"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/BenchmarkStageToolClosureSource"
      },
      "type": "array"
    },
    "summary": {
      "$ref": "#/$defs/BenchmarkStageToolClosureSummary"
    }
  },
  "required": [
    "schema_version",
    "sources",
    "summary",
    "rows"
  ],
  "title": "BenchmarkStageToolClosureReport",
  "type": "object"
}
