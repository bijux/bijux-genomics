{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Execution measurements accompanying one normalized BAM damage result.",
  "properties": {
    "bam_index_input_bytes": {
      "minimum": 1,
      "type": "integer"
    },
    "bam_input_bytes": {
      "minimum": 1,
      "type": "integer"
    },
    "input_bytes": {
      "minimum": 1,
      "type": "integer"
    },
    "native_file_count": {
      "minimum": 1,
      "type": "integer"
    },
    "native_output_bytes": {
      "minimum": 1,
      "type": "integer"
    },
    "normalization_complete": {
      "const": 1,
      "type": "integer"
    },
    "output_bytes": {
      "minimum": 1,
      "type": "integer"
    },
    "reference_input_bytes": {
      "minimum": 1,
      "type": "integer"
    },
    "schema_version": {
      "const": "bijux.benchmark.bam.damage.metrics.v1",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "normalization_complete",
    "native_file_count",
    "native_output_bytes",
    "bam_input_bytes",
    "bam_index_input_bytes",
    "reference_input_bytes",
    "input_bytes",
    "output_bytes"
  ],
  "title": "BenchmarkBamDamageMetrics",
  "type": "object"
}
