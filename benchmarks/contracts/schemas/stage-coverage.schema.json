{
  "$defs": {
    "BenchmarkStageCoverageRow": {
      "additionalProperties": false,
      "properties": {
        "campaign_run_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "definition_status": {
          "$ref": "#/$defs/BenchmarkStageDefinitionStatus"
        },
        "execution_status": {
          "$ref": "#/$defs/BenchmarkStageExecutionStatus"
        },
        "report_repository_commit": {
          "type": [
            "string",
            "null"
          ]
        },
        "report_sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "retained_tools": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "stage_id": {
          "type": "string"
        }
      },
      "required": [
        "stage_id",
        "retained_tools",
        "definition_status",
        "execution_status"
      ],
      "type": "object"
    },
    "BenchmarkStageCoverageSummary": {
      "additionalProperties": false,
      "properties": {
        "admitted_stage_count": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "comparative_stage_count": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "defined_stage_count": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "failed_stage_count": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "missing_stage_count": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "qualification_stage_count": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "retained_stage_count": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "stale_stage_count": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "retained_stage_count",
        "defined_stage_count",
        "qualification_stage_count",
        "comparative_stage_count",
        "admitted_stage_count",
        "stale_stage_count",
        "failed_stage_count",
        "missing_stage_count"
      ],
      "type": "object"
    },
    "BenchmarkStageDefinitionStatus": {
      "enum": [
        "missing",
        "qualification",
        "comparative"
      ],
      "type": "string"
    },
    "BenchmarkStageExecutionStatus": {
      "enum": [
        "not_defined",
        "not_admitted",
        "stale",
        "failed",
        "admitted"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "bijux.benchmark.stage_coverage.v1",
      "type": "string"
    },
    "stages": {
      "items": {
        "$ref": "#/$defs/BenchmarkStageCoverageRow"
      },
      "type": "array"
    },
    "summary": {
      "$ref": "#/$defs/BenchmarkStageCoverageSummary"
    }
  },
  "required": [
    "schema_version",
    "summary",
    "stages"
  ],
  "title": "BenchmarkStageCoverage",
  "type": "object"
}
