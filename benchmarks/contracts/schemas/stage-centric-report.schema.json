  "required": [
    "schema_version",
    "output_path",
    "stage_count",
    "multi_tool_stage_count",
    "blocked_stage_count",
    "declared_shared_metric_stage_count",
    "not_declared_shared_metric_stage_count",
    "row_count",
    "benchmark_ready_row_count",
    "blocked_row_count",
    "domain_counts",
    "section_counts",
    "readiness_gap_counts",
    "stages"
  ],
  "title": "StageCentricReport",
  "type": "object"
}
