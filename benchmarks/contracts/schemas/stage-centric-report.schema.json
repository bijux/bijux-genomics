        "format": "uint",
        "minimum": 0,
        "type": "integer"
      },
      "type": "object"
    },
    "multi_tool_stage_count": {
      "format": "uint",
      "minimum": 0,
      "type": "integer"
    },
    "not_declared_shared_metric_stage_count": {
      "format": "uint",
      "minimum": 0,
      "type": "integer"
    },
    "output_path": {
      "type": "string"
    },
    "readiness_gap_counts": {
      "additionalProperties": {
        "format": "uint",
        "minimum": 0,
        "type": "integer"
      },
      "type": "object"
    },
    "row_count": {
      "format": "uint",
      "minimum": 0,
      "type": "integer"
    },
    "schema_version": {
      "const": "bijux.bench.readiness.stage_centric_report.v1",
      "type": "string"
    },
    "section_counts": {
      "additionalProperties": {
        "format": "uint",
        "minimum": 0,
        "type": "integer"
      },
      "type": "object"
    },
    "stage_count": {
      "format": "uint",
      "minimum": 0,
      "type": "integer"
    },
    "stages": {
      "items": {
        "$ref": "#/$defs/StageCentricStageReport"
      },
      "type": "array"
    }
