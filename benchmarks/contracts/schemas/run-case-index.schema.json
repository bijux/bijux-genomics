{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BenchmarkRunCaseIndex",
  "type": "object",
  "properties": {
    "cases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/BenchmarkRunCaseIndexEntry"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "protocol_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "run": {
      "$ref": "#/$defs/BenchmarkRunIdentity"
    },
    "schema_version": {
      "type": "string",
      "const": "bijux.benchmark.run_case_index.v1"
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run",
    "protocol_sha256",
    "cases",
    "limitations"
  ],
  "$defs": {
    "BenchmarkRunCaseIndexEntry": {
      "type": "object",
      "properties": {
        "case_id": {
          "type": "string"
        },
        "definition": {
          "$ref": "#/$defs/BenchmarkRunIndexFileReference"
        },
        "tool_id": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "case_id",
        "tool_id",
        "definition"
      ]
    },
    "BenchmarkRunIdentity": {
      "type": "object",
      "properties": {
        "domain": {
          "type": "string"
        },
        "run_id": {
          "type": "string"
        },
        "stage_id": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "run_id",
        "domain",
        "stage_id"
      ]
    },
    "BenchmarkRunIndexFileReference": {
      "type": "object",
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "uri": {
          "type": "string",
          "pattern": "^(repo|study)://[^/].+$"
        }
      },
      "additionalProperties": false,
      "required": [
        "uri",
        "sha256",
        "size_bytes"
      ]
    }
  }
}
