{
  "$defs": {
    "BenchmarkRunCaseIndexEntry": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "type": "string"
        },
        "definition": {
          "$ref": "#/$defs/BenchmarkRunIndexFileReference"
        },
        "tool_id": {
          "type": "string"
        }
      },
      "required": [
        "case_id",
        "tool_id",
        "definition"
      ],
      "type": "object"
    },
    "BenchmarkRunIdentity": {
      "additionalProperties": false,
      "properties": {
        "domain": {
          "type": "string"
        },
        "run_id": {
          "type": "string"
        },
        "stage_id": {
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "domain",
        "stage_id"
      ],
      "type": "object"
    },
    "BenchmarkRunIndexFileReference": {
      "additionalProperties": false,
      "properties": {
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "size_bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "uri": {
          "pattern": "^(repo|study)://[^/].+$",
          "type": "string"
        }
      },
      "required": [
        "uri",
        "sha256",
        "size_bytes"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "cases": {
      "items": {
        "$ref": "#/$defs/BenchmarkRunCaseIndexEntry"
      },
      "type": "array"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "protocol_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "run": {
      "$ref": "#/$defs/BenchmarkRunIdentity"
    },
    "schema_version": {
      "const": "bijux.benchmark.run_case_index.v1",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "run",
    "protocol_sha256",
    "cases",
    "limitations"
  ],
  "title": "BenchmarkRunCaseIndex",
  "type": "object"
}
