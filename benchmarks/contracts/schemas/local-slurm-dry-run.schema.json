          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "memory_mb": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "readiness_kind": {
          "$ref": "#/$defs/BenchmarkLocalStageReadinessKind"
        },
        "result_root": {
          "type": "string"
        },
        "script_path": {
          "type": "string"
        },
        "stage_id": {
          "type": "string"
        },
        "stage_result_manifest_path": {
          "type": "string"
        },
        "stderr_path": {
          "type": "string"
        },
        "stdout_path": {
          "type": "string"
        },
        "time_limit": {
          "type": "string"
        },
        "tool_id": {
          "type": "string"
        }
      },
      "required": [
        "stage_id",
        "tool_id",
        "readiness_kind",
        "cpus_per_task",
        "memory_mb",
        "time_limit",
        "script_path",
        "stdout_path",
        "stderr_path",
        "result_root",
        "stage_result_manifest_path",
        "command"
