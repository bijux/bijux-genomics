      "type": "string"
    },
    "script_count": {
      "format": "uint",
      "minimum": 0,
      "type": "integer"
    },
    "scripts": {
      "items": {
        "$ref": "#/$defs/BenchmarkLocalSlurmScriptEntry"
      },
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "domain",
    "output_root",
    "script_count",
    "scripts"
  ],
  "title": "BenchmarkLocalSlurmDryRunReport",
  "type": "object"
