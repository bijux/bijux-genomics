      "type": "string"
    },
    "corpora": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "environment_label": {
      "type": "string"
    },
    "metrics": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "schema_version": {
      "const": "bijux.bench.bundle.v1",
