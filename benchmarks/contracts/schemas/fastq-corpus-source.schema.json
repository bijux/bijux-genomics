{
  "$defs": {
    "BenchmarkCorpusClass": {
      "enum": [
        "production_real",
        "qualification_real",
        "test_fixture",
        "toy",
        "synthetic",
        "smoke",
        "local_development"
      ],
      "type": "string"
    },
    "CorpusAcquisitionLayout": {
      "enum": [
        "se",
        "pe"
      ],
      "type": "string"
    },
    "FastqCorpusSourceSample": {
      "additionalProperties": false,
      "properties": {
        "accession": {
          "type": "string"
        },
        "era": {
          "type": "string"
        },
        "layout": {
          "$ref": "#/$defs/CorpusAcquisitionLayout"
        },
        "reason": {
          "type": "string"
        },
        "size_band": {
          "type": "string"
        },
        "study_accession": {
          "type": "string"
        }
      },
      "required": [
        "accession",
        "study_accession",
        "era",
        "layout",
        "size_band",
        "reason"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "access_classification": {
      "type": "string"
    },
    "access_terms_url": {
      "type": "string"
    },
    "attribution": {
      "type": "string"
    },
    "class": {
      "$ref": "#/$defs/BenchmarkCorpusClass"
    },
    "corpus_id": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "known_limitations": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "portfolio_id": {
      "type": "string"
    },
    "preferred_root": {
      "type": [
        "string",
        "null"
      ]
    },
    "projected_cpu_hours": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "projected_storage_bytes": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "projection_basis": {
      "type": "string"
    },
    "redistribution_classification": {
      "type": "string"
    },
    "samples": {
      "items": {
        "$ref": "#/$defs/FastqCorpusSourceSample"
      },
      "type": "array"
    },
    "schema_version": {
      "const": "bijux.benchmark.fastq_corpus_source.v1",
      "type": "string"
    },
    "source_authority": {
      "type": "string"
    },
    "species": {
      "type": "string"
    },
    "species_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "target_ancient_pe": {
      "format": "uint",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "target_ancient_se": {
      "format": "uint",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "target_modern_pe": {
      "format": "uint",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "target_modern_se": {
      "format": "uint",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "target_total": {
      "format": "uint",
      "minimum": 0,
      "type": "integer"
    },
    "truth_roles": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "truth_strategy": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "corpus_id",
    "portfolio_id",
    "class",
    "species",
    "description",
    "source_authority",
    "access_classification",
    "redistribution_classification",
    "access_terms_url",
    "attribution",
    "projected_storage_bytes",
    "projected_cpu_hours",
    "projection_basis",
    "truth_roles",
    "truth_strategy",
    "known_limitations",
    "target_total",
    "samples"
  ],
  "title": "FastqCorpusSourceSpec",
  "type": "object"
}
