{
  "$defs": {
    "BenchmarkCaseAggregationV2": {
      "additionalProperties": false,
      "properties": {
        "admission_sha256": {
          "type": "string"
        },
        "case_id": {
          "type": "string"
        },
        "corpus": {
          "$ref": "#/$defs/BenchmarkCorpusSnapshotV1"
        },
        "domain": {
          "type": "string"
        },
        "execution": {
          "$ref": "#/$defs/BenchmarkCaseExecutionEvidenceV1"
        },
        "input_lock_sha256": {
          "type": "string"
        },
        "normalized_result_sha256": {
          "type": "string"
        },
        "parameter_lock_sha256": {
          "type": "string"
        },
        "performance": {
          "additionalProperties": {
            "$ref": "#/$defs/BenchmarkMetricDistribution"
          },
          "type": "object"
        },
        "repetition_count": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "repository_commit": {
          "type": "string"
        },
        "run_id": {
          "type": "string"
        },
        "schema_version": {
          "const": "bijux.benchmark.case_aggregation.v2",
          "type": "string"
        },
        "scientific": {
          "additionalProperties": {
            "items": {
              "$ref": "#/$defs/BenchmarkScientificValue"
            },
            "type": "array"
          },
          "type": "object"
        },
        "stage_id": {
          "type": "string"
        },
        "tool_id": {
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "case_id",
        "run_id",
        "domain",
        "stage_id",
        "tool_id",
        "corpus",
        "repository_commit",
        "admission_sha256",
        "input_lock_sha256",
        "parameter_lock_sha256",
        "execution",
        "repetition_count",
        "performance",
        "scientific",
        "normalized_result_sha256"
      ],
      "type": "object"
    },
    "BenchmarkCaseExecutionEvidenceV1": {
      "additionalProperties": false,
      "properties": {
        "image": {
          "$ref": "#/$defs/BenchmarkReportImage"
        },
        "input_bytes": {
          "additionalProperties": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "type": "object"
        },
        "input_locks": {
          "items": {
            "$ref": "#/$defs/BenchmarkReportInputLock"
          },
          "type": "array"
        },
        "slurm": {
          "$ref": "#/$defs/BenchmarkReportSlurmJob"
        },
        "source_evidence_sha256": {
          "type": "string"
        }
      },
      "required": [
        "image",
        "slurm",
        "source_evidence_sha256",
        "input_locks",
        "input_bytes"
      ],
      "type": "object"
    },
    "BenchmarkCorpusSnapshotV1": {
      "additionalProperties": false,
      "properties": {
        "corpus_id": {
          "type": "string"
        },
        "sample_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "snapshot_sha256": {
          "type": "string"
        }
      },
      "required": [
        "corpus_id",
        "snapshot_sha256",
        "sample_ids"
      ],
      "type": "object"
    },
    "BenchmarkMetricDistribution": {
      "additionalProperties": false,
      "properties": {
        "maximum": {
          "format": "double",
          "type": "number"
        },
        "mean": {
          "format": "double",
          "type": "number"
        },
        "minimum": {
          "format": "double",
          "type": "number"
        },
        "sample_standard_deviation": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "minimum",
        "maximum",
        "mean",
        "sample_standard_deviation"
      ],
      "type": "object"
    },
    "BenchmarkReportImage": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "size_bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "name",
        "sha256",
        "size_bytes"
      ],
      "type": "object"
    },
    "BenchmarkReportInputLock": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "mount_path": {
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "mount_path",
        "sha256"
      ],
      "type": "object"
    },
    "BenchmarkReportSlurmJob": {
      "additionalProperties": false,
      "properties": {
        "allocated_cpus": {
          "type": "string"
        },
        "elapsed": {
          "type": "string"
        },
        "host": {
          "type": "string"
        },
        "job_id": {
          "type": "string"
        }
      },
      "required": [
        "job_id",
        "host",
        "elapsed",
        "allocated_cpus"
      ],
      "type": "object"
    },
    "BenchmarkScientificValue": {
      "anyOf": [
        {
          "format": "double",
          "type": "number"
        },
        {
          "type": "string"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "aggregations": {
      "items": {
        "$ref": "#/$defs/BenchmarkCaseAggregationV2"
      },
      "type": "array"
    },
    "case_matrix_sha256": {
      "type": "string"
    },
    "observation_set_sha256": {
      "type": "string"
    },
    "repository_commit": {
      "type": "string"
    },
    "schema_version": {
      "const": "bijux.benchmark.case_aggregation_set.v1",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "repository_commit",
    "case_matrix_sha256",
    "observation_set_sha256",
    "aggregations"
  ],
  "title": "BenchmarkCaseAggregationSetV1",
  "type": "object"
}
