{
  "$defs": {
    "BenchmarkCorpusClass": {
      "enum": [
        "production_real",
        "qualification_real",
        "test_fixture",
        "toy",
        "synthetic",
        "smoke",
        "local_development"
      ],
      "type": "string"
    },
    "BenchmarkCorpusDataAudit": {
      "additionalProperties": false,
      "properties": {
        "blockers": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "catalog_bindings": {
          "items": {
            "$ref": "#/$defs/BenchmarkGovernedDataBinding"
          },
          "type": "array"
        },
        "class": {
          "$ref": "#/$defs/BenchmarkCorpusClass"
        },
        "corpus_id": {
          "type": "string"
        },
        "data_types": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "declared_sample_count": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "evidence_scope": {
          "$ref": "#/$defs/BenchmarkEvidenceScope"
        },
        "minimum_sample_count": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "projected_cpu_hours": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "projected_storage_bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "publishable_data_ready": {
          "type": "boolean"
        },
        "source_specs": {
          "items": {
            "$ref": "#/$defs/BenchmarkDataSourceSpecIdentity"
          },
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/BenchmarkCorpusStatus"
        },
        "truth_roles": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "truth_strategy": {
          "type": "string"
        },
        "verified_storage_bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "corpus_id",
        "status",
        "evidence_scope",
        "class",
        "declared_sample_count",
        "minimum_sample_count",
        "data_types",
        "truth_roles",
        "truth_strategy",
        "source_specs",
        "catalog_bindings",
        "verified_storage_bytes",
        "publishable_data_ready",
        "blockers"
      ],
      "type": "object"
    },
    "BenchmarkCorpusStatus": {
      "enum": [
        "missing",
        "source_defined",
        "admitted"
      ],
      "type": "string"
    },
    "BenchmarkDataPortfolioAuditSummary": {
      "additionalProperties": false,
      "properties": {
        "admitted_corpus_count": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "bound_catalog_count": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "corpus_count": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "missing_catalog_binding_count": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "missing_corpus_count": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "publishable_contamination_count": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "publishable_data_ready_count": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "source_defined_corpus_count": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "suspected_nonproduction_asset_count": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "unbound_catalog_count": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "unknown_compute_projection_count": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "unknown_storage_projection_count": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "verified_bound_file_count": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "verified_bound_size_bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "corpus_count",
        "admitted_corpus_count",
        "source_defined_corpus_count",
        "missing_corpus_count",
        "publishable_data_ready_count",
        "bound_catalog_count",
        "missing_catalog_binding_count",
        "unbound_catalog_count",
        "verified_bound_file_count",
        "verified_bound_size_bytes",
        "unknown_storage_projection_count",
        "unknown_compute_projection_count",
        "suspected_nonproduction_asset_count",
        "publishable_contamination_count"
      ],
      "type": "object"
    },
    "BenchmarkDataSourceSpecIdentity": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string"
        },
        "planned_accession_count": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "planned_sample_count": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "projected_cpu_hours": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "projected_storage_bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "selected_accession_count": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "selection_complete": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "selection_group_count": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "type": "object"
    },
    "BenchmarkEvidenceScope": {
      "enum": [
        "qualification",
        "comparative"
      ],
      "type": "string"
    },
    "BenchmarkGovernedDataBinding": {
      "additionalProperties": false,
      "properties": {
        "access_classification": {
          "type": [
            "string",
            "null"
          ]
        },
        "access_terms": {
          "type": [
            "string",
            "null"
          ]
        },
        "benchmark_eligible": {
          "type": "boolean"
        },
        "catalog_id": {
          "type": "string"
        },
        "catalog_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "catalog_sha256": {
          "oneOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "file_roles": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "integrity_verified": {
          "type": "boolean"
        },
        "observed_sample_count": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "present": {
          "type": "boolean"
        },
        "redistribution_classification": {
          "type": [
            "string",
            "null"
          ]
        },
        "sample_count_authority": {
          "type": [
            "string",
            "null"
          ]
        },
        "verified_file_count": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "verified_size_bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "catalog_id",
        "present",
        "catalog_sha256",
        "integrity_verified",
        "benchmark_eligible",
        "verified_file_count",
        "verified_size_bytes",
        "file_roles"
      ],
      "type": "object"
    },
    "BenchmarkUnboundDataAsset": {
      "additionalProperties": false,
      "properties": {
        "access_classification": {
          "type": "string"
        },
        "catalog_id": {
          "type": "string"
        },
        "classification_reasons": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "purpose": {
          "type": "string"
        },
        "redistribution_classification": {
          "type": "string"
        },
        "suspected_nonproduction": {
          "type": "boolean"
        },
        "verified_file_count": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "verified_size_bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "catalog_id",
        "purpose",
        "access_classification",
        "redistribution_classification",
        "verified_file_count",
        "verified_size_bytes",
        "suspected_nonproduction",
        "classification_reasons"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "corpora": {
      "items": {
        "$ref": "#/$defs/BenchmarkCorpusDataAudit"
      },
      "type": "array"
    },
    "data_index_path": {
      "type": "string"
    },
    "data_index_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "portfolio_path": {
      "type": "string"
    },
    "portfolio_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "publishable_contamination": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "schema_version": {
      "const": "bijux.benchmark.data_portfolio_audit.v2",
      "type": "string"
    },
    "source_commit": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "summary": {
      "$ref": "#/$defs/BenchmarkDataPortfolioAuditSummary"
    },
    "unbound_assets": {
      "items": {
        "$ref": "#/$defs/BenchmarkUnboundDataAsset"
      },
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "source_commit",
    "portfolio_path",
    "portfolio_sha256",
    "data_index_path",
    "data_index_sha256",
    "summary",
    "corpora",
    "unbound_assets",
    "publishable_contamination"
  ],
  "title": "BenchmarkDataPortfolioAudit",
  "type": "object"
}
