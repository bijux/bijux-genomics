{
  "$defs": {
    "BenchmarkCorpusClass": {
      "enum": [
        "production_real",
        "qualification_real",
        "test_fixture",
        "toy",
        "synthetic",
        "smoke",
        "local_development"
      ],
      "type": "string"
    },
    "CorpusAcquisitionLayout": {
      "enum": [
        "se",
        "pe"
      ],
      "type": "string"
    },
    "CorpusMaterializationDisposition": {
      "enum": [
        "downloaded",
        "verified_existing"
      ],
      "type": "string"
    },
    "GovernedDataCatalog": {
      "additionalProperties": false,
      "properties": {
        "access_classification": {
          "type": "string"
        },
        "access_terms_url": {
          "type": "string"
        },
        "admitted_at_utc": {
          "type": "string"
        },
        "attribution": {
          "type": "string"
        },
        "class": {
          "$ref": "#/$defs/BenchmarkCorpusClass"
        },
        "files": {
          "items": {
            "$ref": "#/$defs/GovernedDataCatalogFile"
          },
          "type": "array"
        },
        "id": {
          "type": "string"
        },
        "known_limitations": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "projected_cpu_hours": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "projected_storage_bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "projection_basis": {
          "type": "string"
        },
        "purpose": {
          "type": "string"
        },
        "redistribution_classification": {
          "type": "string"
        },
        "retrieved_at_utc": {
          "type": "string"
        },
        "samples": {
          "items": {
            "$ref": "#/$defs/GovernedDataCatalogSample"
          },
          "type": "array"
        },
        "schema_version": {
          "const": "bijux.data_catalog.v2",
          "type": "string"
        },
        "scientific_name": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "source_record": {
          "type": "string"
        },
        "source_record_sha256": {
          "type": "string"
        },
        "truth_roles": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "truth_strategy": {
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "id",
        "purpose",
        "source",
        "class",
        "access_classification",
        "redistribution_classification",
        "access_terms_url",
        "attribution",
        "projected_storage_bytes",
        "projected_cpu_hours",
        "projection_basis",
        "truth_roles",
        "truth_strategy",
        "known_limitations",
        "source_record",
        "source_record_sha256",
        "retrieved_at_utc",
        "admitted_at_utc",
        "scientific_name",
        "samples",
        "files"
      ],
      "type": "object"
    },
    "GovernedDataCatalogFile": {
      "additionalProperties": false,
      "properties": {
        "accession": {
          "type": "string"
        },
        "base_count": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "era": {
          "type": "string"
        },
        "experiment_accession": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "layout": {
          "$ref": "#/$defs/CorpusAcquisitionLayout"
        },
        "mate": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "materialization_status": {
          "$ref": "#/$defs/CorpusMaterializationDisposition"
        },
        "path": {
          "type": "string"
        },
        "read_count": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "sample_accession": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        },
        "size_bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "source_md5": {
          "type": "string"
        },
        "source_url": {
          "type": "string"
        },
        "study_accession": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes",
        "kind",
        "accession",
        "study_accession",
        "sample_accession",
        "experiment_accession",
        "era",
        "layout",
        "read_count",
        "base_count",
        "source_url",
        "source_md5",
        "materialization_status"
      ],
      "type": "object"
    },
    "GovernedDataCatalogSample": {
      "additionalProperties": false,
      "properties": {
        "accession": {
          "type": "string"
        },
        "archive_base_count": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "archive_read_count": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "era": {
          "type": "string"
        },
        "experiment_accession": {
          "type": "string"
        },
        "first_public": {
          "type": "string"
        },
        "instrument_model": {
          "type": "string"
        },
        "instrument_platform": {
          "type": "string"
        },
        "last_updated": {
          "type": "string"
        },
        "layout": {
          "$ref": "#/$defs/CorpusAcquisitionLayout"
        },
        "library_selection": {
          "type": "string"
        },
        "library_source": {
          "type": "string"
        },
        "library_strategy": {
          "type": "string"
        },
        "sample_accession": {
          "type": "string"
        },
        "scientific_name": {
          "type": "string"
        },
        "selection_reason": {
          "type": "string"
        },
        "size_band": {
          "type": "string"
        },
        "study_accession": {
          "type": "string"
        }
      },
      "required": [
        "accession",
        "study_accession",
        "sample_accession",
        "experiment_accession",
        "era",
        "layout",
        "size_band",
        "selection_reason",
        "scientific_name",
        "library_source",
        "library_strategy",
        "library_selection",
        "instrument_platform",
        "instrument_model",
        "archive_base_count",
        "archive_read_count",
        "first_public",
        "last_updated"
      ],
      "type": "object"
    },
    "GovernedDataDerivation": {
      "additionalProperties": false,
      "properties": {
        "contig_dictionary_sha256": {
          "type": "string"
        },
        "parameter_sha256": {
          "type": "string"
        },
        "pipeline_id": {
          "type": "string"
        },
        "pipeline_version": {
          "type": "string"
        },
        "reference_catalog_sha256": {
          "type": "string"
        },
        "reference_id": {
          "type": "string"
        },
        "source_commit": {
          "type": "string"
        }
      },
      "required": [
        "pipeline_id",
        "pipeline_version",
        "source_commit",
        "parameter_sha256",
        "reference_id",
        "reference_catalog_sha256",
        "contig_dictionary_sha256"
      ],
      "type": "object"
    },
    "GovernedDerivedDataCatalog": {
      "additionalProperties": false,
      "properties": {
        "access_classification": {
          "type": "string"
        },
        "access_terms_url": {
          "type": "string"
        },
        "admitted_at_utc": {
          "type": "string"
        },
        "allowed_uses": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "attribution": {
          "type": "string"
        },
        "class": {
          "$ref": "#/$defs/BenchmarkCorpusClass"
        },
        "derivation": {
          "$ref": "#/$defs/GovernedDataDerivation"
        },
        "files": {
          "items": {
            "$ref": "#/$defs/GovernedDerivedDataCatalogFile"
          },
          "type": "array"
        },
        "id": {
          "type": "string"
        },
        "known_limitations": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "projected_cpu_hours": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "projected_storage_bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "projection_basis": {
          "type": "string"
        },
        "purpose": {
          "type": "string"
        },
        "redistribution_classification": {
          "type": "string"
        },
        "reference_assembly": {
          "type": "string"
        },
        "samples": {
          "items": {
            "$ref": "#/$defs/GovernedDerivedDataCatalogSample"
          },
          "type": "array"
        },
        "schema_version": {
          "const": "bijux.data_catalog.derived.v1",
          "type": "string"
        },
        "scientific_name": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/GovernedDerivedDataSource"
          },
          "type": "array"
        },
        "truth_roles": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "truth_strategy": {
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "id",
        "purpose",
        "source",
        "class",
        "access_classification",
        "redistribution_classification",
        "access_terms_url",
        "attribution",
        "projected_storage_bytes",
        "projected_cpu_hours",
        "projection_basis",
        "truth_roles",
        "truth_strategy",
        "known_limitations",
        "sources",
        "admitted_at_utc",
        "scientific_name",
        "reference_assembly",
        "allowed_uses",
        "derivation",
        "samples",
        "files"
      ],
      "type": "object"
    },
    "GovernedDerivedDataCatalogFile": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "sample_id": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        },
        "size_bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "source_sha256s": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes",
        "kind",
        "sample_id",
        "source_sha256s"
      ],
      "type": "object"
    },
    "GovernedDerivedDataCatalogSample": {
      "additionalProperties": false,
      "properties": {
        "assay_context": {
          "type": "string"
        },
        "control_roles": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "held_out_split": {
          "type": "string"
        },
        "library_context": {
          "type": "string"
        },
        "read_group_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "sample_id": {
          "type": "string"
        },
        "source_accessions": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "strata": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "truth_roles": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "sample_id",
        "source_accessions",
        "library_context",
        "assay_context",
        "strata",
        "control_roles",
        "truth_roles",
        "held_out_split",
        "read_group_ids"
      ],
      "type": "object"
    },
    "GovernedDerivedDataSource": {
      "additionalProperties": false,
      "properties": {
        "catalog_id": {
          "type": "string"
        },
        "catalog_path": {
          "type": "string"
        },
        "catalog_sha256": {
          "type": "string"
        }
      },
      "required": [
        "catalog_id",
        "catalog_path",
        "catalog_sha256"
      ],
      "type": "object"
    },
    "GovernedPreservedDataCatalog": {
      "additionalProperties": false,
      "description": "Source-addressed preservation of a governed catalog whose domain-specific shape predates v2.",
      "properties": {
        "id": {
          "type": "string"
        },
        "preserved_at_utc": {
          "type": "string"
        },
        "preserved_catalog": true,
        "schema_version": {
          "const": "bijux.data_catalog.v2",
          "type": "string"
        },
        "source_catalog_path": {
          "type": "string"
        },
        "source_catalog_schema_version": {
          "type": "string"
        },
        "source_catalog_sha256": {
          "type": "string"
        },
        "source_catalog_size_bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "id",
        "source_catalog_path",
        "source_catalog_sha256",
        "source_catalog_size_bytes",
        "source_catalog_schema_version",
        "preserved_at_utc",
        "preserved_catalog"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "$ref": "#/$defs/GovernedDataCatalog"
    },
    {
      "$ref": "#/$defs/GovernedDerivedDataCatalog"
    },
    {
      "$ref": "#/$defs/GovernedPreservedDataCatalog"
    }
  ],
  "description": "A v2 catalog is either native typed materialization or a digest-bound historical authority.",
  "title": "GovernedDataCatalogDocument"
}
