{
  "$defs": {
    "BenchmarkArchiveFileRecord": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "pattern": "^(submission|result)/[^/].+$",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "size_bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "path",
        "size_bytes",
        "sha256"
      ],
      "type": "object"
    },
    "BenchmarkArchiveSourcePaths": {
      "additionalProperties": false,
      "properties": {
        "result": {
          "pattern": "^study://[^/].+$",
          "type": "string"
        },
        "submission": {
          "pattern": "^study://[^/].+$",
          "type": "string"
        }
      },
      "required": [
        "submission",
        "result"
      ],
      "type": "object"
    },
    "BenchmarkAttemptDisposition": {
      "enum": [
        "failed",
        "superseded"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "accounting_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "archived_at_utc": {
      "type": "string"
    },
    "attempt_id": {
      "type": "string"
    },
    "disposition": {
      "$ref": "#/$defs/BenchmarkAttemptDisposition"
    },
    "evidence_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "files": {
      "items": {
        "$ref": "#/$defs/BenchmarkArchiveFileRecord"
      },
      "type": "array"
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "run_id": {
      "type": "string"
    },
    "schema_version": {
      "const": "bijux.benchmark.attempt_archive.v1",
      "type": "string"
    },
    "slurm_job_id": {
      "type": "string"
    },
    "source_paths": {
      "$ref": "#/$defs/BenchmarkArchiveSourcePaths"
    },
    "tool_id": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "attempt_id",
    "tool_id",
    "slurm_job_id",
    "disposition",
    "archived_at_utc",
    "source_paths",
    "evidence_sha256",
    "accounting_sha256",
    "files"
  ],
  "title": "BenchmarkAttemptArchive",
  "type": "object"
}
