{
  "$defs": {
    "BenchmarkArchiveFileRecord": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "pattern": "^(submission|result)/[^/].+$",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "size_bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "path",
        "size_bytes",
        "sha256"
      ],
      "type": "object"
    },
    "BenchmarkAttemptDisposition": {
      "enum": [
        "failed",
        "superseded"
      ],
      "type": "string"
    },
    "BenchmarkAttemptMigrationEntry": {
      "additionalProperties": false,
      "properties": {
        "attempt_id": {
          "type": "string"
        },
        "case_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "disposition": {
          "$ref": "#/$defs/BenchmarkAttemptDisposition"
        },
        "files": {
          "items": {
            "$ref": "#/$defs/BenchmarkArchiveFileRecord"
          },
          "type": "array"
        },
        "run_id": {
          "type": "string"
        },
        "slurm_job_id": {
          "type": "string"
        },
        "source": {
          "pattern": "^study://[^/].+$",
          "type": "string"
        },
        "target": {
          "pattern": "^study://[^/].+$",
          "type": "string"
        },
        "tool_id": {
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "attempt_id",
        "tool_id",
        "slurm_job_id",
        "disposition",
        "source",
        "target",
        "files"
      ],
      "type": "object"
    },
    "BenchmarkAttemptMigrationExclusion": {
      "additionalProperties": false,
      "properties": {
        "reason": {
          "type": "string"
        },
        "source": {
          "pattern": "^study://[^/].+$",
          "type": "string"
        }
      },
      "required": [
        "source",
        "reason"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "created_at_utc": {
      "type": "string"
    },
    "entries": {
      "items": {
        "$ref": "#/$defs/BenchmarkAttemptMigrationEntry"
      },
      "type": "array"
    },
    "exclusions": {
      "items": {
        "$ref": "#/$defs/BenchmarkAttemptMigrationExclusion"
      },
      "type": "array"
    },
    "plan_id": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "schema_version": {
      "const": "bijux.benchmark.attempt_migration_plan.v1",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "plan_id",
    "created_at_utc",
    "entries",
    "exclusions"
  ],
  "title": "BenchmarkAttemptMigrationPlan",
  "type": "object"
}
