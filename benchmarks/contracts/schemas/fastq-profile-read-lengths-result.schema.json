{
  "$defs": {
    "BenchmarkFastqReadLengthResultRow": {
      "additionalProperties": false,
      "properties": {
        "distinct_read_lengths": {
          "minimum": 1,
          "type": "integer"
        },
        "file_count": {
          "maximum": 2,
          "minimum": 1,
          "type": "integer"
        },
        "histogram_artifact": {
          "pattern": "^[A-Za-z0-9._/-]+[.]tsv$",
          "type": "string"
        },
        "histogram_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "input_layout": {
          "enum": [
            "single_end",
            "paired_end"
          ],
          "type": "string"
        },
        "maximum_read_length": {
          "minimum": 1,
          "type": "integer"
        },
        "mean_read_length": {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "median_read_length": {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "minimum_read_length": {
          "minimum": 1,
          "type": "integer"
        },
        "read_count": {
          "minimum": 1,
          "type": "integer"
        },
        "sample_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "type": "string"
        }
      },
      "required": [
        "sample_id",
        "input_layout",
        "file_count",
        "read_count",
        "minimum_read_length",
        "mean_read_length",
        "median_read_length",
        "maximum_read_length",
        "distinct_read_lengths",
        "histogram_artifact",
        "histogram_sha256"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "results": {
      "items": {
        "$ref": "#/$defs/BenchmarkFastqReadLengthResultRow"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "schema_version": {
      "const": "bijux.benchmark.fastq.profile_read_lengths.bundle.v1",
      "type": "string"
    },
    "stage_id": {
      "const": "fastq.profile_read_lengths",
      "type": "string"
    },
    "tool_id": {
      "enum": [
        "seqfu",
        "seqkit"
      ],
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "stage_id",
    "tool_id",
    "results"
  ],
  "title": "BenchmarkFastqReadLengthResult",
  "type": "object"
}
