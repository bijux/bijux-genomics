        },
        "stage_id": {
          "type": "string"
        },
        "tool_id": {
          "type": "string"
        }
      },
      "required": [
        "stage_id",
        "readiness_kind",
        "tool_id",
        "declared_output_count",
        "present_output_count",
        "missing_output_count",
        "complete",
        "missing_outputs"
      ],
      "type": "object"
    },
    "BenchmarkLocalStageReadinessKind": {
      "enum": [
