          "type": "boolean"
        },
        "role": {
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "declared_path",
        "expected_fake_run_path",
        "role",
        "optional"
      ],
      "type": "object"
    },
    "BenchmarkLocalStageOutputCompletionEntry": {
      "additionalProperties": false,
      "properties": {
        "complete": {
          "type": "boolean"
        },
        "declared_output_count": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "missing_output_count": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "missing_outputs": {
