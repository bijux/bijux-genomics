    },
    "markdown_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "presentation_catalog_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "presentation_overlaid_stage_ids": {
