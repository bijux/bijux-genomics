{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bijux.github.io/bijux-genomics/schemas/benchmark-bam-duplication-metrics-result-v1.json",
  "title": "Normalized BAM duplication-metrics benchmark bundle",
  "type": "object",
  "required": [
    "schema_version",
    "stage_id",
    "tool_id",
    "sample_id",
    "examined_reads",
    "duplicate_reads",
    "duplication_fraction"
  ],
  "properties": {
    "schema_version": {"const": "bijux.benchmark.bam.duplication_metrics.bundle.v1"},
    "stage_id": {"const": "bam.duplication_metrics"},
    "tool_id": {"enum": ["picard", "samtools"]},
    "sample_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "examined_reads": {"type": "integer", "minimum": 1},
    "duplicate_reads": {"type": "integer", "minimum": 0},
    "duplication_fraction": {"type": "number", "minimum": 0, "maximum": 1}
  },
  "additionalProperties": false
}
