{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BenchmarkRunDefinition",
  "type": "object",
  "properties": {
    "acceptance_policy_id": {
      "type": "string"
    },
    "accepted_input_contracts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "citation_key": {
      "type": "string"
    },
    "contracts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/BenchmarkContractLock"
      }
    },
    "corpus_roles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/BenchmarkCorpusRole"
      }
    },
    "identity": {
      "$ref": "#/$defs/BenchmarkRunIdentity"
    },
    "measurement_policy_id": {
      "type": "string"
    },
    "normalized_result_contract": {
      "type": [
        "string",
        "null"
      ]
    },
    "output_contract": {
      "type": [
        "string",
        "null"
      ]
    },
    "owner": {
      "type": "string"
    },
    "profile_id": {
      "type": "string"
    },
    "protocol_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)[.](0|[1-9][0-9]*)[.](0|[1-9][0-9]*)$"
    },
    "purpose": {
      "type": "string"
    },
    "schema_version": {
      "type": "string",
      "const": "bijux.benchmark.run_definition.v1"
    },
    "state": {
      "$ref": "#/$defs/BenchmarkRunState"
    },
    "state_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "supersedes_run_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "title": {
      "type": "string"
    },
    "tool_exclusion_policy": {
      "type": "string"
    },
    "tool_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "identity",
    "protocol_version",
    "title",
    "purpose",
    "owner",
    "profile_id",
    "tool_exclusion_policy",
    "state",
    "tool_ids",
    "accepted_input_contracts",
    "measurement_policy_id",
    "contracts",
    "corpus_roles",
    "acceptance_policy_id",
    "citation_key",
    "supersedes_run_ids"
  ],
  "$defs": {
    "BenchmarkContractLock": {
      "type": "object",
      "properties": {
        "contract_id": {
          "type": "string"
        },
        "repository_path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false,
      "required": [
        "contract_id",
        "repository_path",
        "sha256"
      ]
    },
    "BenchmarkCorpusRole": {
      "type": "object",
      "properties": {
        "corpus_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "role": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "role",
        "corpus_ids"
      ]
    },
    "BenchmarkRunIdentity": {
      "type": "object",
      "properties": {
        "domain": {
          "type": "string"
        },
        "run_id": {
          "type": "string"
        },
        "stage_id": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "run_id",
        "domain",
        "stage_id"
      ]
    },
    "BenchmarkRunState": {
      "type": "string",
      "enum": [
        "active",
        "reserved",
        "retired"
      ]
    }
  }
}
