{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "mapped_primary_fraction": {
      "exclusiveMinimum": 0,
      "maximum": 1,
      "type": "number"
    },
    "mapped_primary_reads": {
      "minimum": 1,
      "type": "integer"
    },
    "paired_primary_reads": {
      "minimum": 1,
      "type": "integer"
    },
    "primary_reads": {
      "minimum": 1,
      "type": "integer"
    },
    "sample_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "type": "string"
    },
    "schema_version": {
      "const": "bijux.benchmark.bam.mapping_summary.bundle.v1",
      "type": "string"
    },
    "stage_id": {
      "const": "bam.mapping_summary",
      "type": "string"
    },
    "tool_id": {
      "enum": [
        "picard",
        "samtools"
      ],
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "stage_id",
    "tool_id",
    "sample_id",
    "primary_reads",
    "mapped_primary_reads",
    "mapped_primary_fraction",
    "paired_primary_reads"
  ],
  "title": "BenchmarkBamMappingSummaryResult",
  "type": "object"
}
