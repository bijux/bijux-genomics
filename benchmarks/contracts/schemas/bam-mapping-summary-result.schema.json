{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bijux.github.io/bijux-genomics/schemas/benchmark-bam-mapping-summary-result-v1.json",
  "title": "Normalized BAM mapping-summary benchmark bundle",
  "type": "object",
  "required": [
    "schema_version",
    "stage_id",
    "tool_id",
    "sample_id",
    "primary_reads",
    "mapped_primary_reads",
    "mapped_primary_fraction",
    "paired_primary_reads"
  ],
  "properties": {
    "schema_version": {"const": "bijux.benchmark.bam.mapping_summary.bundle.v1"},
    "stage_id": {"const": "bam.mapping_summary"},
    "tool_id": {"enum": ["picard", "samtools"]},
    "sample_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "primary_reads": {"type": "integer", "minimum": 1},
    "mapped_primary_reads": {"type": "integer", "minimum": 1},
    "mapped_primary_fraction": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
    "paired_primary_reads": {"type": "integer", "minimum": 1}
  },
  "additionalProperties": false
}
