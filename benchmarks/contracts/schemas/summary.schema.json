          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "params_hash": {
          "type": "string"
        },
        "read_layout": {
          "type": "string"
        },
        "runtime": {
          "$ref": "#/$defs/MetricSummary"
        },
        "stage_id": {
          "type": "string"
        },
        "stage_instance_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "tool_id": {
          "type": "string"
        }
