        "iqr": {
          "format": "double",
          "type": "number"
        },
        "mad": {
          "format": "double",
          "type": "number"
        },
        "median": {
          "format": "double",
          "type": "number"
        },
        "n": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "trimmed_mean": {
          "format": "double",
          "type": "number"
        }
