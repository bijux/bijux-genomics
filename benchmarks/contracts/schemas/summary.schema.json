        "$ref": "#/$defs/SummaryStratum"
      },
      "type": "array"
    },
    "suite_id": {
      "type": "string"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "suite_id",
    "rows",
    "strata",
    "warnings",
    "scientifically_invalid",
    "invalid_reasons"
