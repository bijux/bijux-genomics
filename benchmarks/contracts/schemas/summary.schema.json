        "ci_high": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "ci_low": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "metric_id": {
          "type": "string"
        },
        "n": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "outlier_count": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "outlier_replicates": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "power_warning": {
          "type": "boolean"
        },
        "practical_threshold": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "stats": {
          "$ref": "#/$defs/RobustStats"
        }
      },
      "required": [
        "metric_id",
        "n",
        "stats",
        "outlier_count",
        "outlier_replicates",
        "power_warning"
