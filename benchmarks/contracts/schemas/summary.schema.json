      "required": [
        "dataset_id",
        "dataset_class",
        "read_layout",
        "stage_id",
        "tool_id",
        "params_hash",
        "runtime",
        "memory",
        "metrics",
        "failure_rate",
        "completeness",
        "n_effective",
        "low_power"
