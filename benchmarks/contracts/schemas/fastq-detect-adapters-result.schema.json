{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bijux.github.io/bijux-genomics/schemas/benchmark-fastq-detect-adapters-result-v1.json",
  "title": "Normalized FASTQ adapter-inspection benchmark bundle",
  "type": "object",
  "required": ["schema_version", "stage_id", "tool_id", "results"],
  "properties": {
    "schema_version": {"const": "bijux.benchmark.fastq.detect_adapters.bundle.v1"},
    "stage_id": {"const": "fastq.detect_adapters"},
    "tool_id": {"enum": ["fastqc"]},
    "results": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "sample_id",
          "input_layout",
          "file_count",
          "reads_in",
          "reads_out",
          "bases_in",
          "bases_out",
          "mean_q",
          "candidate_adapter_count",
          "detected_adapter_ids",
          "detection_threshold",
          "adapter_trimmed_fraction",
          "adapter_content_max",
          "adapter_content_mean",
          "duplication_rate",
          "n_rate",
          "kmer_warning_count",
          "overrepresented_sequence_count"
        ],
        "properties": {
          "sample_id": {"type": "string", "minLength": 1},
          "input_layout": {"enum": ["single_end", "paired_end"]},
          "file_count": {"type": "integer", "minimum": 1, "maximum": 2},
          "reads_in": {"type": "integer", "minimum": 1},
          "reads_out": {"type": "integer", "minimum": 1},
          "bases_in": {"type": "integer", "minimum": 1},
          "bases_out": {"type": "integer", "minimum": 1},
          "mean_q": {"type": "number", "minimum": 0.0},
          "candidate_adapter_count": {"type": "integer", "minimum": 0},
          "detected_adapter_ids": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "detection_confidence": {"type": ["number", "null"], "minimum": 0.0},
          "detection_threshold": {"type": "number", "minimum": 0.0},
          "adapter_trimmed_fraction": {"type": "number", "minimum": 0.0},
          "adapter_content_max": {"type": "number", "minimum": 0.0},
          "adapter_content_mean": {"type": "number", "minimum": 0.0},
          "duplication_rate": {"type": "number", "minimum": 0.0},
          "n_rate": {"type": "number", "minimum": 0.0},
          "kmer_warning_count": {"type": "integer", "minimum": 0},
          "overrepresented_sequence_count": {"type": "integer", "minimum": 0}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
