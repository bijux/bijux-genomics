{
  "$defs": {
    "BenchmarkReportComparisonPresentation": {
      "enum": [
        "status_only",
        "range_only",
        "tool_means"
      ],
      "type": "string"
    },
    "BenchmarkReportDeterminismPresentation": {
      "enum": [
        "detailed_evidence",
        "compact_evidence"
      ],
      "type": "string"
    },
    "BenchmarkReportMetricFormat": {
      "enum": [
        "seconds3",
        "mebibytes1",
        "mebibytes_per_second2",
        "number0",
        "number1",
        "percent1"
      ],
      "type": "string"
    },
    "BenchmarkReportPerformanceColumn": {
      "additionalProperties": false,
      "properties": {
        "format": {
          "$ref": "#/$defs/BenchmarkReportMetricFormat"
        },
        "heading": {
          "type": "string"
        },
        "include_range": {
          "default": false,
          "type": "boolean"
        },
        "metric": {
          "type": "string"
        }
      },
      "required": [
        "metric",
        "heading",
        "format"
      ],
      "type": "object"
    },
    "BenchmarkReportPresentation": {
      "additionalProperties": false,
      "properties": {
        "comparison": {
          "$ref": "#/$defs/BenchmarkReportComparisonPresentation"
        },
        "determinism": {
          "$ref": "#/$defs/BenchmarkReportDeterminismPresentation"
        },
        "generated_source": {
          "type": "string"
        },
        "include_comparison_closure": {
          "default": false,
          "type": "boolean"
        },
        "performance_columns": {
          "items": {
            "$ref": "#/$defs/BenchmarkReportPerformanceColumn"
          },
          "type": "array"
        },
        "report_file_stem": {
          "type": "string"
        },
        "separate_accuracy_claim": {
          "default": false,
          "type": "boolean"
        },
        "title_class": {
          "$ref": "#/$defs/BenchmarkReportTitleClass"
        }
      },
      "required": [
        "report_file_stem",
        "generated_source",
        "title_class",
        "determinism",
        "comparison",
        "performance_columns"
      ],
      "type": "object"
    },
    "BenchmarkReportTitleClass": {
      "enum": [
        "qualification",
        "comparative"
      ],
      "type": "string"
    },
    "BenchmarkStageDownstreamProbe": {
      "additionalProperties": false,
      "properties": {
        "assertions": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "consumer_stage_id": {
          "type": "string"
        },
        "input_contract": {
          "type": "string"
        },
        "source": {
          "type": "string"
        }
      },
      "required": [
        "consumer_stage_id",
        "input_contract",
        "source",
        "assertions"
      ],
      "type": "object"
    },
    "BenchmarkStageInterfaceSpec": {
      "additionalProperties": false,
      "properties": {
        "accepted_input_contracts": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "adapters": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "default_provider": {
          "type": "string"
        },
        "downstream_probe": {
          "$ref": "#/$defs/BenchmarkStageDownstreamProbe"
        },
        "effective_parameters_artifact": {
          "type": "string"
        },
        "immutable_parameters": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "input_derived_parameters": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "normalized_result_contract": {
          "type": "string"
        },
        "operator_override_keys": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "output_contract": {
          "type": "string"
        },
        "parameter_config": {
          "type": "string"
        },
        "parameter_projections": {
          "additionalProperties": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "type": "object"
        },
        "parameter_schema_version": {
          "type": "string"
        },
        "planner_contract": {
          "type": [
            "string",
            "null"
          ]
        },
        "provenance_sources": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "report_presentation": {
          "$ref": "#/$defs/BenchmarkReportPresentation"
        },
        "stage_id": {
          "type": "string"
        },
        "tool_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "stage_id",
        "accepted_input_contracts",
        "output_contract",
        "normalized_result_contract",
        "parameter_schema_version",
        "default_provider",
        "parameter_config",
        "input_derived_parameters",
        "immutable_parameters",
        "effective_parameters_artifact",
        "tool_ids",
        "provenance_sources",
        "adapters",
        "downstream_probe",
        "report_presentation"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "interfaces": {
      "items": {
        "$ref": "#/$defs/BenchmarkStageInterfaceSpec"
      },
      "type": "array"
    },
    "schema_version": {
      "const": "bijux.benchmark.stage_interfaces.v1",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "interfaces"
  ],
  "title": "BenchmarkStageInterfaceCatalog",
  "type": "object"
}
