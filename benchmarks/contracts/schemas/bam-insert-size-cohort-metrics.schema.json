{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Aggregate metrics emitted for one measured insert-size cohort repetition.",
  "properties": {
    "input_bytes": {
      "minimum": 1,
      "type": "integer"
    },
    "maximum_insert_size": {
      "exclusiveMinimum": 0,
      "type": "number"
    },
    "mean_insert_size": {
      "exclusiveMinimum": 0,
      "type": "number"
    },
    "median_absolute_deviation": {
      "minimum": 0,
      "type": "number"
    },
    "median_insert_size": {
      "exclusiveMinimum": 0,
      "type": "number"
    },
    "minimum_insert_size": {
      "exclusiveMinimum": 0,
      "type": "number"
    },
    "output_bytes": {
      "minimum": 1,
      "type": "integer"
    },
    "pair_orientation_fr_fraction": {
      "maximum": 1,
      "minimum": 0,
      "type": "number"
    },
    "read_pairs": {
      "exclusiveMinimum": 0,
      "type": "number"
    },
    "sample_count": {
      "minimum": 1,
      "type": "integer"
    },
    "standard_deviation": {
      "minimum": 0,
      "type": "number"
    }
  },
  "required": [
    "sample_count",
    "median_insert_size",
    "mean_insert_size",
    "standard_deviation",
    "median_absolute_deviation",
    "minimum_insert_size",
    "maximum_insert_size",
    "read_pairs",
    "pair_orientation_fr_fraction",
    "input_bytes",
    "output_bytes"
  ],
  "title": "BenchmarkBamInsertSizeCohortMetrics",
  "type": "object"
}
