{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bijux.github.io/bijux-genomics/schemas/benchmark-bam-coverage-result-v1.json",
  "title": "Normalized BAM coverage benchmark bundle",
  "type": "object",
  "required": [
    "schema_version",
    "stage_id",
    "tool_id",
    "sample_id",
    "reference_bases",
    "covered_bases",
    "coverage_fraction",
    "mean_depth"
  ],
  "properties": {
    "schema_version": {"const": "bijux.benchmark.bam.coverage.bundle.v1"},
    "stage_id": {"const": "bam.coverage"},
    "tool_id": {"enum": ["bedtools", "mosdepth", "samtools"]},
    "sample_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "reference_bases": {"type": "integer", "minimum": 1},
    "covered_bases": {"type": "integer", "minimum": 1},
    "coverage_fraction": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
    "mean_depth": {"type": "number", "exclusiveMinimum": 0}
  },
  "additionalProperties": false
}
