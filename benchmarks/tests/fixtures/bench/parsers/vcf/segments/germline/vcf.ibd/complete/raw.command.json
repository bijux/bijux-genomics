{
  "tool_id": "germline",
  "stage_id": "vcf.ibd",
  "argv": [
    "sh",
    "-lc",
    "plink2 --vcf 'cohort.vcf.gz' --double-id --allow-extra-chr --recode ped --out 'cohort' >/dev/null 2>&1 && germline -silent -input 'cohort.ped' 'cohort.map' -output 'ibd_segments' -bits 50 -min_m 1 -err_hom 2 -err_het 0 > 'raw.log' 2>&1"
  ]
}
