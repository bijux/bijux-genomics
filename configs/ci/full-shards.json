{
  "schema_version": "bijux.ci.full_shards.v4",
  "coverage": {
    "workspace": true,
    "all_targets": true,
    "all_features": true,
    "run_ignored": "all",
    "overlap_policy": "exactly_once"
  },
  "partition_strategy": "hash",
  "workspace_isolation": "tracked_source_clones_with_shared_immutable_archive",
  "build_authority": "configs/ci/build-authority.json",
  "archive_build_jobs": 4,
  "archive_root": "artifacts/ci/full-shards/archive",
  "shard_artifact_root": "artifacts/ci/full-shards/shards",
  "report_root": "artifacts/ci/full-shards",
  "shards": [
    {
      "id": "hash-1-of-4",
      "partition": "hash:1/4"
    },
    {
      "id": "hash-2-of-4",
      "partition": "hash:2/4"
    },
    {
      "id": "hash-3-of-4",
      "partition": "hash:3/4"
    },
    {
      "id": "hash-4-of-4",
      "partition": "hash:4/4"
    }
  ]
}
