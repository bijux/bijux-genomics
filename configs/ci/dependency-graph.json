{
  "schema": "bijux.ci.dependency_graph.v1",
  "planner": {
    "path_match": "longest_declared_path",
    "dependency_propagation": "reverse_dependents",
    "unmatched_change": "ci-full",
    "empty_plan": "ci-full"
  },
  "periodic_full_validation": {
    "gate": "ci-full",
    "cadence": "nightly",
    "validates_change_impact_planner": true
  },
  "gate_families": [
    {
      "id": "ci-full",
      "command": "make _ci-slow"
    },
    {
      "id": "workspace-policy",
      "command": "cargo run -q -p bijux-dna-dev -- checks run all"
    },
    {
      "id": "crate-tests",
      "command_template": "cargo test -p {crate} --all-targets"
    },
    {
      "id": "generated-configs",
      "command": "cargo run -q -p bijux-dna-dev -- checks run check-generated-configs"
    },
    {
      "id": "benchmark-contracts",
      "command": "cargo test -p bijux-dna-bench --all-targets"
    },
    {
      "id": "container-contracts",
      "command": "cargo test -p bijux-dna-containers --all-targets"
    },
    {
      "id": "report-freshness",
      "command": "cargo run -q -p bijux-dna-dev -- checks run check-run-directory-layout"
    }
  ],
