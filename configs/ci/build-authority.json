{
  "schema": "bijux.ci.build_authority.v3",
  "toolchain": {
    "manifest": "rust-toolchain.toml",
    "channel": "1.95.0",
    "required_components": [
      "clippy",
      "rustfmt"
    ]
  },
  "test_executor": {
    "package": "cargo-nextest",
    "subcommand": "nextest",
    "version": "0.9.100"
  },
  "lockfile": {
    "manifest": "Cargo.lock",
    "metadata_mode": "locked",
    "dependency_resolution": "workspace_lock_only"
  },
  "compilation": {
    "manifest": "Cargo.toml",
    "dev_codegen_units": 16,
    "test_codegen_units": 16,
    "incremental": true
  },
  "cache": {
    "compiler_wrapper": "sccache",
    "metrics_format": "json",
    "before_filename": "sccache-before.json",
    "after_filename": "sccache-after.json",
    "publish_on_failure": true
  },
  "targets": {
    "shared_prebuild_root": "artifacts/target",
    "concurrent_target_pattern": "artifacts/github-all/targets/{gate}",
    "concurrent_policy": "isolated_per_gate",
    "reuse_policy": "sccache_and_shared_dev_binary"
  }
}
