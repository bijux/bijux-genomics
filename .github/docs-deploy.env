# The manual publisher builds and verifies one source-qualified artifact.
BIJUX_DOCS_INSTALL_COMMAND='make gh-docs-install'
BIJUX_DOCS_BUILD_COMMAND='make gh-docs-build'
BIJUX_DOCS_VERIFY_COMMAND='make gh-docs-verify'
BIJUX_DOCS_SITE_DIR='artifacts/docs/site'
BIJUX_DOCS_SETUP_PYTHON='true'
BIJUX_DOCS_PYTHON_VERSION='3.11.17'
BIJUX_DOCS_SETUP_NODE='true'
BIJUX_DOCS_NODE_VERSION='24.21.0'
BIJUX_DOCS_SETUP_UV='true'
BIJUX_DOCS_SETUP_RUST='false'
