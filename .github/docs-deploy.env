# The manual publisher builds the governed MkDocs artifact in an isolated environment.
BIJUX_DOCS_INSTALL_COMMAND='python3 -m venv artifacts/docs/venv && artifacts/docs/venv/bin/python -m pip install -r configs/docs/requirements.txt'
BIJUX_DOCS_BUILD_COMMAND='artifacts/docs/venv/bin/python -m mkdocs build --config-file mkdocs.yml --strict --site-dir artifacts/docs/site'
BIJUX_DOCS_VERIFY_COMMAND='DOCS_PYTHON=artifacts/docs/venv/bin/python bash .bijux/shared/bijux-docs/tooling/scripts/verify_bijux_docs_site.sh'
BIJUX_DOCS_SITE_DIR='artifacts/docs/site'
BIJUX_DOCS_SETUP_PYTHON='true'
BIJUX_DOCS_PYTHON_VERSION='3.11'
BIJUX_DOCS_SETUP_NODE='true'
BIJUX_DOCS_NODE_VERSION='24.21.0'
