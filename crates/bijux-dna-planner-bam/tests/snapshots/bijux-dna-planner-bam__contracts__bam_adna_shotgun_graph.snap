yping/genotyping.vcf.gz.tbi\",\"minimum_posterior\":0.8,\"minimum_call_rate\":0.7,\"posterior_derivation\":\"bcftools_tag2tag_PL_to_GP\"}\\n' > <TMPDIR>/<TMP>/out/bam_genotyping/genotyping.summary.json && printf '{\"variant_count\":%s,\"sample_count\":%s,\"confident_called_genotypes\":%s,\"total_genotypes\":%s,\"minimum_posterior\":0.8,\"confident_call_rate\":%s}\\n' \"$variant_count\" \"$sample_count\" \"$called_genotypes\" \"$total_genotypes\" \"$call_rate\" > <TMPDIR>/<TMP>/out/bam_genotyping/stage_metrics.json && printf '{\"status\":\"ok\",\"producer\":\"bam.genotyping\",\"caller\":\"bcftools\",\"output_bcf\":\"<TMPDIR>/<TMP>/out/bam_genotyping/genotyping.bcf\",\"output_vcf\":\"<TMPDIR>/<TMP>/out/bam_genotyping/genotyping.vcf.gz\"}\\n' > <TMPDIR>/<TMP>/out/bam_genotyping/genotyping.json"
