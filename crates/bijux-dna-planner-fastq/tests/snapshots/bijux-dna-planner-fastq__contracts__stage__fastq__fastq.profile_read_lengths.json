{
  "stage_id": "fastq.profile_read_lengths",
  "stage_instance_id": "fastq.profile_read_lengths.tool.seqkit",
  "stage_version": 1,
  "tool_id": "seqkit",
  "tool_version": "domain-manifest",
  "image": {
    "image": "bijuxdna/seqkit",
    "digest": null
  },
  "command": {
    "template": [
      "seqkit",
      "fx2tab",
      "--name",
      "--only-id",
      "--length",
      "--threads",
      "2",
      "reads_R1.fastq.gz",
      "reads_R2.fastq.gz"
    ]
  },
  "resources": {
    "runtime": "local",
    "mem_gb": 4,
    "tmp_gb": 2,
    "threads": 2
  },
  "io": {
    "inputs": [
      {
        "name": "reads_r1",
        "path": "reads_R1.fastq.gz",
        "role": "reads",
        "artifact_contract_id": "bijux.fastq.artifact.reads.v1",
        "optional": false
      },
      {
        "name": "reads_r2",
        "path": "reads_R2.fastq.gz",
        "role": "reads",
        "artifact_contract_id": "bijux.fastq.artifact.reads.v1",
        "optional": false
      }
    ],
    "outputs": [
      {
        "name": "report_json",
        "path": "out/profile_read_lengths_report.json",
        "role": "report_json",
        "artifact_contract_id": "bijux.auxiliary.artifact.json.v1",
        "optional": false
      },
      {
        "name": "length_distribution_tsv",
        "path": "out/length_distribution.tsv",
        "role": "summary_tsv",
        "artifact_contract_id": "bijux.auxiliary.artifact.table.v1",
        "optional": false
      },
      {
        "name": "length_distribution_json",
        "path": "out/length_distribution.json",
        "role": "metrics_json",
        "artifact_contract_id": "bijux.auxiliary.artifact.json.v1",
        "optional": false
      }
    ]
  },
  "out_dir": "out",
  "params": {
    "histogram_bins": 100,
    "input_r1": "reads_R1.fastq.gz",
    "input_r2": "reads_R2.fastq.gz",
    "output_json": "out/length_distribution.json",
    "output_tsv": "out/length_distribution.tsv",
    "report_json": "out/profile_read_lengths_report.json",
    "threads": 2,
    "tool": "seqkit"
  },
  "effective_params": {
    "histogram_bins": 100,
    "paired_mode": "paired_end",
    "schema_version": "bijux.fastq.params.read_length_profile.v1",
    "threads": 2
  },
  "operating_mode": "enforced",
  "aux_images": {},
  "canonical_contract": null,
  "provenance": null,
  "reason": {
    "kind": "default",
    "summary": "pre-trim length distribution metrics",
    "details": {}
  }
}