# BIJUX_TEMPLATE: v1
# Tool ID: bwa
# Version policy: immutable upstream commit and verified source archive
# Upstream source: https://github.com/lh3/bwa
# Build date policy: captured by immutable build evidence
# Network source policy: build-only access to the locked Ubuntu snapshot and source archive
# Runtime UID policy: non-root runtime with caller-owned output paths
# VERSION_SOURCE: containers/contracts/catalog.toml

Bootstrap: docker
From: ubuntu@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b

%labels
    org.opencontainers.image.source https://github.com/lh3/bwa
    org.opencontainers.image.revision 9f26bfcc7780753129b60717ecab0ebba6f04b7c
    org.opencontainers.image.created governed-by-build-evidence
    org.opencontainers.image.licenses GPL-3.0
    org.opencontainers.image.version 0.7.17
    io.bijux.tool.version 0.7.17
    org.opencontainers.image.tool bwa
    org.opencontainers.image.title BWA

%files
    containers/contracts/configure-apt-snapshot /usr/local/sbin/bijux-configure-apt-snapshot
    containers/tools/bwa/bwa /usr/local/bin/bwa

%environment
    export PATH=/usr/local/bin:/usr/bin:/bin
    export LANG=C
    export LC_ALL=C
    export TZ=UTC

%post
    set -eux
    umask 022
    export DEBIAN_FRONTEND=noninteractive
    /bin/sh /usr/local/sbin/bijux-configure-apt-snapshot
    apt-get install -y --no-install-recommends ca-certificates
    apt-get -o Acquire::Check-Valid-Until=false update
    apt-get install -y --no-install-recommends curl gcc make zlib1g-dev
    curl --fail --location --silent --show-error \
        --output /tmp/bwa.tar.gz \
        https://github.com/lh3/bwa/archive/9f26bfcc7780753129b60717ecab0ebba6f04b7c.tar.gz
    echo '79763dd6c48e8b01b8e27d99e6e5575d8bbca419e3eed9f3e330af072e63b370  /tmp/bwa.tar.gz' | sha256sum --check --strict
    rm -rf /tmp/bwa-9f26bfcc7780753129b60717ecab0ebba6f04b7c
    tar --extract --gzip --file /tmp/bwa.tar.gz --directory /tmp
    make --directory /tmp/bwa-9f26bfcc7780753129b60717ecab0ebba6f04b7c \
        CFLAGS='-g -Wall -Wno-unused-function -O2 -fcommon' -j"$(nproc)"
    install -m 0755 /tmp/bwa-9f26bfcc7780753129b60717ecab0ebba6f04b7c/bwa /usr/local/libexec-bwa
    chmod 0555 /usr/local/bin/bwa
    bwa --version > /tmp/bwa.version
    grep -Fx '0.7.17-r1188' /tmp/bwa.version
    bwa --help > /tmp/bwa.help
    grep -F 'Program: bwa ' /tmp/bwa.help
    rm -f /tmp/bwa.version /tmp/bwa.help
    rm -rf /tmp/bwa*
    rm -rf /var/lib/apt/lists/*

%runscript
    exec /usr/local/bin/bwa "$@"

%test
    bwa --version > /tmp/bwa.version
    grep -Fx '0.7.17-r1188' /tmp/bwa.version
    bwa --help > /tmp/bwa.help
    grep -F 'Program: bwa ' /tmp/bwa.help
    rm -f /tmp/bwa.version /tmp/bwa.help

%help
    BWA 0.7.17 built from the catalog-locked upstream commit.
    Version and help normalization are derived from the authentic binary output.
