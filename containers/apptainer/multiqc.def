# BIJUX_TEMPLATE: v1

# Tool ID: multiqc
# Version policy: pinned_or_registry_locked
# Upstream source: see org.opencontainers.image.source label
# Build date policy: captured by immutable build evidence
# Network source policy: NETWORK_SOURCE_VERIFIED_BY_LOCK
# Runtime UID policy: RUNTIME_UID_SAFE

# VERSION_SOURCE: containers/versions/versions.toml
Bootstrap: docker
From: ubuntu@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b

%labels
    MAINTAINER Bijan Mousavi <bijan@bijux.io>
    VERSION MultiQC-v1.24
    org.opencontainers.image.source https://github.com/multiqc/multiqc

    org.opencontainers.image.revision 3c55b3c3f1194e5256a77048535c064e8509487e
    org.opencontainers.image.created governed-by-build-evidence
    org.opencontainers.image.licenses GPL-3.0
    org.opencontainers.image.version 1.24
    org.opencontainers.image.tool multiqc
    org.opencontainers.image.title multiqc
%environment
    export PATH=/opt/multiqc-venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
    export LC_ALL=C
    export TZ=UTC
    DEBIAN_FRONTEND=noninteractive

%post
    set -eux
    umask 022
    export DEBIAN_FRONTEND=noninteractive

    apt-get update && \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        python3 \
        python3-venv \
        python3-pip \
        python3-dev && \

    python3 -m venv /opt/multiqc-venv && \
    python3 -c 'import urllib.request; urllib.request.urlretrieve("https://files.pythonhosted.org/packages/70/47/ba71ed113c96221ce33113baaeac9d75a21e1dd0b5c76eb378ab6a61f87b/multiqc-1.24-py3-none-any.whl", "/tmp/multiqc-1.24-py3-none-any.whl")' && \
    echo '991755ce91462b20aaa72fb78daa8b477b9c920ac099d434cef1b96394d099cb  /tmp/multiqc-1.24-py3-none-any.whl' | sha256sum -c - && \
    /opt/multiqc-venv/bin/pip install --no-cache-dir \
        /tmp/multiqc-1.24-py3-none-any.whl && \
    ln -sf /opt/multiqc-venv/bin/multiqc /usr/local/bin/multiqc && \
    rm -f /tmp/multiqc-1.24-py3-none-any.whl && \

    rm -rf /var/lib/apt/lists/*
%runscript
    if [ $# -eq 0 ]; then
        exec multiqc --help
    else
        exec multiqc "$@"
    fi

%help
    This Apptainer image provides MultiQC version 1.24, installed in /opt/multiqc-venv.
    Run with arguments to execute multiqc (typically on a directory containing QC reports).
    Run without arguments to display detailed help.
