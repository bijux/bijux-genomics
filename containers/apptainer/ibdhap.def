# Tool ID: ibdhap
# Version policy: verified upstream MORGAN release archive
# Upstream source: https://sites.stat.washington.edu/thompson/Genepi/MORGAN/Morgan.shtml
# Build date policy: captured by immutable build evidence
# Network source policy: build-only access to the locked Ubuntu snapshot and release archive
# Runtime UID policy: non-root runtime with caller-owned output paths
# VERSION_SOURCE: containers/contracts/catalog.toml
Bootstrap: docker
From: ubuntu@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b

%labels
    org.opencontainers.image.source https://sites.stat.washington.edu/thompson/Genepi/MORGAN/Morgan.shtml
    org.opencontainers.image.revision 195a84d877413a83de15a20da45d92d2441303b8373b47727ed2e3ab92dc2e6a
    org.opencontainers.image.created governed-by-build-evidence
    org.opencontainers.image.licenses LicenseRef-MORGAN-2006
    org.opencontainers.image.version 3.4
    org.opencontainers.image.tool ibdhap
    org.opencontainers.image.title MORGAN IBDHap

%environment
    export PATH=/usr/local/bin:/usr/bin:/bin
    export LANG=C
    export LC_ALL=C
    export TZ=UTC

%files
    containers/tools/ibdhap/ibdhap /usr/local/bin/ibdhap

%post
    set -eux
    umask 022
    export DEBIAN_FRONTEND=noninteractive
    sed -i 's#http://archive.ubuntu.com/ubuntu/#https://snapshot.ubuntu.com/ubuntu/20260802T000000Z/#g; s#http://security.ubuntu.com/ubuntu/#https://snapshot.ubuntu.com/ubuntu/20260802T000000Z/#g' /etc/apt/sources.list.d/ubuntu.sources
    apt-get -o Acquire::https::Verify-Peer=false -o Acquire::Check-Valid-Until=false update
    apt-get -o Acquire::https::Verify-Peer=false install -y --no-install-recommends ca-certificates
    apt-get -o Acquire::Check-Valid-Until=false update
    apt-get install -y --no-install-recommends curl gcc libc6-dev make python3
    curl --fail --location --silent --show-error --output /opt/morgan.tar.gz https://faculty.washington.edu/eathomp/Anonftp/PANGAEA/MORGAN/morgan_v34_release.tar.gz
    echo '195a84d877413a83de15a20da45d92d2441303b8373b47727ed2e3ab92dc2e6a  /opt/morgan.tar.gz' | sha256sum --check --strict
    tar --extract --gzip --file /opt/morgan.tar.gz --directory /opt
    # MORGAN 3.4 predates GCC 10's -fno-common default. Build only the
    # libraries and IBDHap executable instead of unrelated MORGAN programs.
    make --directory /opt/MORGAN_V34_Release libs CC=gcc 'CFLAGS=-fcommon -pedantic -Wall -std=c99 -I../Headers -I./'
    make --directory /opt/MORGAN_V34_Release/IBD_Haplo ibd_haplo.gcc CFLAGS=-fcommon
    install -d -m 0755 /opt/morgan/bin
    install -m 0755 /opt/MORGAN_V34_Release/IBD_Haplo/ibd_haplo /opt/morgan/bin/ibd_haplo
    chmod 0755 /usr/local/bin/ibdhap
    ibdhap --version | grep -Fx 'ibdhap 3.4'
    ibdhap --help >/dev/null
    rm -rf /opt/morgan.tar.gz /opt/MORGAN_V34_Release
    apt-get purge -y --auto-remove curl gcc libc6-dev make
    apt-get clean
    rm -rf /var/lib/apt/lists/*

%runscript
    exec /usr/local/bin/ibdhap "$@"

%test
    ibdhap --version | grep -Fx 'ibdhap 3.4'
    ibdhap --help >/dev/null
    test -x /opt/morgan/bin/ibd_haplo

%help
    MORGAN IBDHap 3.4 built from its verified University of Washington release.
