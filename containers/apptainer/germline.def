# Bijux Genomics source code is licensed under Apache-2.0.
# Copyright (C) 2026 Bijan Mousavi
# Tool ID: germline
# Version policy: exact upstream release archive with a governed SHA-256 digest
# Upstream source: https://github.com/gusevlab/germline/tree/f8029fcf469a09a83aa1e0d1fb45769f6dcb3c6d
# Build date policy: captured by immutable build evidence
# Network source policy: build-only access to the locked Ubuntu snapshot and release archive
# Runtime UID policy: non-root runtime with caller-owned output paths
# VERSION_SOURCE: containers/contracts/catalog.toml
Bootstrap: docker
From: ubuntu@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b

%labels
    org.opencontainers.image.source https://github.com/gusevlab/germline
    org.opencontainers.image.revision f8029fcf469a09a83aa1e0d1fb45769f6dcb3c6d
    org.opencontainers.image.created governed-by-build-evidence
    org.opencontainers.image.licenses Apache-2.0
    org.opencontainers.image.version 1.5.3
    org.opencontainers.image.tool germline
    org.opencontainers.image.title germline

%environment
    export PATH=/usr/local/bin:/usr/bin:/bin
    export LANG=C
    export LC_ALL=C
    export TZ=UTC

%files
    containers/tools/germline/germline /usr/local/bin/germline

%post
    set -eux
    umask 022
    export DEBIAN_FRONTEND=noninteractive
    sed -i 's#http://archive.ubuntu.com/ubuntu/#https://snapshot.ubuntu.com/ubuntu/20260802T000000Z/#g; s#http://security.ubuntu.com/ubuntu/#https://snapshot.ubuntu.com/ubuntu/20260802T000000Z/#g' /etc/apt/sources.list.d/ubuntu.sources
    apt-get -o Acquire::https::Verify-Peer=false -o Acquire::Check-Valid-Until=false update
    apt-get -o Acquire::https::Verify-Peer=false install -y --no-install-recommends ca-certificates
    apt-get -o Acquire::Check-Valid-Until=false update
    apt-get install -y --no-install-recommends libstdc++6
    apt-get install -y --no-install-recommends curl g++ make
    curl --fail --location --proto '=https' --tlsv1.2 --output /opt/germline.tar.gz https://codeload.github.com/gusevlab/germline/tar.gz/f8029fcf469a09a83aa1e0d1fb45769f6dcb3c6d
    echo '42a6e14e003ac6aa5cc5c3b14db4ba355d748c014b0d0a10f0f734dca2bfb991  /opt/germline.tar.gz' | sha256sum -c -
    tar --extract --gzip --file /opt/germline.tar.gz --directory /opt
    make --directory /opt/germline-f8029fcf469a09a83aa1e0d1fb45769f6dcb3c6d germline
    install -d -m 0755 /opt/germline/bin
    install -m 0755 /opt/germline-f8029fcf469a09a83aa1e0d1fb45769f6dcb3c6d/germline /opt/germline/bin/germline-native
    chmod 0755 /usr/local/bin/germline
    germline --version | grep -Fx 'germline 1.5.3'
    germline --help >/dev/null
    rm -rf /opt/germline.tar.gz /opt/germline-f8029fcf469a09a83aa1e0d1fb45769f6dcb3c6d
    apt-get purge -y --auto-remove curl g++ make
    apt-get clean
    rm -rf /var/lib/apt/lists/*

%runscript
    exec /usr/local/bin/germline "$@"

%test
    germline --version | grep -Fx 'germline 1.5.3'
    germline --help >/dev/null
    test -x /opt/germline/bin/germline-native

%help
    GERMLINE 1.5.3 built from its exact checksummed upstream release.
