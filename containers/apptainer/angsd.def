# Copyright (C) 2026 Bijan Mousavi
# Tool ID: angsd
# Version policy: immutable source graph rooted at the upstream 0.941 commit
# Upstream source: https://github.com/ANGSD/angsd
# Build date policy: captured by immutable build evidence
# Network source policy: build-only access to locked snapshots and source archives
# NETWORK_SOURCE_VERIFIED_BY_LOCK
# Runtime UID policy: non-root runtime with caller-owned output paths
# VERSION_SOURCE: containers/contracts/catalog.toml

Bootstrap: docker
From: ubuntu@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b

%labels
    org.opencontainers.image.source https://github.com/ANGSD/angsd
    org.opencontainers.image.revision b3099ed756e7aff87d2d1dd4fd30cdf36998380b
    org.opencontainers.image.created governed-by-build-evidence
    org.opencontainers.image.licenses NOASSERTION
    org.opencontainers.image.version 0.941
    org.opencontainers.image.tool angsd
    org.opencontainers.image.title ANGSD

%files
    containers/tools/angsd/install /opt/angsd-build/install
    containers/tools/angsd/angsd /usr/local/bin/angsd

%environment
    export PATH=/usr/local/bin:/usr/bin:/bin
    export LANG=C
    export LC_ALL=C
    export TZ=UTC

%post
    set -eux
    umask 022
    export DEBIAN_FRONTEND=noninteractive
    sed -i 's#http://archive.ubuntu.com/ubuntu/#https://snapshot.ubuntu.com/ubuntu/20260802T000000Z/#g; s#http://security.ubuntu.com/ubuntu/#https://snapshot.ubuntu.com/ubuntu/20260802T000000Z/#g' /etc/apt/sources.list.d/ubuntu.sources
    apt-get -o Acquire::https::Verify-Peer=false -o Acquire::Check-Valid-Until=false update
    apt-get -o Acquire::https::Verify-Peer=false install -y --no-install-recommends ca-certificates
    apt-get -o Acquire::Check-Valid-Until=false update
    apt-get install -y --no-install-recommends autoconf automake build-essential curl libbz2-dev libcurl4-openssl-dev liblzma-dev libssl-dev libtool pkg-config zlib1g-dev
    /opt/angsd-build/install
    apt-get clean
    rm -rf /var/lib/apt/lists/*

%runscript
    exec /usr/local/bin/angsd "$@"

%test
    angsd --version | grep -Fx 'ANGSD 0.941'
    angsd --help >/dev/null 2>&1
    if angsd --governed-invalid-option >/dev/null 2>&1; then exit 1; fi
    test -x /opt/angsd/bin/angsd-native

%help
    ANGSD 0.941 built from an immutable ANGSD, HTSlib, and HTScodecs source graph.
