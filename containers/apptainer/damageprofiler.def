# Tool ID: damageprofiler
# Version policy: checksummed DamageProfiler 1.1 release artifact
# Upstream source: https://github.com/Integrative-Transcriptomics/DamageProfiler
# Build date policy: captured by immutable build evidence
# Network source policy: build-only access to the locked release artifact
# NETWORK_SOURCE_VERIFIED_BY_LOCK
# Runtime UID policy: non-root runtime with caller-owned output paths
# VERSION_SOURCE: containers/contracts/catalog.toml

Bootstrap: docker
From: ubuntu@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b

%labels
    org.opencontainers.image.source https://github.com/Integrative-Transcriptomics/DamageProfiler
    org.opencontainers.image.revision 3be52404124ae294f0eaf2fa622fe8af548bb6ed
    org.opencontainers.image.created governed-by-build-evidence
    org.opencontainers.image.licenses GPL-3.0-only
    org.opencontainers.image.version 1.1
    org.opencontainers.image.tool damageprofiler
    org.opencontainers.image.title damageprofiler
%environment
    export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
    export LANG=C
    export LC_ALL=C
    export TZ=UTC

%files
    containers/tools/damageprofiler/install /opt/damageprofiler-build/install
    containers/tools/damageprofiler/damageprofiler /usr/local/bin/damageprofiler

%post
    set -eux
    umask 022
    export DEBIAN_FRONTEND=noninteractive
    sed -i 's#http://archive.ubuntu.com/ubuntu/#https://snapshot.ubuntu.com/ubuntu/20260802T000000Z/#g; s#http://security.ubuntu.com/ubuntu/#https://snapshot.ubuntu.com/ubuntu/20260802T000000Z/#g' /etc/apt/sources.list.d/ubuntu.sources
    apt-get -o Acquire::https::Verify-Peer=false -o Acquire::Check-Valid-Until=false update
    apt-get -o Acquire::https::Verify-Peer=false install -y --no-install-recommends ca-certificates
    apt-get -o Acquire::Check-Valid-Until=false update
    apt-get install -y --no-install-recommends curl openjdk-17-jre-headless libharfbuzz0b fontconfig fonts-dejavu-core
    /opt/damageprofiler-build/install
    apt-get purge -y curl
    apt-get autoremove -y
    apt-get clean
    rm -rf /var/lib/apt/lists/*
%runscript
    exec /usr/local/bin/damageprofiler "$@"

%test
    damageprofiler --version | grep -Fx 'DamageProfiler v1.1'
    damageprofiler --help >/dev/null
    fc-match sans | grep -q 'DejaVuSans'
    if damageprofiler --governed-invalid-option >/dev/null 2>&1; then exit 1; fi

%help
    DamageProfiler 1.1 from its checksummed upstream release artifact.
