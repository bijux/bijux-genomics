# VERSION_SOURCE: containers/versions/versions.toml
Bootstrap: docker
From: ubuntu@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b

%labels
# Tool ID: beagle
# Version policy: exact upstream jar with a governed SHA-256 digest
# Upstream source: https://faculty.washington.edu/browning/beagle/beagle.29Oct24.c8e.jar
# Build date policy: captured by immutable build evidence
# Network source policy: build-only access to the locked Ubuntu snapshot and jar
# Runtime UID policy: non-root runtime with caller-owned output paths

    org.opencontainers.image.source https://faculty.washington.edu/browning/beagle/beagle.html
    org.opencontainers.image.revision 220b8f1687f32f6f04cb4e85b0d6ab4ecd2e98f6f5147064c4c2420ddfdd5b3f
    org.opencontainers.image.created governed-by-build-evidence
    org.opencontainers.image.licenses GPL-3.0
    org.opencontainers.image.version 5.4
    org.opencontainers.image.tool beagle
    org.opencontainers.image.title beagle

%environment
    export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
    export LC_ALL=C
    export TZ=UTC

%files
    containers/tools/beagle/beagle /usr/local/bin/beagle

%post
    set -eux
    umask 022
    export DEBIAN_FRONTEND=noninteractive
    sed -i 's#http://archive.ubuntu.com/ubuntu/#https://snapshot.ubuntu.com/ubuntu/20260802T000000Z/#g; s#http://security.ubuntu.com/ubuntu/#https://snapshot.ubuntu.com/ubuntu/20260802T000000Z/#g' /etc/apt/sources.list.d/ubuntu.sources
    apt-get -o Acquire::https::Verify-Peer=false -o Acquire::Check-Valid-Until=false update
    apt-get -o Acquire::https::Verify-Peer=false install -y --no-install-recommends ca-certificates
    apt-get -o Acquire::Check-Valid-Until=false update
    apt-get install -y --no-install-recommends curl openjdk-21-jre-headless
    install -d -m 0755 /opt/beagle
    curl --fail --location --proto '=https' --tlsv1.2 \
      --output /opt/beagle/beagle.jar \
      https://faculty.washington.edu/browning/beagle/beagle.29Oct24.c8e.jar
    echo '220b8f1687f32f6f04cb4e85b0d6ab4ecd2e98f6f5147064c4c2420ddfdd5b3f  /opt/beagle/beagle.jar' | sha256sum -c -
    chmod 0755 /usr/local/bin/beagle
    beagle --version | grep -Fx 'beagle 5.4'
    beagle --help >/dev/null
    apt-get purge -y --auto-remove curl
    apt-get clean
    rm -rf /var/lib/apt/lists/*

%runscript
    exec /usr/local/bin/beagle "$@"

%test
    beagle --version | grep -Fx 'beagle 5.4'
    beagle --help >/dev/null
    java -jar /opt/beagle/beagle.jar 2>&1 | grep -F 'beagle.29Oct24.c8e.jar'

%help
    Beagle 5.4 installed from the exact upstream jar with a governed checksum.
