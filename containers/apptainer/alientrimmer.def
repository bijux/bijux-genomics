# BIJUX_TEMPLATE: v1

# Tool ID: alientrimmer
# Version policy: immutable release archive
# Upstream source: https://gitlab.pasteur.fr/GIPhy/AlienTrimmer
# Build date policy: captured by immutable build evidence
# Network source policy: build-only access to the locked Ubuntu snapshot and source archive
# Runtime UID policy: non-root runtime with caller-owned output paths

# VERSION_SOURCE: containers/contracts/catalog.toml
Bootstrap: docker
From: ubuntu@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b

%labels
    org.opencontainers.image.source https://gitlab.pasteur.fr/GIPhy/AlienTrimmer
    org.opencontainers.image.revision 6ec40283b87f845dbb833342633258c8e7c18333
    org.opencontainers.image.created governed-by-build-evidence
    org.opencontainers.image.licenses GPL-3.0
    org.opencontainers.image.version 3.2
    io.bijux.tool.version 3.2
    org.opencontainers.image.tool alientrimmer
    org.opencontainers.image.title alientrimmer
%files
    containers/contracts/configure-apt-snapshot /usr/local/sbin/bijux-configure-apt-snapshot
    containers/tools/alientrimmer/alientrimmer /usr/local/bin/alientrimmer

%environment
    export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
    export LC_ALL=C
    export TZ=UTC
    DEBIAN_FRONTEND=noninteractive

%post
    set -eux
    umask 022
    export DEBIAN_FRONTEND=noninteractive
    export ALIENTRIMMER_VERSION=3.2
    export ALIENTRIMMER_SHA256=5f28255e356253b1ff97d4940b637c7f4d7b13da62e603167c3d355a55eb0730

    /bin/sh /usr/local/sbin/bijux-configure-apt-snapshot
    apt-get install -y --no-install-recommends ca-certificates
    apt-get -o Acquire::Check-Valid-Until=false update
    apt-get install -y --no-install-recommends \
        bash \
        curl \
        openjdk-17-jdk-headless

    curl --fail --location --silent --show-error \
        --retry 5 --retry-delay 3 --retry-all-errors \
        --connect-timeout 20 --max-time 300 --retry-max-time 300 \
        "https://gitlab.pasteur.fr/GIPhy/AlienTrimmer/-/archive/${ALIENTRIMMER_VERSION}/AlienTrimmer-${ALIENTRIMMER_VERSION}.tar.gz" \
        -o /tmp/alientrimmer.tar.gz
    echo "${ALIENTRIMMER_SHA256}  /tmp/alientrimmer.tar.gz" | sha256sum --check --strict
    tar --extract --gzip --file /tmp/alientrimmer.tar.gz --directory /opt
    cd "/opt/AlienTrimmer-${ALIENTRIMMER_VERSION}/src"
    javac AlienTrimmer.java
    printf 'Main-Class: AlienTrimmer\n' > MANIFEST.MF
    jar -cmf MANIFEST.MF AlienTrimmer.jar AlienTrimmer*.class
    rm -f MANIFEST.MF AlienTrimmer*.class

    chmod 0555 /usr/local/bin/alientrimmer
    ln -sf /usr/local/bin/alientrimmer /usr/local/bin/AlienTrimmer
    alientrimmer --version > /tmp/alientrimmer.version
    grep -Fx '3.2' /tmp/alientrimmer.version
    alientrimmer --help > /tmp/alientrimmer.help
    grep -F 'AlienTrimmer v3.2' /tmp/alientrimmer.help
    rm -f /tmp/alientrimmer.version /tmp/alientrimmer.help
    rm -f /tmp/alientrimmer.tar.gz
    rm -rf /var/lib/apt/lists/*

%runscript
    exec /usr/local/bin/alientrimmer "$@"

%help
    AlienTrimmer 3.2 with a compatibility interface validated against the native JAR banner.

%test
    alientrimmer --version > /tmp/alientrimmer.version
    grep -Fx '3.2' /tmp/alientrimmer.version
    alientrimmer --help > /tmp/alientrimmer.help
    grep -F 'AlienTrimmer v3.2' /tmp/alientrimmer.help
    rm -f /tmp/alientrimmer.version /tmp/alientrimmer.help
    if alientrimmer --governed-invalid-option >/dev/null 2>&1; then exit 1; fi
