# BIJUX_TEMPLATE: v1

# Tool ID: alientrimmer
# Version policy: immutable release archive
# Upstream source: https://gitlab.pasteur.fr/GIPhy/AlienTrimmer
# Build date policy: captured by immutable build evidence
# Network source policy: build-only access to the locked Ubuntu snapshot and source archive
# Runtime UID policy: non-root runtime with caller-owned output paths

# VERSION_SOURCE: containers/contracts/catalog.toml
Bootstrap: docker
From: ubuntu@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b

%labels
    org.opencontainers.image.source https://gitlab.pasteur.fr/GIPhy/AlienTrimmer
    org.opencontainers.image.revision 3.2
    org.opencontainers.image.created governed-by-build-evidence
    org.opencontainers.image.licenses GPL-3.0
    org.opencontainers.image.version 3.2
    org.opencontainers.image.tool alientrimmer
    org.opencontainers.image.title alientrimmer
%environment
    export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
    export LC_ALL=C
    export TZ=UTC
    DEBIAN_FRONTEND=noninteractive

%post
    set -eux
    umask 022
    export DEBIAN_FRONTEND=noninteractive
    export ALIENTRIMMER_VERSION=3.2
    export ALIENTRIMMER_SHA256=5f28255e356253b1ff97d4940b637c7f4d7b13da62e603167c3d355a55eb0730

    sed -i 's#http://archive.ubuntu.com/ubuntu/#https://snapshot.ubuntu.com/ubuntu/20260802T000000Z/#g; s#http://security.ubuntu.com/ubuntu/#https://snapshot.ubuntu.com/ubuntu/20260802T000000Z/#g' /etc/apt/sources.list.d/ubuntu.sources
    apt-get -o Acquire::https::Verify-Peer=false -o Acquire::Check-Valid-Until=false update
    apt-get -o Acquire::https::Verify-Peer=false install -y --no-install-recommends ca-certificates
    apt-get -o Acquire::Check-Valid-Until=false update
    apt-get install -y --no-install-recommends \
        bash \
        curl \
        openjdk-17-jdk-headless

    curl --fail --location --silent --show-error "https://gitlab.pasteur.fr/GIPhy/AlienTrimmer/-/archive/${ALIENTRIMMER_VERSION}/AlienTrimmer-${ALIENTRIMMER_VERSION}.tar.gz" \
        -o /tmp/alientrimmer.tar.gz
    echo "${ALIENTRIMMER_SHA256}  /tmp/alientrimmer.tar.gz" | sha256sum --check --strict
    tar --extract --gzip --file /tmp/alientrimmer.tar.gz --directory /opt
    cd "/opt/AlienTrimmer-${ALIENTRIMMER_VERSION}/src"
    javac AlienTrimmer.java
    printf 'Main-Class: AlienTrimmer\n' > MANIFEST.MF
    jar -cmf MANIFEST.MF AlienTrimmer.jar AlienTrimmer*.class
    rm -f MANIFEST.MF AlienTrimmer*.class

    cat > /usr/local/bin/alientrimmer <<'SH'
#!/usr/bin/env bash
set -euo pipefail

jar_path="/opt/AlienTrimmer-3.2/src/AlienTrimmer.jar"
java_bin="${JAVA_BIN:-java}"
java_args=(-Xms256m -Xmx256m)

run_alientrimmer() {
  "${java_bin}" "${java_args[@]}" -jar "${jar_path}" "$@"
}

emit_version() {
  printf '3.2\n'
}

move_output() {
  local source="$1"
  local destination="$2"
  if [[ -z "${destination}" ]]; then
    return 0
  fi
  if [[ ! -f "${source}" ]]; then
    printf 'missing AlienTrimmer output: %s\n' "${source}" >&2
    return 1
  fi
  mkdir -p "$(dirname "${destination}")"
  mv "${source}" "${destination}"
}

if [[ $# -eq 0 ]]; then
  exec "${java_bin}" "${java_args[@]}" -jar "${jar_path}"
fi

case "${1:-}" in
  --version)
    emit_version
    exit 0
    ;;
  --help|-h)
    exec "${java_bin}" "${java_args[@]}" -jar "${jar_path}"
    ;;
  --a1|--a2|--p64)
    ;;
  --*)
    printf 'unsupported AlienTrimmer option: %s\n' "$1" >&2
    exit 2
    ;;
esac

legacy_mode=0
has_modern_alien_flags=0
args=("$@")

for ((idx = 0; idx < ${#args[@]}; idx++)); do
  arg="${args[idx]}"
  case "${arg}" in
    -a|--a1|--a2)
      has_modern_alien_flags=1
      ((idx += 1))
      ;;
    -if|-ir|-cf|-cr|-of|-or|-os)
      legacy_mode=1
      ((idx += 1))
      ;;
    -c)
      if (( idx + 1 < ${#args[@]} )) && (( has_modern_alien_flags == 0 )); then
        value="${args[idx + 1]}"
        if [[ ! "${value}" =~ ^[0-9]+$ || -e "${value}" ]]; then
          legacy_mode=1
        fi
      fi
      ((idx += 1))
      ;;
    -i|-1|-2|-o|-k|-m|-q|-p|-l)
      ((idx += 1))
      ;;
  esac
done

if (( legacy_mode == 0 )); then
  exec "${java_bin}" "${java_args[@]}" -jar "${jar_path}" "$@"
fi

translated=()
legacy_single_out=""
legacy_r1_out=""
legacy_r2_out=""
legacy_singletons_out=""
explicit_gzip=0

while (($#)); do
  case "$1" in
    -if)
      translated+=(-1 "$2")
      shift 2
      ;;
    -ir)
      translated+=(-2 "$2")
      shift 2
      ;;
    -cf)
      translated+=(--a1 "$2")
      shift 2
      ;;
    -cr)
      translated+=(--a2 "$2")
      shift 2
      ;;
    -c)
      translated+=(-a "$2")
      shift 2
      ;;
    -o)
      legacy_single_out="$2"
      shift 2
      ;;
    -of)
      legacy_r1_out="$2"
      shift 2
      ;;
    -or)
      legacy_r2_out="$2"
      shift 2
      ;;
    -os)
      legacy_singletons_out="$2"
      shift 2
      ;;
    -z)
      explicit_gzip=1
      translated+=(-z)
      shift
      ;;
    --help|-h)
      exec "${java_bin}" "${java_args[@]}" -jar "${jar_path}"
      ;;
    --version)
      emit_version
      exit 0
      ;;
    *)
      translated+=("$1")
      shift
      ;;
  esac
done

requested_outputs=()
for output_path in \
  "${legacy_single_out}" \
  "${legacy_r1_out}" \
  "${legacy_r2_out}" \
  "${legacy_singletons_out}"
do
  if [[ -n "${output_path}" ]]; then
    requested_outputs+=("${output_path}")
  fi
done

if [[ ${#requested_outputs[@]} -eq 0 ]]; then
  exec "${java_bin}" "${java_args[@]}" -jar "${jar_path}" "${translated[@]}"
fi

gzip_output_count=0
plain_output_count=0
for output_path in "${requested_outputs[@]}"; do
  case "${output_path}" in
    *.gz) ((gzip_output_count += 1)) ;;
    *) ((plain_output_count += 1)) ;;
  esac
done

if (( gzip_output_count > 0 && plain_output_count > 0 )); then
  printf 'legacy AlienTrimmer output paths must agree on gzip suffix\n' >&2
  exit 2
fi

if (( gzip_output_count > 0 && explicit_gzip == 0 )); then
  translated+=(-z)
fi

temp_dir="$(mktemp -d)"
trap 'rm -rf "${temp_dir}"' EXIT
output_base="${temp_dir}/alientrimmer"
translated+=(-o "${output_base}")

run_alientrimmer "${translated[@]}"

suffix=".fastq"
if (( gzip_output_count > 0 || explicit_gzip == 1 )); then
  suffix=".fastq.gz"
fi

move_output "${output_base}${suffix}" "${legacy_single_out}"
move_output "${output_base}.1${suffix}" "${legacy_r1_out}"
move_output "${output_base}.2${suffix}" "${legacy_r2_out}"
move_output "${output_base}.S${suffix}" "${legacy_singletons_out}"
SH
    chmod +x /usr/local/bin/alientrimmer
    ln -sf /usr/local/bin/alientrimmer /usr/local/bin/AlienTrimmer
    rm -f /tmp/alientrimmer.tar.gz
    rm -rf /var/lib/apt/lists/*

%runscript
    exec /usr/local/bin/alientrimmer "$@"

%help
    Apptainer image for AlienTrimmer 3.2 with a governed compatibility wrapper.

%test
    alientrimmer --version | grep -Fx '3.2'
    alientrimmer --help >/dev/null
    if alientrimmer --governed-invalid-option >/dev/null 2>&1; then exit 1; fi
