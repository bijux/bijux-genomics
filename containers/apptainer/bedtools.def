# Tool ID: bedtools
# Version policy: exact upstream tag archive with a governed SHA-256 digest
# Upstream source: https://github.com/arq5x/bedtools2/tree/v2.31.1
# Build date policy: captured by immutable build evidence
# Network source policy: build-only access to the locked Ubuntu snapshot and source archive
# Runtime UID policy: non-root runtime with caller-owned output paths
# VERSION_SOURCE: containers/contracts/catalog.toml
Bootstrap: docker
From: ubuntu@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b

%labels
    org.opencontainers.image.source https://github.com/arq5x/bedtools2
    org.opencontainers.image.revision 705ccfdf2c9a77d71560c8adcece0663c2f5e18e
    org.opencontainers.image.created governed-by-build-evidence
    org.opencontainers.image.licenses MIT
    org.opencontainers.image.version 2.31.1
    org.opencontainers.image.tool bedtools
    org.opencontainers.image.title BEDTools

%environment
    export PATH=/usr/local/bin:/usr/bin:/bin
    export LANG=C
    export LC_ALL=C
    export TZ=UTC

%files
    containers/contracts/configure-apt-snapshot /usr/local/sbin/bijux-configure-apt-snapshot
    containers/tools/bedtools/bedtools /usr/local/bin/bedtools

%post
    set -eux
    umask 022
    export DEBIAN_FRONTEND=noninteractive
    /bin/sh /usr/local/sbin/bijux-configure-apt-snapshot
    apt-get install -y --no-install-recommends ca-certificates
    apt-get -o Acquire::Check-Valid-Until=false update
    apt-get install -y --no-install-recommends libbz2-1.0 liblzma5 zlib1g
    apt-get install -y --no-install-recommends curl g++ libbz2-dev liblzma-dev make python3 zlib1g-dev
    curl --fail --location --proto '=https' --tlsv1.2 --output /opt/bedtools.tar.gz https://codeload.github.com/arq5x/bedtools2/tar.gz/refs/tags/v2.31.1
    echo '79a1ba318d309f4e74bfa74258b73ef578dccb1045e270998d7fe9da9f43a50e  /opt/bedtools.tar.gz' | sha256sum --check --strict
    tar --extract --gzip --file /opt/bedtools.tar.gz --directory /opt
    make --directory /opt/bedtools2-2.31.1 -j2
    install -d -m 0755 /opt/bedtools/bin
    install -m 0755 /opt/bedtools2-2.31.1/bin/bedtools /opt/bedtools/bin/bedtools-native
    chmod 0755 /usr/local/bin/bedtools
    bedtools --version | grep -Fx 'bedtools v2.31.1'
    bedtools --help >/dev/null
    rm -rf /opt/bedtools.tar.gz /opt/bedtools2-2.31.1
    apt-get purge -y --auto-remove curl g++ libbz2-dev liblzma-dev make python3 zlib1g-dev
    apt-get clean
    rm -rf /var/lib/apt/lists/*

%runscript
    exec /usr/local/bin/bedtools "$@"

%test
    bedtools --version | grep -Fx 'bedtools v2.31.1'
    bedtools --help >/dev/null
    test -x /opt/bedtools/bin/bedtools-native

%help
    BEDTools 2.31.1 built from the exact checksummed upstream tag archive.
