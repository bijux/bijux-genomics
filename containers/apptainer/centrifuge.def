# Bijux Genomics source code is licensed under Apache-2.0.
# Copyright (C) 2026 Bijan Mousavi
# Tool ID: centrifuge
# Version policy: checksummed Centrifuge 1.0.4 source commit
# Upstream source: https://github.com/DaehwanKimLab/centrifuge
# Build date policy: captured by immutable build evidence
# Network source policy: build-only access to the locked source archive
# NETWORK_SOURCE_VERIFIED_BY_LOCK
# Runtime UID policy: non-root runtime with caller-owned output paths
# VERSION_SOURCE: containers/contracts/catalog.toml

Bootstrap: docker
From: ubuntu@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b

%labels
    org.opencontainers.image.source https://github.com/DaehwanKimLab/centrifuge
    org.opencontainers.image.revision 92d6e7969afd786ba196b019620453a965a46cdd
    org.opencontainers.image.created governed-by-build-evidence
    org.opencontainers.image.licenses GPL-3.0-or-later
    org.opencontainers.image.version 1.0.4
    org.opencontainers.image.tool centrifuge
    org.opencontainers.image.title Centrifuge

%files
    containers/contracts/configure-apt-snapshot /usr/local/sbin/bijux-configure-apt-snapshot
    containers/tools/centrifuge/install /opt/centrifuge-build/install
    containers/tools/centrifuge/centrifuge /usr/local/bin/centrifuge

%environment
    export PATH=/usr/local/bin:/opt/centrifuge/bin:/usr/bin:/bin
    export LANG=C
    export LC_ALL=C
    export TZ=UTC
    export PYTHONNOUSERSITE=1

%post
    set -eux
    umask 022
    export DEBIAN_FRONTEND=noninteractive
    /bin/sh /usr/local/sbin/bijux-configure-apt-snapshot
    apt-get install -y --no-install-recommends ca-certificates
    apt-get -o Acquire::Check-Valid-Until=false update
    apt-get install -y --no-install-recommends build-essential curl zlib1g-dev libbz2-dev liblzma-dev perl python3 python-is-python3 gzip bzip2
    /opt/centrifuge-build/install
    apt-get purge -y build-essential curl g++ gcc make zlib1g-dev libbz2-dev liblzma-dev
    apt-get autoremove -y
    apt-get clean
    rm -rf /var/lib/apt/lists/*

%runscript
    exec /usr/local/bin/centrifuge "$@"

%test
    centrifuge --version | grep -Fx 'Centrifuge 1.0.4'
    centrifuge --help >/dev/null
    python --version 2>&1 | grep -E '^Python 3[.]'
    if centrifuge --governed-invalid-option >/dev/null 2>&1; then exit 1; fi

%help
    Centrifuge 1.0.4 built from its checksummed source commit.
