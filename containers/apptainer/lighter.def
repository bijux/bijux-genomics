# Bijux Genomics source code is licensed under Apache-2.0.
# Copyright (C) 2026 Bijan Mousavi
# Tool ID: lighter
# Version policy: checksum-verified upstream release archive
# Upstream source: https://github.com/mourisl/Lighter
# Build date policy: captured by immutable build evidence
# Network source policy: build-only access to a locked Ubuntu snapshot and source archive
# NETWORK_SOURCE_VERIFIED_BY_LOCK
# Runtime UID policy: caller identity with caller-owned output paths
# VERSION_SOURCE: containers/contracts/catalog.toml

Bootstrap: docker
From: ubuntu@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b

%labels
    org.opencontainers.image.source https://github.com/mourisl/Lighter
    org.opencontainers.image.revision d8621db12352895662404b38a4b61862eaf60f6a
    org.opencontainers.image.created governed-by-build-evidence
    org.opencontainers.image.licenses GPL-3.0
    org.opencontainers.image.version 1.1.3
    io.bijux.tool.version 1.1.3
    org.opencontainers.image.tool lighter
    org.opencontainers.image.title Lighter

%files
    containers/tools/lighter/install /opt/lighter-build/install
    containers/tools/lighter/lighter /usr/local/bin/lighter

%environment
    export PATH=/usr/local/bin:/usr/bin:/bin
    export LANG=C
    export LC_ALL=C
    export TZ=UTC

%post
    set -eux
    umask 022
    export DEBIAN_FRONTEND=noninteractive
    export LIGHTER_VERSION=1.1.3
    export LIGHTER_SOURCE_SHA256=c8a251c410805f82dad77e40661f0faf14ec82dedb3ff717094ba8ff4ef94465
    apt-get update
    apt-get install -y --no-install-recommends ca-certificates=20240203
    sed -i 's#http://archive.ubuntu.com/ubuntu/#https://snapshot.ubuntu.com/ubuntu/20260802T000000Z/#g; s#http://security.ubuntu.com/ubuntu/#https://snapshot.ubuntu.com/ubuntu/20260802T000000Z/#g' /etc/apt/sources.list.d/ubuntu.sources
    apt-get -o Acquire::Check-Valid-Until=false update
    apt-get install -y --no-install-recommends build-essential curl zlib1g-dev
    chmod 0755 /opt/lighter-build/install /usr/local/bin/lighter
    /opt/lighter-build/install
    apt-get purge -y build-essential curl zlib1g-dev
    apt-get autoremove -y
    apt-get install -y --no-install-recommends zlib1g
    apt-get clean
    rm -rf /var/lib/apt/lists/*

%runscript
    exec /usr/local/bin/lighter "$@"

%test
    lighter --version | grep -Fx 'Lighter v1.1.3'
    lighter --help | grep -F 'Usage: ./lighter [OPTIONS]'
    if lighter --governed-invalid-option >/dev/null 2>&1; then exit 1; fi

%help
    Lighter 1.1.3 from a checksum-verified upstream release archive.
