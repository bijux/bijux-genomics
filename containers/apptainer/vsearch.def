# Tool ID: vsearch
# Version policy: exact upstream tag archive with a governed SHA-256 digest
# Upstream source: https://github.com/torognes/vsearch/tree/v2.29.3
# Build date policy: captured by immutable build evidence
# Network source policy: build-only access to the locked Ubuntu snapshot and source archive
# Runtime UID policy: non-root runtime with caller-owned output paths
# VERSION_SOURCE: containers/contracts/catalog.toml
Bootstrap: docker
From: ubuntu@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b

%labels
    org.opencontainers.image.source https://github.com/torognes/vsearch
    org.opencontainers.image.revision bbd17a05faaf7401176e36b7947874c1e5152cee
    org.opencontainers.image.created governed-by-build-evidence
    org.opencontainers.image.licenses BSD-2-Clause
    org.opencontainers.image.version 2.29.3
    org.opencontainers.image.tool vsearch
    org.opencontainers.image.title VSEARCH

%environment
    export PATH=/usr/local/bin:/usr/bin:/bin
    export LANG=C
    export LC_ALL=C
    export TZ=UTC

%files
    containers/tools/vsearch/vsearch /usr/local/bin/vsearch

%post
    set -eux
    umask 022
    export DEBIAN_FRONTEND=noninteractive
    sed -i 's#http://archive.ubuntu.com/ubuntu/#https://snapshot.ubuntu.com/ubuntu/20260802T000000Z/#g; s#http://security.ubuntu.com/ubuntu/#https://snapshot.ubuntu.com/ubuntu/20260802T000000Z/#g' /etc/apt/sources.list.d/ubuntu.sources
    apt-get -o Acquire::https::Verify-Peer=false -o Acquire::Check-Valid-Until=false update
    apt-get -o Acquire::https::Verify-Peer=false install -y --no-install-recommends ca-certificates
    apt-get -o Acquire::Check-Valid-Until=false update
    apt-get install -y --no-install-recommends libbz2-1.0 liblzma5 libstdc++6 zlib1g
    apt-get install -y --no-install-recommends autoconf automake curl g++ libbz2-dev liblzma-dev libtool make pkg-config zlib1g-dev
    curl --fail --location --proto '=https' --tlsv1.2 --output /opt/vsearch.tar.gz https://codeload.github.com/torognes/vsearch/tar.gz/bbd17a05faaf7401176e36b7947874c1e5152cee
    echo '6a1039a99422340cbfb3c723f0caa414e91e7d36b963075e59f033ac59580c0e  /opt/vsearch.tar.gz' | sha256sum --check --strict
    tar --extract --gzip --file /opt/vsearch.tar.gz --directory /opt
    cd /opt/vsearch-bbd17a05faaf7401176e36b7947874c1e5152cee
    ./autogen.sh
    ./configure --quiet CFLAGS=-O3 CXXFLAGS=-O3
    make -j2
    install -d -m 0755 /opt/vsearch/bin
    install -m 0755 ./bin/vsearch /opt/vsearch/bin/vsearch-native
    chmod 0755 /usr/local/bin/vsearch
    vsearch --version | grep -Fx 'vsearch 2.29.3'
    vsearch --help >/dev/null
    rm -rf /opt/vsearch.tar.gz /opt/vsearch-bbd17a05faaf7401176e36b7947874c1e5152cee
    apt-get purge -y --auto-remove autoconf automake curl g++ libbz2-dev liblzma-dev libtool make pkg-config zlib1g-dev
    apt-get clean
    rm -rf /var/lib/apt/lists/*

%runscript
    exec /usr/local/bin/vsearch "$@"

%test
    vsearch --version | grep -Fx 'vsearch 2.29.3'
    vsearch --help >/dev/null
    test -x /opt/vsearch/bin/vsearch-native

%help
    VSEARCH 2.29.3 built from the exact checksummed upstream tag archive.
