# BIJUX_TEMPLATE: v1

# Tool ID: contammix
# Version policy: verified upstream release archive
# Upstream source: https://github.com/plfjohnson/contamMix
# Build date policy: captured by immutable build evidence
# Network source policy: build-only access to the locked Ubuntu snapshot and release archive
# Runtime UID policy: non-root runtime with caller-owned output paths
# VERSION_SOURCE: containers/contracts/catalog.toml
Bootstrap: docker
From: ubuntu@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b

%labels
    org.opencontainers.image.source https://github.com/plfjohnson/contamMix
    org.opencontainers.image.revision 46c2b9c9fa82c2507f2b084f0b37d862a0825f4b
    org.opencontainers.image.created governed-by-build-evidence
    org.opencontainers.image.licenses GPL-3.0-only
    org.opencontainers.image.version 1.0.11
    org.opencontainers.image.tool contammix
    org.opencontainers.image.title contamMix
%environment
    export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
    export LC_ALL=C
    export TZ=UTC
    export DEBIAN_FRONTEND=noninteractive

%files
    containers/tools/contammix/contammix /usr/local/bin/contammix

%post
    set -eux
    umask 022
    export DEBIAN_FRONTEND=noninteractive
    sed -i 's#http://archive.ubuntu.com/ubuntu/#https://snapshot.ubuntu.com/ubuntu/20260802T000000Z/#g; s#http://security.ubuntu.com/ubuntu/#https://snapshot.ubuntu.com/ubuntu/20260802T000000Z/#g' /etc/apt/sources.list.d/ubuntu.sources
    apt-get -o Acquire::https::Verify-Peer=false -o Acquire::Check-Valid-Until=false update
    apt-get -o Acquire::https::Verify-Peer=false install -y --no-install-recommends ca-certificates
    apt-get -o Acquire::Check-Valid-Until=false update
    apt-get install -y --no-install-recommends build-essential curl perl r-base r-base-dev r-cran-coda r-cran-getopt samtools
    curl --fail --location --silent --show-error --output /opt/contamMix-v1.0-11.tar.gz https://github.com/plfjohnson/contamMix/archive/refs/tags/v1.0-11.tar.gz
    echo '1bfd53eca5554c957771daa51a2520306e90da17423dded39454ac8f23424a22  /opt/contamMix-v1.0-11.tar.gz' | sha256sum --check --strict
    R CMD INSTALL /opt/contamMix-v1.0-11.tar.gz
    Rscript -e 'stopifnot(as.character(packageVersion("contamMix")) == "1.0.10")'
    chmod 0755 /usr/local/bin/contammix
    contammix --version | grep -Fx 'contammix 1.0.11 (contamMix package 1.0-10)'
    rm /opt/contamMix-v1.0-11.tar.gz
    rm -rf /var/lib/apt/lists/*
%runscript
    exec /usr/local/bin/contammix "$@"

%test
    contammix --version | grep -Fx 'contammix 1.0.11 (contamMix package 1.0-10)'
    contammix --help >/dev/null
    Rscript -e 'stopifnot(as.character(packageVersion("contamMix")) == "1.0.10")'

%help
    contamMix release v1.0-11 compiled from its verified upstream source archive.
