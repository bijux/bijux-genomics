# Bijux Genomics source code is licensed under Apache-2.0.
# Copyright (C) 2026 Bijan Mousavi
# Tool ID: contammix
# Version policy: checksummed contamMix v1.0-11 source commit
# Upstream source: https://github.com/plfjohnson/contamMix
# Build date policy: captured by immutable build evidence
# Network source policy: build-only access to the locked source archive
# NETWORK_SOURCE_VERIFIED_BY_LOCK
# Runtime UID policy: non-root runtime with caller-owned output paths
# VERSION_SOURCE: containers/contracts/catalog.toml

Bootstrap: docker
From: ubuntu@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b

%labels
    org.opencontainers.image.source https://github.com/plfjohnson/contamMix
    org.opencontainers.image.revision 46c2b9c9fa82c2507f2b084f0b37d862a0825f4b
    org.opencontainers.image.created governed-by-build-evidence
    org.opencontainers.image.licenses GPL-3.0-only
    org.opencontainers.image.version 1.0.11
    io.bijux.tool.version 1.0.11
    org.opencontainers.image.tool contammix
    org.opencontainers.image.title contamMix

%files
    containers/contracts/configure-apt-snapshot /usr/local/sbin/bijux-configure-apt-snapshot
    containers/tools/contammix/install /opt/contammix-build/install
    containers/tools/contammix/contammix /usr/local/bin/contammix

%environment
    export PATH=/usr/local/bin:/usr/bin:/bin
    export LANG=C
    export LC_ALL=C
    export TZ=UTC
    export R_ENVIRON_USER=/dev/null
    export R_PROFILE_USER=/dev/null

%post
    set -eux
    umask 022
    export DEBIAN_FRONTEND=noninteractive
    /bin/sh /usr/local/sbin/bijux-configure-apt-snapshot
    apt-get install -y --no-install-recommends ca-certificates
    apt-get -o Acquire::Check-Valid-Until=false update
    apt-get install -y --no-install-recommends build-essential curl perl r-base-core r-base-dev r-cran-coda r-cran-getopt samtools
    /opt/contammix-build/install
    apt-get purge -y build-essential curl g++ gcc make r-base-dev
    apt-get autoremove -y
    apt-get clean
    rm -rf /var/lib/apt/lists/*

%runscript
    exec /usr/local/bin/contammix "$@"

%test
    contammix --version | grep -Fx 'contammix 1.0.11 (contamMix package 1.0-10)'
    contammix --help >/dev/null
    Rscript -e 'stopifnot(as.character(packageVersion("contamMix")) == "1.0.10")'
    if contammix --governed-invalid-option >/dev/null 2>&1; then exit 1; fi

%help
    contamMix v1.0-11 built from its checksummed source commit.
