# Bijux Genomics source code is licensed under Apache-2.0.
# Copyright (C) 2026 Bijan Mousavi
# Tool ID: clumpify
# Version policy: immutable release archive checksum
# Upstream source: https://sourceforge.net/projects/bbmap/
# Build date policy: captured by immutable build evidence
# Network source policy: build-only access to the locked Ubuntu snapshot and source archive
# Runtime UID policy: non-root runtime with caller-owned output paths
# VERSION_SOURCE: containers/contracts/catalog.toml

Bootstrap: docker
From: ubuntu@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b

%labels
    org.opencontainers.image.source https://sourceforge.net/projects/bbmap/
    org.opencontainers.image.revision sha256:61d45bd59a543b90a143c5c7dbfec0ff6163dce54194b8c4b648fb6aac67d42e
    org.opencontainers.image.created governed-by-build-evidence
    org.opencontainers.image.licenses BSD-3-Clause
    org.opencontainers.image.version 39.06
    org.opencontainers.image.tool clumpify
    org.opencontainers.image.title Clumpify

%environment
    export PATH=/usr/local/bin:/opt/bbmap:/usr/bin:/bin
    export LANG=C
    export LC_ALL=C
    export TZ=UTC

%post
    set -eux
    umask 022
    export DEBIAN_FRONTEND=noninteractive
    sed -i 's#http://archive.ubuntu.com/ubuntu/#https://snapshot.ubuntu.com/ubuntu/20260802T000000Z/#g; s#http://security.ubuntu.com/ubuntu/#https://snapshot.ubuntu.com/ubuntu/20260802T000000Z/#g' /etc/apt/sources.list.d/ubuntu.sources
    apt-get -o Acquire::https::Verify-Peer=false -o Acquire::Check-Valid-Until=false update
    apt-get -o Acquire::https::Verify-Peer=false install -y --no-install-recommends ca-certificates
    apt-get -o Acquire::Check-Valid-Until=false update
    apt-get install -y --no-install-recommends curl openjdk-17-jre-headless
    mkdir -p /opt
    curl --fail --location --silent --show-error \
        --output /opt/bbmap-source.tar.gz \
        'https://downloads.sourceforge.net/project/bbmap/BBMap_39.06.tar.gz?download'
    echo '61d45bd59a543b90a143c5c7dbfec0ff6163dce54194b8c4b648fb6aac67d42e  /opt/bbmap-source.tar.gz' | sha256sum --check --strict
    tar --extract --gzip --file /opt/bbmap-source.tar.gz --directory /opt
    cat > /usr/local/bin/clumpify <<'EOF'
#!/usr/bin/env sh
set -eu
case "${1:-}" in
  --version) printf '%s\n' 'BBMap 39.06 (Clumpify)' ;;
  --help|-h|"") exec /opt/bbmap/clumpify.sh ;;
  *) exec /opt/bbmap/clumpify.sh "$@" ;;
esac
EOF
    chmod 0755 /usr/local/bin/clumpify
    test "$(clumpify --version)" = 'BBMap 39.06 (Clumpify)'
    rm -f /opt/bbmap-source.tar.gz
    rm -rf /var/lib/apt/lists/*

%runscript
    exec /usr/local/bin/clumpify "$@"

%test
    test "$(clumpify --version)" = 'BBMap 39.06 (Clumpify)'
    clumpify --help >/dev/null

%help
    Clumpify from the checksum-locked BBMap 39.06 release archive.
