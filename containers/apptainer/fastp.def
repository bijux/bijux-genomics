# Tool ID: fastp
# Version policy: exact upstream tag archive with a governed SHA-256 digest
# Upstream source: https://github.com/OpenGene/fastp/tree/v0.23.4
# Build date policy: captured by immutable build evidence
# Network source policy: build-only access to the locked Ubuntu snapshot and source archive
# Runtime UID policy: non-root runtime with caller-owned output paths
# VERSION_SOURCE: containers/contracts/catalog.toml
Bootstrap: docker
From: ubuntu@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b

%labels
    org.opencontainers.image.source https://github.com/OpenGene/fastp
    org.opencontainers.image.revision 1ffcaed6892832c09c4b4094c201cd4eff8fa622
    org.opencontainers.image.created governed-by-build-evidence
    org.opencontainers.image.licenses MIT
    org.opencontainers.image.version 0.23.4
    org.opencontainers.image.tool fastp
    org.opencontainers.image.title fastp

%environment
    export PATH=/usr/local/bin:/usr/bin:/bin
    export LANG=C
    export LC_ALL=C
    export TZ=UTC

%files
    containers/contracts/configure-apt-snapshot /usr/local/sbin/bijux-configure-apt-snapshot
    containers/tools/fastp/fastp /usr/local/bin/fastp

%post
    set -eux
    umask 022
    export DEBIAN_FRONTEND=noninteractive
    /bin/sh /usr/local/sbin/bijux-configure-apt-snapshot
    apt-get install -y --no-install-recommends ca-certificates
    apt-get -o Acquire::Check-Valid-Until=false update
    apt-get install -y --no-install-recommends libdeflate0 libisal2 zlib1g
    apt-get install -y --no-install-recommends curl g++ libdeflate-dev libisal-dev make zlib1g-dev
    curl --fail --location --proto '=https' --tlsv1.2 --output /opt/fastp.tar.gz https://codeload.github.com/OpenGene/fastp/tar.gz/refs/tags/v0.23.4
    echo '4fad6db156e769d46071add8a778a13a5cb5186bc1e1a5f9b1ffd499d84d72b5  /opt/fastp.tar.gz' | sha256sum --check --strict
    tar --extract --gzip --file /opt/fastp.tar.gz --directory /opt
    make --directory /opt/fastp-0.23.4 -j2
    install -d -m 0755 /opt/fastp/bin
    install -m 0755 /opt/fastp-0.23.4/fastp /opt/fastp/bin/fastp-native
    chmod 0755 /usr/local/bin/fastp
    fastp --version | grep -Fx 'fastp 0.23.4'
    fastp --help >/dev/null
    rm -rf /opt/fastp.tar.gz /opt/fastp-0.23.4
    apt-get purge -y --auto-remove curl g++ libdeflate-dev libisal-dev make zlib1g-dev
    apt-get clean
    rm -rf /var/lib/apt/lists/*

%runscript
    exec /usr/local/bin/fastp "$@"

%test
    fastp --version | grep -Fx 'fastp 0.23.4'
    fastp --help >/dev/null
    test -x /opt/fastp/bin/fastp-native

%help
    fastp 0.23.4 built from the exact checksummed upstream tag archive.
