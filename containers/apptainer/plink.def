# Tool ID: plink
# Version policy: exact upstream Linux release archive with a governed SHA-256 digest
# Upstream source: https://s3.amazonaws.com/plink1-assets/plink_linux_x86_64_20231211.zip
# Build date policy: captured by immutable build evidence
# Network source policy: build-only access to the locked Ubuntu snapshot and release archive
# Runtime UID policy: non-root runtime with caller-owned output paths

# VERSION_SOURCE: containers/versions/versions.toml
Bootstrap: docker
From: ubuntu@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b

%labels
    org.opencontainers.image.source https://www.cog-genomics.org/plink/
    org.opencontainers.image.revision 1162eca207ecec12b03397a3a9be5eed0527f5d21c173dc24335340ddd191bc3
    org.opencontainers.image.created governed-by-build-evidence
    org.opencontainers.image.licenses GPL-3.0
    org.opencontainers.image.version 1.90b7.2
    io.bijux.tool.version 1.90b7.2
    org.opencontainers.image.tool plink
    org.opencontainers.image.title plink

%files
    containers/contracts/configure-apt-snapshot /usr/local/sbin/bijux-configure-apt-snapshot

%environment
    export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
    export LANG=C
    export LC_ALL=C
    export TZ=UTC

%post
    set -eux
    umask 022
    export DEBIAN_FRONTEND=noninteractive
    /bin/sh /usr/local/sbin/bijux-configure-apt-snapshot
    apt-get install -y --no-install-recommends ca-certificates
    apt-get -o Acquire::Check-Valid-Until=false update
    apt-get install -y --no-install-recommends curl unzip
    curl --fail --location --proto '=https' --tlsv1.2 \
      --output /opt/plink.zip \
      https://s3.amazonaws.com/plink1-assets/plink_linux_x86_64_20231211.zip
    echo '1162eca207ecec12b03397a3a9be5eed0527f5d21c173dc24335340ddd191bc3  /opt/plink.zip' | sha256sum -c -
    unzip -q /opt/plink.zip -d /opt/plink-release
    install -m 0755 /opt/plink-release/plink /usr/local/bin/plink
    plink --version 2>&1 | grep -F 'PLINK v1.90b7.2'
    plink --help >/dev/null
    rm -rf /opt/plink.zip /opt/plink-release
    apt-get clean
    rm -rf /var/lib/apt/lists/*

%runscript
    exec /usr/local/bin/plink "$@"

%test
    plink --version 2>&1 | grep -F 'PLINK v1.90b7.2'
    plink --help >/dev/null

%help
    PLINK 1.90b7.2 installed from the exact upstream Linux release archive.
