# Tool ID: ibdseq
# Version policy: verified official binary and matching source archive
# Upstream source: https://faculty.washington.edu/browning/ibdseq.html
# Build date policy: captured by immutable build evidence
# Network source policy: build-only access to the locked Ubuntu snapshot and release files
# Runtime UID policy: non-root runtime with caller-owned output paths
# VERSION_SOURCE: containers/contracts/catalog.toml

Bootstrap: docker
From: ubuntu@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b

%labels
    org.opencontainers.image.source https://faculty.washington.edu/browning/ibdseq.html
    org.opencontainers.image.revision a835c7282444d8920109362ca012f9a9ac1eb54665d34fb0ca0380a3e0fed8ec
    org.opencontainers.image.created governed-by-build-evidence
    org.opencontainers.image.licenses Apache-2.0
    org.opencontainers.image.version r1206
    org.opencontainers.image.tool ibdseq
    org.opencontainers.image.title IBDseq

%environment
    export PATH=/usr/local/bin:/usr/bin:/bin
    export LANG=C
    export LC_ALL=C
    export TZ=UTC

%files
    containers/contracts/configure-apt-snapshot /usr/local/sbin/bijux-configure-apt-snapshot
    containers/tools/ibdseq/ibdseq /usr/local/bin/ibdseq

%post
    set -eux
    umask 022
    export DEBIAN_FRONTEND=noninteractive
    /bin/sh /usr/local/sbin/bijux-configure-apt-snapshot
    apt-get install -y --no-install-recommends ca-certificates
    apt-get -o Acquire::Check-Valid-Until=false update
    apt-get install -y --no-install-recommends curl openjdk-17-jre-headless
    mkdir -p /opt/ibdseq
    curl --fail --location --silent --show-error --output /opt/ibdseq/ibdseq.jar https://faculty.washington.edu/browning/ibdseq/ibdseq.r1206.jar
    curl --fail --location --silent --show-error --output /opt/ibdseq/source.zip https://faculty.washington.edu/browning/ibdseq/ibdseq.r1206.zip
    echo '6b750f46f5557e8c5e2f612449d34510c14392d427632ee850de5e96e5d0c2e1  /opt/ibdseq/ibdseq.jar' | sha256sum --check --strict
    echo 'a835c7282444d8920109362ca012f9a9ac1eb54665d34fb0ca0380a3e0fed8ec  /opt/ibdseq/source.zip' | sha256sum --check --strict
    rm /opt/ibdseq/source.zip
    chmod 0555 /opt/ibdseq/ibdseq.jar
    chmod 0755 /usr/local/bin/ibdseq
    ibdseq --version | grep -Fx 'ibdseq r1206'
    rm -rf /var/lib/apt/lists/*

%runscript
    exec /usr/local/bin/ibdseq "$@"

%test
    ibdseq --version | grep -Fx 'ibdseq r1206'
    ibdseq --help >/dev/null

%help
    IBDseq r1206 from the verified official JAR and matching source archive.
