# BIJUX_TEMPLATE: v1

# Tool ID: gatk
# Version policy: pinned_or_registry_locked
# Upstream source: see org.opencontainers.image.source label
# Build date policy: captured by immutable build evidence
# Network source policy: NETWORK_SOURCE_VERIFIED_BY_LOCK
# Runtime UID policy: RUNTIME_UID_SAFE

# VERSION_SOURCE: containers/versions/versions.toml
Bootstrap: docker
From: ubuntu@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b

%labels
    org.opencontainers.image.source https://github.com/broadinstitute/gatk
    org.opencontainers.image.title gatk
    org.opencontainers.image.revision 76edc75c26504da94bbaee66584e107e76ee15de
    org.opencontainers.image.created governed-by-build-evidence
    org.opencontainers.image.licenses Apache-2.0
    org.opencontainers.image.version 4.6.2.0
    org.opencontainers.image.tool gatk
%files
    containers/contracts/configure-apt-snapshot /usr/local/sbin/bijux-configure-apt-snapshot

%environment
    export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
    export LC_ALL=C
    export TZ=UTC
    export VERSION_GATK=4.6.2.0
%post
    set -eux
    # NETWORK_SOURCE_VERIFIED_BY_LOCK
    umask 022
    VERSION_GATK=4.6.2.0
    export VERSION_GATK
    export DEBIAN_FRONTEND=noninteractive
    /bin/sh /usr/local/sbin/bijux-configure-apt-snapshot
    apt-get install -y --no-install-recommends \
        ca-certificates curl openjdk-21-jre-headless python3 unzip
    curl --fail --location --proto '=https' --tlsv1.2 \
        --output /tmp/gatk.zip \
        "https://github.com/broadinstitute/gatk/releases/download/${VERSION_GATK}/gatk-${VERSION_GATK}.zip"
    echo '32d2f90bf13fcb3a8ac765bb2cb8ec1fc9a6cc447055d0156bd1db2092d4e3e8  /tmp/gatk.zip' \
        | sha256sum --check --strict
    unzip -q /tmp/gatk.zip -d /opt
    mv "/opt/gatk-${VERSION_GATK}" /opt/gatk
    sed -i '1s|python$|python3|' /opt/gatk/gatk
    chmod 0555 /opt/gatk/gatk
    ln -s /opt/gatk/gatk /usr/local/bin/gatk
    gatk --version 2>&1 | grep -F "The Genome Analysis Toolkit (GATK) v${VERSION_GATK}"
    gatk --help | grep -F 'Usage template for all tools'
    rm -f /tmp/gatk.zip
    apt-get purge -y --auto-remove curl unzip
    rm -rf /var/lib/apt/lists/*
%runscript
    if [ $# -eq 0 ]; then
        exec gatk --help
    else
        exec gatk "$@"
    fi
%help
    GATK 4.6.2.0 from the checksummed upstream release archive. The authentic
    upstream launcher and its complete release directory are retained.

%test
    gatk --version 2>&1 | grep -F 'The Genome Analysis Toolkit (GATK) v4.6.2.0'
    gatk --help | grep -F 'Usage template for all tools'
