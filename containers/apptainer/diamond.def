# Tool ID: diamond
# Version policy: checksummed DIAMOND 2.1.10 source commit
# Upstream source: https://github.com/bbuchfink/diamond
# Build date policy: captured by immutable build evidence
# Network source policy: build-only access to the locked source archive
# NETWORK_SOURCE_VERIFIED_BY_LOCK
# Runtime UID policy: non-root runtime with caller-owned output paths
# VERSION_SOURCE: containers/contracts/catalog.toml

Bootstrap: docker
From: ubuntu@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b

%labels
    org.opencontainers.image.source https://github.com/bbuchfink/diamond
    org.opencontainers.image.title diamond
    org.opencontainers.image.revision 1130513e06223ffd12c74a11e8e2c967e108a825
    org.opencontainers.image.created governed-by-build-evidence
    org.opencontainers.image.licenses GPL-3.0-or-later
    org.opencontainers.image.version 2.1.10
    io.bijux.tool.version 2.1.10
    org.opencontainers.image.tool diamond
%environment
    export PATH=/opt/diamond/bin:/usr/local/bin:/usr/bin:/bin
    export LANG=C
    export LC_ALL=C
    export TZ=UTC

%files
    containers/contracts/configure-apt-snapshot /usr/local/sbin/bijux-configure-apt-snapshot
    containers/tools/diamond/install /opt/diamond-build/install

%post
    set -eux
    umask 022
    export DEBIAN_FRONTEND=noninteractive
    /bin/sh /usr/local/sbin/bijux-configure-apt-snapshot
    apt-get install -y --no-install-recommends ca-certificates
    apt-get -o Acquire::Check-Valid-Until=false update
    apt-get install -y --no-install-recommends build-essential cmake curl zlib1g-dev
    /opt/diamond-build/install
    apt-get purge -y build-essential cmake curl zlib1g-dev
    apt-get autoremove -y
    apt-get clean
    rm -rf /var/lib/apt/lists/*

%runscript
    exec /opt/diamond/bin/diamond "$@"

%test
    diamond version | grep -Fx 'diamond version 2.1.10'
    diamond help >/dev/null
    if diamond governed-invalid-command >/dev/null 2>&1; then exit 1; fi

%help
    DIAMOND 2.1.10 built from its checksummed source commit.
