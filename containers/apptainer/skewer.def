# Tool ID: skewer
# Version policy: exact upstream commit archive with a governed SHA-256 digest
# Upstream source: https://github.com/relipmoc/skewer/tree/0.2.2
# Build date policy: captured by immutable build evidence
# Network source policy: build-only access to the locked Ubuntu snapshot and source archive
# Runtime UID policy: non-root runtime with caller-owned output paths
# VERSION_SOURCE: containers/contracts/catalog.toml
Bootstrap: docker
From: ubuntu@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b

%labels
    org.opencontainers.image.source https://github.com/relipmoc/skewer
    org.opencontainers.image.revision 978e8e46cba44595ece623e5387749284a86b74b
    org.opencontainers.image.created governed-by-build-evidence
    org.opencontainers.image.licenses MIT
    org.opencontainers.image.version 0.2.2
    org.opencontainers.image.tool skewer
    org.opencontainers.image.title Skewer

%environment
    export PATH=/usr/local/bin:/usr/bin:/bin
    export LANG=C
    export LC_ALL=C
    export TZ=UTC

%files
    containers/contracts/configure-apt-snapshot /usr/local/sbin/bijux-configure-apt-snapshot
    containers/tools/skewer/skewer /usr/local/bin/skewer
    containers/tools/skewer/gcc-compatibility.patch /opt/skewer-gcc-compatibility.patch

%post
    set -eux
    umask 022
    export DEBIAN_FRONTEND=noninteractive
    /bin/sh /usr/local/sbin/bijux-configure-apt-snapshot
    apt-get install -y --no-install-recommends ca-certificates
    apt-get -o Acquire::Check-Valid-Until=false update
    apt-get install -y --no-install-recommends zlib1g
    apt-get install -y --no-install-recommends curl g++ make patch zlib1g-dev
    curl --fail --location --proto '=https' --tlsv1.2 --output /opt/skewer.tar.gz https://codeload.github.com/relipmoc/skewer/tar.gz/978e8e46cba44595ece623e5387749284a86b74b
    echo '695c5f714e23ba5572e2525b7445439b632f52653e28ea46ed9988fc2f765169  /opt/skewer.tar.gz' | sha256sum --check --strict
    tar --extract --gzip --file /opt/skewer.tar.gz --directory /opt
    patch --directory /opt/skewer-978e8e46cba44595ece623e5387749284a86b74b --strip=1 --input /opt/skewer-gcc-compatibility.patch
    make --directory /opt/skewer-978e8e46cba44595ece623e5387749284a86b74b -j2
    install -d -m 0755 /opt/skewer/bin
    install -m 0755 /opt/skewer-978e8e46cba44595ece623e5387749284a86b74b/skewer /opt/skewer/bin/skewer-native
    chmod 0755 /usr/local/bin/skewer
    skewer --version | grep -Fx 'skewer 0.2.2'
    skewer --help >/dev/null
    rm -rf /opt/skewer.tar.gz /opt/skewer-gcc-compatibility.patch /opt/skewer-978e8e46cba44595ece623e5387749284a86b74b
    apt-get purge -y --auto-remove curl g++ make patch zlib1g-dev
    apt-get clean
    rm -rf /var/lib/apt/lists/*

%runscript
    exec /usr/local/bin/skewer "$@"

%test
    skewer --version | grep -Fx 'skewer 0.2.2'
    skewer --help >/dev/null
    test -x /opt/skewer/bin/skewer-native

%help
    Skewer 0.2.2 built from the exact checksummed upstream commit archive.
