# Bijux Genomics source code is licensed under Apache-2.0.
# Copyright (C) 2026 Bijan Mousavi
# Tool ID: eigensoft
# Version policy: exact upstream commit archive with a governed SHA-256 digest
# Upstream source: https://github.com/DReichLab/EIG/commit/09ed563fdec05648a66c206ba1fc37a198395cd7
# Build date policy: captured by immutable build evidence
# Network source policy: build-only access to the locked Ubuntu snapshot and commit archive
# Runtime UID policy: non-root runtime with caller-owned output paths
# VERSION_SOURCE: containers/contracts/catalog.toml
Bootstrap: docker
From: ubuntu@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b

%labels
    org.opencontainers.image.source https://github.com/DReichLab/EIG
    org.opencontainers.image.revision 09ed563fdec05648a66c206ba1fc37a198395cd7
    org.opencontainers.image.created governed-by-build-evidence
    org.opencontainers.image.licenses GPL-2.0
    org.opencontainers.image.version 8.0.0
    io.bijux.tool.version 8.0.0
    org.opencontainers.image.tool eigensoft
    org.opencontainers.image.title eigensoft

%environment
    export PATH=/usr/local/bin:/usr/bin:/bin
    export LANG=C
    export LC_ALL=C
    export TZ=UTC

%files
    containers/contracts/configure-apt-snapshot /usr/local/sbin/bijux-configure-apt-snapshot
    containers/tools/eigensoft/smartpca /usr/local/bin/smartpca

%post
    set -eux
    umask 022
    export DEBIAN_FRONTEND=noninteractive
    /bin/sh /usr/local/sbin/bijux-configure-apt-snapshot
    apt-get install -y --no-install-recommends ca-certificates
    apt-get -o Acquire::Check-Valid-Until=false update
    apt-get install -y --no-install-recommends libgsl27 liblapacke libopenblas0-pthread
    apt-get install -y --no-install-recommends curl gcc libc6-dev libgsl-dev liblapacke-dev libopenblas-dev make
    curl --fail --location --proto '=https' --tlsv1.2 --output /opt/eigensoft.tar.gz https://github.com/DReichLab/EIG/archive/09ed563fdec05648a66c206ba1fc37a198395cd7.tar.gz
    echo '83207df20d658142c8d3d93db8d2d668b06812a90cc474454d18b62b973ca4c2  /opt/eigensoft.tar.gz' | sha256sum -c -
    tar --extract --gzip --file /opt/eigensoft.tar.gz --directory /opt
    sed -i 's/^# override LDLIBS += -llapacke$/override LDLIBS += -llapacke/' /opt/EIG-09ed563fdec05648a66c206ba1fc37a198395cd7/src/Makefile
    make --directory /opt/EIG-09ed563fdec05648a66c206ba1fc37a198395cd7/src eigensrc/smartpca OPTIMIZE=1
    install -d -m 0755 /opt/eigensoft/bin
    install -m 0755 /opt/EIG-09ed563fdec05648a66c206ba1fc37a198395cd7/src/eigensrc/smartpca /opt/eigensoft/bin/smartpca-native
    chmod 0755 /usr/local/bin/smartpca
    smartpca --version | grep -Fx 'smartpca 8.0.0'
    smartpca --help >/dev/null
    rm -rf /opt/eigensoft.tar.gz /opt/EIG-09ed563fdec05648a66c206ba1fc37a198395cd7
    apt-get purge -y --auto-remove curl gcc libc6-dev libgsl-dev liblapacke-dev libopenblas-dev make
    apt-get clean
    rm -rf /var/lib/apt/lists/*

%runscript
    exec /usr/local/bin/smartpca "$@"

%test
    smartpca --version | grep -Fx 'smartpca 8.0.0'
    smartpca --help >/dev/null
    test -x /opt/eigensoft/bin/smartpca-native

%help
    EIGENSOFT smartpca 8.0.0 built from its exact checksummed upstream commit.
