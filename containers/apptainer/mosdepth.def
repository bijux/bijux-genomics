# Tool ID: mosdepth
# Version policy: exact upstream amd64 release artifact with a governed SHA-256 digest
# Upstream source: https://github.com/brentp/mosdepth/releases/tag/v0.3.11
# Build date policy: captured by immutable build evidence
# Network source policy: build-only access to the locked Ubuntu snapshot and release artifact
# Runtime UID policy: non-root runtime with caller-owned output paths
# VERSION_SOURCE: containers/contracts/catalog.toml
Bootstrap: docker
From: ubuntu@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b

%labels
    org.opencontainers.image.source https://github.com/brentp/mosdepth
    org.opencontainers.image.revision e065a5f38ad6ff6c612a63d32f82fcfb6c00915d
    org.opencontainers.image.created governed-by-build-evidence
    org.opencontainers.image.licenses MIT
    org.opencontainers.image.version 0.3.11
    io.bijux.tool.version 0.3.11
    org.opencontainers.image.tool mosdepth
    org.opencontainers.image.title Mosdepth

%environment
    export PATH=/usr/local/bin:/usr/bin:/bin
    export LANG=C
    export LC_ALL=C
    export TZ=UTC

%files
    containers/contracts/configure-apt-snapshot /usr/local/sbin/bijux-configure-apt-snapshot
    containers/tools/mosdepth/mosdepth /usr/local/bin/mosdepth

%post
    set -eux
    umask 022
    export DEBIAN_FRONTEND=noninteractive
    /bin/sh /usr/local/sbin/bijux-configure-apt-snapshot
    apt-get install -y --no-install-recommends ca-certificates
    apt-get -o Acquire::Check-Valid-Until=false update
    apt-get install -y --no-install-recommends curl time
    install -d -m 0755 /opt/mosdepth/bin
    curl --fail --location --proto '=https' --tlsv1.2 --output /opt/mosdepth/bin/mosdepth-native https://github.com/brentp/mosdepth/releases/download/v0.3.11/mosdepth
    echo '4564b69249f03cb5ccb2bb04a8b4723293c86b9c9183cf40c50711e5003cdef2  /opt/mosdepth/bin/mosdepth-native' | sha256sum --check --strict
    chmod 0755 /opt/mosdepth/bin/mosdepth-native /usr/local/bin/mosdepth
    mosdepth --version | grep -Fx 'mosdepth 0.3.11'
    mosdepth --help >/dev/null
    apt-get purge -y --auto-remove curl
    apt-get clean
    rm -rf /var/lib/apt/lists/*

%runscript
    exec /usr/local/bin/mosdepth "$@"

%test
    mosdepth --version | grep -Fx 'mosdepth 0.3.11'
    mosdepth --help >/dev/null
    test -x /opt/mosdepth/bin/mosdepth-native

%help
    Mosdepth 0.3.11 from the exact checksummed upstream amd64 release artifact.
