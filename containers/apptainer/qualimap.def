# BIJUX_TEMPLATE: v1

# Tool ID: qualimap
# Version policy: pinned_or_registry_locked
# Upstream source: see org.opencontainers.image.source label
# Build date policy: org.opencontainers.image.created set by release pipeline
# Network source policy: NETWORK_SOURCE_VERIFIED_BY_LOCK
# Runtime UID policy: RUNTIME_UID_SAFE

# VERSION_SOURCE: containers/versions/versions.toml
Bootstrap: docker
From: ubuntu@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b

%labels
    org.opencontainers.image.source https://bitbucket.org/kokonech/qualimap
    org.opencontainers.image.revision 2a04dd864b712da30923cce3bc8dfc6ea59612118e8b0ff1a246fe43b8d34c40
    org.opencontainers.image.created governed-by-build-evidence
    org.opencontainers.image.licenses GPL-2.0-only
    org.opencontainers.image.version 2.3
    org.opencontainers.image.tool qualimap
    org.opencontainers.image.title qualimap
%environment
    export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
    export LC_ALL=C
    export TZ=UTC
%files
    containers/tools/qualimap/qualimap /usr/local/bin/qualimap

%post
    set -eux
    umask 022
    export DEBIAN_FRONTEND=noninteractive

    sed -i 's#http://archive.ubuntu.com/ubuntu/#https://snapshot.ubuntu.com/ubuntu/20260802T000000Z/#g; s#http://security.ubuntu.com/ubuntu/#https://snapshot.ubuntu.com/ubuntu/20260802T000000Z/#g' /etc/apt/sources.list.d/ubuntu.sources
    apt-get -o Acquire::https::Verify-Peer=false -o Acquire::Check-Valid-Until=false update
    apt-get -o Acquire::https::Verify-Peer=false install -y --no-install-recommends ca-certificates
    apt-get -o Acquire::Check-Valid-Until=false update
    apt-get install -y --no-install-recommends curl fontconfig fonts-dejavu-core libharfbuzz0b openjdk-11-jre-headless unzip
    fc-cache --force
    curl --fail --location --silent --show-error --output /opt/qualimap.zip https://bitbucket.org/kokonech/qualimap/downloads/qualimap_v2.3.zip
    echo '2a04dd864b712da30923cce3bc8dfc6ea59612118e8b0ff1a246fe43b8d34c40  /opt/qualimap.zip' | sha256sum --check --strict
    unzip -q /opt/qualimap.zip -d /opt
    mv /opt/qualimap_v2.3 /opt/qualimap
    chmod 0755 /usr/local/bin/qualimap
    qualimap --version | grep -Fx '2.3'
    qualimap --help >/dev/null
    rm /opt/qualimap.zip
    rm -rf /var/lib/apt/lists/*

%test
    qualimap --version | grep -Fx '2.3'
    qualimap --help >/dev/null
%runscript
    if [ $# -eq 0 ]; then
        exec /usr/local/bin/qualimap --help
    else
        exec /usr/local/bin/qualimap "$@"
    fi

%help
    Qualimap 2.3 from its authenticated official release archive.
