# Tool ID: seqtk
# Version policy: exact upstream tag archive with a governed SHA-256 digest
# Upstream source: https://github.com/lh3/seqtk/tree/v1.4
# Build date policy: captured by immutable build evidence
# Network source policy: build-only access to the locked Ubuntu snapshot and source archive
# Runtime UID policy: non-root runtime with caller-owned output paths
# VERSION_SOURCE: containers/contracts/catalog.toml
Bootstrap: docker
From: ubuntu@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b

%labels
    org.opencontainers.image.source https://github.com/lh3/seqtk
    org.opencontainers.image.revision ae7defa8bead3ef77d241f12194dc66acdd40fca
    org.opencontainers.image.created governed-by-build-evidence
    org.opencontainers.image.licenses MIT
    org.opencontainers.image.version 1.4
    io.bijux.tool.version 1.4
    org.opencontainers.image.tool seqtk
    org.opencontainers.image.title Seqtk

%environment
    export PATH=/usr/local/bin:/usr/bin:/bin
    export LANG=C
    export LC_ALL=C
    export TZ=UTC

%files
    containers/contracts/configure-apt-snapshot /usr/local/sbin/bijux-configure-apt-snapshot
    containers/tools/seqtk/seqtk /usr/local/bin/seqtk

%post
    set -eux
    umask 022
    export DEBIAN_FRONTEND=noninteractive
    /bin/sh /usr/local/sbin/bijux-configure-apt-snapshot
    apt-get install -y --no-install-recommends ca-certificates
    apt-get -o Acquire::Check-Valid-Until=false update
    apt-get install -y --no-install-recommends zlib1g
    apt-get install -y --no-install-recommends curl gcc make zlib1g-dev
    curl --fail --location --proto '=https' --tlsv1.2 --output /opt/seqtk.tar.gz https://codeload.github.com/lh3/seqtk/tar.gz/refs/tags/v1.4
    echo 'd124604ec24f29ed14ce127426ab90e0f3a2c0280c80d1a3ff8b1c09feede19c  /opt/seqtk.tar.gz' | sha256sum --check --strict
    tar --extract --gzip --file /opt/seqtk.tar.gz --directory /opt
    make --directory /opt/seqtk-1.4
    install -d -m 0755 /opt/seqtk/bin
    install -m 0755 /opt/seqtk-1.4/seqtk /opt/seqtk/bin/seqtk-native
    chmod 0755 /usr/local/bin/seqtk
    seqtk --version | grep -Fx 'seqtk 1.4'
    seqtk --help >/dev/null
    rm -rf /opt/seqtk.tar.gz /opt/seqtk-1.4
    apt-get clean
    rm -rf /var/lib/apt/lists/*

%runscript
    exec /usr/local/bin/seqtk "$@"

%test
    seqtk --version | grep -Fx 'seqtk 1.4'
    seqtk --help >/dev/null
    test -x /opt/seqtk/bin/seqtk-native

%help
    Seqtk 1.4 built from the exact checksummed upstream tag archive.
