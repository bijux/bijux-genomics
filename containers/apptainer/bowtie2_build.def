# Tool ID: bowtie2_build
# Version policy: checksummed Bowtie 2 2.5.4 release artifact
# Upstream source: https://github.com/BenLangmead/bowtie2
# Build date policy: captured by immutable build evidence
# Network source policy: build-only access to locked release artifacts
# NETWORK_SOURCE_VERIFIED_BY_LOCK
# Runtime UID policy: non-root runtime with caller-owned output paths
# VERSION_SOURCE: containers/contracts/catalog.toml

Bootstrap: docker
From: ubuntu@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b

%labels
    org.opencontainers.image.source https://github.com/BenLangmead/bowtie2
    org.opencontainers.image.revision 4cf8d526f4b7ec6519a79ed4c6f826caf09e0bba
    org.opencontainers.image.created governed-by-build-evidence
    org.opencontainers.image.licenses GPL-3.0-only
    org.opencontainers.image.version 2.5.4
    io.bijux.tool.version 2.5.4
    org.opencontainers.image.tool bowtie2_build
    org.opencontainers.image.title Bowtie_2_Build

%files
    containers/contracts/configure-apt-snapshot /usr/local/sbin/bijux-configure-apt-snapshot
    containers/tools/bowtie2/install /opt/bowtie2-build/install
    containers/tools/bowtie2/bowtie2 /usr/local/bin/bowtie2
    containers/tools/bowtie2/bowtie2-build /usr/local/bin/bowtie2-build

%environment
    export PATH=/usr/local/bin:/opt/bowtie2:/usr/bin:/bin
    export LANG=C
    export LC_ALL=C
    export TZ=UTC

%post
    set -eux
    umask 022
    export DEBIAN_FRONTEND=noninteractive
    /bin/sh /usr/local/sbin/bijux-configure-apt-snapshot
    apt-get install -y --no-install-recommends ca-certificates
    apt-get -o Acquire::Check-Valid-Until=false update
    apt-get install -y --no-install-recommends curl libstdc++6 perl python3 unzip zlib1g
    /opt/bowtie2-build/install
    apt-get purge -y curl unzip
    apt-get autoremove -y
    apt-get clean
    rm -rf /var/lib/apt/lists/*

%runscript
    exec /usr/local/bin/bowtie2-build "$@"

%test
    bowtie2-build --version | grep -Fx 'Bowtie 2 Build 2.5.4'
    bowtie2-build --help >/dev/null
    if bowtie2-build --governed-invalid-option >/dev/null 2>&1; then exit 1; fi

%help
    Bowtie 2 Build 2.5.4 from a checksummed architecture-specific upstream release.
