# BIJUX_TEMPLATE: v1

# Tool ID: prinseq
# Version policy: pinned_or_registry_locked
# Upstream source: see org.opencontainers.image.source label
# Build date policy: captured by immutable build evidence
# Network source policy: NETWORK_SOURCE_VERIFIED_BY_LOCK
# Runtime UID policy: RUNTIME_UID_SAFE

# VERSION_SOURCE: containers/versions/versions.toml
Bootstrap: docker
From: ubuntu@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b

%labels
    org.opencontainers.image.source https://github.com/Adrian-Cantu/PRINSEQ-plus-plus
    org.opencontainers.image.revision 3dde89b381c9df27792478f68e7e4f3bca4d45ff
    org.opencontainers.image.created governed-by-build-evidence
    org.opencontainers.image.licenses GPL-3.0
    org.opencontainers.image.version 1.2.4
    org.opencontainers.image.tool prinseq
    org.opencontainers.image.title prinseq
%files
    containers/contracts/configure-apt-snapshot /usr/local/sbin/bijux-configure-apt-snapshot

%environment
    export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
    export LC_ALL=C
    export TZ=UTC
%post
    set -eux
    umask 022
    export DEBIAN_FRONTEND=noninteractive

    /bin/sh /usr/local/sbin/bijux-configure-apt-snapshot
    apt-get install -y --no-install-recommends ca-certificates
    apt-get -o Acquire::Check-Valid-Until=false update
    apt-get install -y --no-install-recommends \
        build-essential \
        curl \
        libboost-all-dev \
        gzip \
        tar
    curl --fail --location --silent --show-error --output /opt/prinseq.tar.gz https://github.com/Adrian-Cantu/PRINSEQ-plus-plus/releases/download/v1.2.4/prinseq-plus-plus-1.2.4.tar.gz
    echo '957fd45f035ef94e5b8a478f4de82e2f2099d490a69a5acd73a4bdad4dd0eea3  /opt/prinseq.tar.gz' | sha256sum --check --strict
    tar --extract --gzip --file /opt/prinseq.tar.gz --directory /opt
    cd /opt/prinseq-plus-plus-1.2.4
    ./configure --prefix=/usr/local
    make -j"$(nproc)"
    make install
    prinseq++ --version | grep -F '1.2.4'
    prinseq++ --help >/dev/null
    cd /
    rm -rf /opt/prinseq-plus-plus-1.2.4 /opt/prinseq.tar.gz
    rm -rf /var/lib/apt/lists/*

%test
    prinseq++ --version | grep -F '1.2.4'
    prinseq++ --help >/dev/null
%runscript
    if [ $# -eq 0 ]; then
        exec prinseq++ --help
    else
        exec prinseq++ "$@"
    fi

%help
    PRINSEQ++ v1.2.4 built from its authenticated official release tarball.
    Executable: prinseq++
