# Bijux Genomics source code is licensed under Apache-2.0.
# Copyright (C) 2026 Bijan Mousavi
# Tool ID: kraken2
# Version policy: checksummed Kraken 2.1.3 source commit
# Upstream source: https://github.com/DerrickWood/kraken2
# Build date policy: captured by immutable build evidence
# Network source policy: build-only access to the locked source archive
# NETWORK_SOURCE_VERIFIED_BY_LOCK
# Runtime UID policy: non-root runtime with caller-owned output paths
# VERSION_SOURCE: containers/contracts/catalog.toml

Bootstrap: docker
From: ubuntu@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b

%labels
    org.opencontainers.image.source https://github.com/DerrickWood/kraken2
    org.opencontainers.image.revision 8f82a7ded7816c7ceed5086598b2979f80c970d8
    org.opencontainers.image.created governed-by-build-evidence
    org.opencontainers.image.licenses MIT
    org.opencontainers.image.version 2.1.3
    org.opencontainers.image.tool kraken2
    org.opencontainers.image.title Kraken-2

%files
    containers/tools/kraken2/install /opt/kraken2-build/install
    containers/tools/kraken2/kraken2 /usr/local/bin/kraken2

%environment
    export PATH=/usr/local/bin:/opt/kraken2:/usr/bin:/bin
    export LANG=C
    export LC_ALL=C
    export TZ=UTC
    export PERL5LIB=/opt/kraken2

%post
    set -eux
    umask 022
    export DEBIAN_FRONTEND=noninteractive
    sed -i 's#http://archive.ubuntu.com/ubuntu/#https://snapshot.ubuntu.com/ubuntu/20260802T000000Z/#g; s#http://security.ubuntu.com/ubuntu/#https://snapshot.ubuntu.com/ubuntu/20260802T000000Z/#g' /etc/apt/sources.list.d/ubuntu.sources
    apt-get -o Acquire::https::Verify-Peer=false -o Acquire::Check-Valid-Until=false update
    apt-get -o Acquire::https::Verify-Peer=false install -y --no-install-recommends ca-certificates
    apt-get -o Acquire::Check-Valid-Until=false update
    apt-get install -y --no-install-recommends build-essential curl zlib1g-dev perl gzip bzip2 libgomp1
    /opt/kraken2-build/install
    apt-get purge -y build-essential curl g++ gcc make zlib1g-dev
    apt-get autoremove -y
    apt-get clean
    rm -rf /var/lib/apt/lists/*

%runscript
    exec /usr/local/bin/kraken2 "$@"

%test
    kraken2 --version | grep -Fx 'Kraken 2.1.3'
    kraken2 --help >/dev/null
    if kraken2 --governed-invalid-option >/dev/null 2>&1; then exit 1; fi

%help
    Kraken 2.1.3 built from its checksummed source commit.
