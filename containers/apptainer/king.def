# BIJUX_TEMPLATE: v1

# Tool ID: king
# Version policy: pinned_or_registry_locked
# Upstream source: see org.opencontainers.image.source label
# Build date policy: captured by immutable build evidence
# Network source policy: NETWORK_SOURCE_VERIFIED_BY_LOCK
# Runtime UID policy: RUNTIME_UID_SAFE

# VERSION_SOURCE: containers/versions/versions.toml
Bootstrap: docker
From: ubuntu@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b

%labels
    VERSION 2.3.0
    org.opencontainers.image.source https://www.kingrelatedness.com/executables/Linux-king230.tar.gz
    org.opencontainers.image.revision sha256:5a00cb504b56e3a05c8aa2b4531b1f85c9947e7c9aa89bfec7afd72b28663b39
    org.opencontainers.image.created governed-by-build-evidence
    org.opencontainers.image.licenses GPL-3.0
    org.opencontainers.image.version 2.3.0
    io.bijux.tool.version 2.3.0
    org.opencontainers.image.tool king
    org.opencontainers.image.title king

%environment
    export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
    export LC_ALL=C
    export TZ=UTC
    DEBIAN_FRONTEND=noninteractive

%post
    set -eux
    umask 022
    export DEBIAN_FRONTEND=noninteractive
    apt-get update -qq && apt-get install -y --no-install-recommends ca-certificates curl libgomp1 libquadmath0 && rm -rf /var/lib/apt/lists/*
    mkdir -p /usr/local/libexec/king
    curl -L --retry 5 --retry-delay 3 --connect-timeout 20 --max-time 300 \
        -o /tmp/Linux-king230.tar.gz \
        "https://www.kingrelatedness.com/executables/Linux-king230.tar.gz"
    tar -xzf /tmp/Linux-king230.tar.gz -C /usr/local/libexec/king
    install -m 0755 /usr/local/libexec/king/king /usr/local/libexec/king/king-bin
    rm -f /tmp/Linux-king230.tar.gz
    cat > /usr/local/bin/king <<'EOS'
#!/usr/bin/env sh
set -eu
bin="/usr/local/libexec/king/king-bin"
native_info() {
  set +e
  native_output="$("$bin" --help 2>&1)"
  native_status=$?
  set -e
  if [ "$native_status" -ne 1 ] || ! printf '%s\n' "$native_output" | grep -Fq 'KING 2.3.0 -'; then
    printf 'error: unexpected KING information probe (status=%s)\n' "$native_status" >&2
    exit 70
  fi
}
case "${1:-}" in
  --version)
    native_info
    printf 'KING 2.3.0\n'
    exit 0
    ;;
  --help|-h|"")
    native_info
    printf '%s\n' "$native_output"
    exit 0
    ;;
esac
exec "$bin" "$@"
EOS
    chmod +x /usr/local/bin/king
    king --version > /tmp/king.version
    grep -Fx 'KING 2.3.0' /tmp/king.version
    king --help > /tmp/king.help
    grep -F 'KING 2.3.0 -' /tmp/king.help
    rm -f /tmp/king.version /tmp/king.help
%runscript
    exec king "$@"

%test
    king --version > /tmp/king.version
    grep -Fx 'KING 2.3.0' /tmp/king.version
    king --help > /tmp/king.help
    grep -F 'KING 2.3.0 -' /tmp/king.help
    rm -f /tmp/king.version /tmp/king.help

%help
    Apptainer image for king.
    Version and help normalization validate the native KING information output.
