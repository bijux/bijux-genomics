# Copyright (C) 2026 Bijan Mousavi
# Tool ID: fastqvalidator
# Version policy: exact tool and libStatGen source commits with governed SHA-256 digests
# Upstream source: https://github.com/statgen/fastQValidator/tree/v0.1.1
# Build date policy: captured by immutable build evidence
# Network source policy: build-only access to the locked Ubuntu snapshot and source archives
# Runtime UID policy: non-root runtime with caller-owned output paths
# VERSION_SOURCE: containers/contracts/catalog.toml
Bootstrap: docker
From: ubuntu@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b

%labels
    org.opencontainers.image.source https://github.com/statgen/fastQValidator
    org.opencontainers.image.revision 4cb293ca4153459b05ae7983f65a082d56b55c21
    org.opencontainers.image.created governed-by-build-evidence
    org.opencontainers.image.licenses GPL-3.0-or-later
    org.opencontainers.image.version 0.1.1
    org.opencontainers.image.tool fastqvalidator
    org.opencontainers.image.title fastQValidator

%environment
    export PATH=/usr/local/bin:/usr/bin:/bin
    export LANG=C
    export LC_ALL=C
    export TZ=UTC

%files
    containers/contracts/configure-apt-snapshot /usr/local/sbin/bijux-configure-apt-snapshot
    containers/tools/fastqvalidator/fastqvalidator /usr/local/bin/fastqvalidator

%post
    set -eux
    umask 022
    export DEBIAN_FRONTEND=noninteractive
    /bin/sh /usr/local/sbin/bijux-configure-apt-snapshot
    apt-get install -y --no-install-recommends ca-certificates
    apt-get -o Acquire::Check-Valid-Until=false update
    apt-get install -y --no-install-recommends libbz2-1.0 zlib1g
    apt-get install -y --no-install-recommends curl g++ libbz2-dev make zlib1g-dev
    curl --fail --location --proto '=https' --tlsv1.2 --output /opt/fastqvalidator.tar.gz https://codeload.github.com/statgen/fastQValidator/tar.gz/4cb293ca4153459b05ae7983f65a082d56b55c21
    echo '0172c7e86bdb33dbf71900a3a9b2a6aae4ec9f6918f934a7c23a9d599e12181c  /opt/fastqvalidator.tar.gz' | sha256sum --check --strict
    curl --fail --location --proto '=https' --tlsv1.2 --output /opt/libstatgen.tar.gz https://codeload.github.com/statgen/libStatGen/tar.gz/fae4fca874b3b78bf9b61c0eae080c15edd976a4
    echo '8b49088139d70cd67c94bda68a94621452ef925bb7e266576b830cc01d9d8c2a  /opt/libstatgen.tar.gz' | sha256sum --check --strict
    tar --extract --gzip --file /opt/fastqvalidator.tar.gz --directory /opt
    tar --extract --gzip --file /opt/libstatgen.tar.gz --directory /opt
    make --directory /opt/libStatGen-fae4fca874b3b78bf9b61c0eae080c15edd976a4 -j1
    make --directory /opt/fastQValidator-4cb293ca4153459b05ae7983f65a082d56b55c21 -j1 LIB_PATH_FASTQ_VALIDATOR=/opt/libStatGen-fae4fca874b3b78bf9b61c0eae080c15edd976a4
    install -d -m 0755 /opt/fastqvalidator/bin
    install -m 0755 /opt/fastQValidator-4cb293ca4153459b05ae7983f65a082d56b55c21/bin/fastQValidator /opt/fastqvalidator/bin/fastqvalidator-native
    chmod 0755 /usr/local/bin/fastqvalidator
    fastqvalidator --version | grep -Fx 'fastqvalidator 0.1.1'
    fastqvalidator --help >/dev/null
    rm -rf /opt/fastqvalidator.tar.gz /opt/libstatgen.tar.gz /opt/fastQValidator-4cb293ca4153459b05ae7983f65a082d56b55c21 /opt/libStatGen-fae4fca874b3b78bf9b61c0eae080c15edd976a4
    apt-get purge -y --auto-remove curl g++ libbz2-dev make zlib1g-dev
    apt-get clean
    rm -rf /var/lib/apt/lists/*

%runscript
    exec /usr/local/bin/fastqvalidator "$@"

%test
    fastqvalidator --version | grep -Fx 'fastqvalidator 0.1.1'
    fastqvalidator --help >/dev/null
    test -x /opt/fastqvalidator/bin/fastqvalidator-native

%help
    fastQValidator 0.1.1 built from exact checksummed tool and libStatGen sources.
