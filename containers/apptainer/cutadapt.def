# Copyright (C) 2026 Bijan Mousavi
# Tool ID: cutadapt
# Version policy: checksummed Cutadapt 4.9 source commit
# Upstream source: https://github.com/marcelm/cutadapt
# Build date policy: captured by immutable build evidence
# Network source policy: build-only access to the locked source archive
# NETWORK_SOURCE_VERIFIED_BY_LOCK
# Runtime UID policy: non-root runtime with caller-owned output paths
# VERSION_SOURCE: containers/contracts/catalog.toml

Bootstrap: docker
From: ubuntu@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b

%labels
    org.opencontainers.image.source https://github.com/marcelm/cutadapt
    org.opencontainers.image.revision 9276a89d5df9282ff51602b042b40c3b48c98566
    org.opencontainers.image.created governed-by-build-evidence
    org.opencontainers.image.licenses MIT
    org.opencontainers.image.version 4.9
    io.bijux.tool.version 4.9
    org.opencontainers.image.tool cutadapt
    org.opencontainers.image.title cutadapt
%environment
    export PATH=/opt/cutadapt-venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
    export LANG=C
    export LC_ALL=C
    export TZ=UTC
    export PYTHONNOUSERSITE=1

%files
    containers/contracts/configure-apt-snapshot /usr/local/sbin/bijux-configure-apt-snapshot
    containers/tools/cutadapt/install /opt/cutadapt-build/install

%post
    set -eux
    umask 022
    export DEBIAN_FRONTEND=noninteractive

    /bin/sh /usr/local/sbin/bijux-configure-apt-snapshot
    apt-get install -y --no-install-recommends ca-certificates
    apt-get -o Acquire::Check-Valid-Until=false update
    apt-get install -y --no-install-recommends python3 python3-pip python3-venv python3-dev build-essential curl
    /opt/cutadapt-build/install
    apt-get clean
    rm -rf /var/lib/apt/lists/*
%runscript
    exec /opt/cutadapt-venv/bin/cutadapt "$@"

%test
    cutadapt --version | grep -Fx '4.9'
    cutadapt --help >/dev/null
    if cutadapt --governed-invalid-option >/dev/null 2>&1; then exit 1; fi

%help
    Cutadapt 4.9 built from its checksummed source commit.
