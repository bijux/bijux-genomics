# BIJUX_TEMPLATE: v1

# Tool ID: rcorrector
# Version policy: pinned_or_registry_locked
# Upstream source: see org.opencontainers.image.source label
# Build date policy: captured by immutable build evidence
# Network source policy: NETWORK_SOURCE_VERIFIED_BY_LOCK
# Runtime UID policy: RUNTIME_UID_SAFE

# VERSION_SOURCE: containers/versions/versions.toml
Bootstrap: docker
From: ubuntu@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b

%labels
    MAINTAINER Bijan Mousavi <bijan@bijux.io>
    VERSION Rcorrector-v1.0.7
    COMMIT_SHA f8915b79363e896409bd9ca56819f56c3f77a47e
    JELLYFISH_VERSION 2.3.0
    org.opencontainers.image.source https://github.com/mourisl/Rcorrector
    org.opencontainers.image.revision f8915b79363e896409bd9ca56819f56c3f77a47e
    org.opencontainers.image.created governed-by-build-evidence
    org.opencontainers.image.licenses GPL-3.0
    org.opencontainers.image.version 1.0.7
    io.bijux.tool.version 1.0.7
    org.opencontainers.image.tool rcorrector
    org.opencontainers.image.title rcorrector

%files
    containers/tools/rcorrector/rcorrector /usr/local/bin/rcorrector

%environment
    export LC_ALL=C
    DEBIAN_FRONTEND=noninteractive
    TZ=UTC
    export VERSION_RCORRECTOR=1.0.7
    JELLYFISH_VERSION=2.3.0
    PATH=/opt/jellyfish/bin:/usr/local/bin:/usr/bin:/bin

%post
    set -eux
    umask 022
    export DEBIAN_FRONTEND=noninteractive

    apt-get update
    apt-get install -y --no-install-recommends \
        build-essential \
        git \
        perl \
        ca-certificates \
        wget \
        curl \
        zlib1g-dev \
        libbz2-dev

    # Build the declared Jellyfish version instead of inheriting distribution drift.
    mkdir -p /opt/src
    cd /opt/src
    wget -O jellyfish.tar.gz \
      https://github.com/gmarcais/Jellyfish/releases/download/v2.3.0/jellyfish-2.3.0.tar.gz \
      || curl -L -o jellyfish.tar.gz \
      https://github.com/gmarcais/Jellyfish/releases/download/v2.3.0/jellyfish-2.3.0.tar.gz
    tar -xzf jellyfish.tar.gz
    cd jellyfish-2.3.0
    ./configure --prefix=/opt/jellyfish
    make -j"$(nproc)"
    make install

    # The source checkout is fixed to the catalog commit before compilation.
    mkdir -p /opt/rcorrector
    for i in 1 2 3; do \
        git clone https://github.com/mourisl/Rcorrector.git /opt/rcorrector && break || \
        echo "Git clone attempt $i failed, retrying..." && sleep 5; \
    done || { echo "Failed to clone Rcorrector after 3 attempts"; exit 1; }

    cd /opt/rcorrector
    git checkout f8915b79363e896409bd9ca56819f56c3f77a47e

    # Keep the upstream driver and native executable at stable runtime paths.
    sed -i 's|\$WD/rcorrector|\$WD/rcorrector-bin|g' run_rcorrector.pl

    # Upstream requires this signed-char correction with the current compiler.
    sed -i 's/-1/(char)-1/g' ./*.cpp

    # Compilation resolves Jellyfish only from the source-built prefix.
    export PATH="/opt/jellyfish/bin:${PATH}"
    make -j"$(nproc)"

    install -m 0755 ./rcorrector /usr/local/bin/rcorrector-bin
    install -m 0755 ./run_rcorrector.pl /usr/local/bin/run_rcorrector.pl

    chmod 0555 /usr/local/bin/rcorrector
    rcorrector --version > /tmp/rcorrector.version
    grep -Fx 'Rcorrector v1.0.7' /tmp/rcorrector.version
    rcorrector --help > /tmp/rcorrector.help
    grep -F 'Usage: perl ./run_rcorrector.pl [OPTIONS]' /tmp/rcorrector.help
    rm -f /tmp/rcorrector.version /tmp/rcorrector.help
    cd /
    rm -rf /opt/src/jellyfish-2.3.0 /opt/src/jellyfish.tar.gz /opt/rcorrector

    rm -rf /var/lib/apt/lists/*

%runscript
    if [ $# -eq 0 ]; then
        exec rcorrector --help
    else
        exec rcorrector "$@"
    fi

%test
    rcorrector --version > /tmp/rcorrector.version
    grep -Fx 'Rcorrector v1.0.7' /tmp/rcorrector.version
    rcorrector --help > /tmp/rcorrector.help
    grep -F 'Usage: perl ./run_rcorrector.pl [OPTIONS]' /tmp/rcorrector.help
    rm -f /tmp/rcorrector.version /tmp/rcorrector.help

%help
    Rcorrector v1.0.7 (commit f8915b7) built from source on Ubuntu 24.04.
    Ships Jellyfish v2.3.0 under /opt/jellyfish to ensure deterministic behavior.
    Entry point: rcorrector (validated interface to the upstream Perl driver).
    Underlying binary: rcorrector-bin.
