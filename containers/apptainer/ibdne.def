# Tool ID: ibdne
# Version policy: verified official binary and matching source archive
# Upstream source: https://faculty.washington.edu/browning/ibdne.html
# Build date policy: captured by immutable build evidence
# Network source policy: build-only access to the locked Ubuntu snapshot and release files
# Runtime UID policy: non-root runtime with caller-owned output paths
# VERSION_SOURCE: containers/contracts/catalog.toml

Bootstrap: docker
From: ubuntu@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b

%labels
    org.opencontainers.image.source https://faculty.washington.edu/browning/ibdne.html
    org.opencontainers.image.revision b3324ebd74ed69477067e0aec1dd22be56b1bcedbbe72d8757cda28746312665
    org.opencontainers.image.created governed-by-build-evidence
    org.opencontainers.image.licenses Apache-2.0
    org.opencontainers.image.version 23Apr20.ae9
    org.opencontainers.image.tool ibdne
    org.opencontainers.image.title IBDNe

%environment
    export PATH=/usr/local/bin:/usr/bin:/bin
    export LANG=C
    export LC_ALL=C
    export TZ=UTC

%files
    containers/tools/ibdne/ibdne /usr/local/bin/ibdne

%post
    set -eux
    umask 022
    export DEBIAN_FRONTEND=noninteractive
    sed -i 's#http://archive.ubuntu.com/ubuntu/#https://snapshot.ubuntu.com/ubuntu/20260802T000000Z/#g; s#http://security.ubuntu.com/ubuntu/#https://snapshot.ubuntu.com/ubuntu/20260802T000000Z/#g' /etc/apt/sources.list.d/ubuntu.sources
    apt-get -o Acquire::https::Verify-Peer=false -o Acquire::Check-Valid-Until=false update
    apt-get -o Acquire::https::Verify-Peer=false install -y --no-install-recommends ca-certificates
    apt-get -o Acquire::Check-Valid-Until=false update
    apt-get install -y --no-install-recommends curl openjdk-17-jre-headless
    mkdir -p /opt/ibdne
    curl --fail --location --silent --show-error --output /opt/ibdne/ibdne.jar https://faculty.washington.edu/browning/ibdne/ibdne.23Apr20.ae9.jar
    curl --fail --location --silent --show-error --output /opt/ibdne/source.zip https://faculty.washington.edu/browning/ibdne/ibdne.23Apr20.ae9.src.zip
    echo 'e153f431254f08d41c21ab3db9fbedca4907c25ea3175e67ec10228b132ba48c  /opt/ibdne/ibdne.jar' | sha256sum --check --strict
    echo 'b3324ebd74ed69477067e0aec1dd22be56b1bcedbbe72d8757cda28746312665  /opt/ibdne/source.zip' | sha256sum --check --strict
    rm /opt/ibdne/source.zip
    chmod 0555 /opt/ibdne/ibdne.jar
    chmod 0755 /usr/local/bin/ibdne
    ibdne --version | grep -Fx 'ibdne 23Apr20.ae9'
    rm -rf /var/lib/apt/lists/*

%runscript
    exec /usr/local/bin/ibdne "$@"

%test
    ibdne --version | grep -Fx 'ibdne 23Apr20.ae9'
    ibdne --help >/dev/null

%help
    IBDNe 23Apr20.ae9 from the verified official JAR and matching source archive.
