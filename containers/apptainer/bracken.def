# Bijux Genomics source code is licensed under Apache-2.0.
# Copyright (C) 2026 Bijan Mousavi
# Tool ID: bracken
# Version policy: checksummed Bracken 2.9 source commit
# Upstream source: https://github.com/jenniferlu717/Bracken
# Build date policy: captured by immutable build evidence
# Network source policy: build-only access to the locked source archive
# NETWORK_SOURCE_VERIFIED_BY_LOCK
# Runtime UID policy: non-root runtime with caller-owned output paths
# VERSION_SOURCE: containers/contracts/catalog.toml

Bootstrap: docker
From: ubuntu@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b

%labels
    org.opencontainers.image.source https://github.com/jenniferlu717/Bracken
    org.opencontainers.image.revision c5bfec1929fe30feef21afbde67b16bda44de448
    org.opencontainers.image.created governed-by-build-evidence
    org.opencontainers.image.licenses GPL-3.0-or-later
    org.opencontainers.image.version 2.9
    io.bijux.tool.version 2.9
    org.opencontainers.image.tool bracken
    org.opencontainers.image.title Bracken

%files
    containers/contracts/configure-apt-snapshot /usr/local/sbin/bijux-configure-apt-snapshot
    containers/tools/bracken/install /opt/bracken-build/install
    containers/tools/bracken/bracken /usr/local/bin/bracken

%environment
    export PATH=/usr/local/bin:/opt/bracken:/opt/bracken/src:/usr/bin:/bin
    export LANG=C
    export LC_ALL=C
    export TZ=UTC
    export PYTHONNOUSERSITE=1

%post
    set -eux
    umask 022
    export DEBIAN_FRONTEND=noninteractive
    /bin/sh /usr/local/sbin/bijux-configure-apt-snapshot
    apt-get install -y --no-install-recommends ca-certificates
    apt-get -o Acquire::Check-Valid-Until=false update
    apt-get install -y --no-install-recommends build-essential curl libgomp1 python3 python-is-python3
    /opt/bracken-build/install
    apt-get purge -y build-essential curl g++ gcc make
    apt-get autoremove -y
    apt-get clean
    rm -rf /var/lib/apt/lists/*

%runscript
    exec /usr/local/bin/bracken "$@"

%test
    bracken --version | grep -Fx 'Bracken 2.9'
    bracken --help >/dev/null
    python --version 2>&1 | grep -E '^Python 3[.]'
    if bracken --governed-invalid-option >/dev/null 2>&1; then exit 1; fi

%help
    Bracken 2.9 built from its checksummed source commit.
