# Tool ID: bcftools
# Version policy: pinned_or_registry_locked
# Upstream source: see org.opencontainers.image.source label
# Build date policy: captured by immutable build evidence
# Network source policy: NETWORK_SOURCE_VERIFIED_BY_LOCK
# Runtime UID policy: RUNTIME_UID_SAFE

# VERSION_SOURCE: containers/versions/versions.toml
Bootstrap: docker
From: quay.io/biocontainers/bcftools@sha256:badc3a0c7af72a83e5761ab0e881aa84204694bdead003b47552cb283958f78d

%labels
    VERSION 1.20
    org.opencontainers.image.source https://github.com/samtools/bcftools
    org.opencontainers.image.revision 02ee548d77916357dcd3699eab88273acd8f9f7c
    org.opencontainers.image.created governed-by-build-evidence
    org.opencontainers.image.licenses MIT
    org.opencontainers.image.version 1.20
    org.opencontainers.image.tool bcftools
    org.opencontainers.image.title bcftools

%environment
    export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
    export TZ=UTC
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8

%post
    set -eux
    umask 022
    set -eu
    bcftools --version >/dev/null 2>&1 || true
%runscript
    exec bcftools "$@"

%help
    Apptainer image for bcftools.
    Default runscript forwards arguments to the tool entrypoint.
