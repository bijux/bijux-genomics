# BIJUX_TEMPLATE: v1
#
# Tool ID: bijux_dna
# Version policy: registry_locked
# Upstream source: https://github.com/bijux/bijux-genomics
# Build date policy: captured by immutable build evidence
# Network source policy: NETWORK_SOURCE_VERIFIED_BY_LOCK
# Runtime UID policy: RUNTIME_UID_SAFE
#
# VERSION_SOURCE: containers/versions/versions.toml
Bootstrap: docker
From: ubuntu@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b

%labels
    org.opencontainers.image.source https://github.com/bijux/bijux-genomics
    org.opencontainers.image.title bijux_dna
    org.opencontainers.image.revision governed-by-build-evidence
    org.opencontainers.image.created governed-by-build-evidence
    org.opencontainers.image.licenses Apache-2.0
    org.opencontainers.image.version 0.1.0
    io.bijux.tool.version 0.1.0
    org.opencontainers.image.tool bijux_dna

%files
    .cargo /opt/bijux-src/.cargo
    Cargo.toml /opt/bijux-src/Cargo.toml
    Cargo.lock /opt/bijux-src/Cargo.lock
    rust-toolchain.toml /opt/bijux-src/rust-toolchain.toml
    rustfmt.toml /opt/bijux-src/rustfmt.toml
    crates /opt/bijux-src/crates
    configs /opt/bijux-src/configs
    domain /opt/bijux-src/domain
    assets /opt/bijux-src/assets

%environment
    export PATH=/opt/rust/bin:/usr/local/bin:/usr/bin:/bin
    export LC_ALL=C
    export TZ=UTC

%post
    set -eux
    umask 022
    export DEBIAN_FRONTEND=noninteractive
    apt-get update -qq
    apt-get install -y --no-install-recommends build-essential ca-certificates curl libsqlite3-dev pkg-config libssl-dev xz-utils
    case "$(uname -m)" in
        x86_64)
            rust_target=x86_64-unknown-linux-gnu
            rust_sha256=2e0338f18ecbaa4a0f631b9e80e8b8e26bb6fe77dd5454fba8a70cf96c1e84a1
            ;;
        aarch64)
            rust_target=aarch64-unknown-linux-gnu
            rust_sha256=094c9c36531911c5cc7dd6ab2d3069ab8dcd744d6239b0bda1387b243dfc391e
            ;;
        *)
            echo "unsupported build architecture: $(uname -m)" >&2
            exit 1
            ;;
    esac
    rust_archive="rust-1.95.0-${rust_target}.tar.xz"
    curl -fsSL -o "/tmp/${rust_archive}" \
        "https://static.rust-lang.org/dist/2026-04-16/${rust_archive}"
    echo "${rust_sha256}  /tmp/${rust_archive}" | sha256sum -c -
    tar -xJf "/tmp/${rust_archive}" -C /tmp
    "/tmp/rust-1.95.0-${rust_target}/install.sh" --prefix=/opt/rust --without=rust-docs
    export PATH=/opt/rust/bin:${PATH}
    cd /opt/bijux-src
    cargo build --locked --release -p bijux-dna
    install -Dm0755 artifacts/rust/target/release/bijux-dna /usr/local/bin/bijux-dna
    install -d /opt/bijux/assets /opt/bijux/configs /opt/bijux/domain
    cp -a assets/. /opt/bijux/assets/
    cp -a configs/. /opt/bijux/configs/
    cp -a domain/. /opt/bijux/domain/
    rm -rf /var/lib/apt/lists/*
    rm -rf "/tmp/rust-1.95.0-${rust_target}" "/tmp/${rust_archive}"
    rm -rf /opt/bijux-src

%runscript
    exec bijux-dna "$@"

%help
    Bijux Apptainer image for the governed bijux-dna CLI.
