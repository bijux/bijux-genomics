# Copyright (C) 2026 Bijan Mousavi
# Tool ID: bayeshammer
# Version policy: checksummed SPAdes 4.2.0 release artifact and source graph
# Upstream source: https://github.com/ablab/spades
# Build date policy: captured by immutable build evidence
# Network source policy: build-only access to locked snapshots and release artifacts
# NETWORK_SOURCE_VERIFIED_BY_LOCK
# Runtime UID policy: non-root runtime with caller-owned output paths
# VERSION_SOURCE: containers/contracts/catalog.toml

Bootstrap: docker
From: ubuntu@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b

%labels
    org.opencontainers.image.source https://github.com/ablab/spades
    org.opencontainers.image.revision 7fee3c1050a732faef8a0d93d70861015a96f44e
    org.opencontainers.image.created governed-by-build-evidence
    org.opencontainers.image.licenses GPL-2.0-only
    org.opencontainers.image.version 4.2.0
    org.opencontainers.image.tool bayeshammer
    org.opencontainers.image.title BayesHammer

%files
    containers/tools/bayeshammer/install /opt/bayeshammer-build/install
    containers/tools/bayeshammer/bayeshammer /usr/local/bin/bayeshammer

%environment
    export PATH=/opt/spades/bin:/usr/local/bin:/usr/bin:/bin
    export LANG=C
    export LC_ALL=C
    export TZ=UTC
    export PYTHONNOUSERSITE=1

%post
    set -eux
    umask 022
    export DEBIAN_FRONTEND=noninteractive
    sed -i 's#http://archive.ubuntu.com/ubuntu/#https://snapshot.ubuntu.com/ubuntu/20260802T000000Z/#g; s#http://security.ubuntu.com/ubuntu/#https://snapshot.ubuntu.com/ubuntu/20260802T000000Z/#g' /etc/apt/sources.list.d/ubuntu.sources
    apt-get -o Acquire::https::Verify-Peer=false -o Acquire::Check-Valid-Until=false update
    apt-get -o Acquire::https::Verify-Peer=false install -y --no-install-recommends ca-certificates
    apt-get -o Acquire::Check-Valid-Until=false update
    apt-get install -y --no-install-recommends curl libgomp1 python3
    /opt/bayeshammer-build/install
    apt-get clean
    rm -rf /var/lib/apt/lists/*

%runscript
    exec /usr/local/bin/bayeshammer "$@"

%test
    bayeshammer --version | grep -Fx 'BayesHammer 4.2.0'
    bayeshammer --help >/dev/null
    if bayeshammer --governed-invalid-option >/dev/null 2>&1; then exit 1; fi

%help
    BayesHammer from SPAdes 4.2.0 with architecture-specific immutable build inputs.
