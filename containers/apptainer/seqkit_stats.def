# Tool ID: seqkit_stats
# Version policy: exact upstream SeqKit release binary with a governed SHA-256 digest
# Upstream source: https://github.com/shenwei356/seqkit/releases/tag/v2.8.2
# Build date policy: captured by immutable build evidence
# Network source policy: build-only access to the locked Ubuntu snapshot and release artifact
# Runtime UID policy: non-root runtime with caller-owned output paths
# VERSION_SOURCE: containers/contracts/catalog.toml
Bootstrap: docker
From: ubuntu@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b

%labels
    org.opencontainers.image.source https://github.com/shenwei356/seqkit
    org.opencontainers.image.revision 1aef84fbc2381db2e73639632bc44a5f7a0a8bcc
    org.opencontainers.image.created governed-by-build-evidence
    org.opencontainers.image.licenses MIT
    org.opencontainers.image.version 2.8.2
    io.bijux.tool.version 2.8.2
    org.opencontainers.image.tool seqkit_stats
    org.opencontainers.image.title SeqKit Stats

%environment
    export PATH=/usr/local/bin:/usr/bin:/bin
    export LANG=C
    export LC_ALL=C
    export TZ=UTC

%files
    containers/contracts/configure-apt-snapshot /usr/local/sbin/bijux-configure-apt-snapshot
    containers/tools/seqkit_stats/seqkit_stats /usr/local/bin/seqkit_stats

%post
    set -eux
    umask 022
    export DEBIAN_FRONTEND=noninteractive
    /bin/sh /usr/local/sbin/bijux-configure-apt-snapshot
    apt-get install -y --no-install-recommends ca-certificates
    apt-get -o Acquire::Check-Valid-Until=false update
    apt-get install -y --no-install-recommends curl
    curl --fail --location --proto '=https' --tlsv1.2 --output /opt/seqkit.tar.gz https://github.com/shenwei356/seqkit/releases/download/v2.8.2/seqkit_linux_amd64.tar.gz
    echo 'a6515a64bf28ceba6922a3854d8ec898ca2ca637b4b00fc883c83076dfaf1ffa  /opt/seqkit.tar.gz' | sha256sum --check --strict
    install -d -m 0755 /opt/seqkit/bin
    tar --extract --gzip --file /opt/seqkit.tar.gz --directory /opt/seqkit/bin
    mv /opt/seqkit/bin/seqkit /opt/seqkit/bin/seqkit-native
    chmod 0755 /opt/seqkit/bin/seqkit-native /usr/local/bin/seqkit_stats
    seqkit_stats --version | grep -Fx 'seqkit_stats 2.8.2'
    seqkit_stats --help >/dev/null
    rm /opt/seqkit.tar.gz
    apt-get purge -y --auto-remove curl
    apt-get clean
    rm -rf /var/lib/apt/lists/*

%runscript
    exec /usr/local/bin/seqkit_stats "$@"

%test
    seqkit_stats --version | grep -Fx 'seqkit_stats 2.8.2'
    seqkit_stats --help >/dev/null
    test -x /opt/seqkit/bin/seqkit-native

%help
    SeqKit stats 2.8.2 from the exact checksummed upstream Linux AMD64 release.
