# Tool ID: plink2
# Version policy: exact Ubuntu package from a dated snapshot
# Upstream source: https://www.cog-genomics.org/plink/2.0/
# Build date policy: captured by immutable build evidence
# Network source policy: build-only access to the locked Ubuntu snapshot
# Runtime UID policy: non-root runtime with caller-owned output paths

# VERSION_SOURCE: containers/versions/versions.toml
Bootstrap: docker
From: ubuntu@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b

%labels
    org.opencontainers.image.source https://www.cog-genomics.org/plink/2.0/
    org.opencontainers.image.revision 2.00~a5.8-231123+dfsg-1
    org.opencontainers.image.created governed-by-build-evidence
    org.opencontainers.image.licenses GPL-3.0
    org.opencontainers.image.version 2.00a5.8
    org.opencontainers.image.tool plink2
    org.opencontainers.image.title plink2

%environment
    export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
    export LANG=C
    export LC_ALL=C
    export TZ=UTC

%post
    set -eux
    umask 022
    export DEBIAN_FRONTEND=noninteractive
    sed -i 's#http://archive.ubuntu.com/ubuntu/#https://snapshot.ubuntu.com/ubuntu/20260802T000000Z/#g; s#http://security.ubuntu.com/ubuntu/#https://snapshot.ubuntu.com/ubuntu/20260802T000000Z/#g' /etc/apt/sources.list.d/ubuntu.sources
    apt-get -o Acquire::https::Verify-Peer=false -o Acquire::Check-Valid-Until=false update
    apt-get -o Acquire::https::Verify-Peer=false install -y --no-install-recommends ca-certificates
    apt-get -o Acquire::Check-Valid-Until=false update
    apt-get install -y --no-install-recommends plink2=2.00~a5.8-231123+dfsg-1
    dpkg-query --show --showformat='${Version}\n' plink2 | grep -Fx '2.00~a5.8-231123+dfsg-1'
    plink2 --version 2>&1 | grep -F 'PLINK v2.00a5.8'
    plink2 --help >/dev/null
    apt-get clean
    rm -rf /var/lib/apt/lists/*

%runscript
    exec /usr/bin/plink2 "$@"

%test
    dpkg-query --show --showformat='${Version}\n' plink2 | grep -Fx '2.00~a5.8-231123+dfsg-1'
    plink2 --version 2>&1 | grep -F 'PLINK v2.00a5.8'
    plink2 --help >/dev/null

%help
    PLINK 2.00a5.8 installed from the exact package in the locked Ubuntu snapshot.
