# Tool ID: ngsbriggs
# Version policy: verified upstream commit archive
# Upstream source: https://github.com/RAHenriksen/ngsBriggs
# Build date policy: captured by immutable build evidence
# Network source policy: build-only access to the locked Ubuntu snapshot and source archive
# Runtime UID policy: non-root runtime with caller-owned output paths
# VERSION_SOURCE: containers/contracts/catalog.toml

Bootstrap: docker
From: ubuntu@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b

%labels
    org.opencontainers.image.source https://github.com/RAHenriksen/ngsBriggs
    org.opencontainers.image.title ngsBriggs
    org.opencontainers.image.revision ab3b5ae8a388b9b1874dd2854fdec32bd9195f22
    org.opencontainers.image.created governed-by-build-evidence
    org.opencontainers.image.licenses NOASSERTION
    org.opencontainers.image.version 0.01
    org.opencontainers.image.tool ngsbriggs

%environment
    export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
    export LC_ALL=C
    export TZ=UTC

%files
    containers/tools/ngsbriggs/ngsbriggs /usr/local/bin/ngsbriggs

%post
    set -eux
    umask 022
    export DEBIAN_FRONTEND=noninteractive
    sed -i 's#http://archive.ubuntu.com/ubuntu/#https://snapshot.ubuntu.com/ubuntu/20260802T000000Z/#g; s#http://security.ubuntu.com/ubuntu/#https://snapshot.ubuntu.com/ubuntu/20260802T000000Z/#g' /etc/apt/sources.list.d/ubuntu.sources
    apt-get -o Acquire::https::Verify-Peer=false -o Acquire::Check-Valid-Until=false update
    apt-get -o Acquire::https::Verify-Peer=false install -y --no-install-recommends ca-certificates
    apt-get -o Acquire::Check-Valid-Until=false update
    apt-get install -y --no-install-recommends build-essential curl libbz2-dev libcurl4-gnutls-dev libeigen3-dev libhts-dev liblzma-dev libssl-dev zlib1g-dev
    curl --fail --location --silent --show-error --output /opt/ngsBriggs.tar.gz https://github.com/RAHenriksen/ngsBriggs/archive/ab3b5ae8a388b9b1874dd2854fdec32bd9195f22.tar.gz
    echo 'afa0d40a8ab85074363cbb6415461504888bb707f04a40ee31b4f632ce629cf7  /opt/ngsBriggs.tar.gz' | sha256sum --check --strict
    mkdir /opt/ngsBriggs
    tar --extract --gzip --file /opt/ngsBriggs.tar.gz --directory /opt/ngsBriggs --strip-components 1
    CPATH=/usr/include/eigen3 make -C /opt/ngsBriggs HTSSRC=systemwide
    install -m 0755 /opt/ngsBriggs/ngsbriggs /usr/local/libexec/ngsbriggs
    chmod 0755 /usr/local/bin/ngsbriggs
    ngsbriggs --version | grep -Fx 'ngsbriggs 0.01 (commit ab3b5ae8a388b9b1874dd2854fdec32bd9195f22)'
    rm -rf /opt/ngsBriggs /opt/ngsBriggs.tar.gz
    rm -rf /var/lib/apt/lists/*

%runscript
    exec ngsbriggs "$@"

%test
    ngsbriggs --version | grep -Fx 'ngsbriggs 0.01 (commit ab3b5ae8a388b9b1874dd2854fdec32bd9195f22)'
    ngsbriggs --help 2>&1 | grep -F './ngsBriggs -bam -tab -ref'

%help
    ngsBriggs compiled from the checksum-verified upstream commit archive.
