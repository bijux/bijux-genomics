# Bijux Genomics source code is licensed under Apache-2.0.
# Copyright (C) 2026 Bijan Mousavi
# Tool ID: fastqc
# Version policy: exact upstream distribution with a governed SHA-256 digest
# Upstream source: https://github.com/s-andrews/FastQC/tree/v0.12.1
# Build date policy: captured by immutable build evidence
# Network source policy: build-only access to the locked Ubuntu snapshot and distribution archive
# Runtime UID policy: non-root runtime with caller-owned output paths
# VERSION_SOURCE: containers/contracts/catalog.toml
Bootstrap: docker
From: ubuntu@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b

%labels
    org.opencontainers.image.source https://github.com/s-andrews/FastQC
    org.opencontainers.image.revision e7ef390bf10382f60786bdd0cf28abd4f8683ffd
    org.opencontainers.image.created governed-by-build-evidence
    org.opencontainers.image.licenses GPL-3.0-only
    org.opencontainers.image.version 0.12.1
    io.bijux.tool.version 0.12.1
    org.opencontainers.image.tool fastqc
    org.opencontainers.image.title FastQC

%environment
    export PATH=/usr/local/bin:/usr/bin:/bin
    export LANG=C
    export LC_ALL=C
    export TZ=UTC

%files
    containers/contracts/configure-apt-snapshot /usr/local/sbin/bijux-configure-apt-snapshot
    containers/tools/fastqc/fastqc /usr/local/bin/fastqc

%post
    set -eux
    umask 022
    export DEBIAN_FRONTEND=noninteractive
    /bin/sh /usr/local/sbin/bijux-configure-apt-snapshot
    apt-get install -y --no-install-recommends ca-certificates
    apt-get -o Acquire::Check-Valid-Until=false update
    apt-get install -y --no-install-recommends default-jre-headless fontconfig fonts-dejavu-core libharfbuzz0b perl
    apt-get install -y --no-install-recommends curl unzip
    curl --fail --location --proto '=https' --tlsv1.2 --output /opt/fastqc.zip https://www.bioinformatics.babraham.ac.uk/projects/fastqc/fastqc_v0.12.1.zip
    echo '5f4dba8780231a25a6b8e11ab2c238601920c9704caa5458d9de559575d58aa7  /opt/fastqc.zip' | sha256sum --check --strict
    unzip -q /opt/fastqc.zip -d /opt
    chmod 0755 /opt/FastQC/fastqc /usr/local/bin/fastqc
    fastqc --version | grep -Fx 'FastQC v0.12.1'
    fastqc --help >/dev/null
    rm -f /opt/fastqc.zip
    apt-get purge -y --auto-remove curl unzip
    apt-get clean
    rm -rf /var/lib/apt/lists/*

%runscript
    exec /usr/local/bin/fastqc "$@"

%test
    fastqc --version | grep -Fx 'FastQC v0.12.1'
    fastqc --help >/dev/null
    test -x /opt/FastQC/fastqc

%help
    FastQC 0.12.1 installed from the exact checksummed upstream distribution.
