# BIJUX_TEMPLATE: v1

# Tool ID: pydamage
# Version policy: pinned_or_registry_locked
# Upstream source: see org.opencontainers.image.source label
# Build date policy: org.opencontainers.image.created set by release pipeline
# Network source policy: NETWORK_SOURCE_VERIFIED_BY_LOCK
# Runtime UID policy: RUNTIME_UID_SAFE

# VERSION_SOURCE: containers/versions/versions.toml
Bootstrap: docker
From: ubuntu@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b

%labels
    VERSION pydamage-1.0
    org.opencontainers.image.source https://github.com/bijux/bijux-genomics
    org.opencontainers.image.revision unknown
    org.opencontainers.image.created unknown
    org.opencontainers.image.licenses GPL-3.0
    org.opencontainers.image.version 1.0
    org.opencontainers.image.tool pydamage
    org.opencontainers.image.title pydamage

%environment
    export PATH=/opt/pydamage-venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
    export LC_ALL=C
    export TZ=UTC
    DEBIAN_FRONTEND=noninteractive

%post
    set -eux
    umask 022
    export DEBIAN_FRONTEND=noninteractive
    apt-get update -qq && apt-get install -y --no-install-recommends \
        python3 python3-pip python3-venv ca-certificates && \
        rm -rf /var/lib/apt/lists/*

    python3 -c 'import urllib.request; urllib.request.urlretrieve("https://github.com/maxibor/pydamage/archive/08f1d0f2d1981d350decbf10964f989e9567ddbf.tar.gz", "/tmp/pydamage.tar.gz")'
    echo 'f049fad925e8418f5ba31e78429fde6cc62ad0ccb9a6ff0a8b739ba894d15d9f  /tmp/pydamage.tar.gz' | sha256sum -c -
    mkdir -p /opt/pydamage
    tar -xzf /tmp/pydamage.tar.gz --strip-components=1 -C /opt/pydamage
    cd /opt/pydamage
    python3 -m venv /opt/pydamage-venv
    /opt/pydamage-venv/bin/pip install --no-cache-dir --upgrade pip setuptools wheel
    /opt/pydamage-venv/bin/pip install --no-cache-dir .
    rm -f /tmp/pydamage.tar.gz
%runscript
    exec /usr/local/bin/pydamage "$@"

%help
    This image provides pyDamage 1.0 from immutable upstream commit
    08f1d0f2d1981d350decbf10964f989e9567ddbf.
