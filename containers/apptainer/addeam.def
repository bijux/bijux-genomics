# Bijux Genomics source code is licensed under Apache-2.0.
# Copyright (C) 2026 Bijan Mousavi
# Tool ID: addeam
# Version policy: immutable source graph and hashed Python lock
# Upstream source: https://github.com/LouisPwr/AdDeam
# Build date policy: captured by immutable build evidence
# Network source policy: build-only access to locked snapshots and source archives
# NETWORK_SOURCE_VERIFIED_BY_LOCK
# Runtime UID policy: non-root runtime with caller-owned output paths
# VERSION_SOURCE: containers/contracts/catalog.toml

Bootstrap: docker
From: ubuntu@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b

%labels
    org.opencontainers.image.source https://github.com/LouisPwr/AdDeam
    org.opencontainers.image.revision 8122b9a99d560ef8ea8abdd5b1aacccd00ea0cdd
    org.opencontainers.image.created governed-by-build-evidence
    org.opencontainers.image.licenses GPL-3.0-only
    org.opencontainers.image.version 1.0.0
    org.opencontainers.image.tool addeam
    org.opencontainers.image.title AdDeam

%files
    containers/contracts/configure-apt-snapshot /usr/local/sbin/bijux-configure-apt-snapshot
    containers/tools/addeam/requirements.lock /opt/addeam-build/requirements.lock
    containers/tools/addeam/bam2prof-offline-build.patch /opt/addeam-build/bam2prof-offline-build.patch
    containers/tools/addeam/profile-execution.patch /opt/addeam-build/profile-execution.patch
    containers/tools/addeam/install /opt/addeam-build/install
    containers/tools/addeam/addeam /usr/local/bin/addeam

%environment
    export PATH=/opt/addeam-venv/bin:/usr/local/bin:/usr/bin:/bin
    export LANG=C
    export LC_ALL=C
    export TZ=UTC
    export PYTHONNOUSERSITE=1

%post
    set -eux
    umask 022
    export DEBIAN_FRONTEND=noninteractive
    /bin/sh /usr/local/sbin/bijux-configure-apt-snapshot
    apt-get install -y --no-install-recommends ca-certificates
    apt-get -o Acquire::Check-Valid-Until=false update
    apt-get install -y --no-install-recommends build-essential curl libbz2-dev libcurl4-openssl-dev libgsl-dev liblzma-dev libncurses-dev libssl-dev patch python3 python3-pip python3-venv zlib1g-dev
    /opt/addeam-build/install
    rm -rf /var/lib/apt/lists/*

%runscript
    exec /usr/local/bin/addeam "$@"

%test
    addeam --version | grep -Fx 'AdDeam 1.0.0'
    addeam --help >/dev/null
    if addeam --governed-invalid-command >/dev/null 2>&1; then exit 1; fi

%help
    AdDeam 1.0.0 with its exact native source graph and hashed Python dependencies.
