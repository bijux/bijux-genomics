# Tool ID: sortmerna
# Version policy: exact official amd64 release artifact with a governed SHA-256 digest
# Upstream source: https://github.com/sortmerna/sortmerna/releases/tag/v4.3.7
# Build date policy: captured by immutable build evidence
# Network source policy: build-only access to the locked Ubuntu snapshot and release artifact
# Runtime UID policy: non-root runtime with caller-owned output paths
# VERSION_SOURCE: containers/contracts/catalog.toml

Bootstrap: docker
From: ubuntu@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b

%labels
    org.opencontainers.image.source https://github.com/sortmerna/sortmerna
    org.opencontainers.image.title SortMeRNA
    org.opencontainers.image.revision 307e84021ab3561c38fbee2854bef3eba8e6cfda
    org.opencontainers.image.created governed-by-build-evidence
    org.opencontainers.image.licenses GPL-3.0
    org.opencontainers.image.version 4.3.7
    io.bijux.tool.version 4.3.7
    org.opencontainers.image.tool sortmerna

%environment
    export PATH=/usr/local/bin:/usr/bin:/bin
    export LANG=C
    export LC_ALL=C
    export TZ=UTC

%files
    containers/contracts/configure-apt-snapshot /usr/local/sbin/bijux-configure-apt-snapshot

%post
    set -eux
    umask 022
    export DEBIAN_FRONTEND=noninteractive
    /bin/sh /usr/local/sbin/bijux-configure-apt-snapshot
    apt-get install -y --no-install-recommends ca-certificates
    apt-get -o Acquire::Check-Valid-Until=false update
    apt-get install -y --no-install-recommends curl libstdc++6
    curl --fail --location --proto '=https' --tlsv1.2 \
        --output /tmp/sortmerna.tar.gz \
        https://github.com/sortmerna/sortmerna/releases/download/v4.3.7/sortmerna-4.3.7-Linux.tar.gz
    echo '1add6d30e2ce3cffd8bc022e5cf359882aa50dcae647bfaef3937132e46a0ab3  /tmp/sortmerna.tar.gz' \
        | sha256sum --check --strict
    tar --extract --gzip --file /tmp/sortmerna.tar.gz --directory /opt
    install -m 0755 /opt/sortmerna-4.3.7-Linux/bin/sortmerna /usr/local/bin/sortmerna
    sortmerna --version 2>&1 | grep -Fx 'SortMeRNA version 4.3.7'
    sortmerna -h 2>&1 | grep -F 'SortMeRNA'
    rm -rf /opt/sortmerna-4.3.7-Linux /tmp/sortmerna.tar.gz
    apt-get purge -y --auto-remove curl
    apt-get clean
    rm -rf /var/lib/apt/lists/*

%runscript
    exec sortmerna "$@"

%test
    sortmerna --version 2>&1 | grep -Fx 'SortMeRNA version 4.3.7'
    sortmerna -h 2>&1 | grep -F 'SortMeRNA'

%help
    SortMeRNA 4.3.7 from the exact checksummed official amd64 release artifact.
    The image exposes the authentic upstream executable without a version or help wrapper.
