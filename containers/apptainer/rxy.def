# This container recipe is maintained by Bijux Genomics.
# Bijux Genomics source code is licensed under Apache-2.0.
# Copyright (C) 2026 Bijan Mousavi
# Tool ID: rxy
# Version policy: repository source locked by SHA-256
# Upstream source: repository-owned implementation in containers/tools/rxy
# Scientific method: https://doi.org/10.1016/j.jas.2013.07.004
# Build date policy: captured by immutable build evidence
# Network source policy: build-only access to the locked Ubuntu snapshot
# Runtime UID policy: non-root runtime with caller-owned output paths
# VERSION_SOURCE: containers/contracts/catalog.toml

Bootstrap: docker
From: ubuntu@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b

%labels
    org.opencontainers.image.source https://github.com/bijux/bijux-genomics
    org.opencontainers.image.revision governed-by-build-evidence
    org.opencontainers.image.created governed-by-build-evidence
    org.opencontainers.image.licenses Apache-2.0
    org.opencontainers.image.version 1.0.0
    org.opencontainers.image.tool rxy
    org.opencontainers.image.title rxy

%files
    containers/tools/rxy/rxy /usr/local/bin/rxy

%environment
    export PATH=/usr/local/bin:/usr/bin:/bin
    export LANG=C
    export LC_ALL=C
    export TZ=UTC

%post
    set -eux
    umask 022
    export DEBIAN_FRONTEND=noninteractive
    sed -i 's#http://archive.ubuntu.com/ubuntu/#https://snapshot.ubuntu.com/ubuntu/20260802T000000Z/#g; s#http://security.ubuntu.com/ubuntu/#https://snapshot.ubuntu.com/ubuntu/20260802T000000Z/#g' /etc/apt/sources.list.d/ubuntu.sources
    apt-get -o Acquire::https::Verify-Peer=false -o Acquire::Check-Valid-Until=false update
    apt-get -o Acquire::https::Verify-Peer=false install -y --no-install-recommends ca-certificates
    apt-get -o Acquire::Check-Valid-Until=false update
    apt-get install -y --no-install-recommends python3 samtools=1.19.2-1build2
    chmod 0755 /usr/local/bin/rxy
    test "$(sha256sum /usr/local/bin/rxy | cut -d ' ' -f 1)" = 1331672e8a982637a83f060bc7c834501cf7e1ed86cad484d4f0a4777964ca38
    rxy --version | grep -F 'rxy 1.0.0'
    rm -rf /var/lib/apt/lists/*

%runscript
    exec /usr/local/bin/rxy "$@"

%test
    rxy --version | grep -F 'rxy 1.0.0'
    rxy --help >/dev/null

%help
    Bijux Genomics R_y chromosomal-sex inference with explicit contig controls.
