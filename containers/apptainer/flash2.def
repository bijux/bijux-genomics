# Tool ID: flash2
# Version policy: exact upstream commit archive with a governed SHA-256 digest
# Upstream source: https://github.com/dstreett/FLASH2/tree/2.2.00
# Build date policy: captured by immutable build evidence
# Network source policy: build-only access to the locked Ubuntu snapshot and source archive
# Runtime UID policy: non-root runtime with caller-owned output paths
# VERSION_SOURCE: containers/contracts/catalog.toml
Bootstrap: docker
From: ubuntu@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b

%labels
    org.opencontainers.image.source https://github.com/dstreett/FLASH2
    org.opencontainers.image.revision 64826f4574b11b3c0ae7460826f30be16f49c3ea
    org.opencontainers.image.created governed-by-build-evidence
    org.opencontainers.image.licenses GPL-3.0-or-later
    org.opencontainers.image.version 2.2.00
    io.bijux.tool.version 2.2.00
    org.opencontainers.image.tool flash2
    org.opencontainers.image.title FLASH2

%environment
    export PATH=/usr/local/bin:/usr/bin:/bin
    export LANG=C
    export LC_ALL=C
    export TZ=UTC

%files
    containers/contracts/configure-apt-snapshot /usr/local/sbin/bijux-configure-apt-snapshot
    containers/tools/flash2/flash2 /usr/local/bin/flash2

%post
    set -eux
    umask 022
    export DEBIAN_FRONTEND=noninteractive
    /bin/sh /usr/local/sbin/bijux-configure-apt-snapshot
    apt-get install -y --no-install-recommends ca-certificates
    apt-get -o Acquire::Check-Valid-Until=false update
    apt-get install -y --no-install-recommends zlib1g
    apt-get install -y --no-install-recommends curl gcc make zlib1g-dev
    curl --fail --location --proto '=https' --tlsv1.2 --output /opt/flash2.tar.gz https://codeload.github.com/dstreett/FLASH2/tar.gz/64826f4574b11b3c0ae7460826f30be16f49c3ea
    echo 'da5aa6c5791c69cf254f8d9b817392be79a74d6c3384fbcf6c32fcd392b76ae8  /opt/flash2.tar.gz' | sha256sum --check --strict
    tar --extract --gzip --file /opt/flash2.tar.gz --directory /opt
    make --directory /opt/FLASH2-64826f4574b11b3c0ae7460826f30be16f49c3ea -j2
    install -d -m 0755 /opt/flash2/bin
    install -m 0755 /opt/FLASH2-64826f4574b11b3c0ae7460826f30be16f49c3ea/flash2 /opt/flash2/bin/flash2-native
    chmod 0755 /usr/local/bin/flash2
    flash2 --version | grep -Fx 'flash2 2.2.00'
    flash2 --help >/dev/null
    rm -rf /opt/flash2.tar.gz /opt/FLASH2-64826f4574b11b3c0ae7460826f30be16f49c3ea
    apt-get clean
    rm -rf /var/lib/apt/lists/*

%runscript
    exec /usr/local/bin/flash2 "$@"

%test
    flash2 --version | grep -Fx 'flash2 2.2.00'
    flash2 --help >/dev/null
    test -x /opt/flash2/bin/flash2-native

%help
    FLASH2 2.2.00 built from the exact checksummed upstream commit archive.
