# BIJUX_TEMPLATE: v1

# Tool ID: metaphlan
# Version policy: pinned_or_registry_locked
# Upstream source: see org.opencontainers.image.source label
# Build date policy: captured by immutable build evidence
# Network source policy: NETWORK_SOURCE_VERIFIED_BY_LOCK
# Runtime UID policy: RUNTIME_UID_SAFE

# VERSION_SOURCE: containers/versions/versions.toml
Bootstrap: docker
From: ubuntu@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b

%labels
    MAINTAINER Bijan Mousavi <bijan@bijux.io>
    VERSION MetaPhlAn-v4.1.1
    org.opencontainers.image.source https://github.com/biobakery/MetaPhlAn

    org.opencontainers.image.revision 66d5a7ebd21c64c5b6fd6db6a35ff44b820dfbd2
    org.opencontainers.image.created governed-by-build-evidence
    org.opencontainers.image.licenses GPL-3.0
    org.opencontainers.image.version 4.1.1
    io.bijux.tool.version 4.1.1
    org.opencontainers.image.tool metaphlan
    org.opencontainers.image.title metaphlan
%environment
    export PATH=/opt/metaphlan-venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
    export LC_ALL=C
    export TZ=UTC
    DEBIAN_FRONTEND=noninteractive

%post
    set -eux
    umask 022
    export DEBIAN_FRONTEND=noninteractive

    apt-get update && \
    apt-get install -y --no-install-recommends \
        python3 \
        python3-venv \
        python3-dev \
        build-essential \
        pkg-config \
        libbz2-dev \
        liblzma-dev \
        libcurl4-gnutls-dev \
        libssl-dev \
        zlib1g-dev \
        libhdf5-dev && \

    python3 -m venv /opt/metaphlan-venv && \
    /opt/metaphlan-venv/bin/pip install --no-cache-dir \
        metaphlan==4.1.1 && \
    ln -s /opt/metaphlan-venv/bin/metaphlan /usr/local/bin/metaphlan && \
    metaphlan --version > /tmp/metaphlan.version && \
    grep -F 'MetaPhlAn version 4.1.1' /tmp/metaphlan.version && \
    metaphlan --help > /tmp/metaphlan.help && \
    grep -Fq 'usage: metaphlan' /tmp/metaphlan.help && \
    rm -f /tmp/metaphlan.version /tmp/metaphlan.help && \
    rm -rf /var/lib/apt/lists/*
%runscript
    if [ $# -eq 0 ]; then
        exec /usr/local/bin/metaphlan --help
    else
        exec /usr/local/bin/metaphlan "$@"
    fi

%test
    metaphlan --version > /tmp/metaphlan.version
    grep -F 'MetaPhlAn version 4.1.1' /tmp/metaphlan.version
    metaphlan --help > /tmp/metaphlan.help
    grep -Fq 'usage: metaphlan' /tmp/metaphlan.help
    rm -f /tmp/metaphlan.version /tmp/metaphlan.help

%help
    This Apptainer image provides MetaPhlAn version 4.1.1, installed via pip.
    The default command is the upstream `metaphlan` executable.
    Run without arguments to display help.
