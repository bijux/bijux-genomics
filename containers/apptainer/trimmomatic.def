# Tool ID: trimmomatic
# Version policy: exact checksummed upstream release archive
# Upstream source: https://github.com/usadellab/Trimmomatic/releases/tag/v0.39
# Build date policy: captured by immutable build evidence
# Network source policy: build-only access to locked snapshots and release archive
# Runtime UID policy: caller identity with caller-owned output paths
# VERSION_SOURCE: containers/contracts/catalog.toml
Bootstrap: docker
From: ubuntu@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b

%labels
    org.opencontainers.image.source https://github.com/usadellab/Trimmomatic
    org.opencontainers.image.revision e77bb89c70f60cb139393a22e89af47c5c1c69e8
    org.opencontainers.image.created governed-by-build-evidence
    org.opencontainers.image.licenses GPL-3.0-only
    org.opencontainers.image.version 0.39
    io.bijux.tool.version 0.39
    org.opencontainers.image.tool trimmomatic
    org.opencontainers.image.title Trimmomatic

%environment
    export PATH=/usr/local/bin:/usr/bin:/bin
    export LANG=C
    export LC_ALL=C
    export TZ=UTC
    export TRIMMOMATIC_ROOT=/opt/trimmomatic

%files
    containers/contracts/configure-apt-snapshot /usr/local/sbin/bijux-configure-apt-snapshot
    containers/tools/trimmomatic/trimmomatic /usr/local/bin/trimmomatic

%post
    set -eux
    umask 022
    export DEBIAN_FRONTEND=noninteractive
    /bin/sh /usr/local/sbin/bijux-configure-apt-snapshot
    apt-get install -y --no-install-recommends \
        ca-certificates curl openjdk-11-jre-headless unzip
    curl --fail --location --proto '=https' --tlsv1.2 \
        --output /opt/trimmomatic.zip \
        https://github.com/usadellab/Trimmomatic/releases/download/v0.39/Trimmomatic-0.39.zip
    echo '2f7a5de11416899e5b38d3131019bc655946f770f9b7df5355d6a36acbcc488c  /opt/trimmomatic.zip' \
        | sha256sum --check --strict
    unzip -q /opt/trimmomatic.zip -d /opt
    mv /opt/Trimmomatic-0.39 /opt/trimmomatic
    test -f /opt/trimmomatic/trimmomatic-0.39.jar
    test -f /opt/trimmomatic/adapters/TruSeq3-PE.fa
    rm -f /opt/trimmomatic.zip
    apt-get purge -y --auto-remove curl unzip
    apt-get clean
    rm -rf /var/lib/apt/lists/*
    chmod 0555 /usr/local/bin/trimmomatic
    trimmomatic --version | grep -Fx '0.39'
    trimmomatic --help >/dev/null

%runscript
    exec /usr/local/bin/trimmomatic "$@"

%test
    trimmomatic --version | grep -Fx '0.39'
    trimmomatic --help >/dev/null
    test -f /opt/trimmomatic/trimmomatic-0.39.jar
    test -f /opt/trimmomatic/adapters/TruSeq3-PE.fa

%help
    Trimmomatic 0.39 for adapter clipping and quality trimming of FASTQ reads.
    Bundled adapter FASTA files are available under /opt/trimmomatic/adapters.
