# Tool ID: seqprep
# Version policy: exact upstream tag archive with a governed SHA-256 digest
# Upstream source: https://github.com/jstjohn/SeqPrep/tree/v1.3.2
# Build date policy: captured by immutable build evidence
# Network source policy: build-only access to the locked Ubuntu snapshot and source archive
# Runtime UID policy: non-root runtime with caller-owned output paths
# VERSION_SOURCE: containers/contracts/catalog.toml
Bootstrap: docker
From: ubuntu@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b

%labels
    org.opencontainers.image.source https://github.com/jstjohn/SeqPrep
    org.opencontainers.image.revision 575507b0b9c94701bdf67bb592da8ba91ba9639c
    org.opencontainers.image.created governed-by-build-evidence
    org.opencontainers.image.licenses MIT
    org.opencontainers.image.version 1.3.2
    org.opencontainers.image.tool seqprep
    org.opencontainers.image.title SeqPrep

%environment
    export PATH=/usr/local/bin:/usr/bin:/bin
    export LANG=C
    export LC_ALL=C
    export TZ=UTC

%files
    containers/contracts/configure-apt-snapshot /usr/local/sbin/bijux-configure-apt-snapshot
    containers/tools/seqprep/seqprep /usr/local/bin/seqprep

%post
    set -eux
    umask 022
    export DEBIAN_FRONTEND=noninteractive
    /bin/sh /usr/local/sbin/bijux-configure-apt-snapshot
    apt-get install -y --no-install-recommends ca-certificates
    apt-get -o Acquire::Check-Valid-Until=false update
    apt-get install -y --no-install-recommends zlib1g
    apt-get install -y --no-install-recommends curl gcc make zlib1g-dev
    curl --fail --location --proto '=https' --tlsv1.2 --output /opt/seqprep.tar.gz https://codeload.github.com/jstjohn/SeqPrep/tar.gz/575507b0b9c94701bdf67bb592da8ba91ba9639c
    echo 'f45d466650f40b66a83f6ccaa8dbfee104d142ca2cc69c5014b14a92c7b76cb8  /opt/seqprep.tar.gz' | sha256sum --check --strict
    tar --extract --gzip --file /opt/seqprep.tar.gz --directory /opt
    make --directory /opt/SeqPrep-575507b0b9c94701bdf67bb592da8ba91ba9639c -j2
    install -d -m 0755 /opt/seqprep/bin
    install -m 0755 /opt/SeqPrep-575507b0b9c94701bdf67bb592da8ba91ba9639c/SeqPrep /opt/seqprep/bin/seqprep-native
    chmod 0755 /usr/local/bin/seqprep
    seqprep --version | grep -Fx 'seqprep 1.3.2'
    seqprep --help >/dev/null
    rm -rf /opt/seqprep.tar.gz /opt/SeqPrep-575507b0b9c94701bdf67bb592da8ba91ba9639c
    apt-get purge -y --auto-remove curl gcc make zlib1g-dev
    apt-get clean
    rm -rf /var/lib/apt/lists/*

%runscript
    exec /usr/local/bin/seqprep "$@"

%test
    seqprep --version | grep -Fx 'seqprep 1.3.2'
    seqprep --help >/dev/null
    test -x /opt/seqprep/bin/seqprep-native

%help
    SeqPrep 1.3.2 built from the exact checksummed upstream tag archive.
