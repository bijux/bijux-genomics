# BIJUX_TEMPLATE: v1

# Tool ID: seqfu
# Version policy: verified upstream source and Bioconda runtime archive
# Upstream source: https://github.com/telatin/seqfu2
# Build date policy: captured by immutable build evidence
# Network source policy: build-only access to the locked Ubuntu snapshot and package archive
# Runtime UID policy: non-root runtime with caller-owned output paths
# VERSION_SOURCE: containers/contracts/catalog.toml
Bootstrap: docker
From: ubuntu@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b

%labels
    org.opencontainers.image.source https://github.com/telatin/seqfu2
    org.opencontainers.image.title SeqFu
    org.opencontainers.image.revision 681a8fe013f8bed1590ff68e2f62820d2d4303c5
    org.opencontainers.image.created governed-by-build-evidence
    org.opencontainers.image.licenses GPL-3.0-only
    org.opencontainers.image.version 1.26.0
    org.opencontainers.image.tool seqfu
%environment
    export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
    export LC_ALL=C
    export TZ=UTC
%post
    set -eux
    umask 022
    export DEBIAN_FRONTEND=noninteractive
    sed -i 's#http://archive.ubuntu.com/ubuntu/#https://snapshot.ubuntu.com/ubuntu/20260802T000000Z/#g; s#http://security.ubuntu.com/ubuntu/#https://snapshot.ubuntu.com/ubuntu/20260802T000000Z/#g' /etc/apt/sources.list.d/ubuntu.sources
    apt-get -o Acquire::https::Verify-Peer=false -o Acquire::Check-Valid-Until=false update
    apt-get -o Acquire::https::Verify-Peer=false install -y --no-install-recommends ca-certificates
    apt-get -o Acquire::Check-Valid-Until=false update
    apt-get install -y --no-install-recommends bzip2 curl unzip zstd zlib1g
    curl --fail --location --silent --show-error --output /opt/pcre.tar.bz2 https://api.anaconda.org/download/conda-forge/pcre/8.45/linux-64/pcre-8.45-h9c3ff4c_0.tar.bz2
    echo '8f35c244b1631a4f31fb1d66ab6e1d9bfac0ca9b679deced1112c7225b3ad138  /opt/pcre.tar.bz2' | sha256sum --check --strict
    tar --extract --bzip2 --file /opt/pcre.tar.bz2 --directory /usr/local
    curl --fail --location --silent --show-error --output /opt/seqfu.conda https://api.anaconda.org/download/bioconda/seqfu/1.26.0/linux-64/seqfu-1.26.0-h41da26b_0.conda
    echo 'e215acc98bd5f0e1d637b9931c9929b565b30688be714b4dc421fe61bf9cd689  /opt/seqfu.conda' | sha256sum --check --strict
    mkdir /opt/seqfu-package
    unzip -q /opt/seqfu.conda 'pkg-*.tar.zst' -d /opt/seqfu-package
    tar --zstd --extract --file /opt/seqfu-package/pkg-seqfu-1.26.0-h41da26b_0.tar.zst --directory /usr/local
    seqfu --version | grep -Fx '1.26.0'
    rm -rf /opt/pcre.tar.bz2 /opt/seqfu.conda /opt/seqfu-package
    rm -rf /var/lib/apt/lists/*
%runscript
    exec seqfu "$@"

%test
    seqfu --version | grep -Fx '1.26.0'
    seqfu --help >/dev/null

%help
    SeqFu 1.26.0 from the checksum-verified Bioconda Linux package built from upstream source.
