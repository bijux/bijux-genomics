# Tool ID: fastq_screen
# Version policy: exact upstream commit archive with a governed SHA-256 digest
# Upstream source: https://github.com/StevenWingett/FastQ-Screen
# Build date policy: captured by immutable build evidence
# Network source policy: build-only access to the locked Ubuntu snapshot and source archive
# Runtime UID policy: caller identity with caller-owned output paths
# VERSION_SOURCE: containers/contracts/catalog.toml
Bootstrap: docker
From: ubuntu@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b

%labels
    org.opencontainers.image.source https://github.com/StevenWingett/FastQ-Screen
    org.opencontainers.image.revision 6dfa1eef0d3103dd7829eb1f586b4d8a121f911b
    org.opencontainers.image.created governed-by-build-evidence
    org.opencontainers.image.licenses GPL-3.0-or-later
    org.opencontainers.image.version 0.15.3
    io.bijux.tool.version 0.15.3
    org.opencontainers.image.tool fastq_screen
    org.opencontainers.image.title FastQ-Screen

%environment
    export PATH=/usr/local/bin:/usr/bin:/bin
    export LANG=C
    export LC_ALL=C
    export TZ=UTC

%files
    containers/contracts/configure-apt-snapshot /usr/local/sbin/bijux-configure-apt-snapshot

%post
    set -eux
    umask 022
    export DEBIAN_FRONTEND=noninteractive
    /bin/sh /usr/local/sbin/bijux-configure-apt-snapshot
    apt-get install -y --no-install-recommends bzip2 curl gzip perl
    curl --fail --location --proto '=https' --tlsv1.2 --output /opt/fastq-screen.tar.gz https://codeload.github.com/StevenWingett/FastQ-Screen/tar.gz/6dfa1eef0d3103dd7829eb1f586b4d8a121f911b
    echo '79a66b7265374c1c1b34ca166eede564bfa7ec58e17c3ba9a0e1de9bbe1c2448  /opt/fastq-screen.tar.gz' | sha256sum --check --strict
    install -d -m 0755 /opt/fastq-screen
    tar --extract --gzip --file /opt/fastq-screen.tar.gz --strip-components=1 --directory /opt/fastq-screen
    ln -s /opt/fastq-screen/fastq_screen /usr/local/bin/fastq_screen
    fastq_screen --version | grep -Fx 'FastQ Screen v0.15.3'
    fastq_screen --help >/dev/null
    rm /opt/fastq-screen.tar.gz
    apt-get clean
    rm -rf /var/lib/apt/lists/*

%runscript
    exec /usr/local/bin/fastq_screen "$@"

%test
    fastq_screen --version | grep -Fx 'FastQ Screen v0.15.3'
    fastq_screen --help >/dev/null
    test -x /opt/fastq-screen/fastq_screen

%help
    FastQ Screen 0.15.3 from the exact checksummed upstream commit archive.
    Screening additionally requires a governed aligner and reference database.
