# Bijux Genomics source code is licensed under Apache-2.0.
# Copyright (C) 2026 Bijan Mousavi
# Tool ID: schmutzi
# Version policy: exact upstream tag commit and checksummed source archives
# Upstream source: https://github.com/grenaud/schmutzi/tree/v1.5.4
# Build date policy: captured by immutable build evidence
# Network source policy: build-only access to locked snapshots and source archives
# Runtime UID policy: caller identity with caller-owned output paths
# VERSION_SOURCE: containers/contracts/catalog.toml
Bootstrap: docker
From: ubuntu@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b

%labels
    org.opencontainers.image.source https://github.com/grenaud/schmutzi
    org.opencontainers.image.revision a42e6a90b2cb6ee395f17c87ceeb76bde5127017
    org.opencontainers.image.created governed-by-build-evidence
    org.opencontainers.image.licenses GPL-3.0
    org.opencontainers.image.version 1.5.4
    org.opencontainers.image.tool schmutzi
    org.opencontainers.image.title Schmutzi

%environment
    export PATH=/opt/schmutzi:/usr/local/bin:/usr/bin:/bin
    export LANG=C
    export LC_ALL=C
    export TZ=UTC

%files
    containers/contracts/configure-apt-snapshot /usr/local/sbin/bijux-configure-apt-snapshot
    containers/tools/schmutzi/bamtools-gcc13.patch /opt/bamtools-gcc13.patch
    containers/tools/schmutzi/schmutzi /usr/local/bin/schmutzi

%post
    set -eux
    umask 022
    export DEBIAN_FRONTEND=noninteractive
    /bin/sh /usr/local/sbin/bijux-configure-apt-snapshot
    apt-get install -y --no-install-recommends \
        ca-certificates cmake curl g++ make patch zlib1g-dev
    curl --fail --location --proto '=https' --tlsv1.2 \
        --output /opt/schmutzi.tar.gz \
        https://codeload.github.com/grenaud/schmutzi/tar.gz/a42e6a90b2cb6ee395f17c87ceeb76bde5127017
    curl --fail --location --proto '=https' --tlsv1.2 \
        --output /opt/libgab.tar.gz \
        https://codeload.github.com/grenaud/libgab/tar.gz/2789928a40469ae1e4ab3b085d8f0f250d1f6b72
    curl --fail --location --proto '=https' --tlsv1.2 \
        --output /opt/bamtools.tar.gz \
        https://codeload.github.com/pezmaster31/bamtools/tar.gz/48233a28881f887b5847a031c5febbee19fcb3ad
    printf '%s  %s\n' \
        '653daf69b241d89647e5a6273fb97c4b9366a5252e4d955651514e800082b426' /opt/schmutzi.tar.gz \
        '72c4442ffe592e0a36bdd9d6bb53962c0918a5fceea6c3b65c7cfcd0b3d45873' /opt/libgab.tar.gz \
        'aaf3f12d95813c7d5e531f824505d731864ddcb6c21ce41f64bc8d43b96ebcc2' /opt/bamtools.tar.gz \
        | sha256sum --check --strict
    mkdir -p /opt/schmutzi /opt/schmutzi/libgab /opt/schmutzi/bamtools
    tar --extract --gzip --file /opt/schmutzi.tar.gz \
        --directory /opt/schmutzi --strip-components 1
    tar --extract --gzip --file /opt/libgab.tar.gz \
        --directory /opt/schmutzi/libgab --strip-components 1
    tar --extract --gzip --file /opt/bamtools.tar.gz \
        --directory /opt/schmutzi/bamtools --strip-components 1
    patch --directory /opt/schmutzi/bamtools --strip=1 \
        < /opt/bamtools-gcc13.patch
    cmake -S /opt/schmutzi/bamtools -B /opt/schmutzi/bamtools/build \
        -DCMAKE_BUILD_TYPE=Release
    cmake --build /opt/schmutzi/bamtools/build --parallel 2
    make --directory /opt/schmutzi/libgab -j2
    make --directory /opt/schmutzi -j2
    test -x /opt/schmutzi/schmutzi.pl
    test -x /opt/schmutzi/contDeam.pl
    test -x /opt/schmutzi/endoCaller
    test -x /opt/schmutzi/mtCont
    apt-get purge -y --auto-remove cmake curl g++ make patch zlib1g-dev
    apt-get install -y --no-install-recommends \
        ca-certificates gzip libstdc++6 perl python3 r-base-core \
        r-cran-fitdistrplus r-cran-mass samtools zlib1g
    apt-get clean
    rm -f /opt/*.tar.gz
    rm -rf /var/lib/apt/lists/*
    chmod 0555 /usr/local/bin/schmutzi
    schmutzi --version | grep -Fx 'schmutzi 1.5.4'
    schmutzi --help >/dev/null

%runscript
    exec /usr/local/bin/schmutzi "$@"

%test
    schmutzi --version | grep -Fx 'schmutzi 1.5.4'
    schmutzi --help >/dev/null
    test -x /opt/schmutzi/schmutzi.pl
    test -x /opt/schmutzi/contDeam.pl
    test -x /opt/schmutzi/endoCaller
    test -x /opt/schmutzi/mtCont
    Rscript -e 'library(fitdistrplus); library(MASS)'
    samtools --version >/dev/null

%help
    Schmutzi 1.5.4 for mitochondrial contamination estimation and endogenous
    consensus reconstruction. Run `schmutzi --help` for the governed interface.
