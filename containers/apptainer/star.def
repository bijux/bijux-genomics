# Bijux Genomics source code is licensed under Apache-2.0.
# Copyright (C) 2026 Bijan Mousavi
# Tool ID: star
# Version policy: exact upstream commit archive with a governed SHA-256 digest
# Upstream source: https://github.com/alexdobin/STAR
# Build date policy: captured by immutable build evidence
# Network source policy: build-only access to the locked Ubuntu snapshot and source archive
# Runtime UID policy: caller identity with caller-owned output paths
# VERSION_SOURCE: containers/contracts/catalog.toml
Bootstrap: docker
From: ubuntu@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b

%labels
    org.opencontainers.image.source https://github.com/alexdobin/STAR
    org.opencontainers.image.revision b1edc1208d91a53bf40ebae8669f71d50b994851
    org.opencontainers.image.created governed-by-build-evidence
    org.opencontainers.image.licenses GPL-3.0
    org.opencontainers.image.version 2.7.11b
    io.bijux.tool.version 2.7.11b
    org.opencontainers.image.tool star
    org.opencontainers.image.title STAR

%environment
    export PATH=/usr/local/bin:/usr/bin:/bin
    export LANG=C
    export LC_ALL=C
    export TZ=UTC

%files
    containers/contracts/configure-apt-snapshot /usr/local/sbin/bijux-configure-apt-snapshot

%post
    set -eux
    umask 022
    export DEBIAN_FRONTEND=noninteractive
    /bin/sh /usr/local/sbin/bijux-configure-apt-snapshot
    apt-get install -y --no-install-recommends libbz2-1.0 libgomp1 zlib1g
    apt-get install -y --no-install-recommends curl g++ make xxd libbz2-dev zlib1g-dev
    curl --fail --location --proto '=https' --tlsv1.2 --output /opt/star.tar.gz https://codeload.github.com/alexdobin/STAR/tar.gz/b1edc1208d91a53bf40ebae8669f71d50b994851
    echo '65976afe9b8c5dbda05282c7c02ba27d0f908a7eb83ec12e3fca86ed5eb91cac  /opt/star.tar.gz' | sha256sum --check --strict
    tar --extract --gzip --file /opt/star.tar.gz --directory /opt
    cd /opt/STAR-b1edc1208d91a53bf40ebae8669f71d50b994851/source
    find . -name Makefile -exec sed -Ei 's/-mavx2|-msse[0-9.]*|-mfpmath=sse//g' {} \;
    architecture="$(uname -m)"
    if [ "$architecture" = aarch64 ] || [ "$architecture" = arm64 ]; then
        printf '%s\n' 'CFLAGS += -march=armv8-a' 'CXXFLAGS += -march=armv8-a' >> Makefile
    fi
    make -j2 STAR
    install -m 0755 STAR /usr/local/bin/star
    star --version | grep -Fx '2.7.11b'
    star --help >/dev/null
    cd /
    rm -rf /opt/star.tar.gz /opt/STAR-b1edc1208d91a53bf40ebae8669f71d50b994851
    apt-get clean
    rm -rf /var/lib/apt/lists/*

%runscript
    exec /usr/local/bin/star "$@"

%test
    star --version | grep -Fx '2.7.11b'
    star --help >/dev/null

%help
    STAR 2.7.11b from the exact checksummed upstream commit archive.
    Genome indexing and alignment require governed reference and read inputs.
