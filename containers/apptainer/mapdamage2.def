# Tool ID: mapdamage2
# Version policy: checksum-verified upstream release archive
# Upstream source: https://github.com/ginolhac/mapDamage
# Build date policy: captured by immutable build evidence
# Network source policy: build-only access to the locked Ubuntu snapshot and source archive
# Runtime UID policy: non-root runtime with caller-owned output paths
# VERSION_SOURCE: containers/contracts/catalog.toml
Bootstrap: docker
From: ubuntu@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b

%labels
    org.opencontainers.image.source https://github.com/ginolhac/mapDamage
    org.opencontainers.image.revision 55518aa83141d8f885ce10751c22113f674e95de
    org.opencontainers.image.created governed-by-build-evidence
    org.opencontainers.image.licenses MIT
    org.opencontainers.image.version 2.2.2
    org.opencontainers.image.tool mapdamage2
    org.opencontainers.image.title mapdamage2

%environment
    export PATH=/opt/mapdamage2-venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
    export LC_ALL=C
    export TZ=UTC

%files
    containers/tools/mapdamage2/mapdamage2 /usr/local/bin/mapdamage2
    containers/tools/mapdamage2/patches/skip-r-library-check-without-r.patch /opt/skip-r-library-check-without-r.patch

%post
    set -eux
    umask 022
    export DEBIAN_FRONTEND=noninteractive
    sed -i 's#http://archive.ubuntu.com/ubuntu/#https://snapshot.ubuntu.com/ubuntu/20260802T000000Z/#g; s#http://security.ubuntu.com/ubuntu/#https://snapshot.ubuntu.com/ubuntu/20260802T000000Z/#g' /etc/apt/sources.list.d/ubuntu.sources
    apt-get -o Acquire::https::Verify-Peer=false -o Acquire::Check-Valid-Until=false update
    apt-get -o Acquire::https::Verify-Peer=false install -y --no-install-recommends ca-certificates
    apt-get -o Acquire::Check-Valid-Until=false update
    apt-get install -y --no-install-recommends build-essential curl python3 python3-dev python3-pip python3-pysam python3-setuptools python3-venv zlib1g-dev
    curl --fail --location --silent --show-error --output /opt/mapdamage2.tar.gz https://github.com/ginolhac/mapDamage/archive/55518aa83141d8f885ce10751c22113f674e95de.tar.gz
    echo 'a7dd300489674eeb72e28c5e99627f73840dd7a74c6efce76c1eaee8e7898c54  /opt/mapdamage2.tar.gz' | sha256sum --check --strict
    mkdir /opt/mapdamage2
    tar --extract --gzip --file /opt/mapdamage2.tar.gz --directory /opt/mapdamage2 --strip-components 1
    patch --directory=/opt/mapdamage2 --strip=1 --input=/opt/skip-r-library-check-without-r.patch
    python3 -m venv --system-site-packages /opt/mapdamage2-venv
    /opt/mapdamage2-venv/bin/pip install --no-cache-dir --no-build-isolation --no-deps /opt/mapdamage2
    mapdamage_package=$(/opt/mapdamage2-venv/bin/python -c 'import pathlib, mapdamage; print(pathlib.Path(mapdamage.__file__).parent)')
    install -d -m 0755 "$mapdamage_package/seqtk"
    install -m 0755 /opt/mapdamage2/mapdamage/seqtk/seqtk "$mapdamage_package/seqtk/seqtk"
    install -d -m 0755 /usr/local/libexec
    ln -s /opt/mapdamage2-venv/bin/mapDamage /usr/local/libexec/mapDamage
    chmod 0755 /usr/local/bin/mapdamage2
    mapdamage2 --version | grep -Fx 'mapdamage2 2.2.2 (commit 55518aa83141d8f885ce10751c22113f674e95de)'
    rm -rf /opt/mapdamage2 /opt/mapdamage2.tar.gz /opt/skip-r-library-check-without-r.patch
    rm -rf /var/lib/apt/lists/*
%runscript
    exec /usr/local/bin/mapdamage2 "$@"

%test
    mapdamage2 --version | grep -Fx 'mapdamage2 2.2.2 (commit 55518aa83141d8f885ce10751c22113f674e95de)'
    mapdamage2 --help >/tmp/mapdamage2-help.txt
    grep -F 'mapdamage2 analyze --bam FILE --reference FASTA --out-dir DIR' /tmp/mapdamage2-help.txt
    grep -F 'Usage: mapDamage' /tmp/mapdamage2-help.txt

%help
    mapDamage 2.2.2 built from the checksum-verified upstream release commit.
