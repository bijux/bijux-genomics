# Bijux Genomics source code is licensed under Apache-2.0.
# Copyright (C) 2026 Bijan Mousavi
# Tool ID: authenticct
# Version policy: immutable release commit, source archive, and hashed Python lock
# Upstream source: https://github.com/StephanePeyregne/AuthentiCT
# Build date policy: captured by immutable build evidence
# Network source policy: build-only access to the locked Ubuntu snapshot, source archive, and Python index
# Runtime UID policy: non-root runtime with caller-owned output paths
# VERSION_SOURCE: containers/contracts/catalog.toml

Bootstrap: docker
From: ubuntu@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b

%labels
    org.opencontainers.image.source https://github.com/StephanePeyregne/AuthentiCT
    org.opencontainers.image.revision 13ba26ef82f5a3febd74401f65fb8c1776aa16b2
    org.opencontainers.image.created governed-by-build-evidence
    org.opencontainers.image.licenses GPL-3.0-only
    org.opencontainers.image.version 1.0.0
    org.opencontainers.image.tool authenticct
    org.opencontainers.image.title AuthentiCT

%files
    containers/tools/authenticct/requirements.lock /opt/authenticct-requirements.lock
    containers/tools/authenticct/authenticct /usr/local/bin/authenticct

%environment
    export PATH=/opt/authenticct-venv/bin:/usr/local/bin:/usr/bin:/bin
    export LANG=C
    export LC_ALL=C
    export TZ=UTC
    export PYTHONNOUSERSITE=1

%post
    set -eux
    umask 022
    export DEBIAN_FRONTEND=noninteractive
    sed -i 's#http://archive.ubuntu.com/ubuntu/#https://snapshot.ubuntu.com/ubuntu/20260802T000000Z/#g; s#http://security.ubuntu.com/ubuntu/#https://snapshot.ubuntu.com/ubuntu/20260802T000000Z/#g' /etc/apt/sources.list.d/ubuntu.sources
    apt-get -o Acquire::https::Verify-Peer=false -o Acquire::Check-Valid-Until=false update
    apt-get -o Acquire::https::Verify-Peer=false install -y --no-install-recommends ca-certificates
    apt-get -o Acquire::Check-Valid-Until=false update
    apt-get install -y --no-install-recommends build-essential curl python3 python3-dev python3-pip python3-venv
    curl --fail --location --silent --show-error --output /opt/authenticct-source.tar.gz https://github.com/StephanePeyregne/AuthentiCT/archive/13ba26ef82f5a3febd74401f65fb8c1776aa16b2.tar.gz
    echo '179b79fa0e23ed18c2cc9338055a691575addc513a6e3765d912bb728c249834  /opt/authenticct-source.tar.gz' | sha256sum --check --strict
    mkdir -p /opt/authenticct-source
    tar --extract --gzip --file /opt/authenticct-source.tar.gz --directory /opt/authenticct-source --strip-components=1
    python3 -m venv /opt/authenticct-venv
    /opt/authenticct-venv/bin/pip install --no-cache-dir --require-hashes --requirement /opt/authenticct-requirements.lock
    /opt/authenticct-venv/bin/pip install --no-cache-dir --no-deps --no-build-isolation /opt/authenticct-source
    chmod 0755 /usr/local/bin/authenticct
    authenticct --version | grep -Fx 'AuthentiCT 1.0.0'
    rm -rf /opt/authenticct-source /opt/authenticct-source.tar.gz
    rm -rf /var/lib/apt/lists/*

%runscript
    exec /usr/local/bin/authenticct "$@"

%test
    authenticct --version | grep -Fx 'AuthentiCT 1.0.0'
    authenticct --help >/dev/null
    if authenticct --governed-invalid-option >/dev/null 2>&1; then exit 1; fi

%help
    AuthentiCT 1.0.0 from the immutable upstream release commit with hashed Python dependencies.
