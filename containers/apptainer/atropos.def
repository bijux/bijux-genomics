# This container recipe is maintained by Bijux Genomics.
# Bijux Genomics source code is licensed under Apache-2.0.
# Copyright (C) 2026 Bijan Mousavi
# Tool ID: atropos
# Version policy: immutable upstream commit archive and hashed Python build lock
# Upstream source: https://github.com/jdidion/atropos
# Build date policy: captured by immutable build evidence
# Network source policy: build-only access to locked snapshots, wheels, and source archive
# NETWORK_SOURCE_VERIFIED_BY_LOCK
# Runtime UID policy: non-root runtime with caller-owned output paths
# VERSION_SOURCE: containers/contracts/catalog.toml

Bootstrap: docker
From: python@sha256:e508a34e5491225a76fbb9e0f43ebde1f691c6a689d096d7510cf7fb17d4ba6f

%labels
    org.opencontainers.image.source https://github.com/jdidion/atropos
    org.opencontainers.image.revision 916a0bfbc18149bbefb83ccff9fe2a0807415807
    org.opencontainers.image.created governed-by-build-evidence
    org.opencontainers.image.licenses "MIT AND CC0-1.0"
    org.opencontainers.image.version 1.1.31
    io.bijux.tool.version 1.1.31
    org.opencontainers.image.tool atropos
    org.opencontainers.image.title Atropos

%files
    containers/contracts/configure-apt-snapshot /usr/local/sbin/bijux-configure-apt-snapshot
    containers/tools/atropos/requirements.lock /opt/atropos-build/requirements.lock
    containers/tools/atropos/python-collections-compatibility.patch /opt/atropos-build/python-collections-compatibility.patch
    containers/tools/atropos/install /opt/atropos-build/install
    containers/tools/atropos/atropos /usr/local/bin/atropos

%environment
    export PATH=/opt/atropos-venv/bin:/usr/local/bin:/usr/bin:/bin
    export LANG=C
    export LC_ALL=C
    export TZ=UTC
    export PYTHONNOUSERSITE=1

%post
    set -eux
    umask 022
    export DEBIAN_FRONTEND=noninteractive
    sed -i \
      -e 's#http://deb.debian.org/debian-security#https://snapshot.debian.org/archive/debian-security/20260802T000000Z#g' \
      -e 's#http://deb.debian.org/debian#https://snapshot.debian.org/archive/debian/20260802T000000Z#g' \
      /etc/apt/sources.list.d/debian.sources
    apt-get install -y --no-install-recommends ca-certificates
    apt-get -o Acquire::Check-Valid-Until=false update
    apt-get install -y --no-install-recommends build-essential curl patch
    /opt/atropos-build/install
    apt-get clean
    rm -rf /var/lib/apt/lists/*

%runscript
    exec /usr/local/bin/atropos "$@"

%test
    atropos --version | grep -Fx 'Atropos 1.1.31'
    atropos trim --help >/dev/null
    if atropos --governed-invalid-option >/dev/null 2>&1; then exit 1; fi

%help
    Atropos 1.1.31 built from the exact upstream commit with hashed build tooling.
