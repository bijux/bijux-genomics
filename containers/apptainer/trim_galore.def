# BIJUX_TEMPLATE: v1

# Tool ID: trim_galore
# Version policy: exact upstream commit archive with a governed SHA-256 digest
# Upstream source: https://github.com/FelixKrueger/TrimGalore
# Build date policy: captured by immutable build evidence
# Network source policy: NETWORK_SOURCE_VERIFIED_BY_LOCK
# Runtime UID policy: RUNTIME_UID_SAFE

# VERSION_SOURCE: containers/versions/versions.toml
Bootstrap: docker
From: ubuntu@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b

%labels
    org.opencontainers.image.source https://github.com/FelixKrueger/TrimGalore
    org.opencontainers.image.title Trim Galore!
    org.opencontainers.image.revision 4edff97d22f3837d42a29e4afbfaeb6e07ffb11b
    org.opencontainers.image.created governed-by-build-evidence
    org.opencontainers.image.licenses GPL-3.0
    org.opencontainers.image.version 0.6.10
    io.bijux.tool.version 0.6.10
    org.opencontainers.image.tool trim_galore
%environment
    export PATH=/opt/cutadapt-venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
    export LC_ALL=C
    export DEBIAN_FRONTEND=noninteractive
    export TZ=UTC
    export VERSION_TRIM_GALORE=0.6.10

%files
    containers/contracts/configure-apt-snapshot /usr/local/sbin/bijux-configure-apt-snapshot
    containers/tools/cutadapt/install /opt/cutadapt-build/install

%post
    set -eux
    umask 022
    export DEBIAN_FRONTEND=noninteractive

    /bin/sh /usr/local/sbin/bijux-configure-apt-snapshot
    apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        curl \
        fastqc \
        python3 \
        python3-dev \
        python3-pip \
        python3-venv \
        tar

    chmod 0755 /opt/cutadapt-build/install
    /opt/cutadapt-build/install
    ln -sf /opt/cutadapt-venv/bin/cutadapt /usr/local/bin/cutadapt

    curl --fail --location --proto '=https' --tlsv1.2 \
        --output /tmp/trim-galore.tar.gz \
        https://codeload.github.com/FelixKrueger/TrimGalore/tar.gz/4edff97d22f3837d42a29e4afbfaeb6e07ffb11b
    echo 'dc5d24ab37c3cfed8038b8c2546948e52e3e769b912ccfd5c9d28c34546f5e2c  /tmp/trim-galore.tar.gz' \
        | sha256sum --check --strict
    tar --extract --gzip --file /tmp/trim-galore.tar.gz --directory /opt
    install -m 0755 \
        /opt/TrimGalore-4edff97d22f3837d42a29e4afbfaeb6e07ffb11b/trim_galore \
        /usr/local/bin/trim_galore
    trim_galore --version 2>&1 | grep -F '0.6.10'
    trim_galore --help >/dev/null
    rm -rf /tmp/trim-galore.tar.gz \
        /opt/TrimGalore-4edff97d22f3837d42a29e4afbfaeb6e07ffb11b \
        /opt/cutadapt-build
    rm -rf /var/lib/apt/lists/*
%runscript
    if [ $# -eq 0 ]; then
        exec trim_galore --help
    else
        exec trim_galore "$@"
    fi

%help
    Trim Galore 0.6.10 from the exact checksummed upstream commit archive.
    Cutadapt 4.9 and FastQC provide the governed trimming and quality-control dependencies.

%test
    trim_galore --version 2>&1 | grep -F '0.6.10'
    trim_galore --help >/dev/null
    cutadapt --version | grep -Fx '4.9'
    fastqc --version >/dev/null
