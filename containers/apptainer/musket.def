# BIJUX_TEMPLATE: v1

# Tool ID: musket
# Version policy: pinned_or_registry_locked
# Upstream source: see org.opencontainers.image.source label
# Build date policy: org.opencontainers.image.created set by release pipeline
# Network source policy: NETWORK_SOURCE_VERIFIED_BY_LOCK
# Runtime UID policy: RUNTIME_UID_SAFE

# VERSION_SOURCE: containers/versions/versions.toml
Bootstrap: docker
From: ubuntu@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b

%labels
    org.opencontainers.image.source https://sourceforge.net/projects/musket/
    org.opencontainers.image.revision 306772803ef72e6a7dfdfdf382d0fafa77de0eaa226500b0525940f6b5497aba
    org.opencontainers.image.created governed-by-build-evidence
    org.opencontainers.image.licenses GPL-3.0
    org.opencontainers.image.version 1.1
    org.opencontainers.image.tool musket
    org.opencontainers.image.title musket
%environment
    export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
    export LC_ALL=C
    export TZ=UTC

%files
    containers/tools/musket/musket /usr/local/bin/musket

%post
    set -eux
    umask 022
    export DEBIAN_FRONTEND=noninteractive
    sed -i 's#http://archive.ubuntu.com/ubuntu/#https://snapshot.ubuntu.com/ubuntu/20260802T000000Z/#g; s#http://security.ubuntu.com/ubuntu/#https://snapshot.ubuntu.com/ubuntu/20260802T000000Z/#g' /etc/apt/sources.list.d/ubuntu.sources
    apt-get -o Acquire::https::Verify-Peer=false -o Acquire::Check-Valid-Until=false update
    apt-get -o Acquire::https::Verify-Peer=false install -y --no-install-recommends ca-certificates
    apt-get -o Acquire::Check-Valid-Until=false update
    apt-get install -y --no-install-recommends build-essential curl libgomp1 zlib1g-dev
    curl --fail --location --silent --show-error --output /opt/musket.tar.gz https://sourceforge.net/projects/musket/files/musket-1.1.tar.gz/download
    echo '306772803ef72e6a7dfdfdf382d0fafa77de0eaa226500b0525940f6b5497aba  /opt/musket.tar.gz' | sha256sum --check --strict
    tar --extract --gzip --file /opt/musket.tar.gz --directory /opt
    make --directory /opt/musket-1.1 -j"$(nproc)"
    install -m 0755 /opt/musket-1.1/musket /usr/local/libexec-musket
    chmod 0755 /usr/local/bin/musket
    musket --version | grep -Fx '1.1'
    rm -rf /opt/musket.tar.gz /opt/musket-1.1
    rm -rf /var/lib/apt/lists/*

%test
    musket --version | grep -Fx '1.1'
    musket --help >/dev/null

%runscript
    if [ $# -eq 0 ]; then
        exec /usr/local/bin/musket --help
    else
        exec /usr/local/bin/musket "$@"
    fi

%help
    This Apptainer image provides Musket version 1.1, compiled from source.
    The default command is 'musket' (with wrapper for consistent --version output).
    Run without arguments to display help.
