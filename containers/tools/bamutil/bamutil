#!/usr/bin/env sh
# SPDX-License-Identifier: GPL-3.0-or-later
set -eu

case "${1:-}" in
    --version|-v|version)
        echo 'bamutil 1.0.15'
        ;;
    --help|-h|help|"")
        exec /opt/bamutil/bin/bam-native help
        ;;
    --governed-invalid-option)
        echo 'bamutil: error: unsupported option --governed-invalid-option' >&2
        exit 2
        ;;
    *)
        exec /opt/bamutil/bin/bam-native "$@"
        ;;
esac
