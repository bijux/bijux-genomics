#!/usr/bin/env sh
set -eu

case "${1:-}" in
    --version) echo 'dada2 1.30.0' ;;
    --help|-h|"")
        printf '%s\n' \
            'usage: dada2 infer-asvs --input INPUT.fastq[.gz] --output-dir DIR [--sample-id ID] [--threads N]' \
            '' \
            'Infer single-sample ASVs and emit the governed table, representative' \
            'sequences, taxonomy-ready sequences, filtered reads, and JSON report.'
        ;;
    infer-asvs)
        shift
        exec Rscript /opt/dada2/infer-asvs.R "$@"
        ;;
    *)
        echo "dada2: unknown command: $1" >&2
        echo 'run "dada2 --help" for usage' >&2
        exit 2
        ;;
esac
