#!/usr/bin/env sh
set -eu

native_help() {
    set +e
    native_output="$(java -jar /opt/ibdne/ibdne.jar 2>&1)"
    native_status=$?
    set -e
    if [ "$native_status" -ne 1 ] || ! printf '%s\n' "$native_output" | grep -Fq 'Program: ibdne.23Apr20.ae9.jar'; then
        printf 'error: unexpected IBDNe help probe (status=%s)\n' "$native_status" >&2
        exit 70
    fi
}

case "${1:-}" in
    --version) native_help; printf 'ibdne 23Apr20.ae9\n' ;;
    --help|-h|"")
        native_help
        printf '%s\n' "$native_output"
        ;;
    *) exec java -jar /opt/ibdne/ibdne.jar "$@" ;;
esac
