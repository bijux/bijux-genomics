#!/usr/bin/env sh
# SPDX-License-Identifier: AGPL-3.0-or-later
set -eu

case "${1:-}" in
    --version)
        echo 'fastx_clipper 0.0.14'
        ;;
    --help|-h|"")
        /opt/fastx-clipper/bin/fastx-clipper-native -h 2>&1 || true
        ;;
    --governed-invalid-option)
        echo 'fastx_clipper: error: unsupported option --governed-invalid-option' >&2
        exit 2
        ;;
    *)
        exec /opt/fastx-clipper/bin/fastx-clipper-native "$@"
        ;;
esac
