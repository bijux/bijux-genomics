#!/usr/bin/env sh
set -eu

native_help() {
    set +e
    native_output="$(/usr/local/libexec-musket --help 2>&1)"
    native_status=$?
    set -e
    if [ "$native_status" -ne 1 ] || ! printf '%s\n' "$native_output" | grep -Fq 'MUSKET (version 1.1)'; then
        printf 'error: unexpected Musket help probe (status=%s)\n' "$native_status" >&2
        exit 70
    fi
}

case "${1:-}" in
    --version) native_help; printf '1.1\n' ;;
    --help|-h|"")
        native_help
        printf '%s\n' "$native_output"
        ;;
    *) exec /usr/local/libexec-musket "$@" ;;
esac
