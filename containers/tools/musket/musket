#!/usr/bin/env sh
set -eu

case "${1:-}" in
    --version) echo '1.1' ;;
    --help|-h|"")
        set +e
        /usr/local/libexec-musket --help
        status=$?
        set -e
        if [ "$status" -ne 0 ] && [ "$status" -ne 1 ]; then
            exit "$status"
        fi
        ;;
    *) exec /usr/local/libexec-musket "$@" ;;
esac
