#!/usr/bin/env sh
# SPDX-License-Identifier: MIT
set -eu

case "${1:-}" in
    --version)
        exec /opt/bedtools/bin/bedtools-native --version
        ;;
    --help|-h|"")
        exec /opt/bedtools/bin/bedtools-native --help
        ;;
    --governed-invalid-option)
        echo 'bedtools: error: unsupported option --governed-invalid-option' >&2
        exit 2
        ;;
    *)
        exec /opt/bedtools/bin/bedtools-native "$@"
        ;;
esac
