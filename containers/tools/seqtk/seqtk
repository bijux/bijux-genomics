#!/usr/bin/env sh
# SPDX-License-Identifier: MIT
set -eu

case "${1:-}" in
    --version)
        echo 'seqtk 1.4'
        ;;
    --help|-h|"")
        /opt/seqtk/bin/seqtk-native 2>&1 || true
        ;;
    --governed-invalid-option)
        echo 'seqtk: error: unsupported option --governed-invalid-option' >&2
        exit 2
        ;;
    *)
        exec /opt/seqtk/bin/seqtk-native "$@"
        ;;
esac
