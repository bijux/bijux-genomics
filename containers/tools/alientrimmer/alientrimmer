#!/usr/bin/env bash
set -euo pipefail

jar_path="/opt/AlienTrimmer-3.2/src/AlienTrimmer.jar"
java_bin="${JAVA_BIN:-java}"
java_args=(-Xms256m -Xmx256m)

run_alientrimmer() {
  "${java_bin}" "${java_args[@]}" -jar "${jar_path}" "$@"
}

native_information() {
  local native_status
  set +e
  native_output="$(run_alientrimmer 2>&1)"
  native_status=$?
  set -e
  if [[ $native_status -ne 0 ]] || ! grep -Fq 'AlienTrimmer v3.2' <<<"$native_output"; then
    printf 'error: unexpected AlienTrimmer information probe (status=%s)\n' "$native_status" >&2
    return 70
  fi
}

emit_version() {
  native_information
  printf '3.2\n'
}

emit_help() {
  native_information
  printf '%s\n' "$native_output"
}

move_output() {
  local source="$1"
  local destination="$2"
  if [[ -z "${destination}" ]]; then
    return 0
  fi
  if [[ ! -f "${source}" ]]; then
    printf 'missing AlienTrimmer output: %s\n' "${source}" >&2
    return 1
  fi
  mkdir -p "$(dirname "${destination}")"
  mv "${source}" "${destination}"
}

if [[ $# -eq 0 ]]; then
  emit_help
  exit 0
fi

case "${1:-}" in
  --version)
    emit_version
    exit 0
    ;;
  --help|-h)
    emit_help
    exit 0
    ;;
  --a1|--a2|--p64)
    ;;
  --*)
    printf 'unsupported AlienTrimmer option: %s\n' "$1" >&2
    exit 2
    ;;
esac

legacy_mode=0
has_modern_alien_flags=0
args=("$@")

for ((idx = 0; idx < ${#args[@]}; idx++)); do
  arg="${args[idx]}"
  case "${arg}" in
    -a|--a1|--a2)
      has_modern_alien_flags=1
      ((idx += 1))
      ;;
    -if|-ir|-cf|-cr|-of|-or|-os)
      legacy_mode=1
      ((idx += 1))
      ;;
    -c)
      if (( idx + 1 < ${#args[@]} )) && (( has_modern_alien_flags == 0 )); then
        value="${args[idx + 1]}"
        if [[ ! "${value}" =~ ^[0-9]+$ || -e "${value}" ]]; then
          legacy_mode=1
        fi
      fi
      ((idx += 1))
      ;;
    -i|-1|-2|-o|-k|-m|-q|-p|-l)
      ((idx += 1))
      ;;
  esac
done

if (( legacy_mode == 0 )); then
  exec "${java_bin}" "${java_args[@]}" -jar "${jar_path}" "$@"
fi

translated=()
legacy_single_out=""
legacy_r1_out=""
legacy_r2_out=""
legacy_singletons_out=""
explicit_gzip=0

while (($#)); do
  case "$1" in
    -if)
      translated+=(-1 "$2")
      shift 2
      ;;
    -ir)
      translated+=(-2 "$2")
      shift 2
      ;;
    -cf)
      translated+=(--a1 "$2")
      shift 2
      ;;
    -cr)
      translated+=(--a2 "$2")
      shift 2
      ;;
    -c)
      translated+=(-a "$2")
      shift 2
      ;;
    -o)
      legacy_single_out="$2"
      shift 2
      ;;
    -of)
      legacy_r1_out="$2"
      shift 2
      ;;
    -or)
      legacy_r2_out="$2"
      shift 2
      ;;
    -os)
      legacy_singletons_out="$2"
      shift 2
      ;;
    -z)
      explicit_gzip=1
      translated+=(-z)
      shift
      ;;
    --help|-h)
      emit_help
      exit 0
      ;;
    --version)
      emit_version
      exit 0
      ;;
    *)
      translated+=("$1")
      shift
      ;;
  esac
done

requested_outputs=()
for output_path in \
  "${legacy_single_out}" \
  "${legacy_r1_out}" \
  "${legacy_r2_out}" \
  "${legacy_singletons_out}"
do
  if [[ -n "${output_path}" ]]; then
    requested_outputs+=("${output_path}")
  fi
done

if [[ ${#requested_outputs[@]} -eq 0 ]]; then
  exec "${java_bin}" "${java_args[@]}" -jar "${jar_path}" "${translated[@]}"
fi

gzip_output_count=0
plain_output_count=0
for output_path in "${requested_outputs[@]}"; do
  case "${output_path}" in
    *.gz) ((gzip_output_count += 1)) ;;
    *) ((plain_output_count += 1)) ;;
  esac
done

if (( gzip_output_count > 0 && plain_output_count > 0 )); then
  printf 'legacy AlienTrimmer output paths must agree on gzip suffix\n' >&2
  exit 2
fi

if (( gzip_output_count > 0 && explicit_gzip == 0 )); then
  translated+=(-z)
fi

temp_dir="$(mktemp -d)"
trap 'rm -rf "${temp_dir}"' EXIT
output_base="${temp_dir}/alientrimmer"
translated+=(-o "${output_base}")

run_alientrimmer "${translated[@]}"

suffix=".fastq"
if (( gzip_output_count > 0 || explicit_gzip == 1 )); then
  suffix=".fastq.gz"
fi

move_output "${output_base}${suffix}" "${legacy_single_out}"
move_output "${output_base}.1${suffix}" "${legacy_r1_out}"
move_output "${output_base}.2${suffix}" "${legacy_r2_out}"
move_output "${output_base}.S${suffix}" "${legacy_singletons_out}"
