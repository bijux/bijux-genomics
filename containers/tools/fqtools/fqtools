#!/usr/bin/env sh
set -eu

native_bin=/usr/local/libexec-fqtools

native_version() {
    set +e
    native_output="$("$native_bin" -v 2>&1)"
    native_status=$?
    set -e
    if [ "$native_status" -ne 0 ] || ! printf '%s\n' "$native_output" | grep -Fq 'fqtools 2.3 '; then
        printf 'error: unexpected fqtools version probe (status=%s)\n' "$native_status" >&2
        exit 70
    fi
}

native_help() {
    set +e
    native_output="$("$native_bin" -h 2>&1)"
    native_status=$?
    set -e
    if [ "$native_status" -ne 0 ] || ! printf '%s\n' "$native_output" | grep -Fq 'usage: fqtools '; then
        printf 'error: unexpected fqtools help probe (status=%s)\n' "$native_status" >&2
        exit 70
    fi
}

case "${1:-}" in
    --version|-v)
        native_version
        printf '%s\n' "$native_output"
        ;;
    --help|-h|"")
        native_help
        printf '%s\n' "$native_output"
        ;;
    *) exec "$native_bin" "$@" ;;
esac
