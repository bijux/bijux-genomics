#!/usr/bin/env sh
# SPDX-License-Identifier: MIT
set -eu

native_help() {
    set +e
    native_output="$(/opt/seqprep/bin/seqprep-native -h 2>&1)"
    native_status=$?
    set -e
    if [ "$native_status" -ne 1 ] || ! printf '%s\n' "$native_output" | grep -Fq 'Usage:'; then
        printf 'error: unexpected SeqPrep help probe (status=%s)\n' "$native_status" >&2
        exit 70
    fi
}

case "${1:-}" in
    --version)
        native_help
        printf 'seqprep 1.3.2\n'
        ;;
    --help|-h|"")
        native_help
        printf '%s\n' "$native_output"
        ;;
    --governed-invalid-option)
        echo 'seqprep: error: unsupported option --governed-invalid-option' >&2
        exit 2
        ;;
    *)
        exec /opt/seqprep/bin/seqprep-native "$@"
        ;;
esac
