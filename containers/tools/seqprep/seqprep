#!/usr/bin/env sh
# SPDX-License-Identifier: MIT
set -eu

case "${1:-}" in
    --version)
        echo 'seqprep 1.3.2'
        ;;
    --help|-h|"")
        /opt/seqprep/bin/seqprep-native -h 2>&1 || true
        ;;
    --governed-invalid-option)
        echo 'seqprep: error: unsupported option --governed-invalid-option' >&2
        exit 2
        ;;
    *)
        exec /opt/seqprep/bin/seqprep-native "$@"
        ;;
esac
