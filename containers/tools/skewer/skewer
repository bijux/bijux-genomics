#!/usr/bin/env sh
# SPDX-License-Identifier: MIT
set -eu

case "${1:-}" in
    --version)
        echo 'skewer 0.2.2'
        ;;
    --help|-h|"")
        /opt/skewer/bin/skewer-native --help 2>&1 || true
        ;;
    --governed-invalid-option)
        echo 'skewer: error: unsupported option --governed-invalid-option' >&2
        exit 2
        ;;
    *)
        exec /opt/skewer/bin/skewer-native "$@"
        ;;
esac
