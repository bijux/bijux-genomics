#!/usr/bin/env sh
set -eu

case "${1:-}" in
    --version|-v|version)
        echo 'Kraken 2.1.3'
        ;;
    --help|-h|help|"")
        exec /opt/kraken2/kraken2 --help
        ;;
    --governed-invalid-option)
        echo 'kraken2: error: unsupported option --governed-invalid-option' >&2
        exit 2
        ;;
    *)
        exec /opt/kraken2/kraken2 "$@"
        ;;
esac
