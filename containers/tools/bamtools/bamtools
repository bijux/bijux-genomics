#!/usr/bin/env sh
# SPDX-License-Identifier: MIT
set -eu

case "${1:-}" in
    --version|-v|version)
        echo 'bamtools 2.5.2'
        ;;
    --help|-h|help|"")
        exec /opt/bamtools/bin/bamtools-native --help
        ;;
    --governed-invalid-option)
        echo 'bamtools: error: unsupported option --governed-invalid-option' >&2
        exit 2
        ;;
    *)
        exec /opt/bamtools/bin/bamtools-native "$@"
        ;;
esac
