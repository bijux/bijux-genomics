#!/usr/bin/env sh
set -eu

native_help() {
    native_output="$(GLIMPSE_phase --help 2>&1)"
    if ! printf '%s\n' "$native_output" | grep -Fq 'Version       : 1.1.1'; then
        printf 'error: GLIMPSE help omits version 1.1.1\n' >&2
        exit 70
    fi
}

case "${1:-}" in
    --version) native_help; printf 'glimpse 1.1.1\n' ;;
    --help|-h|"") native_help; printf '%s\n' "$native_output" ;;
    *) exec GLIMPSE_phase "$@" ;;
esac
