#!/usr/bin/env sh
# SPDX-License-Identifier: BSD-2-Clause
set -eu

case "${1:-}" in
    --version)
        echo 'vsearch 2.29.3'
        ;;
    --help|-h|"")
        exec /opt/vsearch/bin/vsearch-native --help
        ;;
    --governed-invalid-option)
        echo 'vsearch: error: unsupported option --governed-invalid-option' >&2
        exit 2
        ;;
    *)
        exec /opt/vsearch/bin/vsearch-native "$@"
        ;;
esac
