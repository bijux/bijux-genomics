#!/usr/bin/env sh
set -eu

case "${1:-}" in
    --version|-v|version)
        echo 'Atropos 1.1.31'
        ;;
    --help|-h|help|"")
        exec /opt/atropos-venv/bin/atropos-native --help
        ;;
    --governed-invalid-option)
        echo 'atropos: error: unsupported option --governed-invalid-option' >&2
        exit 2
        ;;
    *)
        exec /opt/atropos-venv/bin/atropos-native "$@"
        ;;
esac
