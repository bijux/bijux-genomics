#!/usr/bin/env sh
# SPDX-License-Identifier: Apache-2.0
set -eu

case "${1:-}" in
    --version)
        echo 'smartpca 8.0.0'
        ;;
    --help|-h|"")
        printf '%s\n' \
            'usage: smartpca -p PARAMETERS [native options]' \
            '' \
            'Run the pinned EIGENSOFT smartpca 8.0.0 executable.' \
            'Use --version to print the governed runtime version.'
        ;;
    *)
        exec /opt/eigensoft/bin/smartpca-native "$@"
        ;;
esac
