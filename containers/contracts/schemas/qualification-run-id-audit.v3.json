{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QualificationRunIdAudit",
  "type": "object",
  "properties": {
    "allocated_mapping_count": {
      "type": "integer",
      "format": "uint",
      "minimum": 0
    },
    "attempt_ledger": {
      "type": "string"
    },
    "catalog_sha256": {
      "type": "string"
    },
    "current_run_root": {
      "type": "string"
    },
    "external_artifact_tool_count": {
      "type": "integer",
      "format": "uint",
      "minimum": 0
    },
    "historical_identities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/QualificationHistoricalRunIdentity"
      }
    },
    "historical_max_run_number": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "observed_historical_run_count": {
      "type": "integer",
      "format": "uint",
      "minimum": 0
    },
    "redistributable_tool_count": {
      "type": "integer",
      "format": "uint",
      "minimum": 0
    },
    "reserved_run_count": {
      "type": "integer",
      "format": "uint",
      "minimum": 0
    },
    "reserved_run_ids": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/QualificationRunIdTombstone"
      }
    },
    "rows": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/QualificationRunIdAuditRow"
      }
    },
    "schema_version": {
      "type": "string"
    },
    "supplemental_history": {
      "type": "string"
    },
    "supported_tool_count": {
      "type": "integer",
      "format": "uint",
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "catalog_sha256",
    "current_run_root",
    "attempt_ledger",
    "supplemental_history",
    "observed_historical_run_count",
    "reserved_run_count",
    "historical_max_run_number",
    "supported_tool_count",
    "redistributable_tool_count",
    "external_artifact_tool_count",
    "allocated_mapping_count",
    "historical_identities",
    "reserved_run_ids",
    "rows"
  ],
  "$defs": {
    "ContainerArtifactDelivery": {
      "type": "string",
      "enum": [
        "redistributable_image",
        "external_artifact",
        "private_site_build",
        "site_module"
      ]
    },
    "ContainerProductSupport": {
      "type": "string",
      "enum": [
        "supported",
        "retired",
        "excluded"
      ]
    },
    "QualificationHistoricalRunIdentity": {
      "type": "object",
      "properties": {
        "run_id": {
          "type": "string"
        },
        "tool_id": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "run_id",
        "tool_id"
      ]
    },
    "QualificationRunIdAuditRow": {
      "type": "object",
      "properties": {
        "artifact_delivery": {
          "$ref": "#/$defs/ContainerArtifactDelivery"
        },
        "identity_source": {
          "type": "string"
        },
        "input_role": {
          "type": "string"
        },
        "product_support": {
          "$ref": "#/$defs/ContainerProductSupport"
        },
        "redistribution_permitted": {
          "type": "boolean"
        },
        "run_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "stage_id": {
          "type": "string"
        },
        "tool_id": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "tool_id",
        "product_support",
        "artifact_delivery",
        "redistribution_permitted",
        "identity_source",
        "stage_id",
        "input_role"
      ]
    },
    "QualificationRunIdTombstone": {
      "type": "object",
      "properties": {
        "disposition": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "run_id": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "run_id",
        "disposition",
        "reason"
      ]
    }
  }
}