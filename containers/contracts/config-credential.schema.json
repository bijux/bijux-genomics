{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bijux.github.io/bijux-genomics/schemas/container-credential-reference-v1.json",
  "title": "Bijux Genomics credential-reference contract",
  "type": "object",
  "required": ["schema_version", "credentials_required", "references", "redaction"],
  "properties": {
    "schema_version": {"const": "bijux.container.credential_reference.v1"},
    "credentials_required": {"type": "boolean"},
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "purpose", "source_type", "variable_names", "failure_behavior"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "purpose": {"type": "string", "minLength": 1},
          "source_type": {"type": "string", "minLength": 1},
          "variable_names": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "failure_behavior": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false,
        "not": {"anyOf": [
          {"required": ["secret"]}, {"required": ["token"]}, {"required": ["password"]},
          {"required": ["value"]}, {"required": ["private_key"]}
        ]}
      }
    },
    "redaction": {
      "type": "object",
      "required": ["publish_values"],
      "properties": {"publish_values": {"const": false}},
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
