# VERSION_SOURCE: containers/contracts/catalog.toml
FROM ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b
COPY --chmod=0555 containers/contracts/configure-apt-snapshot /usr/local/sbin/bijux-configure-apt-snapshot
ARG OCI_CREATED=governed-by-build-evidence
ARG TOOL_VERSION=0.23.4
LABEL org.opencontainers.image.source="https://github.com/OpenGene/fastp" \
      org.opencontainers.image.revision="1ffcaed6892832c09c4b4094c201cd4eff8fa622" \
      org.opencontainers.image.created="${OCI_CREATED}" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.version="${TOOL_VERSION}"
LABEL org.opencontainers.image.tool="fastp"
LABEL org.opencontainers.image.title="fastp"
LABEL org.opencontainers.image.base.name="ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b"
LABEL org.opencontainers.image.base.digest="sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b"
LABEL io.bijux.tool.version="0.23.4"
ENV LANG=C LC_ALL=C TZ=UTC DEBIAN_FRONTEND=noninteractive

RUN /usr/local/sbin/bijux-configure-apt-snapshot && \
    apt-get install -y --no-install-recommends ca-certificates && \
    apt-get -o Acquire::Check-Valid-Until=false update && \
    apt-get install -y --no-install-recommends libdeflate0 libisal2 zlib1g && \
    apt-get install -y --no-install-recommends curl g++ libdeflate-dev libisal-dev make zlib1g-dev && \
    curl --fail --location --proto '=https' --tlsv1.2 --output /opt/fastp.tar.gz https://codeload.github.com/OpenGene/fastp/tar.gz/refs/tags/v0.23.4 && \
    echo '4fad6db156e769d46071add8a778a13a5cb5186bc1e1a5f9b1ffd499d84d72b5  /opt/fastp.tar.gz' | sha256sum -c - && \
    tar --extract --gzip --file /opt/fastp.tar.gz --directory /opt && \
    make --directory /opt/fastp-0.23.4 -j2 && \
    install -d -m 0755 /opt/fastp/bin && \
    install -m 0755 /opt/fastp-0.23.4/fastp /opt/fastp/bin/fastp-native && \
    rm -rf /opt/fastp.tar.gz /opt/fastp-0.23.4 && \
    apt-get purge -y --auto-remove curl g++ libdeflate-dev libisal-dev make zlib1g-dev && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* && \
    useradd --system --uid 65532 --home-dir /work --create-home bijux
COPY containers/tools/fastp/fastp /usr/local/bin/fastp
RUN chmod 0755 /usr/local/bin/fastp /opt/fastp/bin/fastp-native && \
    fastp --version | grep -Fx 'fastp 0.23.4' && \
    fastp --help >/dev/null

USER 65532:65532
WORKDIR /work
ENTRYPOINT ["fastp"]
CMD ["--help"]
