# VERSION_SOURCE: containers/contracts/catalog.toml
FROM ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b
COPY --chmod=0555 containers/contracts/configure-apt-snapshot /usr/local/sbin/bijux-configure-apt-snapshot
ARG OCI_CREATED=governed-by-build-evidence
ARG TOOL_VERSION=1.30.0
LABEL org.opencontainers.image.source="https://bioconductor.org/packages/3.18/bioc/html/dada2.html" \
      org.opencontainers.image.revision="c6653fe77c3d62dd91207bbbf6641ec143fb8a498967e240a97af26de7e27667" \
      org.opencontainers.image.created="${OCI_CREATED}" \
      org.opencontainers.image.licenses="LGPL-2.0-only" \
      org.opencontainers.image.version="${TOOL_VERSION}" \
      org.opencontainers.image.tool="dada2" \
      org.opencontainers.image.title="DADA2" \
      org.opencontainers.image.base.name="ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b" \
      org.opencontainers.image.base.digest="sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b"
LABEL io.bijux.tool.version="1.30.0"
ENV LANG=C LC_ALL=C TZ=UTC DEBIAN_FRONTEND=noninteractive
RUN /usr/local/sbin/bijux-configure-apt-snapshot && \
    apt-get install -y --no-install-recommends ca-certificates && \
    apt-get -o Acquire::Check-Valid-Until=false update && \
    apt-get install -y --no-install-recommends dpkg-dev=1.22.6ubuntu6.6 r-bioc-dada2=1.30.0+dfsg-1 && \
    test "$(dpkg-query --show --showformat='$${Version}' r-bioc-dada2)" = '1.30.0+dfsg-1' && \
    test "$(dpkg-query --show --showformat='$${Version}' dpkg-dev)" = '1.22.6ubuntu6.6' && \
    Rscript -e 'stopifnot(as.character(packageVersion("dada2")) == "1.30.0")' && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* && \
    useradd --system --uid 65532 --home-dir /work --create-home bijux
COPY containers/tools/dada2/dada2 /usr/local/bin/dada2
COPY containers/tools/dada2/infer-asvs.R /opt/dada2/infer-asvs.R
RUN chmod 0755 /usr/local/bin/dada2 /opt/dada2/infer-asvs.R && \
    dada2 --version | grep -Fx 'dada2 1.30.0' && \
    Rscript -e 'suppressPackageStartupMessages(library(dada2))'
USER 65532:65532
WORKDIR /work
ENTRYPOINT ["/usr/local/bin/dada2"]
CMD ["--help"]
