# VERSION_SOURCE: containers/contracts/catalog.toml
FROM ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b AS builder
COPY --chmod=0555 containers/contracts/configure-apt-snapshot /usr/local/sbin/bijux-configure-apt-snapshot

ARG OCI_CREATED=governed-by-build-evidence
ARG TOOL_VERSION=1.2.18
LABEL org.opencontainers.image.source="https://github.com/grenaud/leeHom" \
      org.opencontainers.image.revision="fea84b803aefb00b05386d802b5382d7d268f3be" \
      org.opencontainers.image.created="${OCI_CREATED}" \
      org.opencontainers.image.licenses="GPL-3.0-only" \
      org.opencontainers.image.version="${TOOL_VERSION}" \
      org.opencontainers.image.tool="leehom" \
      org.opencontainers.image.title="leeHom" \
      org.opencontainers.image.base.name="ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b" \
      org.opencontainers.image.base.digest="sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b"

ENV LANG=C LC_ALL=C TZ=UTC DEBIAN_FRONTEND=noninteractive
RUN /usr/local/sbin/bijux-configure-apt-snapshot && \
    apt-get install -y --no-install-recommends ca-certificates && \
    apt-get -o Acquire::Check-Valid-Until=false update && \
    apt-get install -y --no-install-recommends build-essential cmake curl zlib1g-dev && \
    mkdir -p /opt/leehom /opt/leehom/libgab /opt/leehom/bamtools && \
    curl --fail --location --silent --show-error --output /opt/leehom-source.tar.gz https://github.com/grenaud/leeHom/archive/fea84b803aefb00b05386d802b5382d7d268f3be.tar.gz && \
    curl --fail --location --silent --show-error --output /opt/libgab-source.tar.gz https://github.com/grenaud/libgab/archive/81da9c622242225c76494b7eb2b8c9af03aebc12.tar.gz && \
    curl --fail --location --silent --show-error --output /opt/bamtools-source.tar.gz https://github.com/pezmaster31/bamtools/archive/d24d850de17134fe4e7984b26493c5c0a1844b35.tar.gz && \
    echo '87cbc83c04b51264b7d986aaf9bf7abaedaa827d1a72f783d4c43b63b3cc95ca  /opt/leehom-source.tar.gz' | sha256sum --check --strict && \
    echo 'd3cf9da762846cd616d91ccf71ca7b45544c3d7dcbb9a7f9ff6eba732bfc0ddd  /opt/libgab-source.tar.gz' | sha256sum --check --strict && \
    echo '1cab593e050f8db20361c8a777c81c70d22fde9648b205d4794617c876920600  /opt/bamtools-source.tar.gz' | sha256sum --check --strict && \
    tar --extract --gzip --file /opt/leehom-source.tar.gz --directory /opt/leehom --strip-components=1 && \
    tar --extract --gzip --file /opt/libgab-source.tar.gz --directory /opt/leehom/libgab --strip-components=1 && \
    tar --extract --gzip --file /opt/bamtools-source.tar.gz --directory /opt/leehom/bamtools --strip-components=1 && \
    sed -i '/bool operator()(const MergeItem& lhs, const MergeItem& rhs)/s/)$/) const/' /opt/leehom/bamtools/src/api/internal/bam/BamMultiMerger_p.h && \
    sed -i '/bool operator()(const BamTools::BamAlignment& lhs, const BamTools::BamAlignment& rhs)/s/)$/) const/' /opt/leehom/bamtools/src/api/algorithms/Sort.h && \
    grep -F 'bool operator()(const MergeItem& lhs, const MergeItem& rhs) const' /opt/leehom/bamtools/src/api/internal/bam/BamMultiMerger_p.h && \
    test "$(grep -Fc 'const BamTools::BamAlignment& rhs) const' /opt/leehom/bamtools/src/api/algorithms/Sort.h)" -eq 3 && \
    printf '%s\n' '#define VERSION "v1.2.18"' > /opt/leehom/src/version.h && \
    make --directory /opt/leehom -j"$(nproc)" && \
    install -m 0755 /opt/leehom/src/leeHom /usr/local/libexec-leehom

FROM ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b
COPY --chmod=0555 containers/contracts/configure-apt-snapshot /usr/local/sbin/bijux-configure-apt-snapshot
ARG OCI_CREATED=governed-by-build-evidence
ARG TOOL_VERSION=1.2.18
LABEL org.opencontainers.image.source="https://github.com/grenaud/leeHom" \
      org.opencontainers.image.revision="fea84b803aefb00b05386d802b5382d7d268f3be" \
      org.opencontainers.image.created="${OCI_CREATED}" \
      org.opencontainers.image.licenses="GPL-3.0-only" \
      org.opencontainers.image.version="${TOOL_VERSION}" \
      org.opencontainers.image.tool="leehom" \
      org.opencontainers.image.title="leeHom" \
      org.opencontainers.image.base.name="ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b" \
      org.opencontainers.image.base.digest="sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b"
LABEL io.bijux.tool.version="1.2.18"

ENV LANG=C LC_ALL=C TZ=UTC DEBIAN_FRONTEND=noninteractive
RUN /usr/local/sbin/bijux-configure-apt-snapshot && \
    apt-get install -y --no-install-recommends ca-certificates && \
    apt-get -o Acquire::Check-Valid-Until=false update && \
    apt-get install -y --no-install-recommends zlib1g && \
    rm -rf /var/lib/apt/lists/* && \
    useradd --system --uid 65532 --home-dir /work --create-home bijux
COPY --from=builder /usr/local/libexec-leehom /usr/local/libexec-leehom
COPY containers/tools/leehom/leehom /usr/local/bin/leehom
RUN chmod 0755 /usr/local/bin/leehom && \
    ln -s /usr/local/bin/leehom /usr/local/bin/leeHom && \
    leehom --version | grep -F 'leeHom version: v1.2.18'

USER 65532:65532
WORKDIR /work
ENTRYPOINT ["/usr/local/bin/leehom"]
CMD ["--help"]
