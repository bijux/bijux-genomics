# VERSION_SOURCE: containers/contracts/catalog.toml
FROM ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b AS source
ARG PMDTOOLS_COMMIT=18b5901e93d417ea91fd675b499e401deadfe3c5
ARG PMDTOOLS_SHA256=47d49d8ed5c655a95002969677d9b36f068ebc07a9c1d8ebc57d8d72eff98405
RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates curl patch && \
    curl --fail --location --proto '=https' --tlsv1.2 \
      "https://codeload.github.com/pontussk/PMDtools/tar.gz/${PMDTOOLS_COMMIT}" \
      --output /opt/pmdtools.tar.gz && \
    echo "${PMDTOOLS_SHA256}  /opt/pmdtools.tar.gz" | sha256sum --check --strict && \
    tar --extract --gzip --file /opt/pmdtools.tar.gz --directory /opt
COPY containers/tools/pmdtools/python3-release-metadata.patch /opt/pmdtools-python3-release-metadata.patch
RUN patch --directory "/opt/PMDtools-${PMDTOOLS_COMMIT}" --strip=1 \
      --input /opt/pmdtools-python3-release-metadata.patch && \
    install -m 0755 "/opt/PMDtools-${PMDTOOLS_COMMIT}/pmdtools.0.60.py" /opt/pmdtools

FROM ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b
ARG OCI_CREATED=governed-by-build-evidence
ARG TOOL_VERSION=0.60
LABEL org.opencontainers.image.source="https://github.com/pontussk/PMDtools" \
      org.opencontainers.image.revision="18b5901e93d417ea91fd675b499e401deadfe3c5" \
      org.opencontainers.image.created="${OCI_CREATED}" \
      org.opencontainers.image.licenses="GPL-3.0" \
      org.opencontainers.image.version="${TOOL_VERSION}"
LABEL org.opencontainers.image.tool="pmdtools"
LABEL org.opencontainers.image.title="PMDtools"
LABEL org.opencontainers.image.base.name="ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b"
LABEL org.opencontainers.image.base.digest="sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b"
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && \
    apt-get install -y --no-install-recommends python3 samtools && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* && \
    useradd --system --uid 65532 --home-dir /work --create-home bijux
COPY --from=source /opt/pmdtools /usr/local/bin/pmdtools
RUN pmdtools --version | grep -Fx 'pmdtools v0.60' && \
    pmdtools --help >/dev/null

USER 65532:65532
WORKDIR /work
ENTRYPOINT ["pmdtools"]
CMD ["--help"]
