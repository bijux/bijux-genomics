# VERSION_SOURCE: containers/contracts/catalog.toml
FROM ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b
COPY --chmod=0555 containers/contracts/configure-apt-snapshot /usr/local/sbin/bijux-configure-apt-snapshot
ARG OCI_CREATED=governed-by-build-evidence
ARG TOOL_VERSION=1.24
LABEL org.opencontainers.image.source="https://github.com/multiqc/multiqc" \
      org.opencontainers.image.revision="3c55b3c3f1194e5256a77048535c064e8509487e" \
      org.opencontainers.image.created="${OCI_CREATED}" \
      org.opencontainers.image.licenses="GPL-3.0" \
      org.opencontainers.image.version="${TOOL_VERSION}" \
      io.bijux.tool.version="${TOOL_VERSION}" \
      org.opencontainers.image.tool="multiqc" \
      org.opencontainers.image.title="MultiQC" \
      org.opencontainers.image.base.name="ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b" \
      org.opencontainers.image.base.digest="sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b"
ENV LANG=C LC_ALL=C TZ=UTC DEBIAN_FRONTEND=noninteractive

ARG VERSION_MULTIQC=1.24
ENV VERSION_MULTIQC=${VERSION_MULTIQC}
ENV PATH=/opt/multiqc-venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

RUN /usr/local/sbin/bijux-configure-apt-snapshot && \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        python3 \
        python3-pip \
        python3-venv && \
    python3 -m venv /opt/multiqc-venv && \
    python3 -c 'import urllib.request; urllib.request.urlretrieve("https://files.pythonhosted.org/packages/70/47/ba71ed113c96221ce33113baaeac9d75a21e1dd0b5c76eb378ab6a61f87b/multiqc-1.24-py3-none-any.whl", "/tmp/multiqc-1.24-py3-none-any.whl")' && \
    echo '991755ce91462b20aaa72fb78daa8b477b9c920ac099d434cef1b96394d099cb  /tmp/multiqc-1.24-py3-none-any.whl' | sha256sum -c - && \
    /opt/multiqc-venv/bin/pip install --no-cache-dir /tmp/multiqc-1.24-py3-none-any.whl && \
    ln -sf /opt/multiqc-venv/bin/multiqc /usr/local/bin/multiqc && \
    multiqc --version | grep -Fx 'multiqc, version 1.24' && \
    multiqc --help >/dev/null && \
    useradd --system --uid 65532 --home-dir /work --create-home bijux && \
    rm -f /tmp/multiqc-1.24-py3-none-any.whl && \
    rm -rf /var/lib/apt/lists/*

USER 65532:65532
WORKDIR /work
ENTRYPOINT ["/usr/local/bin/multiqc"]
CMD ["--help"]
