# VERSION_SOURCE: containers/contracts/catalog.toml
FROM ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b AS builder
ARG TOOL_VERSION=1.1.3
ARG LIGHTER_SOURCE_SHA256=c8a251c410805f82dad77e40661f0faf14ec82dedb3ff717094ba8ff4ef94465
ENV DEBIAN_FRONTEND=noninteractive \
    LIGHTER_VERSION=${TOOL_VERSION} \
    LIGHTER_SOURCE_SHA256=${LIGHTER_SOURCE_SHA256}
COPY containers/tools/lighter/install /opt/lighter-build/install
RUN sed -i 's#http://archive.ubuntu.com/ubuntu/#https://snapshot.ubuntu.com/ubuntu/20260802T000000Z/#g; s#http://security.ubuntu.com/ubuntu/#https://snapshot.ubuntu.com/ubuntu/20260802T000000Z/#g' /etc/apt/sources.list.d/ubuntu.sources && \
    apt-get -o Acquire::Check-Valid-Until=false update && \
    apt-get install -y --no-install-recommends build-essential ca-certificates curl zlib1g-dev && \
    chmod 0755 /opt/lighter-build/install && \
    BIJUX_BUILD_JOBS=2 /opt/lighter-build/install

FROM ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b
ARG OCI_CREATED=governed-by-build-evidence
ARG TOOL_VERSION=1.1.3
LABEL org.opencontainers.image.source="https://github.com/mourisl/Lighter" \
      org.opencontainers.image.revision="d8621db12352895662404b38a4b61862eaf60f6a" \
      org.opencontainers.image.created="${OCI_CREATED}" \
      org.opencontainers.image.licenses="GPL-3.0" \
      org.opencontainers.image.version="${TOOL_VERSION}" \
      org.opencontainers.image.tool="lighter" \
      org.opencontainers.image.title="Lighter" \
      org.opencontainers.image.base.name="ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b" \
      org.opencontainers.image.base.digest="sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b"
ENV LANG=C LC_ALL=C TZ=UTC
RUN sed -i 's#http://archive.ubuntu.com/ubuntu/#https://snapshot.ubuntu.com/ubuntu/20260802T000000Z/#g; s#http://security.ubuntu.com/ubuntu/#https://snapshot.ubuntu.com/ubuntu/20260802T000000Z/#g' /etc/apt/sources.list.d/ubuntu.sources && \
    apt-get -o Acquire::Check-Valid-Until=false update && \
    apt-get install -y --no-install-recommends zlib1g && \
    rm -rf /var/lib/apt/lists/* && \
    useradd --system --uid 65532 --home-dir /work --create-home bijux
COPY --from=builder /usr/local/libexec/lighter-bin /usr/local/libexec/lighter-bin
COPY containers/tools/lighter/lighter /usr/local/bin/lighter
RUN chmod 0755 /usr/local/bin/lighter /usr/local/libexec/lighter-bin && \
    lighter --version | grep -Fx 'Lighter v1.1.3' && \
    lighter --help | grep -F 'Usage: ./lighter [OPTIONS]'
USER 65532:65532
WORKDIR /work
ENTRYPOINT ["lighter"]
CMD ["--help"]
