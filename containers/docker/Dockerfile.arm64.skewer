# VERSION_SOURCE: containers/contracts/catalog.toml
FROM ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b AS builder
COPY --chmod=0555 containers/contracts/configure-apt-snapshot /usr/local/sbin/bijux-configure-apt-snapshot
ENV DEBIAN_FRONTEND=noninteractive
RUN /usr/local/sbin/bijux-configure-apt-snapshot && \
    apt-get install -y --no-install-recommends ca-certificates && \
    apt-get -o Acquire::Check-Valid-Until=false update && \
    apt-get install -y --no-install-recommends curl g++ make patch zlib1g-dev && \
    curl --fail --location --proto '=https' --tlsv1.2 --output /opt/skewer.tar.gz https://codeload.github.com/relipmoc/skewer/tar.gz/978e8e46cba44595ece623e5387749284a86b74b && \
    echo '695c5f714e23ba5572e2525b7445439b632f52653e28ea46ed9988fc2f765169  /opt/skewer.tar.gz' | sha256sum -c - && \
    tar --extract --gzip --file /opt/skewer.tar.gz --directory /opt
COPY containers/tools/skewer/gcc-compatibility.patch /opt/skewer-gcc-compatibility.patch
RUN patch --directory /opt/skewer-978e8e46cba44595ece623e5387749284a86b74b --strip=1 --input /opt/skewer-gcc-compatibility.patch && \
    make --directory /opt/skewer-978e8e46cba44595ece623e5387749284a86b74b -j2 && \
    install -d -m 0755 /opt/skewer/bin && \
    install -m 0755 /opt/skewer-978e8e46cba44595ece623e5387749284a86b74b/skewer /opt/skewer/bin/skewer-native

FROM ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b
COPY --chmod=0555 containers/contracts/configure-apt-snapshot /usr/local/sbin/bijux-configure-apt-snapshot
ARG OCI_CREATED=governed-by-build-evidence
ARG TOOL_VERSION=0.2.2
LABEL org.opencontainers.image.source="https://github.com/relipmoc/skewer" \
      org.opencontainers.image.revision="978e8e46cba44595ece623e5387749284a86b74b" \
      org.opencontainers.image.created="${OCI_CREATED}" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.version="${TOOL_VERSION}"
LABEL org.opencontainers.image.tool="skewer"
LABEL org.opencontainers.image.title="Skewer"
LABEL org.opencontainers.image.base.name="ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b"
LABEL org.opencontainers.image.base.digest="sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b"
ENV LANG=C LC_ALL=C TZ=UTC DEBIAN_FRONTEND=noninteractive
RUN /usr/local/sbin/bijux-configure-apt-snapshot && \
    apt-get install -y --no-install-recommends ca-certificates && \
    apt-get -o Acquire::Check-Valid-Until=false update && \
    apt-get install -y --no-install-recommends zlib1g && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* && \
    useradd --system --uid 65532 --home-dir /work --create-home bijux
COPY --from=builder /opt/skewer /opt/skewer
COPY containers/tools/skewer/skewer /usr/local/bin/skewer
RUN chmod 0755 /usr/local/bin/skewer /opt/skewer/bin/skewer-native && \
    skewer --version | grep -Fx 'skewer 0.2.2' && \
    skewer --help >/dev/null

USER 65532:65532
WORKDIR /work
ENTRYPOINT ["skewer"]
CMD ["--help"]
