# VERSION_SOURCE: containers/contracts/catalog.toml
FROM ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b
COPY --chmod=0555 containers/contracts/configure-apt-snapshot /usr/local/sbin/bijux-configure-apt-snapshot
COPY --chmod=0555 containers/tools/seqkit_stats/seqkit_stats /usr/local/bin/seqkit_stats

ARG OCI_CREATED=governed-by-build-evidence
ARG TOOL_VERSION=2.8.2
LABEL org.opencontainers.image.source="https://github.com/shenwei356/seqkit" \
      org.opencontainers.image.revision="1aef84fbc2381db2e73639632bc44a5f7a0a8bcc" \
      org.opencontainers.image.created="${OCI_CREATED}" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.version="${TOOL_VERSION}" \
      io.bijux.tool.version="${TOOL_VERSION}" \
      org.opencontainers.image.tool="seqkit_stats" \
      org.opencontainers.image.title="SeqKit Stats" \
      org.opencontainers.image.base.name="ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b" \
      org.opencontainers.image.base.digest="sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b"

ENV LANG=C LC_ALL=C TZ=UTC DEBIAN_FRONTEND=noninteractive
RUN /usr/local/sbin/bijux-configure-apt-snapshot && \
    apt-get install -y --no-install-recommends curl && \
    curl --fail --location --proto '=https' --tlsv1.2 \
      --output /opt/seqkit.tar.gz \
      https://github.com/shenwei356/seqkit/releases/download/v2.8.2/seqkit_linux_arm64.tar.gz && \
    echo '8c12816c0bf6c01cfcda329fdb5f6c1479cf2485ce9413ce36b96237524da9dc  /opt/seqkit.tar.gz' | sha256sum --check --strict && \
    install -d -m 0755 /opt/seqkit/bin && \
    tar --extract --gzip --file /opt/seqkit.tar.gz --directory /opt/seqkit/bin && \
    mv /opt/seqkit/bin/seqkit /opt/seqkit/bin/seqkit-native && \
    chmod 0755 /opt/seqkit/bin/seqkit-native /usr/local/bin/seqkit_stats && \
    /opt/seqkit/bin/seqkit-native version | grep -F 'seqkit v2.8.2' && \
    seqkit_stats --version | grep -Fx 'seqkit_stats 2.8.2' && \
    seqkit_stats --help >/dev/null && \
    useradd --system --uid 65532 --home-dir /work --create-home bijux && \
    rm /opt/seqkit.tar.gz && \
    apt-get purge -y --auto-remove curl && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

USER 65532:65532
WORKDIR /work
ENTRYPOINT ["/usr/local/bin/seqkit_stats"]
CMD ["--help"]
