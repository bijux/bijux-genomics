# VERSION_SOURCE: containers/versions/versions.toml
FROM ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b
COPY --chmod=0555 containers/contracts/configure-apt-snapshot /usr/local/sbin/bijux-configure-apt-snapshot
COPY --chmod=0555 containers/tools/king/king /usr/local/bin/king
ARG TOOL_VERSION=2.3.0
LABEL org.opencontainers.image.source="https://www.kingrelatedness.com/executables/Linux-king230.tar.gz" \
      org.opencontainers.image.revision="sha256:5a00cb504b56e3a05c8aa2b4531b1f85c9947e7c9aa89bfec7afd72b28663b39" \
      org.opencontainers.image.created="governed-by-build-evidence" \
      org.opencontainers.image.licenses="GPL-3.0" \
      org.opencontainers.image.version="${TOOL_VERSION}"
LABEL org.opencontainers.image.tool="king"
LABEL org.opencontainers.image.title="king"
LABEL org.opencontainers.image.base.name="ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b"
LABEL org.opencontainers.image.base.digest="sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b"
ENV DEBIAN_FRONTEND=noninteractive

RUN set -eux; \
    /usr/local/sbin/bijux-configure-apt-snapshot; \
    apt-get install -y --no-install-recommends ca-certificates; \
    apt-get -o Acquire::Check-Valid-Until=false update; \
    apt-get install -y --no-install-recommends curl libgomp1 libquadmath0; \
    mkdir -p /usr/local/libexec/king; \
    curl -L --retry 5 --retry-delay 3 --connect-timeout 20 --max-time 300 \
      -o /tmp/Linux-king230.tar.gz \
      "https://www.kingrelatedness.com/executables/Linux-king230.tar.gz"; \
    echo '5a00cb504b56e3a05c8aa2b4531b1f85c9947e7c9aa89bfec7afd72b28663b39  /tmp/Linux-king230.tar.gz' | sha256sum --check --strict; \
    tar -xzf /tmp/Linux-king230.tar.gz -C /usr/local/libexec/king; \
    install -m 0755 /usr/local/libexec/king/king /usr/local/libexec/king/king-bin; \
    king --version > /tmp/king.version; \
    grep -Fx 'KING 2.3.0' /tmp/king.version; \
    king --help > /tmp/king.help; \
    grep -F 'KING 2.3.0 -' /tmp/king.help; \
    useradd --system --uid 65532 --home-dir /work --create-home bijux; \
    rm -f /tmp/Linux-king230.tar.gz /tmp/king.version /tmp/king.help; \
    rm -rf /var/lib/apt/lists/*

USER 65532:65532
WORKDIR /work
ENTRYPOINT ["/usr/local/bin/king"]
CMD ["--help"]
