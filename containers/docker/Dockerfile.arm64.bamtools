# VERSION_SOURCE: containers/contracts/catalog.toml
FROM ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b AS builder
COPY --chmod=0555 containers/contracts/configure-apt-snapshot /usr/local/sbin/bijux-configure-apt-snapshot
ENV DEBIAN_FRONTEND=noninteractive
RUN /usr/local/sbin/bijux-configure-apt-snapshot && \
    apt-get install -y --no-install-recommends ca-certificates && \
    apt-get -o Acquire::Check-Valid-Until=false update && \
    apt-get install -y --no-install-recommends cmake curl g++ make zlib1g-dev && \
    curl --fail --location --proto '=https' --tlsv1.2 --output /opt/bamtools.tar.gz https://codeload.github.com/pezmaster31/bamtools/tar.gz/refs/tags/v2.5.2 && \
    echo '4d8b84bd07b673d0ed41031348f10ca98dd6fa6a4460f9b9668d6f1d4084dfc8  /opt/bamtools.tar.gz' | sha256sum -c - && \
    tar --extract --gzip --file /opt/bamtools.tar.gz --directory /opt && \
    cmake -S /opt/bamtools-2.5.2 -B /opt/bamtools-build -DCMAKE_BUILD_TYPE=Release -DBUILD_SHARED_LIBS=OFF && \
    cmake --build /opt/bamtools-build --parallel 2 && \
    install -d -m 0755 /opt/bamtools/bin && \
    install -m 0755 /opt/bamtools-build/src/bamtools /opt/bamtools/bin/bamtools-native

FROM ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b
COPY --chmod=0555 containers/contracts/configure-apt-snapshot /usr/local/sbin/bijux-configure-apt-snapshot
ARG OCI_CREATED=governed-by-build-evidence
ARG TOOL_VERSION=2.5.2
LABEL org.opencontainers.image.source="https://github.com/pezmaster31/bamtools" \
      org.opencontainers.image.revision="9f2fa61d5c10588a426dec12422255d6d0c87d84" \
      org.opencontainers.image.created="${OCI_CREATED}" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.version="${TOOL_VERSION}"
LABEL org.opencontainers.image.tool="bamtools"
LABEL org.opencontainers.image.title="BamTools"
LABEL org.opencontainers.image.base.name="ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b"
LABEL org.opencontainers.image.base.digest="sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b"
ENV LANG=C LC_ALL=C TZ=UTC DEBIAN_FRONTEND=noninteractive
RUN /usr/local/sbin/bijux-configure-apt-snapshot && \
    apt-get -o Acquire::Check-Valid-Until=false install -y --no-install-recommends libstdc++6 zlib1g && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* && \
    useradd --system --uid 65532 --home-dir /work --create-home bijux
COPY --from=builder /opt/bamtools /opt/bamtools
COPY containers/tools/bamtools/bamtools /usr/local/bin/bamtools
RUN chmod 0755 /usr/local/bin/bamtools /opt/bamtools/bin/bamtools-native && \
    bamtools --version | grep -Fx 'bamtools 2.5.2' && \
    bamtools --help >/dev/null 2>&1

USER 65532:65532
WORKDIR /work
ENTRYPOINT ["bamtools"]
CMD ["--help"]
