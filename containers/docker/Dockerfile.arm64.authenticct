# VERSION_SOURCE: containers/contracts/catalog.toml

FROM ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b
COPY --chmod=0555 containers/contracts/configure-apt-snapshot /usr/local/sbin/bijux-configure-apt-snapshot

ARG OCI_CREATED=governed-by-build-evidence
ARG TOOL_VERSION=1.0.0
LABEL org.opencontainers.image.source="https://github.com/StephanePeyregne/AuthentiCT" \
      org.opencontainers.image.revision="13ba26ef82f5a3febd74401f65fb8c1776aa16b2" \
      org.opencontainers.image.created="${OCI_CREATED}" \
      org.opencontainers.image.licenses="GPL-3.0-only" \
      org.opencontainers.image.version="${TOOL_VERSION}" \
      org.opencontainers.image.tool="authenticct" \
      org.opencontainers.image.title="AuthentiCT" \
      org.opencontainers.image.base.name="ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b" \
      org.opencontainers.image.base.digest="sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b"
LABEL io.bijux.tool.version="1.0.0"

ENV DEBIAN_FRONTEND=noninteractive \
    PATH=/opt/authenticct-venv/bin:/usr/local/bin:/usr/bin:/bin \
    LANG=C \
    LC_ALL=C \
    TZ=UTC \
    PYTHONNOUSERSITE=1

COPY containers/tools/authenticct/requirements.lock /opt/authenticct-requirements.lock
COPY containers/tools/authenticct/authenticct /usr/local/bin/authenticct

RUN /usr/local/sbin/bijux-configure-apt-snapshot && \
    apt-get install -y --no-install-recommends ca-certificates && \
    apt-get -o Acquire::Check-Valid-Until=false update && \
    apt-get install -y --no-install-recommends build-essential curl python3 python3-dev python3-pip python3-venv && \
    curl --fail --location --silent --show-error --output /opt/authenticct-source.tar.gz https://github.com/StephanePeyregne/AuthentiCT/archive/13ba26ef82f5a3febd74401f65fb8c1776aa16b2.tar.gz && \
    echo '179b79fa0e23ed18c2cc9338055a691575addc513a6e3765d912bb728c249834  /opt/authenticct-source.tar.gz' | sha256sum --check --strict && \
    mkdir -p /opt/authenticct-source && \
    tar --extract --gzip --file /opt/authenticct-source.tar.gz --directory /opt/authenticct-source --strip-components=1 && \
    python3 -m venv /opt/authenticct-venv && \
    /opt/authenticct-venv/bin/pip install --no-cache-dir --require-hashes --requirement /opt/authenticct-requirements.lock && \
    /opt/authenticct-venv/bin/pip install --no-cache-dir --no-deps --no-build-isolation /opt/authenticct-source && \
    chmod 0755 /usr/local/bin/authenticct && \
    authenticct --version | grep -Fx 'AuthentiCT 1.0.0' && \
    rm -rf /opt/authenticct-source /opt/authenticct-source.tar.gz /var/lib/apt/lists/* && \
    useradd --system --uid 65532 --home-dir /work --create-home bijux

USER 65532:65532
WORKDIR /work
ENTRYPOINT ["/usr/local/bin/authenticct"]
CMD ["--help"]
