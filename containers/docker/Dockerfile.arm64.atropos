# VERSION_SOURCE: containers/contracts/catalog.toml
FROM python:3.10-slim@sha256:e508a34e5491225a76fbb9e0f43ebde1f691c6a689d096d7510cf7fb17d4ba6f AS builder
ENV DEBIAN_FRONTEND=noninteractive
RUN sed -i \
      -e 's#http://deb.debian.org/debian-security#https://snapshot.debian.org/archive/debian-security/20260802T000000Z#g' \
      -e 's#http://deb.debian.org/debian#https://snapshot.debian.org/archive/debian/20260802T000000Z#g' \
      /etc/apt/sources.list.d/debian.sources && \
    apt-get -o Acquire::https::Verify-Peer=false -o Acquire::Check-Valid-Until=false update && \
    apt-get -o Acquire::https::Verify-Peer=false install -y --no-install-recommends ca-certificates && \
    apt-get -o Acquire::Check-Valid-Until=false update && \
    apt-get install -y --no-install-recommends build-essential curl patch
COPY containers/tools/atropos/requirements.lock /opt/atropos-build/requirements.lock
COPY containers/tools/atropos/python-collections-compatibility.patch /opt/atropos-build/python-collections-compatibility.patch
COPY containers/tools/atropos/install /opt/atropos-build/install
COPY containers/tools/atropos/atropos /usr/local/bin/atropos
RUN chmod 0755 /opt/atropos-build/install /usr/local/bin/atropos && /opt/atropos-build/install

FROM python:3.10-slim@sha256:e508a34e5491225a76fbb9e0f43ebde1f691c6a689d096d7510cf7fb17d4ba6f
ARG OCI_CREATED=governed-by-build-evidence
ARG TOOL_VERSION=1.1.31
LABEL org.opencontainers.image.source="https://github.com/jdidion/atropos" \
      org.opencontainers.image.revision="916a0bfbc18149bbefb83ccff9fe2a0807415807" \
      org.opencontainers.image.created="${OCI_CREATED}" \
      org.opencontainers.image.licenses="MIT AND CC0-1.0" \
      org.opencontainers.image.version="${TOOL_VERSION}"
LABEL org.opencontainers.image.tool="atropos"
LABEL org.opencontainers.image.title="Atropos"
LABEL org.opencontainers.image.base.name="python:3.10-slim@sha256:e508a34e5491225a76fbb9e0f43ebde1f691c6a689d096d7510cf7fb17d4ba6f"
LABEL org.opencontainers.image.base.digest="sha256:e508a34e5491225a76fbb9e0f43ebde1f691c6a689d096d7510cf7fb17d4ba6f"
ENV LANG=C LC_ALL=C TZ=UTC PYTHONNOUSERSITE=1
RUN useradd --system --uid 65532 --home-dir /work --create-home bijux
COPY --from=builder /opt/atropos-venv /opt/atropos-venv
COPY containers/tools/atropos/atropos /usr/local/bin/atropos
RUN chmod 0755 /usr/local/bin/atropos && \
    atropos --version | grep -Fx 'Atropos 1.1.31' && \
    atropos trim --help >/dev/null

USER 65532:65532
WORKDIR /work
ENTRYPOINT ["atropos"]
CMD ["--help"]
