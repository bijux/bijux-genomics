# VERSION_SOURCE: containers/contracts/catalog.toml
FROM ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b
COPY --chmod=0555 containers/contracts/configure-apt-snapshot /usr/local/sbin/bijux-configure-apt-snapshot

ARG OCI_CREATED=governed-by-build-evidence
ARG TOOL_VERSION=4.1.4
LABEL org.opencontainers.image.source="https://github.com/genid/Yleaf" \
      org.opencontainers.image.revision="a2368eaaf08c0af53063514ed435d9e844b0ac1e" \
      org.opencontainers.image.created="${OCI_CREATED}" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.version="${TOOL_VERSION}" \
      org.opencontainers.image.tool="yleaf" \
      org.opencontainers.image.title="Yleaf" \
      org.opencontainers.image.base.name="ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b" \
      org.opencontainers.image.base.digest="sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b"

ENV LANG=C LC_ALL=C TZ=UTC DEBIAN_FRONTEND=noninteractive PATH=/opt/yleaf-venv/bin:/usr/local/bin:/usr/bin:/bin
COPY containers/tools/yleaf/requirements.lock /opt/yleaf-requirements.lock
RUN /usr/local/sbin/bijux-configure-apt-snapshot && \
    apt-get install -y --no-install-recommends ca-certificates && \
    apt-get -o Acquire::Check-Valid-Until=false update && \
    apt-get install -y --no-install-recommends bcftools curl graphviz minimap2 python3 python3-pip python3-venv samtools tabix && \
    curl --fail --location --silent --show-error --output /opt/yleaf-source.tar.gz https://github.com/genid/Yleaf/archive/a2368eaaf08c0af53063514ed435d9e844b0ac1e.tar.gz && \
    echo 'b98f63250878caa3b20d40dea352f2fb81438bcf45bc0830693c6e74f69ab9c4  /opt/yleaf-source.tar.gz' | sha256sum --check --strict && \
    mkdir -p /opt/yleaf-source && \
    tar --extract --gzip --file /opt/yleaf-source.tar.gz --directory /opt/yleaf-source --strip-components=1 && \
    python3 -m venv /opt/yleaf-venv && \
    /opt/yleaf-venv/bin/pip install --no-cache-dir --require-hashes --requirement /opt/yleaf-requirements.lock && \
    /opt/yleaf-venv/bin/pip install --no-cache-dir --no-deps --no-build-isolation /opt/yleaf-source && \
    ln -s /opt/yleaf-venv/bin/Yleaf /usr/local/bin/Yleaf && \
    printf '%s\n' '#!/usr/bin/env sh' 'set -eu' 'case "${1:-}" in' '  --version) printf "%s\n" "Yleaf 4.1.4" ;;' '  --help|-h|"") exec /usr/local/bin/Yleaf -h ;;' '  *) exec /usr/local/bin/Yleaf "$@" ;;' 'esac' > /usr/local/bin/yleaf && \
    chmod 0755 /usr/local/bin/yleaf && \
    yleaf --version | grep -F 'Yleaf 4.1.4' && \
    rm -rf /opt/yleaf-source /opt/yleaf-source.tar.gz /var/lib/apt/lists/* && \
    useradd --system --uid 65532 --home-dir /work --create-home bijux

USER 65532:65532
WORKDIR /work
ENTRYPOINT ["/usr/local/bin/yleaf"]
CMD ["--help"]
