# VERSION_SOURCE: containers/versions/versions.toml
FROM ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b AS builder
COPY --chmod=0555 containers/contracts/configure-apt-snapshot /usr/local/sbin/bijux-configure-apt-snapshot
ARG TOOL_VERSION=2.0.1
LABEL org.opencontainers.image.source="https://github.com/Griffan/VerifyBamID" \
      org.opencontainers.image.revision="83a1c936ef2e1a8c9e78ed2d2e2d328adf0c6447" \
      org.opencontainers.image.created="governed-by-build-evidence" \
      org.opencontainers.image.licenses="GPL-3.0" \
      org.opencontainers.image.version="${TOOL_VERSION}"
LABEL org.opencontainers.image.tool="verifybamid2"
LABEL org.opencontainers.image.title="verifybamid2"
LABEL org.opencontainers.image.base.name="ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b"
LABEL org.opencontainers.image.base.digest="sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b"
ENV DEBIAN_FRONTEND=noninteractive

RUN /usr/local/sbin/bijux-configure-apt-snapshot && \
    apt-get install -y --no-install-recommends ca-certificates && \
    apt-get -o Acquire::Check-Valid-Until=false update && \
    apt-get install -y --no-install-recommends \
    git build-essential cmake zlib1g-dev libbz2-dev liblzma-dev libcurl4-gnutls-dev libhts-dev \
    ca-certificates && rm -rf /var/lib/apt/lists/*

RUN git clone --no-checkout https://github.com/Griffan/VerifyBamID.git /opt/VerifyBamID && \
    cd /opt/VerifyBamID && \
    git fetch --depth 1 origin 83a1c936ef2e1a8c9e78ed2d2e2d328adf0c6447 && \
    git checkout 83a1c936ef2e1a8c9e78ed2d2e2d328adf0c6447 && \
    cmake -S . -B build -DCMAKE_BUILD_TYPE=Release && \
    cmake --build build -j"$(nproc)" && \
    install -m 0755 /opt/VerifyBamID/bin/VerifyBamID /opt/verifybamid2

FROM ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b
COPY --chmod=0555 containers/contracts/configure-apt-snapshot /usr/local/sbin/bijux-configure-apt-snapshot
COPY --chmod=0555 containers/tools/verifybamid2/verifybamid2 /usr/local/bin/verifybamid2
ARG TOOL_VERSION=2.0.1
LABEL org.opencontainers.image.source="https://github.com/Griffan/VerifyBamID" \
      org.opencontainers.image.revision="83a1c936ef2e1a8c9e78ed2d2e2d328adf0c6447" \
      org.opencontainers.image.created="governed-by-build-evidence" \
      org.opencontainers.image.licenses="GPL-3.0" \
      org.opencontainers.image.version="${TOOL_VERSION}" \
      org.opencontainers.image.tool="verifybamid2" \
      org.opencontainers.image.title="verifybamid2" \
      org.opencontainers.image.base.name="ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b" \
      org.opencontainers.image.base.digest="sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b"
LABEL io.bijux.tool.version="2.0.1"
ENV DEBIAN_FRONTEND=noninteractive
RUN /usr/local/sbin/bijux-configure-apt-snapshot && \
    apt-get install -y --no-install-recommends ca-certificates && \
    apt-get -o Acquire::Check-Valid-Until=false update && \
    apt-get install -y --no-install-recommends \
    ca-certificates zlib1g libbz2-1.0 liblzma5 libcurl4 libhts3 libgomp1 && \
    useradd --system --uid 65532 --home-dir /work --create-home bijux && \
    rm -rf /var/lib/apt/lists/*
COPY --from=builder /opt/verifybamid2 /usr/local/bin/verifybamid2-bin
RUN verifybamid2 --version > /tmp/verifybamid2.version && \
    grep -Fx 'verifybamid2 2.0.1' /tmp/verifybamid2.version && \
    verifybamid2 --help > /tmp/verifybamid2.help && \
    grep -F 'Detailed instructions of parameters' /tmp/verifybamid2.help && \
    rm -f /tmp/verifybamid2.version /tmp/verifybamid2.help
USER 65532:65532
WORKDIR /work
ENTRYPOINT ["/usr/local/bin/verifybamid2"]
CMD ["--help"]
