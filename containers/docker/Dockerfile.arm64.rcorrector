# VERSION_SOURCE: containers/versions/versions.toml
FROM ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b AS builder
COPY --chmod=0555 containers/contracts/configure-apt-snapshot /usr/local/sbin/bijux-configure-apt-snapshot
ARG TOOL_VERSION=1.0.7
LABEL org.opencontainers.image.source="https://github.com/mourisl/Rcorrector" \
      org.opencontainers.image.revision="f8915b79363e896409bd9ca56819f56c3f77a47e" \
      org.opencontainers.image.created="governed-by-build-evidence" \
      org.opencontainers.image.licenses="GPL-3.0" \
      org.opencontainers.image.version="${TOOL_VERSION}"
LABEL org.opencontainers.image.tool="rcorrector"
LABEL org.opencontainers.image.title="rcorrector"
LABEL org.opencontainers.image.base.name="ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b"
LABEL org.opencontainers.image.base.digest="sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b"

ARG VERSION_RCORRECTOR=1.0.7
ENV DEBIAN_FRONTEND=noninteractive

RUN /usr/local/sbin/bijux-configure-apt-snapshot \
 && apt-get install -y --no-install-recommends \
      build-essential git perl zlib1g-dev libbz2-dev \
      jellyfish sed grep ca-certificates \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /tmp/rcorrector

RUN git clone --depth 1 --branch v${VERSION_RCORRECTOR} \
        https://github.com/mourisl/Rcorrector.git . \
 && git checkout f8915b79363e896409bd9ca56819f56c3f77a47e \
 # Keep the upstream driver and native executable at stable runtime paths.
 && sed -i 's|\$WD/rcorrector|\$WD/rcorrector-bin|g' run_rcorrector.pl \
 && sed -i 's/-1/(char)-1/g' *.cpp \
 && make -j"$(nproc)"

# The runtime stage contains only the driver, executable, and declared libraries.
FROM ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b AS runtime
COPY --chmod=0555 containers/contracts/configure-apt-snapshot /usr/local/sbin/bijux-configure-apt-snapshot
COPY --chmod=0555 containers/tools/rcorrector/rcorrector /usr/local/bin/rcorrector

ARG VERSION_RCORRECTOR=1.0.7
ENV VERSION_RCORRECTOR=${VERSION_RCORRECTOR} \
    DEBIAN_FRONTEND=noninteractive \
    TZ=UTC

LABEL maintainer="Bijan Mousavi" \
      org.opencontainers.image.source="https://github.com/mourisl/Rcorrector" \
      org.opencontainers.image.revision="f8915b79363e896409bd9ca56819f56c3f77a47e" \
      org.opencontainers.image.created="governed-by-build-evidence" \
      org.opencontainers.image.version="${VERSION_RCORRECTOR}" \
      org.opencontainers.image.licenses="GPL-3.0" \
      org.opencontainers.image.tool="rcorrector" \
      org.opencontainers.image.title="rcorrector" \
      org.opencontainers.image.base.name="ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b" \
      org.opencontainers.image.base.digest="sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b"
LABEL io.bijux.tool.version="1.0.7"

RUN /usr/local/sbin/bijux-configure-apt-snapshot \
 && apt-get install -y --no-install-recommends \
      bash perl ca-certificates \
      jellyfish gzip zlib1g libbz2-1.0 \
 && rm -rf /var/lib/apt/lists/*

COPY --from=builder /tmp/rcorrector/rcorrector /usr/local/bin/rcorrector-bin
COPY --from=builder /tmp/rcorrector/run_rcorrector.pl /usr/local/bin/run_rcorrector.pl

RUN chmod +x /usr/local/bin/rcorrector-bin /usr/local/bin/run_rcorrector.pl \
 && rcorrector --version > /tmp/rcorrector.version \
 && grep -Fx 'Rcorrector v1.0.7' /tmp/rcorrector.version \
 && rcorrector --help > /tmp/rcorrector.help \
 && grep -F 'Usage: perl ./run_rcorrector.pl [OPTIONS]' /tmp/rcorrector.help \
 && rm -f /tmp/rcorrector.version /tmp/rcorrector.help \
 && useradd --system --uid 65532 --home-dir /work --create-home bijux

USER 65532:65532
WORKDIR /work

HEALTHCHECK --interval=1h --timeout=10s \
  CMD [ "rcorrector", "--version" ]

ENTRYPOINT ["rcorrector"]
CMD ["--help"]
