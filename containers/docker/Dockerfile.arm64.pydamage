# VERSION_SOURCE: containers/versions/versions.toml
FROM ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b
ARG OCI_REVISION=unknown
ARG OCI_CREATED=unknown
ARG TOOL_VERSION=1.0
LABEL org.opencontainers.image.source="https://github.com/bijux/bijux-genomics"       org.opencontainers.image.revision="${OCI_REVISION}"       org.opencontainers.image.created="${OCI_CREATED}"       org.opencontainers.image.licenses="GPL-3.0"       org.opencontainers.image.version="${TOOL_VERSION}"
LABEL org.opencontainers.image.tool="pydamage"
LABEL org.opencontainers.image.title="pydamage"
LABEL org.opencontainers.image.base.name="ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b"
LABEL org.opencontainers.image.base.digest="sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b"
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update -qq && apt-get install -y --no-install-recommends \
      python3=3.12.3-0ubuntu2.1 \
      python3-pip=24.0+dfsg-1ubuntu1.3 \
      ca-certificates=20240203 && \
    python3 -c 'import urllib.request; urllib.request.urlretrieve("https://github.com/maxibor/pydamage/archive/08f1d0f2d1981d350decbf10964f989e9567ddbf.tar.gz", "/tmp/pydamage.tar.gz")' && \
    echo 'f049fad925e8418f5ba31e78429fde6cc62ad0ccb9a6ff0a8b739ba894d15d9f  /tmp/pydamage.tar.gz' | sha256sum -c - && \
    mkdir -p /opt/pydamage && \
    tar -xzf /tmp/pydamage.tar.gz --strip-components=1 -C /opt/pydamage && \
    python3 -m pip install --break-system-packages --no-cache-dir /opt/pydamage && \
    rm -f /tmp/pydamage.tar.gz && \
    rm -rf /var/lib/apt/lists/*

ENTRYPOINT ["/usr/local/bin/pydamage"]
CMD ["--help"]
