# VERSION_SOURCE: containers/contracts/catalog.toml
FROM ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b
COPY --chmod=0555 containers/contracts/configure-apt-snapshot /usr/local/sbin/bijux-configure-apt-snapshot
ARG OCI_CREATED=governed-by-build-evidence
ARG TOOL_VERSION=2.15.0
LABEL org.opencontainers.image.source="https://ftp.ncbi.nlm.nih.gov/blast/executables/blast+/2.15.0/" \
      org.opencontainers.image.revision="6918c370524c8d44e028bf491e8f245a895e07c66c77b261ce3b38d6058216e0" \
      org.opencontainers.image.created="${OCI_CREATED}" \
      org.opencontainers.image.licenses="LicenseRef-NCBI-Public-Domain" \
      org.opencontainers.image.version="${TOOL_VERSION}" \
      org.opencontainers.image.tool="dustmasker" \
      org.opencontainers.image.title="DustMasker" \
      org.opencontainers.image.base.name="ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b" \
      org.opencontainers.image.base.digest="sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b"
LABEL io.bijux.tool.version="2.15.0"
ENV LANG=C LC_ALL=C TZ=UTC DEBIAN_FRONTEND=noninteractive
RUN /usr/local/sbin/bijux-configure-apt-snapshot && \
    apt-get install -y --no-install-recommends ca-certificates && \
    apt-get -o Acquire::Check-Valid-Until=false update && \
    apt-get install -y --no-install-recommends curl libgomp1 && \
    curl --fail --location --silent --show-error --output /opt/blast.tar.gz 'https://ftp.ncbi.nlm.nih.gov/blast/executables/blast+/2.15.0/ncbi-blast-2.15.0+-aarch64-linux.tar.gz' && \
    curl --fail --location --silent --show-error --output /opt/blast-source.tar.gz 'https://ftp.ncbi.nlm.nih.gov/blast/executables/blast+/2.15.0/ncbi-blast-2.15.0+-src.tar.gz' && \
    echo '47ce417832e31366ec6835adc0c88a2e164f17e646dd025d7e4ddd263ad8ed51  /opt/blast.tar.gz' | sha256sum --check --strict && \
    echo '6918c370524c8d44e028bf491e8f245a895e07c66c77b261ce3b38d6058216e0  /opt/blast-source.tar.gz' | sha256sum --check --strict && \
    tar --extract --gzip --file /opt/blast.tar.gz --directory /opt && \
    install -m 0755 '/opt/ncbi-blast-2.15.0+/bin/dustmasker' /usr/local/libexec-dustmasker && \
    rm -rf '/opt/ncbi-blast-2.15.0+' /opt/blast.tar.gz /opt/blast-source.tar.gz /var/lib/apt/lists/* && \
    useradd --system --uid 65532 --home-dir /work --create-home bijux
COPY containers/tools/dustmasker/dustmasker /usr/local/bin/dustmasker
RUN chmod 0755 /usr/local/bin/dustmasker && dustmasker --version | grep -Fx 'dustmasker 2.15.0'
USER 65532:65532
WORKDIR /work
ENTRYPOINT ["/usr/local/bin/dustmasker"]
CMD ["--help"]
