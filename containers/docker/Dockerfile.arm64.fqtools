# VERSION_SOURCE: containers/contracts/catalog.toml
FROM ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b AS builder
COPY --chmod=0555 containers/contracts/configure-apt-snapshot /usr/local/sbin/bijux-configure-apt-snapshot

ARG OCI_CREATED=governed-by-build-evidence
ARG TOOL_VERSION=2.3
LABEL org.opencontainers.image.source="https://github.com/alastair-droop/fqtools" \
      org.opencontainers.image.revision="63c6fa707fabc7569c2f256b8bcfc6ebb760f72a" \
      org.opencontainers.image.created="${OCI_CREATED}" \
      org.opencontainers.image.licenses="GPL-3.0-only" \
      org.opencontainers.image.version="${TOOL_VERSION}" \
      org.opencontainers.image.tool="fqtools" \
      org.opencontainers.image.title="fqtools" \
      org.opencontainers.image.base.name="ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b" \
      org.opencontainers.image.base.digest="sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b"

ENV LANG=C LC_ALL=C TZ=UTC DEBIAN_FRONTEND=noninteractive
RUN /usr/local/sbin/bijux-configure-apt-snapshot && \
    apt-get install -y --no-install-recommends ca-certificates && \
    apt-get -o Acquire::Check-Valid-Until=false update && \
    apt-get install -y --no-install-recommends curl gcc make zlib1g-dev libhts-dev && \
    curl --fail --location --silent --show-error --output /tmp/fqtools.tar.gz \
      https://github.com/alastair-droop/fqtools/archive/63c6fa707fabc7569c2f256b8bcfc6ebb760f72a.tar.gz && \
    echo '209020076fcc0e7beee4e86ca2579242799536ba47f4fdd2411dc5a0f86aa3f6  /tmp/fqtools.tar.gz' | sha256sum --check --strict && \
    tar --extract --gzip --file /tmp/fqtools.tar.gz --directory /tmp && \
    make --directory /tmp/fqtools-63c6fa707fabc7569c2f256b8bcfc6ebb760f72a \
      HTSDIR=/usr CFLAGS='-O2 -g -Wall -Wextra -Wno-unused-parameter -fcommon' -j"$(nproc)" && \
    install -m 0755 /tmp/fqtools-63c6fa707fabc7569c2f256b8bcfc6ebb760f72a/bin/fqtools /usr/local/libexec-fqtools

FROM ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b
COPY --chmod=0555 containers/contracts/configure-apt-snapshot /usr/local/sbin/bijux-configure-apt-snapshot
ARG OCI_CREATED=governed-by-build-evidence
ARG TOOL_VERSION=2.3
LABEL org.opencontainers.image.source="https://github.com/alastair-droop/fqtools" \
      org.opencontainers.image.revision="63c6fa707fabc7569c2f256b8bcfc6ebb760f72a" \
      org.opencontainers.image.created="${OCI_CREATED}" \
      org.opencontainers.image.licenses="GPL-3.0-only" \
      org.opencontainers.image.version="${TOOL_VERSION}" \
      org.opencontainers.image.tool="fqtools" \
      org.opencontainers.image.title="fqtools" \
      org.opencontainers.image.base.name="ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b" \
      org.opencontainers.image.base.digest="sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b"

ENV LANG=C LC_ALL=C TZ=UTC DEBIAN_FRONTEND=noninteractive
RUN /usr/local/sbin/bijux-configure-apt-snapshot && \
    apt-get install -y --no-install-recommends ca-certificates && \
    apt-get -o Acquire::Check-Valid-Until=false update && \
    apt-get install -y --no-install-recommends libhts3 zlib1g && \
    rm -rf /var/lib/apt/lists/* && \
    useradd --system --uid 65532 --home-dir /work --create-home bijux
COPY --from=builder /usr/local/libexec-fqtools /usr/local/libexec-fqtools
RUN printf '%s\n' '#!/usr/bin/env sh' 'set -eu' \
      'case "${1:-}" in' \
      '  --version|-v) printf "%s\\n" "2.3" ;;' \
      '  --help|-h|"") exec /usr/local/libexec-fqtools -h ;;' \
      '  *) exec /usr/local/libexec-fqtools "$@" ;;' 'esac' > /usr/local/bin/fqtools && \
    chmod 0755 /usr/local/bin/fqtools && test "$(fqtools --version)" = 2.3

USER 65532:65532
WORKDIR /work
ENTRYPOINT ["/usr/local/bin/fqtools"]
CMD ["--help"]
