# VERSION_SOURCE: containers/contracts/catalog.toml
FROM ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b AS builder
COPY --chmod=0555 containers/contracts/configure-apt-snapshot /usr/local/sbin/bijux-configure-apt-snapshot
ENV DEBIAN_FRONTEND=noninteractive
RUN /usr/local/sbin/bijux-configure-apt-snapshot && \
    apt-get install -y --no-install-recommends curl unzip
COPY containers/tools/bowtie2/install /opt/bowtie2-build/install
COPY containers/tools/bowtie2/bowtie2 /usr/local/bin/bowtie2
COPY containers/tools/bowtie2/bowtie2-build /usr/local/bin/bowtie2-build
RUN chmod 0755 /opt/bowtie2-build/install /usr/local/bin/bowtie2 /usr/local/bin/bowtie2-build && \
    /opt/bowtie2-build/install

FROM ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b
COPY --chmod=0555 containers/contracts/configure-apt-snapshot /usr/local/sbin/bijux-configure-apt-snapshot
ARG OCI_CREATED=governed-by-build-evidence
ARG TOOL_VERSION=2.5.4
LABEL org.opencontainers.image.source="https://github.com/BenLangmead/bowtie2" \
      org.opencontainers.image.revision="4cf8d526f4b7ec6519a79ed4c6f826caf09e0bba" \
      org.opencontainers.image.created="${OCI_CREATED}" \
      org.opencontainers.image.licenses="GPL-3.0-only" \
      org.opencontainers.image.version="${TOOL_VERSION}"
LABEL org.opencontainers.image.tool="bowtie2"
LABEL org.opencontainers.image.title="Bowtie 2"
LABEL org.opencontainers.image.base.name="ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b"
LABEL org.opencontainers.image.base.digest="sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b"
LABEL io.bijux.tool.version="2.5.4"
ENV LANG=C LC_ALL=C TZ=UTC PATH=/usr/local/bin:/opt/bowtie2:/usr/bin:/bin
RUN /usr/local/sbin/bijux-configure-apt-snapshot && \
    apt-get install -y --no-install-recommends libstdc++6 perl python3 zlib1g && \
    rm -rf /var/lib/apt/lists/* && \
    useradd --system --uid 65532 --home-dir /work --create-home bijux
COPY --from=builder /opt/bowtie2 /opt/bowtie2
COPY containers/tools/bowtie2/bowtie2 /usr/local/bin/bowtie2
COPY containers/tools/bowtie2/bowtie2-build /usr/local/bin/bowtie2-build
RUN chmod 0755 /usr/local/bin/bowtie2 /usr/local/bin/bowtie2-build && \
    bowtie2 --version | grep -Fx 'Bowtie 2 2.5.4' && \
    bowtie2 --help >/dev/null

USER 65532:65532
WORKDIR /work
ENTRYPOINT ["bowtie2"]
CMD ["--help"]
