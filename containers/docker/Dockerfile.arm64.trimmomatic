# VERSION_SOURCE: containers/contracts/catalog.toml
FROM ubuntu@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b
COPY --chmod=0555 containers/contracts/configure-apt-snapshot /usr/local/sbin/bijux-configure-apt-snapshot
ARG OCI_REVISION
ARG OCI_CREATED
ARG TOOL_VERSION=0.39
RUN test -n "${OCI_REVISION}" && \
    test -n "${OCI_CREATED}" && \
    test "${TOOL_VERSION}" = '0.39'
LABEL org.opencontainers.image.source="https://github.com/usadellab/Trimmomatic" \
      org.opencontainers.image.revision="${OCI_REVISION}" \
      org.opencontainers.image.created="${OCI_CREATED}" \
      org.opencontainers.image.licenses="GPL-3.0-only" \
      org.opencontainers.image.version="${TOOL_VERSION}" \
      org.opencontainers.image.tool="trimmomatic" \
      org.opencontainers.image.title="Trimmomatic" \
      org.opencontainers.image.base.name="ubuntu@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b" \
      org.opencontainers.image.base.digest="sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b"
LABEL io.bijux.tool.version="0.39"
RUN /usr/local/sbin/bijux-configure-apt-snapshot && \
    apt-get install -y --no-install-recommends \
        ca-certificates curl openjdk-11-jre-headless unzip && \
    curl --fail --location --proto '=https' --tlsv1.2 \
        --output /opt/trimmomatic.zip \
        https://github.com/usadellab/Trimmomatic/releases/download/v0.39/Trimmomatic-0.39.zip && \
    echo '2f7a5de11416899e5b38d3131019bc655946f770f9b7df5355d6a36acbcc488c  /opt/trimmomatic.zip' \
        | sha256sum --check --strict && \
    unzip -q /opt/trimmomatic.zip -d /opt && \
    mv /opt/Trimmomatic-0.39 /opt/trimmomatic && \
    test -f /opt/trimmomatic/trimmomatic-0.39.jar && \
    test -f /opt/trimmomatic/adapters/TruSeq3-PE.fa && \
    rm -f /opt/trimmomatic.zip && \
    apt-get purge -y --auto-remove curl unzip && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*
COPY --chmod=0555 containers/tools/trimmomatic/trimmomatic /usr/local/bin/trimmomatic
ENV LANG=C \
    LC_ALL=C \
    TZ=UTC \
    TRIMMOMATIC_ROOT=/opt/trimmomatic
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/trimmomatic"]
CMD ["--help"]
