# VERSION_SOURCE: containers/contracts/catalog.toml
FROM ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b
ARG OCI_CREATED=governed-by-build-evidence
ARG TOOL_VERSION=0.01
LABEL org.opencontainers.image.source="https://github.com/RAHenriksen/ngsBriggs" \
      org.opencontainers.image.revision="ab3b5ae8a388b9b1874dd2854fdec32bd9195f22" \
      org.opencontainers.image.created="${OCI_CREATED}" \
      org.opencontainers.image.licenses="NOASSERTION" \
      org.opencontainers.image.version="${TOOL_VERSION}" \
      org.opencontainers.image.tool="ngsbriggs" \
      org.opencontainers.image.title="ngsBriggs" \
      org.opencontainers.image.base.name="ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b" \
      org.opencontainers.image.base.digest="sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b"
ENV LANG=C LC_ALL=C TZ=UTC DEBIAN_FRONTEND=noninteractive
RUN sed -i 's#http://archive.ubuntu.com/ubuntu/#https://snapshot.ubuntu.com/ubuntu/20260802T000000Z/#g; s#http://security.ubuntu.com/ubuntu/#https://snapshot.ubuntu.com/ubuntu/20260802T000000Z/#g' /etc/apt/sources.list.d/ubuntu.sources && \
    apt-get -o Acquire::https::Verify-Peer=false -o Acquire::Check-Valid-Until=false update && \
    apt-get -o Acquire::https::Verify-Peer=false install -y --no-install-recommends ca-certificates && \
    apt-get -o Acquire::Check-Valid-Until=false update && \
    apt-get install -y --no-install-recommends build-essential curl libbz2-dev libcurl4-gnutls-dev libhts-dev liblzma-dev libssl-dev zlib1g-dev && \
    curl --fail --location --silent --show-error --output /opt/ngsBriggs.tar.gz https://github.com/RAHenriksen/ngsBriggs/archive/ab3b5ae8a388b9b1874dd2854fdec32bd9195f22.tar.gz && \
    echo 'afa0d40a8ab85074363cbb6415461504888bb707f04a40ee31b4f632ce629cf7  /opt/ngsBriggs.tar.gz' | sha256sum --check --strict && \
    mkdir /opt/ngsBriggs && \
    tar --extract --gzip --file /opt/ngsBriggs.tar.gz --directory /opt/ngsBriggs --strip-components 1 && \
    make -C /opt/ngsBriggs HTSSRC=systemwide && \
    install -m 0755 /opt/ngsBriggs/ngsbriggs /usr/local/libexec/ngsbriggs && \
    rm -rf /opt/ngsBriggs /opt/ngsBriggs.tar.gz && \
    rm -rf /var/lib/apt/lists/* && \
    useradd --system --uid 65532 --home-dir /work --create-home bijux
COPY containers/tools/ngsbriggs/ngsbriggs /usr/local/bin/ngsbriggs
RUN chmod 0755 /usr/local/bin/ngsbriggs && ngsbriggs --version | grep -Fx 'ngsbriggs 0.01 (commit ab3b5ae8a388b9b1874dd2854fdec32bd9195f22)'
USER 65532:65532
WORKDIR /work
ENTRYPOINT ["/usr/local/bin/ngsbriggs"]
CMD ["--help"]
