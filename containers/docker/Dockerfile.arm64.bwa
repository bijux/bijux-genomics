# VERSION_SOURCE: containers/contracts/catalog.toml
FROM ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b
COPY --chmod=0555 containers/contracts/configure-apt-snapshot /usr/local/sbin/bijux-configure-apt-snapshot
COPY --chmod=0555 containers/tools/bwa/bwa /usr/local/bin/bwa

ARG OCI_CREATED=governed-by-build-evidence
ARG TOOL_VERSION=0.7.17
LABEL org.opencontainers.image.source="https://github.com/lh3/bwa" \
      org.opencontainers.image.revision="9f26bfcc7780753129b60717ecab0ebba6f04b7c" \
      org.opencontainers.image.created="${OCI_CREATED}" \
      org.opencontainers.image.licenses="GPL-3.0-only" \
      org.opencontainers.image.version="${TOOL_VERSION}" \
      org.opencontainers.image.tool="bwa" \
      org.opencontainers.image.title="BWA" \
      org.opencontainers.image.base.name="ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b" \
      org.opencontainers.image.base.digest="sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b"
LABEL io.bijux.tool.version="0.7.17"

ENV LANG=C LC_ALL=C TZ=UTC DEBIAN_FRONTEND=noninteractive
RUN /usr/local/sbin/bijux-configure-apt-snapshot && \
    apt-get install -y --no-install-recommends ca-certificates && \
    apt-get -o Acquire::Check-Valid-Until=false update && \
    apt-get install -y --no-install-recommends curl gcc make zlib1g-dev && \
    curl --fail --location --silent --show-error \
      --output /tmp/bwa.tar.gz \
      https://github.com/lh3/bwa/archive/9f26bfcc7780753129b60717ecab0ebba6f04b7c.tar.gz && \
    echo '79763dd6c48e8b01b8e27d99e6e5575d8bbca419e3eed9f3e330af072e63b370  /tmp/bwa.tar.gz' | sha256sum --check --strict && \
    rm -rf /tmp/bwa-9f26bfcc7780753129b60717ecab0ebba6f04b7c && \
    tar --extract --gzip --file /tmp/bwa.tar.gz --directory /tmp && \
    make --directory /tmp/bwa-9f26bfcc7780753129b60717ecab0ebba6f04b7c \
      CFLAGS='-g -Wall -Wno-unused-function -O2 -fcommon' -j"$(nproc)" && \
    install -m 0755 /tmp/bwa-9f26bfcc7780753129b60717ecab0ebba6f04b7c/bwa /usr/local/libexec-bwa && \
    bwa --version > /tmp/bwa.version && \
    grep -Fx '0.7.17-r1188' /tmp/bwa.version && \
    bwa --help > /tmp/bwa.help && \
    grep -F 'Program: bwa ' /tmp/bwa.help && \
    rm -f /tmp/bwa.version /tmp/bwa.help && \
    rm -rf /tmp/bwa* /var/lib/apt/lists/* && \
    useradd --system --uid 65532 --home-dir /work --create-home bijux

USER 65532:65532
WORKDIR /work
ENTRYPOINT ["/usr/local/bin/bwa"]
CMD ["--help"]
