# VERSION_SOURCE: containers/contracts/catalog.toml
FROM ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b AS builder
COPY --chmod=0555 containers/contracts/configure-apt-snapshot /usr/local/sbin/bijux-configure-apt-snapshot
ARG OCI_CREATED=governed-by-build-evidence
ARG TOOL_VERSION=2.4.1
LABEL org.opencontainers.image.source="https://github.com/poruloh/Eagle" \
      org.opencontainers.image.revision="dec140eefc0eda3b7f02233a3c02361eaeb8227c" \
      org.opencontainers.image.created="${OCI_CREATED}" \
      org.opencontainers.image.licenses="GPL-3.0-or-later" \
      org.opencontainers.image.version="${TOOL_VERSION}" \
      org.opencontainers.image.tool="eagle" \
      org.opencontainers.image.title="Eagle" \
      org.opencontainers.image.base.name="ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b" \
      org.opencontainers.image.base.digest="sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b"
ENV LANG=C LC_ALL=C TZ=UTC DEBIAN_FRONTEND=noninteractive
COPY containers/tools/eagle/portable-aligned-memory.patch /opt/portable-aligned-memory.patch
RUN set -eu; \
    /usr/local/sbin/bijux-configure-apt-snapshot && \
    apt-get install -y --no-install-recommends ca-certificates && \
    apt-get -o Acquire::Check-Valid-Until=false update && \
    apt-get install -y --no-install-recommends build-essential curl libboost-iostreams-dev libboost-program-options-dev libbz2-dev libcurl4-gnutls-dev libhts-dev liblzma-dev libopenblas-dev patch zlib1g-dev && \
    curl --fail --location --silent --show-error --output /opt/eagle.tar.gz https://github.com/poruloh/Eagle/archive/dec140eefc0eda3b7f02233a3c02361eaeb8227c.tar.gz && \
    echo '6ea8f16fb17ca92ebec9cf4ae6b16cccc0ab63f1ca445e6a83b4c16bf4e50255  /opt/eagle.tar.gz' | sha256sum --check --strict && \
    mkdir /opt/eagle && \
    tar --extract --gzip --file /opt/eagle.tar.gz --directory /opt/eagle --strip-components 1 && \
    patch --directory /opt/eagle --strip 1 < /opt/portable-aligned-memory.patch && \
    make --directory /opt/eagle/src -j"$(nproc)" BOOST_INSTALL_DIR=/usr HTSLIB_DIR=/usr BLAS_DIR=/usr/lib/$(uname -m)-linux-gnu LBLAS=-lopenblas CFLAGS='-O2 -std=c++0x -fopenmp -Wall' && \
    install -d -m 0755 /usr/local/libexec && \
    install -m 0755 /opt/eagle/src/eagle /usr/local/libexec/eagle

FROM ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b
COPY --chmod=0555 containers/contracts/configure-apt-snapshot /usr/local/sbin/bijux-configure-apt-snapshot
ARG OCI_CREATED=governed-by-build-evidence
ARG TOOL_VERSION=2.4.1
LABEL org.opencontainers.image.source="https://github.com/poruloh/Eagle" \
      org.opencontainers.image.revision="dec140eefc0eda3b7f02233a3c02361eaeb8227c" \
      org.opencontainers.image.created="${OCI_CREATED}" \
      org.opencontainers.image.licenses="GPL-3.0-or-later" \
      org.opencontainers.image.version="${TOOL_VERSION}" \
      org.opencontainers.image.tool="eagle" \
      org.opencontainers.image.title="Eagle" \
      org.opencontainers.image.base.name="ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b" \
      org.opencontainers.image.base.digest="sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b"
LABEL io.bijux.tool.version="2.4.1"
ENV LANG=C LC_ALL=C TZ=UTC DEBIAN_FRONTEND=noninteractive
RUN set -eu; \
    /usr/local/sbin/bijux-configure-apt-snapshot && \
    apt-get install -y --no-install-recommends ca-certificates && \
    apt-get -o Acquire::Check-Valid-Until=false update && \
    apt-get install -y --no-install-recommends libboost-iostreams1.83.0 libboost-program-options1.83.0 libbz2-1.0 libgomp1 libhts3t64 liblzma5 libopenblas0-pthread zlib1g && \
    rm -rf /var/lib/apt/lists/* && \
    useradd --system --uid 65532 --home-dir /work --create-home bijux
COPY --from=builder /usr/local/libexec/eagle /usr/local/libexec/eagle
COPY containers/tools/eagle/eagle /usr/local/bin/eagle
RUN chmod 0755 /usr/local/bin/eagle && \
    eagle --version | grep -Fx 'eagle 2.4.1 (commit dec140eefc0eda3b7f02233a3c02361eaeb8227c)' && \
    eagle --help >/dev/null
USER 65532:65532
WORKDIR /work
ENTRYPOINT ["eagle"]
CMD ["--help"]
