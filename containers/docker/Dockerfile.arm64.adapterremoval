# VERSION_SOURCE: containers/contracts/catalog.toml
FROM ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b
COPY --chmod=0555 containers/contracts/configure-apt-snapshot /usr/local/sbin/bijux-configure-apt-snapshot

ARG OCI_CREATED=governed-by-build-evidence
ARG TOOL_VERSION=2.3.4
LABEL org.opencontainers.image.source="https://github.com/MikkelSchubert/adapterremoval" \
      org.opencontainers.image.revision="79b296b8fcfd853757d798528128c37a166331a9" \
      org.opencontainers.image.created="${OCI_CREATED}" \
      org.opencontainers.image.licenses="GPL-3.0-only" \
      org.opencontainers.image.version="${TOOL_VERSION}" \
      org.opencontainers.image.tool="adapterremoval" \
      org.opencontainers.image.title="AdapterRemoval" \
      org.opencontainers.image.base.name="ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b" \
      org.opencontainers.image.base.digest="sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b"

ENV LANG=C LC_ALL=C TZ=UTC DEBIAN_FRONTEND=noninteractive
RUN /usr/local/sbin/bijux-configure-apt-snapshot && \
    apt-get install -y --no-install-recommends ca-certificates && \
    apt-get -o Acquire::Check-Valid-Until=false update && \
    apt-get install -y --no-install-recommends curl g++ make zlib1g-dev libbz2-dev && \
    curl --fail --location --silent --show-error \
      --output /tmp/adapterremoval.tar.gz \
      https://github.com/MikkelSchubert/adapterremoval/archive/79b296b8fcfd853757d798528128c37a166331a9.tar.gz && \
    echo '47cc1f41af7de6e9b8057a1ff80748e96df1a1e653bf39d8f6b8321a6f050c20  /tmp/adapterremoval.tar.gz' | sha256sum --check --strict && \
    tar --extract --gzip --file /tmp/adapterremoval.tar.gz --directory /tmp && \
    make --directory /tmp/adapterremoval-79b296b8fcfd853757d798528128c37a166331a9 -j"$(nproc)" && \
    make --directory /tmp/adapterremoval-79b296b8fcfd853757d798528128c37a166331a9 install && \
    ln -s /usr/local/bin/AdapterRemoval /usr/local/bin/adapterremoval && \
    adapterremoval --version && \
    rm -rf /tmp/adapterremoval* /var/lib/apt/lists/* && \
    useradd --system --uid 65532 --home-dir /work --create-home bijux

USER 65532:65532
WORKDIR /work
ENTRYPOINT ["/usr/local/bin/adapterremoval"]
CMD ["--help"]
