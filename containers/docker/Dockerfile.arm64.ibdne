# VERSION_SOURCE: containers/contracts/catalog.toml
FROM ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b
COPY --chmod=0555 containers/contracts/configure-apt-snapshot /usr/local/sbin/bijux-configure-apt-snapshot
ARG OCI_CREATED=governed-by-build-evidence
ARG TOOL_VERSION=23Apr20.ae9
LABEL org.opencontainers.image.source="https://faculty.washington.edu/browning/ibdne.html" \
      org.opencontainers.image.revision="b3324ebd74ed69477067e0aec1dd22be56b1bcedbbe72d8757cda28746312665" \
      org.opencontainers.image.created="${OCI_CREATED}" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.version="${TOOL_VERSION}" \
      org.opencontainers.image.tool="ibdne" \
      org.opencontainers.image.title="IBDNe" \
      org.opencontainers.image.base.name="ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b" \
      org.opencontainers.image.base.digest="sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b"
ENV LANG=C LC_ALL=C TZ=UTC DEBIAN_FRONTEND=noninteractive
RUN /usr/local/sbin/bijux-configure-apt-snapshot && \
    apt-get install -y --no-install-recommends ca-certificates && \
    apt-get -o Acquire::Check-Valid-Until=false update && \
    apt-get install -y --no-install-recommends curl openjdk-17-jre-headless && \
    mkdir -p /opt/ibdne && \
    curl --fail --location --silent --show-error --output /opt/ibdne/ibdne.jar https://faculty.washington.edu/browning/ibdne/ibdne.23Apr20.ae9.jar && \
    curl --fail --location --silent --show-error --output /opt/ibdne/source.zip https://faculty.washington.edu/browning/ibdne/ibdne.23Apr20.ae9.src.zip && \
    echo 'e153f431254f08d41c21ab3db9fbedca4907c25ea3175e67ec10228b132ba48c  /opt/ibdne/ibdne.jar' | sha256sum --check --strict && \
    echo 'b3324ebd74ed69477067e0aec1dd22be56b1bcedbbe72d8757cda28746312665  /opt/ibdne/source.zip' | sha256sum --check --strict && \
    rm /opt/ibdne/source.zip && chmod 0555 /opt/ibdne/ibdne.jar && \
    rm -rf /var/lib/apt/lists/* && useradd --system --uid 65532 --home-dir /work --create-home bijux
COPY containers/tools/ibdne/ibdne /usr/local/bin/ibdne
RUN chmod 0755 /usr/local/bin/ibdne && ibdne --version | grep -Fx 'ibdne 23Apr20.ae9'
USER 65532:65532
WORKDIR /work
ENTRYPOINT ["/usr/local/bin/ibdne"]
CMD ["--help"]
