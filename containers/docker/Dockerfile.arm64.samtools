# VERSION_SOURCE: containers/contracts/catalog.toml
FROM ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b
COPY --chmod=0555 containers/contracts/configure-apt-snapshot /usr/local/sbin/bijux-configure-apt-snapshot

ARG OCI_CREATED=governed-by-build-evidence
ARG TOOL_VERSION=1.20
LABEL org.opencontainers.image.source="https://github.com/samtools/samtools" \
      org.opencontainers.image.revision="906a3b562ef985d2a9777768f8a81001d6ce6dcb" \
      org.opencontainers.image.created="${OCI_CREATED}" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.version="${TOOL_VERSION}" \
      org.opencontainers.image.tool="samtools" \
      org.opencontainers.image.title="Samtools" \
      org.opencontainers.image.base.name="ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b" \
      org.opencontainers.image.base.digest="sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b"

ENV LANG=C LC_ALL=C TZ=UTC DEBIAN_FRONTEND=noninteractive
RUN /usr/local/sbin/bijux-configure-apt-snapshot && \
    apt-get install -y --no-install-recommends ca-certificates && \
    apt-get -o Acquire::Check-Valid-Until=false update && \
    apt-get install -y --no-install-recommends \
      bzip2 curl gcc make perl \
      zlib1g-dev libbz2-dev liblzma-dev libcurl4-openssl-dev libssl-dev libdeflate-dev libncurses-dev && \
    curl --fail --location --silent --show-error \
      --output /tmp/samtools.tar.bz2 \
      https://github.com/samtools/samtools/releases/download/1.20/samtools-1.20.tar.bz2 && \
    echo 'c71be865e241613c2ca99679c074f1a0daeb55288af577db945bdabe3eb2cf10  /tmp/samtools.tar.bz2' | sha256sum --check --strict && \
    tar --extract --bzip2 --file /tmp/samtools.tar.bz2 --directory /tmp && \
    cd /tmp/samtools-1.20 && \
    ./configure --prefix=/usr/local && \
    make -j"$(nproc)" && \
    make install && \
    samtools --version | grep '^samtools 1.20$' && \
    rm -rf /tmp/samtools* /var/lib/apt/lists/* && \
    useradd --system --uid 65532 --home-dir /work --create-home bijux

USER 65532:65532
WORKDIR /work
ENTRYPOINT ["/usr/local/bin/samtools"]
CMD ["--help"]
