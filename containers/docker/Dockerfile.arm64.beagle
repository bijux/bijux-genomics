# VERSION_SOURCE: containers/versions/versions.toml
FROM ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b
COPY --chmod=0555 containers/contracts/configure-apt-snapshot /usr/local/sbin/bijux-configure-apt-snapshot
ARG OCI_CREATED=governed-by-build-evidence
ARG TOOL_VERSION=5.4
LABEL org.opencontainers.image.source="https://faculty.washington.edu/browning/beagle/beagle.html" \
      org.opencontainers.image.revision="938f0b1ab12385e0686790cef52d7b9491c96c0c1837af5c0d62c9a6576a8956" \
      org.opencontainers.image.created="${OCI_CREATED}" \
      org.opencontainers.image.licenses="GPL-3.0" \
      org.opencontainers.image.version="${TOOL_VERSION}"
LABEL org.opencontainers.image.tool="beagle"
LABEL org.opencontainers.image.title="beagle"
LABEL org.opencontainers.image.base.name="ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b"
LABEL org.opencontainers.image.base.digest="sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b"
LABEL io.bijux.tool.version="5.4"
ENV LANG=C LC_ALL=C TZ=UTC DEBIAN_FRONTEND=noninteractive

RUN /usr/local/sbin/bijux-configure-apt-snapshot && \
    apt-get install -y --no-install-recommends ca-certificates && \
    apt-get -o Acquire::Check-Valid-Until=false update && \
    apt-get install -y --no-install-recommends curl openjdk-21-jre-headless && \
    install -d -m 0755 /opt/beagle && \
    curl --fail --location --proto '=https' --tlsv1.2 \
      --output /opt/beagle/beagle.jar \
      https://faculty.washington.edu/browning/beagle/beagle.29Oct24.c8e.jar && \
    echo '938f0b1ab12385e0686790cef52d7b9491c96c0c1837af5c0d62c9a6576a8956  /opt/beagle/beagle.jar' | sha256sum -c - && \
    apt-get purge -y --auto-remove curl && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* && \
    useradd --system --uid 65532 --home-dir /work --create-home bijux
COPY containers/tools/beagle/beagle /usr/local/bin/beagle
RUN chmod 0755 /usr/local/bin/beagle && \
    beagle --version | grep -Fx 'beagle 5.4' && \
    beagle --help >/dev/null

USER 65532:65532
WORKDIR /work
ENTRYPOINT ["/usr/local/bin/beagle"]
CMD ["--help"]
