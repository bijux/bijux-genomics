# VERSION_SOURCE: containers/contracts/catalog.toml
FROM ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b
COPY --chmod=0555 containers/contracts/configure-apt-snapshot /usr/local/sbin/bijux-configure-apt-snapshot
COPY --chmod=0555 containers/tools/seqtk/seqtk /usr/local/bin/seqtk

ARG OCI_CREATED=governed-by-build-evidence
ARG TOOL_VERSION=1.4
LABEL org.opencontainers.image.source="https://github.com/lh3/seqtk" \
      org.opencontainers.image.revision="ae7defa8bead3ef77d241f12194dc66acdd40fca" \
      org.opencontainers.image.created="${OCI_CREATED}" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.version="${TOOL_VERSION}" \
      io.bijux.tool.version="${TOOL_VERSION}" \
      org.opencontainers.image.tool="seqtk" \
      org.opencontainers.image.title="Seqtk" \
      org.opencontainers.image.base.name="ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b" \
      org.opencontainers.image.base.digest="sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b"

ENV LANG=C LC_ALL=C TZ=UTC DEBIAN_FRONTEND=noninteractive
RUN /usr/local/sbin/bijux-configure-apt-snapshot && \
    apt-get install -y --no-install-recommends zlib1g && \
    apt-get install -y --no-install-recommends curl gcc make zlib1g-dev && \
    curl --fail --location --proto '=https' --tlsv1.2 \
      --output /opt/seqtk.tar.gz \
      https://codeload.github.com/lh3/seqtk/tar.gz/refs/tags/v1.4 && \
    echo 'd124604ec24f29ed14ce127426ab90e0f3a2c0280c80d1a3ff8b1c09feede19c  /opt/seqtk.tar.gz' | sha256sum --check --strict && \
    tar --extract --gzip --file /opt/seqtk.tar.gz --directory /opt && \
    make --directory /opt/seqtk-1.4 -j"$(nproc)" && \
    install -d -m 0755 /opt/seqtk/bin && \
    install -m 0755 /opt/seqtk-1.4/seqtk /opt/seqtk/bin/seqtk-native && \
    chmod 0755 /usr/local/bin/seqtk && \
    seqtk --version | grep -Fx 'seqtk 1.4' && \
    seqtk --help >/dev/null && \
    useradd --system --uid 65532 --home-dir /work --create-home bijux && \
    rm -rf /opt/seqtk.tar.gz /opt/seqtk-1.4 && \
    apt-get purge -y --auto-remove curl gcc make zlib1g-dev && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

USER 65532:65532
WORKDIR /work
ENTRYPOINT ["/usr/local/bin/seqtk"]
CMD ["--help"]
