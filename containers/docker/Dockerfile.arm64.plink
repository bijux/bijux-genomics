# VERSION_SOURCE: containers/versions/versions.toml
FROM ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b
COPY --chmod=0555 containers/contracts/configure-apt-snapshot /usr/local/sbin/bijux-configure-apt-snapshot
ARG OCI_REVISION=unknown
ARG OCI_CREATED=unknown
ARG TOOL_VERSION=1.90b7.2
LABEL org.opencontainers.image.source="https://github.com/bijux/bijux-genomics" \
      org.opencontainers.image.revision="${OCI_REVISION}" \
      org.opencontainers.image.created="${OCI_CREATED}" \
      org.opencontainers.image.licenses="GPL-3.0" \
      org.opencontainers.image.version="${TOOL_VERSION}"
LABEL org.opencontainers.image.tool="plink"
LABEL org.opencontainers.image.title="plink"
LABEL org.opencontainers.image.base.name="ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b"
LABEL org.opencontainers.image.base.digest="sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b"
LABEL io.bijux.tool.version="1.90b7.2"
ENV DEBIAN_FRONTEND=noninteractive

RUN /usr/local/sbin/bijux-configure-apt-snapshot && apt-get install -y --no-install-recommends \
    ca-certificates curl unzip && rm -rf /var/lib/apt/lists/*
RUN curl -fsSL -o /tmp/plink.zip https://s3.amazonaws.com/plink1-assets/plink_linux_x86_64_20231211.zip && \
    echo "1162eca207ecec12b03397a3a9be5eed0527f5d21c173dc24335340ddd191bc3  /tmp/plink.zip" | sha256sum -c - && \
    unzip -q /tmp/plink.zip -d /opt/plink && \
    install -m 0755 /opt/plink/plink /usr/local/bin/plink && \
    rm -rf /tmp/plink.zip /opt/plink

ENTRYPOINT ["/usr/local/bin/plink"]
CMD ["--help"]
