# VERSION_SOURCE: containers/versions/versions.toml
FROM rust:1.95.0-bookworm@sha256:6258907abe69656e41cd992e0b705cdcfabcbbe3db374f92ed2d47121282d4a1 AS build

WORKDIR /workspace

COPY .cargo .cargo
COPY Cargo.toml Cargo.lock rust-toolchain.toml rustfmt.toml ./
COPY crates crates
COPY configs configs
COPY domain domain
COPY benchmarks benchmarks

RUN cargo build --release -p bijux-dna

FROM ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b
COPY --chmod=0555 containers/contracts/configure-apt-snapshot /usr/local/sbin/bijux-configure-apt-snapshot
ARG OCI_REVISION
ARG OCI_CREATED=governed-by-build-evidence
ARG TOOL_VERSION=0.1.0
RUN printf '%s\n' "${OCI_REVISION}" | grep -Eq '^[0-9a-f]{40}$'
LABEL org.opencontainers.image.source="https://github.com/bijux/bijux-genomics" \
      org.opencontainers.image.revision="${OCI_REVISION}" \
      org.opencontainers.image.created="${OCI_CREATED}" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.version="${TOOL_VERSION}"
LABEL org.opencontainers.image.tool="bijux_dna"
LABEL org.opencontainers.image.title="bijux_dna"
LABEL org.opencontainers.image.base.name="ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b"
LABEL org.opencontainers.image.base.digest="sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b"
LABEL io.bijux.tool.version="0.1.0"
ENV DEBIAN_FRONTEND=noninteractive

RUN /usr/local/sbin/bijux-configure-apt-snapshot && \
    apt-get install -y --no-install-recommends ca-certificates && \
    rm -rf /var/lib/apt/lists/* && \
    useradd --system --uid 65532 --home-dir /work --create-home bijux

RUN mkdir -p /opt/bijux
COPY --from=build /workspace/target/release/bijux-dna /usr/local/bin/bijux-dna
COPY --from=build /workspace/configs /opt/bijux/configs
COPY --from=build /workspace/domain /opt/bijux/domain
COPY --from=build /workspace/benchmarks /opt/bijux/benchmarks

USER 65532:65532
WORKDIR /work
ENTRYPOINT ["/usr/local/bin/bijux-dna"]
CMD ["--help"]
