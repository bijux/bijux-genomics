# VERSION_SOURCE: containers/versions/versions.toml
FROM ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b AS builder
COPY --chmod=0555 containers/contracts/configure-apt-snapshot /usr/local/sbin/bijux-configure-apt-snapshot
ARG OCI_CREATED=governed-by-build-evidence
ARG TOOL_VERSION=0.9.6
LABEL org.opencontainers.image.source="https://cme.h-its.org/exelixis/web/software/pear/" \
      org.opencontainers.image.revision="f7728371e26a5b46fa928b0f7ae1b552ed6a78815b117ba48ef1af98e96c8e2b" \
      org.opencontainers.image.created="${OCI_CREATED}" \
      org.opencontainers.image.licenses="GPL-3.0" \
      org.opencontainers.image.version="${TOOL_VERSION}"
LABEL org.opencontainers.image.tool="pear"
LABEL org.opencontainers.image.title="pear"
LABEL org.opencontainers.image.base.name="ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b"
LABEL org.opencontainers.image.base.digest="sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b"
ENV LANG=C LC_ALL=C TZ=UTC DEBIAN_FRONTEND=noninteractive VERSION_PEAR=0.9.6
RUN /usr/local/sbin/bijux-configure-apt-snapshot && \
    apt-get install -y --no-install-recommends ca-certificates && \
    apt-get -o Acquire::Check-Valid-Until=false update && \
    apt-get install -y --no-install-recommends autoconf automake build-essential curl libbz2-dev liblzma-dev libtool m4 pkg-config zlib1g-dev && \
    curl --fail --location --silent --show-error --output /opt/pear.tar.gz https://depot.galaxyproject.org/software/pear/pear_0.9.6_src_all.tar.gz && \
    echo 'f7728371e26a5b46fa928b0f7ae1b552ed6a78815b117ba48ef1af98e96c8e2b  /opt/pear.tar.gz' | sha256sum --check --strict && \
    tar --extract --gzip --file /opt/pear.tar.gz --directory /opt && \
    cd /opt/pear-0.9.6-src && \
    autoreconf --install && \
    ./configure --prefix=/usr/local && \
    make -j"$(nproc)" && \
    make install && \
    mv /usr/local/bin/pear /usr/local/libexec-pear && \
    test -x /usr/local/libexec-pear

FROM ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b
COPY --chmod=0555 containers/contracts/configure-apt-snapshot /usr/local/sbin/bijux-configure-apt-snapshot
ARG OCI_CREATED=governed-by-build-evidence
ARG TOOL_VERSION=0.9.6
LABEL org.opencontainers.image.source="https://cme.h-its.org/exelixis/web/software/pear/" \
      org.opencontainers.image.revision="f7728371e26a5b46fa928b0f7ae1b552ed6a78815b117ba48ef1af98e96c8e2b" \
      org.opencontainers.image.created="${OCI_CREATED}" \
      org.opencontainers.image.licenses="GPL-3.0" \
      org.opencontainers.image.version="${TOOL_VERSION}" \
      org.opencontainers.image.tool="pear" \
      org.opencontainers.image.title="PEAR" \
      org.opencontainers.image.base.name="ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b" \
      org.opencontainers.image.base.digest="sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b"
LABEL io.bijux.tool.version="0.9.6"
ENV LANG=C LC_ALL=C TZ=UTC DEBIAN_FRONTEND=noninteractive VERSION_PEAR=0.9.6
RUN /usr/local/sbin/bijux-configure-apt-snapshot && \
    apt-get install -y --no-install-recommends ca-certificates && \
    apt-get -o Acquire::Check-Valid-Until=false update && \
    apt-get install -y --no-install-recommends libbz2-1.0 libgomp1 liblzma5 zlib1g && \
    rm -rf /var/lib/apt/lists/* && \
    useradd --system --uid 65532 --home-dir /work --create-home bijux
COPY --from=builder /usr/local/libexec-pear /usr/local/libexec-pear
COPY containers/tools/pear/pear /usr/local/bin/pear
RUN chmod 0755 /usr/local/bin/pear && \
    pear --version | grep -Fx '0.9.6' && \
    pear --help >/dev/null
USER 65532:65532
WORKDIR /work
ENTRYPOINT ["pear"]
CMD ["--help"]
