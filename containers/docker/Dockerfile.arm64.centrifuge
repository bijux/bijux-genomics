# VERSION_SOURCE: containers/contracts/catalog.toml
FROM ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b AS builder
ENV DEBIAN_FRONTEND=noninteractive
RUN sed -i 's#http://archive.ubuntu.com/ubuntu/#https://snapshot.ubuntu.com/ubuntu/20260802T000000Z/#g; s#http://security.ubuntu.com/ubuntu/#https://snapshot.ubuntu.com/ubuntu/20260802T000000Z/#g' /etc/apt/sources.list.d/ubuntu.sources && \
    apt-get -o Acquire::https::Verify-Peer=false -o Acquire::Check-Valid-Until=false update && \
    apt-get -o Acquire::https::Verify-Peer=false install -y --no-install-recommends ca-certificates && \
    apt-get -o Acquire::Check-Valid-Until=false update && \
    apt-get install -y --no-install-recommends build-essential curl zlib1g-dev libbz2-dev liblzma-dev perl python3
COPY containers/tools/centrifuge/install /opt/centrifuge-build/install
COPY containers/tools/centrifuge/centrifuge /usr/local/bin/centrifuge
RUN chmod 0755 /opt/centrifuge-build/install /usr/local/bin/centrifuge && /opt/centrifuge-build/install

FROM ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b
ARG OCI_CREATED=governed-by-build-evidence
ARG TOOL_VERSION=1.0.4
LABEL org.opencontainers.image.source="https://github.com/DaehwanKimLab/centrifuge" \
      org.opencontainers.image.revision="92d6e7969afd786ba196b019620453a965a46cdd" \
      org.opencontainers.image.created="${OCI_CREATED}" \
      org.opencontainers.image.licenses="GPL-3.0-or-later" \
      org.opencontainers.image.version="${TOOL_VERSION}"
LABEL org.opencontainers.image.tool="centrifuge"
LABEL org.opencontainers.image.title="Centrifuge"
LABEL org.opencontainers.image.base.name="ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b"
LABEL org.opencontainers.image.base.digest="sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b"
ENV LANG=C LC_ALL=C TZ=UTC PYTHONNOUSERSITE=1 \
    PATH=/usr/local/bin:/opt/centrifuge/bin:/usr/bin:/bin
RUN apt-get update && \
    apt-get install -y --no-install-recommends zlib1g libbz2-1.0 liblzma5 perl python3 python-is-python3 gzip bzip2 && \
    rm -rf /var/lib/apt/lists/* && \
    useradd --system --uid 65532 --home-dir /work --create-home bijux
COPY --from=builder /opt/centrifuge /opt/centrifuge
COPY containers/tools/centrifuge/centrifuge /usr/local/bin/centrifuge
RUN chmod 0755 /usr/local/bin/centrifuge && \
    centrifuge --version | grep -Fx 'Centrifuge 1.0.4' && \
    centrifuge --help >/dev/null && \
    python --version 2>&1 | grep -E '^Python 3[.]'

USER 65532:65532
WORKDIR /work
ENTRYPOINT ["centrifuge"]
CMD ["--help"]
