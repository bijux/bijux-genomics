# VERSION_SOURCE: containers/contracts/catalog.toml
FROM ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b
ARG OCI_CREATED=governed-by-build-evidence
ARG TOOL_VERSION=1.26.0
LABEL org.opencontainers.image.source="https://github.com/telatin/seqfu2" \
      org.opencontainers.image.revision="681a8fe013f8bed1590ff68e2f62820d2d4303c5" \
      org.opencontainers.image.created="${OCI_CREATED}" \
      org.opencontainers.image.licenses="GPL-3.0-only" \
      org.opencontainers.image.version="${TOOL_VERSION}" \
      org.opencontainers.image.tool="seqfu" \
      org.opencontainers.image.title="SeqFu" \
      org.opencontainers.image.base.name="ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b" \
      org.opencontainers.image.base.digest="sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b"
ENV LANG=C LC_ALL=C TZ=UTC DEBIAN_FRONTEND=noninteractive
RUN sed -i 's#http://archive.ubuntu.com/ubuntu/#https://snapshot.ubuntu.com/ubuntu/20260802T000000Z/#g; s#http://security.ubuntu.com/ubuntu/#https://snapshot.ubuntu.com/ubuntu/20260802T000000Z/#g' /etc/apt/sources.list.d/ubuntu.sources && \
    apt-get -o Acquire::https::Verify-Peer=false -o Acquire::Check-Valid-Until=false update && \
    apt-get -o Acquire::https::Verify-Peer=false install -y --no-install-recommends ca-certificates && \
    apt-get -o Acquire::Check-Valid-Until=false update && \
    apt-get install -y --no-install-recommends curl unzip zstd zlib1g && \
    curl --fail --location --silent --show-error --output /opt/seqfu.conda https://api.anaconda.org/download/bioconda/seqfu/1.26.0/linux-aarch64/seqfu-1.26.0-h0bbf5d2_0.conda && \
    echo '158efdbdb2c47bf4ed7397805ea69d35800672ca289ac25c0bc8e2fc40f145f6  /opt/seqfu.conda' | sha256sum --check --strict && \
    mkdir /opt/seqfu-package && \
    unzip -q /opt/seqfu.conda 'pkg-*.tar.zst' -d /opt/seqfu-package && \
    tar --zstd --extract --file /opt/seqfu-package/pkg-seqfu-1.26.0-h0bbf5d2_0.tar.zst --directory /usr/local && \
    seqfu --version | grep -Fx '1.26.0' && \
    rm -rf /opt/seqfu.conda /opt/seqfu-package /var/lib/apt/lists/* && \
    useradd --system --uid 65532 --home-dir /work --create-home bijux
USER 65532:65532
WORKDIR /work
ENTRYPOINT ["/usr/local/bin/seqfu"]
CMD ["--help"]
