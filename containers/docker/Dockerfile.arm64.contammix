# VERSION_SOURCE: containers/contracts/catalog.toml
FROM ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b AS builder
ENV DEBIAN_FRONTEND=noninteractive
RUN sed -i 's#http://archive.ubuntu.com/ubuntu/#https://snapshot.ubuntu.com/ubuntu/20260802T000000Z/#g; s#http://security.ubuntu.com/ubuntu/#https://snapshot.ubuntu.com/ubuntu/20260802T000000Z/#g' /etc/apt/sources.list.d/ubuntu.sources && \
    apt-get -o Acquire::https::Verify-Peer=false -o Acquire::Check-Valid-Until=false update && \
    apt-get -o Acquire::https::Verify-Peer=false install -y --no-install-recommends ca-certificates && \
    apt-get -o Acquire::Check-Valid-Until=false update && \
    apt-get install -y --no-install-recommends build-essential curl perl r-base-core r-base-dev r-cran-coda r-cran-getopt
COPY containers/tools/contammix/install /opt/contammix-build/install
COPY containers/tools/contammix/contammix /usr/local/bin/contammix
RUN chmod 0755 /opt/contammix-build/install /usr/local/bin/contammix && /opt/contammix-build/install

FROM ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b
ARG OCI_CREATED=governed-by-build-evidence
ARG TOOL_VERSION=1.0.11
LABEL org.opencontainers.image.source="https://github.com/plfjohnson/contamMix" \
      org.opencontainers.image.revision="46c2b9c9fa82c2507f2b084f0b37d862a0825f4b" \
      org.opencontainers.image.created="${OCI_CREATED}" \
      org.opencontainers.image.licenses="GPL-3.0-only" \
      org.opencontainers.image.version="${TOOL_VERSION}"
LABEL org.opencontainers.image.tool="contammix"
LABEL org.opencontainers.image.title="contamMix"
LABEL org.opencontainers.image.base.name="ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b"
LABEL org.opencontainers.image.base.digest="sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b"
ENV LANG=C LC_ALL=C TZ=UTC R_ENVIRON_USER=/dev/null R_PROFILE_USER=/dev/null \
    PATH=/usr/local/bin:/usr/bin:/bin
RUN apt-get update && \
    apt-get install -y --no-install-recommends perl r-base-core r-cran-coda r-cran-getopt samtools && \
    rm -rf /var/lib/apt/lists/* && \
    useradd --system --uid 65532 --home-dir /work --create-home bijux
COPY --from=builder /usr/local/lib/R/site-library/contamMix /usr/local/lib/R/site-library/contamMix
COPY containers/tools/contammix/contammix /usr/local/bin/contammix
RUN chmod 0755 /usr/local/bin/contammix && \
    contammix --version | grep -Fx 'contammix 1.0.11 (contamMix package 1.0-10)' && \
    contammix --help >/dev/null && \
    Rscript -e 'stopifnot(as.character(packageVersion("contamMix")) == "1.0.10")'

USER 65532:65532
WORKDIR /work
ENTRYPOINT ["contammix"]
CMD ["--help"]
