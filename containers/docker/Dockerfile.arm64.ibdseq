# VERSION_SOURCE: containers/contracts/catalog.toml
FROM ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b
ARG OCI_CREATED=governed-by-build-evidence
ARG TOOL_VERSION=r1206
LABEL org.opencontainers.image.source="https://faculty.washington.edu/browning/ibdseq.html" \
      org.opencontainers.image.revision="a835c7282444d8920109362ca012f9a9ac1eb54665d34fb0ca0380a3e0fed8ec" \
      org.opencontainers.image.created="${OCI_CREATED}" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.version="${TOOL_VERSION}" \
      org.opencontainers.image.tool="ibdseq" \
      org.opencontainers.image.title="IBDseq" \
      org.opencontainers.image.base.name="ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b" \
      org.opencontainers.image.base.digest="sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b"
ENV LANG=C LC_ALL=C TZ=UTC DEBIAN_FRONTEND=noninteractive
RUN sed -i 's#http://archive.ubuntu.com/ubuntu/#https://snapshot.ubuntu.com/ubuntu/20260802T000000Z/#g; s#http://security.ubuntu.com/ubuntu/#https://snapshot.ubuntu.com/ubuntu/20260802T000000Z/#g' /etc/apt/sources.list.d/ubuntu.sources && \
    apt-get -o Acquire::https::Verify-Peer=false -o Acquire::Check-Valid-Until=false update && \
    apt-get -o Acquire::https::Verify-Peer=false install -y --no-install-recommends ca-certificates && \
    apt-get -o Acquire::Check-Valid-Until=false update && \
    apt-get install -y --no-install-recommends curl openjdk-17-jre-headless && \
    mkdir -p /opt/ibdseq && \
    curl --fail --location --silent --show-error --output /opt/ibdseq/ibdseq.jar https://faculty.washington.edu/browning/ibdseq/ibdseq.r1206.jar && \
    curl --fail --location --silent --show-error --output /opt/ibdseq/source.zip https://faculty.washington.edu/browning/ibdseq/ibdseq.r1206.zip && \
    echo '6b750f46f5557e8c5e2f612449d34510c14392d427632ee850de5e96e5d0c2e1  /opt/ibdseq/ibdseq.jar' | sha256sum --check --strict && \
    echo 'a835c7282444d8920109362ca012f9a9ac1eb54665d34fb0ca0380a3e0fed8ec  /opt/ibdseq/source.zip' | sha256sum --check --strict && \
    rm /opt/ibdseq/source.zip && chmod 0555 /opt/ibdseq/ibdseq.jar && \
    rm -rf /var/lib/apt/lists/* && useradd --system --uid 65532 --home-dir /work --create-home bijux
COPY containers/tools/ibdseq/ibdseq /usr/local/bin/ibdseq
RUN chmod 0755 /usr/local/bin/ibdseq && ibdseq --version | grep -Fx 'ibdseq r1206'
USER 65532:65532
WORKDIR /work
ENTRYPOINT ["/usr/local/bin/ibdseq"]
CMD ["--help"]
