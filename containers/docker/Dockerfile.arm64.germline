# VERSION_SOURCE: containers/versions/versions.toml
FROM ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b
COPY --chmod=0555 containers/contracts/configure-apt-snapshot /usr/local/sbin/bijux-configure-apt-snapshot
ARG OCI_CREATED=governed-by-build-evidence
ARG TOOL_VERSION=1.5.3
LABEL org.opencontainers.image.source="https://github.com/gusevlab/germline" \
      org.opencontainers.image.revision="f8029fcf469a09a83aa1e0d1fb45769f6dcb3c6d" \
      org.opencontainers.image.created="${OCI_CREATED}" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.version="${TOOL_VERSION}"
LABEL org.opencontainers.image.tool="germline"
LABEL org.opencontainers.image.title="germline"
LABEL org.opencontainers.image.base.name="ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b"
LABEL org.opencontainers.image.base.digest="sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b"
ENV LANG=C LC_ALL=C TZ=UTC DEBIAN_FRONTEND=noninteractive

RUN /usr/local/sbin/bijux-configure-apt-snapshot && \
    apt-get install -y --no-install-recommends ca-certificates && \
    apt-get -o Acquire::Check-Valid-Until=false update && \
    apt-get install -y --no-install-recommends libstdc++6 && \
    apt-get install -y --no-install-recommends curl g++ make && \
    curl --fail --location --proto '=https' --tlsv1.2 --output /opt/germline.tar.gz https://codeload.github.com/gusevlab/germline/tar.gz/f8029fcf469a09a83aa1e0d1fb45769f6dcb3c6d && \
    echo '42a6e14e003ac6aa5cc5c3b14db4ba355d748c014b0d0a10f0f734dca2bfb991  /opt/germline.tar.gz' | sha256sum -c - && \
    tar --extract --gzip --file /opt/germline.tar.gz --directory /opt && \
    make --directory /opt/germline-f8029fcf469a09a83aa1e0d1fb45769f6dcb3c6d germline && \
    install -d -m 0755 /opt/germline/bin && \
    install -m 0755 /opt/germline-f8029fcf469a09a83aa1e0d1fb45769f6dcb3c6d/germline /opt/germline/bin/germline-native && \
    rm -rf /opt/germline.tar.gz /opt/germline-f8029fcf469a09a83aa1e0d1fb45769f6dcb3c6d && \
    apt-get purge -y --auto-remove curl g++ make && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* && \
    useradd --system --uid 65532 --home-dir /work --create-home bijux
COPY containers/tools/germline/germline /usr/local/bin/germline
RUN chmod 0755 /usr/local/bin/germline /opt/germline/bin/germline-native && \
    germline --version | grep -Fx 'germline 1.5.3' && \
    germline --help >/dev/null

USER 65532:65532
WORKDIR /work
ENTRYPOINT ["germline"]
CMD ["--help"]
