# VERSION_SOURCE: containers/contracts/catalog.toml
FROM ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b AS builder
COPY --chmod=0555 containers/contracts/configure-apt-snapshot /usr/local/sbin/bijux-configure-apt-snapshot
ENV DEBIAN_FRONTEND=noninteractive
RUN /usr/local/sbin/bijux-configure-apt-snapshot && \
    apt-get install -y --no-install-recommends ca-certificates && \
    apt-get -o Acquire::Check-Valid-Until=false update && \
    apt-get install -y --no-install-recommends autoconf automake curl g++ libbz2-dev liblzma-dev libtool make pkg-config zlib1g-dev && \
    curl --fail --location --proto '=https' --tlsv1.2 --output /opt/vsearch.tar.gz https://codeload.github.com/torognes/vsearch/tar.gz/bbd17a05faaf7401176e36b7947874c1e5152cee && \
    echo '6a1039a99422340cbfb3c723f0caa414e91e7d36b963075e59f033ac59580c0e  /opt/vsearch.tar.gz' | sha256sum -c - && \
    tar --extract --gzip --file /opt/vsearch.tar.gz --directory /opt && \
    cd /opt/vsearch-bbd17a05faaf7401176e36b7947874c1e5152cee && \
    ./autogen.sh && \
    ./configure --quiet CFLAGS=-O3 CXXFLAGS=-O3 && \
    make -j2 && \
    install -d -m 0755 /opt/vsearch/bin && \
    install -m 0755 ./bin/vsearch /opt/vsearch/bin/vsearch-native

FROM ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b
COPY --chmod=0555 containers/contracts/configure-apt-snapshot /usr/local/sbin/bijux-configure-apt-snapshot
ARG OCI_CREATED=governed-by-build-evidence
ARG TOOL_VERSION=2.29.3
LABEL org.opencontainers.image.source="https://github.com/torognes/vsearch" \
      org.opencontainers.image.revision="bbd17a05faaf7401176e36b7947874c1e5152cee" \
      org.opencontainers.image.created="${OCI_CREATED}" \
      org.opencontainers.image.licenses="BSD-2-Clause" \
      org.opencontainers.image.version="${TOOL_VERSION}"
LABEL org.opencontainers.image.tool="vsearch"
LABEL org.opencontainers.image.title="VSEARCH"
LABEL org.opencontainers.image.base.name="ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b"
LABEL org.opencontainers.image.base.digest="sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b"
ENV LANG=C LC_ALL=C TZ=UTC DEBIAN_FRONTEND=noninteractive
RUN /usr/local/sbin/bijux-configure-apt-snapshot && \
    apt-get -o Acquire::Check-Valid-Until=false install -y --no-install-recommends libbz2-1.0 liblzma5 libstdc++6 zlib1g && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* && \
    useradd --system --uid 65532 --home-dir /work --create-home bijux
COPY --from=builder /opt/vsearch /opt/vsearch
COPY containers/tools/vsearch/vsearch /usr/local/bin/vsearch
RUN chmod 0755 /usr/local/bin/vsearch /opt/vsearch/bin/vsearch-native && \
    vsearch --version | grep -Fx 'vsearch 2.29.3' && \
    vsearch --help >/dev/null

USER 65532:65532
WORKDIR /work
ENTRYPOINT ["vsearch"]
CMD ["--help"]
