# VERSION_SOURCE: containers/contracts/catalog.toml
FROM ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b AS builder
RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates build-essential cmake curl zlib1g-dev
COPY containers/tools/diamond/install /opt/diamond-build/install
RUN chmod 0755 /opt/diamond-build/install && /opt/diamond-build/install

FROM ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b
ARG OCI_CREATED=governed-by-build-evidence
ARG TOOL_VERSION=2.1.10
LABEL org.opencontainers.image.source="https://github.com/bbuchfink/diamond" \
      org.opencontainers.image.revision="1130513e06223ffd12c74a11e8e2c967e108a825" \
      org.opencontainers.image.created="${OCI_CREATED}" \
      org.opencontainers.image.licenses="GPL-3.0-or-later" \
      org.opencontainers.image.version="${TOOL_VERSION}"
LABEL org.opencontainers.image.tool="diamond"
LABEL org.opencontainers.image.title="diamond"
LABEL org.opencontainers.image.base.name="ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b"
LABEL org.opencontainers.image.base.digest="sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b"
ENV LANG=C LC_ALL=C TZ=UTC PATH=/opt/diamond/bin:/usr/local/bin:/usr/bin:/bin
RUN apt-get update && \
    apt-get install -y --no-install-recommends zlib1g libstdc++6 && \
    rm -rf /var/lib/apt/lists/* && \
    useradd --system --uid 65532 --home-dir /work --create-home bijux
COPY --from=builder /opt/diamond /opt/diamond
RUN diamond version | grep -Fx 'diamond version 2.1.10' && diamond help >/dev/null

USER 65532:65532
WORKDIR /work
ENTRYPOINT ["diamond"]
CMD ["help"]
