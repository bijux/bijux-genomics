# VERSION_SOURCE: containers/contracts/catalog.toml
FROM ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b
COPY --chmod=0555 containers/contracts/configure-apt-snapshot /usr/local/sbin/bijux-configure-apt-snapshot
COPY --chmod=0555 containers/tools/bedtools/bedtools /usr/local/bin/bedtools

ARG OCI_CREATED=governed-by-build-evidence
ARG TOOL_VERSION=2.31.1
LABEL org.opencontainers.image.source="https://github.com/arq5x/bedtools2" \
      org.opencontainers.image.revision="705ccfdf2c9a77d71560c8adcece0663c2f5e18e" \
      org.opencontainers.image.created="${OCI_CREATED}" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.version="${TOOL_VERSION}" \
      io.bijux.tool.version="${TOOL_VERSION}" \
      org.opencontainers.image.tool="bedtools" \
      org.opencontainers.image.title="BEDTools" \
      org.opencontainers.image.base.name="ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b" \
      org.opencontainers.image.base.digest="sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b"

ENV LANG=C LC_ALL=C TZ=UTC DEBIAN_FRONTEND=noninteractive
RUN /usr/local/sbin/bijux-configure-apt-snapshot && \
    apt-get install -y --no-install-recommends libbz2-1.0 liblzma5 zlib1g && \
    apt-get install -y --no-install-recommends curl g++ libbz2-dev liblzma-dev make python3 zlib1g-dev && \
    curl --fail --location --proto '=https' --tlsv1.2 \
      --output /opt/bedtools.tar.gz \
      https://codeload.github.com/arq5x/bedtools2/tar.gz/refs/tags/v2.31.1 && \
    echo '79a1ba318d309f4e74bfa74258b73ef578dccb1045e270998d7fe9da9f43a50e  /opt/bedtools.tar.gz' | sha256sum --check --strict && \
    tar --extract --gzip --file /opt/bedtools.tar.gz --directory /opt && \
    make --directory /opt/bedtools2-2.31.1 -j"$(nproc)" && \
    install -d -m 0755 /opt/bedtools/bin && \
    install -m 0755 /opt/bedtools2-2.31.1/bin/bedtools /opt/bedtools/bin/bedtools-native && \
    chmod 0755 /usr/local/bin/bedtools && \
    bedtools --version | grep -Fx 'bedtools v2.31.1' && \
    bedtools --help >/dev/null && \
    useradd --system --uid 65532 --home-dir /work --create-home bijux && \
    rm -rf /opt/bedtools.tar.gz /opt/bedtools2-2.31.1 && \
    apt-get purge -y --auto-remove curl g++ libbz2-dev liblzma-dev make python3 zlib1g-dev && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

USER 65532:65532
WORKDIR /work
ENTRYPOINT ["/usr/local/bin/bedtools"]
CMD ["--help"]
