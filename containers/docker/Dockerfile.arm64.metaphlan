# VERSION_SOURCE: containers/versions/versions.toml
FROM ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b
COPY --chmod=0555 containers/contracts/configure-apt-snapshot /usr/local/sbin/bijux-configure-apt-snapshot
ARG TOOL_VERSION=4.1.1
LABEL org.opencontainers.image.source="https://github.com/biobakery/MetaPhlAn" \
      org.opencontainers.image.revision="66d5a7ebd21c64c5b6fd6db6a35ff44b820dfbd2" \
      org.opencontainers.image.created="governed-by-build-evidence" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.version="${TOOL_VERSION}"
LABEL org.opencontainers.image.tool="metaphlan"
LABEL org.opencontainers.image.title="metaphlan"
LABEL org.opencontainers.image.base.name="ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b"
LABEL org.opencontainers.image.base.digest="sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b"
LABEL io.bijux.tool.version="4.1.1"

ARG VERSION_METAPHLAN=4.1.1
ENV VERSION_METAPHLAN=${VERSION_METAPHLAN} \
    DEBIAN_FRONTEND=noninteractive

# Native extensions require the declared compiler and library surface.
RUN set -eux; \
    /usr/local/sbin/bijux-configure-apt-snapshot && \
    apt-get install -y --no-install-recommends \
      python3 \
      python3-pip \
      python3-dev \
      build-essential \
      pkg-config \
      libbz2-dev \
      liblzma-dev \
      libcurl4-gnutls-dev \
      libssl-dev \
      zlib1g-dev \
      libhdf5-dev && \
    rm -rf /var/lib/apt/lists/*

RUN set -eux; \
    pip3 install --no-cache-dir --break-system-packages metaphlan==${VERSION_METAPHLAN} && \
    metaphlan --version > /tmp/metaphlan.version && \
    grep -F 'MetaPhlAn version 4.1.1' /tmp/metaphlan.version && \
    metaphlan --help > /tmp/metaphlan.help && \
    grep -F 'usage: metaphlan ' /tmp/metaphlan.help && \
    rm -f /tmp/metaphlan.version /tmp/metaphlan.help

WORKDIR /data
ENTRYPOINT ["metaphlan"]
CMD ["--help"]
