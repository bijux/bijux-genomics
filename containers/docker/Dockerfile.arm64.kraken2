# VERSION_SOURCE: containers/contracts/catalog.toml
FROM ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b AS builder
ENV DEBIAN_FRONTEND=noninteractive
RUN sed -i 's#http://archive.ubuntu.com/ubuntu/#https://snapshot.ubuntu.com/ubuntu/20260802T000000Z/#g; s#http://security.ubuntu.com/ubuntu/#https://snapshot.ubuntu.com/ubuntu/20260802T000000Z/#g' /etc/apt/sources.list.d/ubuntu.sources && \
    apt-get -o Acquire::https::Verify-Peer=false -o Acquire::Check-Valid-Until=false update && \
    apt-get -o Acquire::https::Verify-Peer=false install -y --no-install-recommends ca-certificates && \
    apt-get -o Acquire::Check-Valid-Until=false update && \
    apt-get install -y --no-install-recommends build-essential curl zlib1g-dev perl
COPY containers/tools/kraken2/install /opt/kraken2-build/install
COPY containers/tools/kraken2/kraken2 /usr/local/bin/kraken2
RUN chmod 0755 /opt/kraken2-build/install /usr/local/bin/kraken2 && /opt/kraken2-build/install

FROM ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b
ARG OCI_CREATED=governed-by-build-evidence
ARG TOOL_VERSION=2.1.3
LABEL org.opencontainers.image.source="https://github.com/DerrickWood/kraken2" \
      org.opencontainers.image.revision="8f82a7ded7816c7ceed5086598b2979f80c970d8" \
      org.opencontainers.image.created="${OCI_CREATED}" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.version="${TOOL_VERSION}"
LABEL org.opencontainers.image.tool="kraken2"
LABEL org.opencontainers.image.title="Kraken 2"
LABEL org.opencontainers.image.base.name="ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b"
LABEL org.opencontainers.image.base.digest="sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b"
ENV LANG=C LC_ALL=C TZ=UTC PERL5LIB=/opt/kraken2 \
    PATH=/usr/local/bin:/opt/kraken2:/usr/bin:/bin
RUN apt-get update && \
    apt-get install -y --no-install-recommends perl gzip bzip2 libgomp1 && \
    rm -rf /var/lib/apt/lists/* && \
    useradd --system --uid 65532 --home-dir /work --create-home bijux
COPY --from=builder /opt/kraken2 /opt/kraken2
COPY containers/tools/kraken2/kraken2 /usr/local/bin/kraken2
RUN chmod 0755 /usr/local/bin/kraken2 && \
    kraken2 --version | grep -Fx 'Kraken 2.1.3' && \
    kraken2 --help >/dev/null

USER 65532:65532
WORKDIR /work
ENTRYPOINT ["kraken2"]
CMD ["--help"]
