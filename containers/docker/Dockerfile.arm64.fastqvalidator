RUN chmod 0755 /usr/local/bin/fastqvalidator /opt/fastqvalidator/bin/fastqvalidator-native && \
    fastqvalidator --version | grep -Fx 'fastqvalidator 0.1.1' && \
    fastqvalidator --help >/dev/null

USER 65532:65532
