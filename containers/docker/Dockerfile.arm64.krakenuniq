# VERSION_SOURCE: containers/contracts/catalog.toml
FROM ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b AS build
COPY --chmod=0555 containers/contracts/configure-apt-snapshot /usr/local/sbin/bijux-configure-apt-snapshot

ENV DEBIAN_FRONTEND=noninteractive
RUN /usr/local/sbin/bijux-configure-apt-snapshot && \
    apt-get install -y --no-install-recommends curl g++ make libbz2-dev perl zlib1g-dev && \
    curl --fail --location --proto '=https' --tlsv1.2 \
      --output /opt/krakenuniq.tar.gz \
      https://codeload.github.com/fbreitwieser/krakenuniq/tar.gz/d3305ac7d7fddbd3e62240ab62869aded869f133 && \
    echo 'aa11c4d015516dcfdd58bc38234cfb4f0473833be49c2a6dc12da384540bead9  /opt/krakenuniq.tar.gz' | sha256sum --check --strict && \
    tar --extract --gzip --file /opt/krakenuniq.tar.gz --directory /opt && \
    sed -i '1i #include <cstdint>' /opt/krakenuniq-d3305ac7d7fddbd3e62240ab62869aded869f133/src/uid_mapping.hpp && \
    sed -i '1i #include <cstdint>' /opt/krakenuniq-d3305ac7d7fddbd3e62240ab62869aded869f133/src/report-cols.hpp && \
    sed -i 's/enum class REPORTCOLS : uint8_t/enum class REPORTCOLS : std::uint8_t/g; s/std:map/std::map/g; s/std:string/std::string/g' /opt/krakenuniq-d3305ac7d7fddbd3e62240ab62869aded869f133/src/report-cols.hpp && \
    /opt/krakenuniq-d3305ac7d7fddbd3e62240ab62869aded869f133/install_krakenuniq.sh /opt/krakenuniq/bin && \
    /opt/krakenuniq/bin/krakenuniq --version | grep -Fx 'KrakenUniq version 1.0.4' && \
    /opt/krakenuniq/bin/krakenuniq --help >/dev/null

FROM ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b
COPY --chmod=0555 containers/contracts/configure-apt-snapshot /usr/local/sbin/bijux-configure-apt-snapshot
COPY --from=build /opt/krakenuniq/bin /opt/krakenuniq/bin

ARG OCI_CREATED=governed-by-build-evidence
ARG TOOL_VERSION=1.0.4
LABEL org.opencontainers.image.source="https://github.com/fbreitwieser/krakenuniq" \
      org.opencontainers.image.revision="d3305ac7d7fddbd3e62240ab62869aded869f133" \
      org.opencontainers.image.created="${OCI_CREATED}" \
      org.opencontainers.image.licenses="GPL-3.0-or-later" \
      org.opencontainers.image.version="${TOOL_VERSION}" \
      io.bijux.tool.version="${TOOL_VERSION}" \
      org.opencontainers.image.tool="krakenuniq" \
      org.opencontainers.image.title="KrakenUniq" \
      org.opencontainers.image.base.name="ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b" \
      org.opencontainers.image.base.digest="sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b"

ENV PATH=/opt/krakenuniq/bin:/usr/local/bin:/usr/bin:/bin \
    LANG=C LC_ALL=C TZ=UTC DEBIAN_FRONTEND=noninteractive
RUN /usr/local/sbin/bijux-configure-apt-snapshot && \
    apt-get install -y --no-install-recommends bzip2 gzip perl python3 zlib1g && \
    krakenuniq --version | grep -Fx 'KrakenUniq version 1.0.4' && \
    krakenuniq --help >/dev/null && \
    useradd --system --uid 65532 --home-dir /work --create-home bijux && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

USER 65532:65532
WORKDIR /work
ENTRYPOINT ["/opt/krakenuniq/bin/krakenuniq"]
CMD ["--help"]
