# VERSION_SOURCE: containers/versions/versions.toml
FROM ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b
COPY --chmod=0555 containers/contracts/configure-apt-snapshot /usr/local/sbin/bijux-configure-apt-snapshot
ARG OCI_CREATED=governed-by-build-evidence
ARG TOOL_VERSION=2.00a6
ARG PLINK2_APT_VERSION=2.00~a5.8-231123+dfsg-1
LABEL org.opencontainers.image.source="https://www.cog-genomics.org/plink/2.0/" \
      org.opencontainers.image.revision="${PLINK2_APT_VERSION}" \
      org.opencontainers.image.created="${OCI_CREATED}" \
      org.opencontainers.image.licenses="GPL-3.0" \
      org.opencontainers.image.version="${TOOL_VERSION}"
LABEL org.opencontainers.image.tool="plink2"
LABEL org.opencontainers.image.title="plink2"
LABEL org.opencontainers.image.base.name="ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b"
LABEL org.opencontainers.image.base.digest="sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b"
ENV LANG=C LC_ALL=C TZ=UTC DEBIAN_FRONTEND=noninteractive

RUN /usr/local/sbin/bijux-configure-apt-snapshot && \
    apt-get install -y --no-install-recommends ca-certificates && \
    apt-get -o Acquire::Check-Valid-Until=false update && \
    apt-get install -y --no-install-recommends plink2=${PLINK2_APT_VERSION} && \
    test "$(dpkg-query --show --showformat='$${Version}' plink2)" = "${PLINK2_APT_VERSION}" && \
    plink2 --version 2>&1 | grep -F 'PLINK v2.00a6' && \
    plink2 --help >/dev/null && \
    rm -rf /var/lib/apt/lists/* && \
    useradd --system --uid 65532 --home-dir /work --create-home bijux

USER 65532:65532
WORKDIR /work
ENTRYPOINT ["plink2"]
CMD ["--help"]
