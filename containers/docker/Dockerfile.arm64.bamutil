# VERSION_SOURCE: containers/contracts/catalog.toml
FROM ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b AS builder
ENV DEBIAN_FRONTEND=noninteractive
RUN sed -i 's#http://archive.ubuntu.com/ubuntu/#https://snapshot.ubuntu.com/ubuntu/20260802T000000Z/#g; s#http://security.ubuntu.com/ubuntu/#https://snapshot.ubuntu.com/ubuntu/20260802T000000Z/#g' /etc/apt/sources.list.d/ubuntu.sources && \
    apt-get -o Acquire::https::Verify-Peer=false -o Acquire::Check-Valid-Until=false update && \
    apt-get -o Acquire::https::Verify-Peer=false install -y --no-install-recommends ca-certificates && \
    apt-get -o Acquire::Check-Valid-Until=false update && \
    apt-get install -y --no-install-recommends curl g++ make zlib1g-dev && \
    curl --fail --location --proto '=https' --tlsv1.2 --output /opt/bamutil.tar.gz https://codeload.github.com/statgen/bamUtil/tar.gz/refs/tags/v1.0.15 && \
    echo '24ac4bdb81eded6e33f60dba85ec3d32ebdb06d42f75df775c2632bbfbd8cce9  /opt/bamutil.tar.gz' | sha256sum -c - && \
    curl --fail --location --proto '=https' --tlsv1.2 --output /opt/libstatgen.tar.gz https://codeload.github.com/statgen/libStatGen/tar.gz/refs/tags/v1.0.15 && \
    echo '075dcd891409c48d76c0c66186c0cc479bc3cd50bba093e7f318e1d1d19961ff  /opt/libstatgen.tar.gz' | sha256sum -c - && \
    tar --extract --gzip --file /opt/bamutil.tar.gz --directory /opt && \
    tar --extract --gzip --file /opt/libstatgen.tar.gz --directory /opt && \
    make --directory /opt/bamUtil-1.0.15 --jobs 2 LIB_PATH_GENERAL=/opt/libStatGen-1.0.15 DATE=1970-01-01T00:00:00Z USER=bijux USER_COMPILE_VARS=-D_NO_PHONEHOME && \
    install -d -m 0755 /opt/bamutil/bin && \
    install -m 0755 /opt/bamUtil-1.0.15/bin/bam /opt/bamutil/bin/bam-native

FROM ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b
ARG OCI_CREATED=governed-by-build-evidence
ARG TOOL_VERSION=1.0.15
LABEL org.opencontainers.image.source="https://github.com/statgen/bamUtil" \
      org.opencontainers.image.revision="3ad3980a3a3a3fc35eca3636b7206676c8303ce6" \
      org.opencontainers.image.created="${OCI_CREATED}" \
      org.opencontainers.image.licenses="GPL-3.0-or-later" \
      org.opencontainers.image.version="${TOOL_VERSION}"
LABEL org.opencontainers.image.tool="bamutil"
LABEL org.opencontainers.image.title="bamUtil"
LABEL org.opencontainers.image.base.name="ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b"
LABEL org.opencontainers.image.base.digest="sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b"
ENV LANG=C LC_ALL=C TZ=UTC DEBIAN_FRONTEND=noninteractive
RUN sed -i 's#http://archive.ubuntu.com/ubuntu/#https://snapshot.ubuntu.com/ubuntu/20260802T000000Z/#g; s#http://security.ubuntu.com/ubuntu/#https://snapshot.ubuntu.com/ubuntu/20260802T000000Z/#g' /etc/apt/sources.list.d/ubuntu.sources && \
    apt-get -o Acquire::https::Verify-Peer=false -o Acquire::Check-Valid-Until=false update && \
    apt-get -o Acquire::Check-Valid-Until=false install -y --no-install-recommends libstdc++6 zlib1g && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* && \
    useradd --system --uid 65532 --home-dir /work --create-home bijux
COPY --from=builder /opt/bamutil /opt/bamutil
COPY containers/tools/bamutil/bamutil /usr/local/bin/bamutil
RUN chmod 0755 /usr/local/bin/bamutil /opt/bamutil/bin/bam-native && \
    bamutil --version | grep -Fx 'bamutil 1.0.15' && \
    bamutil --help >/dev/null

USER 65532:65532
WORKDIR /work
ENTRYPOINT ["bamutil"]
CMD ["--help"]
