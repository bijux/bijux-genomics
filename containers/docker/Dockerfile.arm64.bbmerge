# VERSION_SOURCE: containers/contracts/catalog.toml
FROM ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b
COPY --chmod=0555 containers/contracts/configure-apt-snapshot /usr/local/sbin/bijux-configure-apt-snapshot
COPY --chmod=0555 containers/tools/bbmap/bbmap-interface /usr/local/bin/bbmerge

ARG OCI_CREATED=governed-by-build-evidence
ARG TOOL_VERSION=39.06
LABEL org.opencontainers.image.source="https://sourceforge.net/projects/bbmap/" \
      org.opencontainers.image.revision="sha256:61d45bd59a543b90a143c5c7dbfec0ff6163dce54194b8c4b648fb6aac67d42e" \
      org.opencontainers.image.created="${OCI_CREATED}" \
      org.opencontainers.image.licenses="BSD-3-Clause" \
      org.opencontainers.image.version="${TOOL_VERSION}" \
      org.opencontainers.image.tool="bbmerge" \
      org.opencontainers.image.title="BBMerge" \
      org.opencontainers.image.base.name="ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b" \
      org.opencontainers.image.base.digest="sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b"

ENV LANG=C LC_ALL=C TZ=UTC DEBIAN_FRONTEND=noninteractive
RUN /usr/local/sbin/bijux-configure-apt-snapshot && \
    apt-get install -y --no-install-recommends ca-certificates && \
    apt-get -o Acquire::Check-Valid-Until=false update && \
    apt-get install -y --no-install-recommends curl openjdk-17-jre-headless && \
    curl --fail --location --silent --show-error --output /tmp/bbmap.tar.gz \
      'https://downloads.sourceforge.net/project/bbmap/BBMap_39.06.tar.gz?download' && \
    echo '61d45bd59a543b90a143c5c7dbfec0ff6163dce54194b8c4b648fb6aac67d42e  /tmp/bbmap.tar.gz' | sha256sum --check --strict && \
    mkdir -p /opt && tar --extract --gzip --file /tmp/bbmap.tar.gz --directory /opt && \
    bbmerge --version > /tmp/bbmerge.version && \
    grep -Fx 'BBMap 39.06 (BBMerge)' /tmp/bbmerge.version && \
    bbmerge --help > /tmp/bbmerge.help && \
    grep -F 'Usage for interleaved files:' /tmp/bbmerge.help && \
    rm -f /tmp/bbmerge.version /tmp/bbmerge.help && \
    rm -f /tmp/bbmap.tar.gz && rm -rf /var/lib/apt/lists/* && \
    useradd --system --uid 65532 --home-dir /work --create-home bijux

USER 65532:65532
WORKDIR /work
ENTRYPOINT ["/usr/local/bin/bbmerge"]
CMD ["--help"]
