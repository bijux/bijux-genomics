# VERSION_SOURCE: containers/versions/versions.toml
FROM ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b AS builder
ARG OCI_CREATED=governed-by-build-evidence
ARG TOOL_VERSION=1.1.1
LABEL org.opencontainers.image.source="https://github.com/odelaneau/GLIMPSE" \
      org.opencontainers.image.revision="c27e90d0f8df6b64c0ecf26af13ad6f112c94a9a" \
      org.opencontainers.image.created="${OCI_CREATED}" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.version="${TOOL_VERSION}"
LABEL org.opencontainers.image.tool="glimpse" \
      org.opencontainers.image.title="GLIMPSE" \
      org.opencontainers.image.base.name="ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b" \
      org.opencontainers.image.base.digest="sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b"
ENV LANG=C LC_ALL=C TZ=UTC DEBIAN_FRONTEND=noninteractive
RUN set -eu; \
    sed -i 's#http://archive.ubuntu.com/ubuntu/#https://snapshot.ubuntu.com/ubuntu/20260802T000000Z/#g; s#http://security.ubuntu.com/ubuntu/#https://snapshot.ubuntu.com/ubuntu/20260802T000000Z/#g' /etc/apt/sources.list.d/ubuntu.sources && \
    apt-get -o Acquire::https::Verify-Peer=false -o Acquire::Check-Valid-Until=false update && \
    apt-get -o Acquire::https::Verify-Peer=false install -y --no-install-recommends ca-certificates && \
    apt-get -o Acquire::Check-Valid-Until=false update && \
    apt-get install -y --no-install-recommends build-essential curl libboost-iostreams-dev libboost-program-options-dev libbz2-dev libcurl4-openssl-dev libhts-dev liblzma-dev libssl-dev zlib1g-dev && \
    curl --fail --location --silent --show-error --output /opt/glimpse.tar.gz https://github.com/odelaneau/GLIMPSE/archive/c27e90d0f8df6b64c0ecf26af13ad6f112c94a9a.tar.gz && \
    echo 'd58b8881981db2feb3dd62f8a73d3cd0325ada056a885d5a0e0bfa3571569e5c  /opt/glimpse.tar.gz' | sha256sum --check --strict && \
    tar --extract --gzip --file /opt/glimpse.tar.gz --directory /opt && \
    for project in chunk concordance ligate phase sample snparray; do \
        make --directory "/opt/GLIMPSE-c27e90d0f8df6b64c0ecf26af13ad6f112c94a9a/${project}" -j"$(nproc)" HTSLIB_INC=/usr/include HTSLIB_LIB=-lhts BOOST_INC=/usr/include BOOST_LIB_IO=-lboost_iostreams BOOST_LIB_PO=-lboost_program_options; \
        install -m 0755 "/opt/GLIMPSE-c27e90d0f8df6b64c0ecf26af13ad6f112c94a9a/${project}/bin/GLIMPSE_${project}" "/usr/local/bin/GLIMPSE_${project}"; \
    done

FROM ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b
ARG OCI_CREATED=governed-by-build-evidence
ARG TOOL_VERSION=1.1.1
LABEL org.opencontainers.image.source="https://github.com/odelaneau/GLIMPSE" \
      org.opencontainers.image.revision="c27e90d0f8df6b64c0ecf26af13ad6f112c94a9a" \
      org.opencontainers.image.created="${OCI_CREATED}" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.version="${TOOL_VERSION}" \
      org.opencontainers.image.tool="glimpse" \
      org.opencontainers.image.title="GLIMPSE" \
      org.opencontainers.image.base.name="ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b" \
      org.opencontainers.image.base.digest="sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b"
ENV LANG=C LC_ALL=C TZ=UTC DEBIAN_FRONTEND=noninteractive
RUN sed -i 's#http://archive.ubuntu.com/ubuntu/#https://snapshot.ubuntu.com/ubuntu/20260802T000000Z/#g; s#http://security.ubuntu.com/ubuntu/#https://snapshot.ubuntu.com/ubuntu/20260802T000000Z/#g' /etc/apt/sources.list.d/ubuntu.sources && \
    apt-get -o Acquire::https::Verify-Peer=false -o Acquire::Check-Valid-Until=false update && \
    apt-get -o Acquire::https::Verify-Peer=false install -y --no-install-recommends ca-certificates && \
    apt-get -o Acquire::Check-Valid-Until=false update && \
    apt-get install -y --no-install-recommends libboost-iostreams1.83.0 libboost-program-options1.83.0 libbz2-1.0 libcurl4t64 libhts3t64 liblzma5 libssl3t64 zlib1g && \
    rm -rf /var/lib/apt/lists/* && \
    useradd --system --uid 65532 --home-dir /work --create-home bijux
COPY --from=builder /usr/local/bin/GLIMPSE_* /usr/local/bin/
COPY containers/tools/glimpse/glimpse /usr/local/bin/glimpse
RUN chmod 0755 /usr/local/bin/glimpse && glimpse --version | grep -Fx 'glimpse 1.1.1' && glimpse --help >/dev/null
USER 65532:65532
WORKDIR /work
ENTRYPOINT ["glimpse"]
CMD ["--help"]
