# VERSION_SOURCE: containers/contracts/catalog.toml
FROM ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b AS builder
COPY --chmod=0555 containers/contracts/configure-apt-snapshot /usr/local/sbin/bijux-configure-apt-snapshot
ENV DEBIAN_FRONTEND=noninteractive
RUN /usr/local/sbin/bijux-configure-apt-snapshot && \
    apt-get install -y --no-install-recommends build-essential curl python3
COPY containers/tools/bracken/install /opt/bracken-build/install
COPY containers/tools/bracken/bracken /usr/local/bin/bracken
RUN chmod 0755 /opt/bracken-build/install /usr/local/bin/bracken && /opt/bracken-build/install

FROM ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b
COPY --chmod=0555 containers/contracts/configure-apt-snapshot /usr/local/sbin/bijux-configure-apt-snapshot
ARG OCI_CREATED=governed-by-build-evidence
ARG TOOL_VERSION=2.9
LABEL org.opencontainers.image.source="https://github.com/jenniferlu717/Bracken" \
      org.opencontainers.image.revision="c5bfec1929fe30feef21afbde67b16bda44de448" \
      org.opencontainers.image.created="${OCI_CREATED}" \
      org.opencontainers.image.licenses="GPL-3.0-or-later" \
      org.opencontainers.image.version="${TOOL_VERSION}"
LABEL org.opencontainers.image.tool="bracken"
LABEL org.opencontainers.image.title="Bracken"
LABEL org.opencontainers.image.base.name="ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b"
LABEL org.opencontainers.image.base.digest="sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b"
LABEL io.bijux.tool.version="2.9"
ENV LANG=C LC_ALL=C TZ=UTC PYTHONNOUSERSITE=1 \
    PATH=/usr/local/bin:/opt/bracken:/opt/bracken/src:/usr/bin:/bin
RUN /usr/local/sbin/bijux-configure-apt-snapshot && \
    apt-get install -y --no-install-recommends libgomp1 python3 python-is-python3 && \
    rm -rf /var/lib/apt/lists/* && \
    useradd --system --uid 65532 --home-dir /work --create-home bijux
COPY --from=builder /opt/bracken /opt/bracken
COPY containers/tools/bracken/bracken /usr/local/bin/bracken
RUN chmod 0755 /usr/local/bin/bracken && \
    bracken --version | grep -Fx 'Bracken 2.9' && \
    bracken --help >/dev/null && \
    python --version 2>&1 | grep -E '^Python 3[.]'

USER 65532:65532
WORKDIR /work
ENTRYPOINT ["bracken"]
CMD ["--help"]
