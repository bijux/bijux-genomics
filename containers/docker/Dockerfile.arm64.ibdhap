# VERSION_SOURCE: containers/contracts/catalog.toml
FROM ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b AS builder
ARG OCI_CREATED=governed-by-build-evidence
ARG TOOL_VERSION=3.4
LABEL org.opencontainers.image.source="https://sites.stat.washington.edu/thompson/Genepi/MORGAN/Morgan.shtml" \
      org.opencontainers.image.revision="195a84d877413a83de15a20da45d92d2441303b8373b47727ed2e3ab92dc2e6a" \
      org.opencontainers.image.created="${OCI_CREATED}" \
      org.opencontainers.image.licenses="LicenseRef-MORGAN-2006" \
      org.opencontainers.image.version="${TOOL_VERSION}" \
      org.opencontainers.image.tool="ibdhap" \
      org.opencontainers.image.title="MORGAN IBDHap" \
      org.opencontainers.image.base.name="ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b" \
      org.opencontainers.image.base.digest="sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b"
ENV LANG=C LC_ALL=C TZ=UTC DEBIAN_FRONTEND=noninteractive
RUN set -eu; \
    sed -i 's#http://archive.ubuntu.com/ubuntu/#https://snapshot.ubuntu.com/ubuntu/20260802T000000Z/#g; s#http://security.ubuntu.com/ubuntu/#https://snapshot.ubuntu.com/ubuntu/20260802T000000Z/#g' /etc/apt/sources.list.d/ubuntu.sources; \
    apt-get -o Acquire::https::Verify-Peer=false -o Acquire::Check-Valid-Until=false update; \
    apt-get -o Acquire::https::Verify-Peer=false install -y --no-install-recommends ca-certificates; \
    apt-get -o Acquire::Check-Valid-Until=false update; \
    apt-get install -y --no-install-recommends curl gcc libc6-dev make; \
    curl --fail --location --silent --show-error --output /opt/morgan.tar.gz https://faculty.washington.edu/eathomp/Anonftp/PANGAEA/MORGAN/morgan_v34_release.tar.gz; \
    echo '195a84d877413a83de15a20da45d92d2441303b8373b47727ed2e3ab92dc2e6a  /opt/morgan.tar.gz' | sha256sum --check --strict; \
    tar --extract --gzip --file /opt/morgan.tar.gz --directory /opt; \
    make --directory /opt/MORGAN_V34_Release morgan.gcc CFLAGS=-fcommon; \
    install -d -m 0755 /opt/morgan/bin; \
    install -m 0755 /opt/MORGAN_V34_Release/IBD_Haplo/ibd_haplo /opt/morgan/bin/ibd_haplo

FROM ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b
ARG OCI_CREATED=governed-by-build-evidence
ARG TOOL_VERSION=3.4
LABEL org.opencontainers.image.source="https://sites.stat.washington.edu/thompson/Genepi/MORGAN/Morgan.shtml" \
      org.opencontainers.image.revision="195a84d877413a83de15a20da45d92d2441303b8373b47727ed2e3ab92dc2e6a" \
      org.opencontainers.image.created="${OCI_CREATED}" \
      org.opencontainers.image.licenses="LicenseRef-MORGAN-2006" \
      org.opencontainers.image.version="${TOOL_VERSION}" \
      org.opencontainers.image.tool="ibdhap" \
      org.opencontainers.image.title="MORGAN IBDHap" \
      org.opencontainers.image.base.name="ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b" \
      org.opencontainers.image.base.digest="sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b"
ENV LANG=C LC_ALL=C TZ=UTC DEBIAN_FRONTEND=noninteractive
RUN sed -i 's#http://archive.ubuntu.com/ubuntu/#https://snapshot.ubuntu.com/ubuntu/20260802T000000Z/#g; s#http://security.ubuntu.com/ubuntu/#https://snapshot.ubuntu.com/ubuntu/20260802T000000Z/#g' /etc/apt/sources.list.d/ubuntu.sources && \
    apt-get -o Acquire::https::Verify-Peer=false -o Acquire::Check-Valid-Until=false update && \
    apt-get -o Acquire::https::Verify-Peer=false install -y --no-install-recommends ca-certificates && \
    apt-get -o Acquire::Check-Valid-Until=false update && \
    apt-get install -y --no-install-recommends python3-minimal && \
    rm -rf /var/lib/apt/lists/* && \
    useradd --system --uid 65532 --home-dir /work --create-home bijux
COPY --from=builder /opt/morgan/bin/ibd_haplo /opt/morgan/bin/ibd_haplo
COPY containers/tools/ibdhap/ibdhap /usr/local/bin/ibdhap
RUN chmod 0755 /usr/local/bin/ibdhap /opt/morgan/bin/ibd_haplo && \
    ibdhap --version | grep -Fx 'ibdhap 3.4' && \
    ibdhap --help >/dev/null
USER 65532:65532
WORKDIR /work
ENTRYPOINT ["ibdhap"]
CMD ["--help"]
