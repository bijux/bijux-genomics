FROM ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b AS builder
COPY --chmod=0555 containers/contracts/configure-apt-snapshot /usr/local/sbin/bijux-configure-apt-snapshot
ENV DEBIAN_FRONTEND=noninteractive
RUN /usr/local/sbin/bijux-configure-apt-snapshot && \
    apt-get install -y --no-install-recommends ca-certificates && \
    apt-get -o Acquire::Check-Valid-Until=false update && \
    apt-get install -y --no-install-recommends autoconf automake bzip2 curl g++ libtool make perl pkg-config zlib1g-dev && \
    curl --fail --location --proto '=https' --tlsv1.2 --output /opt/libgtextutils.tar.gz https://github.com/agordon/libgtextutils/releases/download/0.7/libgtextutils-0.7.tar.gz && \
    echo '792e0ea3c96ffe3ad65617a104b7dc50684932bc96d2adab501c952fd65c3e4a  /opt/libgtextutils.tar.gz' | sha256sum -c - && \
    tar --extract --gzip --file /opt/libgtextutils.tar.gz --directory /opt && \
    perl -0pi -e 's/return input_stream ;/return static_cast<bool>(input_stream) ;/' /opt/libgtextutils-0.7/src/gtextutils/text_line_reader.cpp && \
    cd /opt/libgtextutils-0.7 && \
    ./configure --prefix=/usr/local && \
    make -j2 && \
    make install && \
    ldconfig && \
    curl --fail --location --proto '=https' --tlsv1.2 --output /opt/fastx-toolkit.tar.bz2 https://github.com/agordon/fastx_toolkit/releases/download/0.0.14/fastx_toolkit-0.0.14.tar.bz2 && \
    echo '9e1f00c4c9f286be59ac0e07ddb7504f3b6433c93c5c7941d6e3208306ff5806  /opt/fastx-toolkit.tar.bz2' | sha256sum -c - && \
    tar --extract --bzip2 --file /opt/fastx-toolkit.tar.bz2 --directory /opt && \
    cd /opt/fastx_toolkit-0.0.14 && \
    ./configure --prefix=/usr/local PKG_CONFIG_PATH=/usr/local/lib/pkgconfig CPPFLAGS=-I/usr/local/include LDFLAGS=-L/usr/local/lib && \
    find /opt/fastx_toolkit-0.0.14 -name Makefile -exec perl -0pi -e 's/ -Werror//g' {} + && \
    make -j2 && \
    make install && \
    install -d -m 0755 /opt/fastx-clipper/bin && \
    mv /usr/local/bin/fastx_clipper /opt/fastx-clipper/bin/fastx-clipper-native

FROM ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b
COPY --chmod=0555 containers/contracts/configure-apt-snapshot /usr/local/sbin/bijux-configure-apt-snapshot
ARG OCI_CREATED=governed-by-build-evidence
ARG TOOL_VERSION=0.0.14
LABEL org.opencontainers.image.source="https://github.com/agordon/fastx_toolkit" \
      org.opencontainers.image.revision="105a189a102d66d246bd618f07af2b861916272c" \
      org.opencontainers.image.created="${OCI_CREATED}" \
      org.opencontainers.image.licenses="AGPL-3.0-or-later" \
      org.opencontainers.image.version="${TOOL_VERSION}"
LABEL org.opencontainers.image.tool="fastx_clipper"
LABEL org.opencontainers.image.title="FASTX Clipper"
LABEL org.opencontainers.image.base.name="ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b"
LABEL org.opencontainers.image.base.digest="sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b"
ENV PATH=/usr/local/bin:/usr/bin:/bin LD_LIBRARY_PATH=/usr/local/lib LANG=C LC_ALL=C TZ=UTC DEBIAN_FRONTEND=noninteractive
RUN /usr/local/sbin/bijux-configure-apt-snapshot && \
    apt-get install -y --no-install-recommends ca-certificates && \
    apt-get -o Acquire::Check-Valid-Until=false update && \
    apt-get install -y --no-install-recommends libstdc++6 zlib1g && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* && \
    useradd --system --uid 65532 --home-dir /work --create-home bijux
COPY --from=builder /usr/local/lib /usr/local/lib
COPY --from=builder /opt/fastx-clipper /opt/fastx-clipper
COPY containers/tools/fastx_clipper/fastx_clipper /usr/local/bin/fastx_clipper
RUN chmod 0755 /usr/local/bin/fastx_clipper /opt/fastx-clipper/bin/fastx-clipper-native && \
    fastx_clipper --version | grep -Fx 'fastx_clipper 0.0.14' && \
    fastx_clipper --help >/dev/null

USER 65532:65532
WORKDIR /work
ENTRYPOINT ["fastx_clipper"]
CMD ["--help"]
