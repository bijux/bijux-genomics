# VERSION_SOURCE: containers/versions/versions.toml
FROM ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b
ARG OCI_CREATED=governed-by-build-evidence
ARG TOOL_VERSION=8.0.0
LABEL org.opencontainers.image.source="https://github.com/DReichLab/EIG" \
      org.opencontainers.image.revision="09ed563fdec05648a66c206ba1fc37a198395cd7" \
      org.opencontainers.image.created="${OCI_CREATED}" \
      org.opencontainers.image.licenses="GPL-2.0" \
      org.opencontainers.image.version="${TOOL_VERSION}"
LABEL org.opencontainers.image.tool="eigensoft"
LABEL org.opencontainers.image.title="eigensoft"
LABEL org.opencontainers.image.base.name="ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b"
LABEL org.opencontainers.image.base.digest="sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b"
ENV LANG=C LC_ALL=C TZ=UTC DEBIAN_FRONTEND=noninteractive

RUN sed -i 's#http://archive.ubuntu.com/ubuntu/#https://snapshot.ubuntu.com/ubuntu/20260802T000000Z/#g; s#http://security.ubuntu.com/ubuntu/#https://snapshot.ubuntu.com/ubuntu/20260802T000000Z/#g' /etc/apt/sources.list.d/ubuntu.sources && \
    apt-get -o Acquire::https::Verify-Peer=false -o Acquire::Check-Valid-Until=false update && \
    apt-get -o Acquire::https::Verify-Peer=false install -y --no-install-recommends ca-certificates && \
    apt-get -o Acquire::Check-Valid-Until=false update && \
    apt-get install -y --no-install-recommends libgsl27 libopenblas0-pthread && \
    apt-get install -y --no-install-recommends curl gcc libc6-dev libgsl-dev libopenblas-dev make && \
    curl --fail --location --proto '=https' --tlsv1.2 --output /opt/eigensoft.tar.gz https://github.com/DReichLab/EIG/archive/09ed563fdec05648a66c206ba1fc37a198395cd7.tar.gz && \
    echo '83207df20d658142c8d3d93db8d2d668b06812a90cc474454d18b62b973ca4c2  /opt/eigensoft.tar.gz' | sha256sum -c - && \
    tar --extract --gzip --file /opt/eigensoft.tar.gz --directory /opt && \
    make --directory /opt/EIG-09ed563fdec05648a66c206ba1fc37a198395cd7/src eigensrc/smartpca OPTIMIZE=1 && \
    install -d -m 0755 /opt/eigensoft/bin && \
    install -m 0755 /opt/EIG-09ed563fdec05648a66c206ba1fc37a198395cd7/src/eigensrc/smartpca /opt/eigensoft/bin/smartpca-native && \
    rm -rf /opt/eigensoft.tar.gz /opt/EIG-09ed563fdec05648a66c206ba1fc37a198395cd7 && \
    apt-get purge -y --auto-remove curl gcc libc6-dev libgsl-dev libopenblas-dev make && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* && \
    useradd --system --uid 65532 --home-dir /work --create-home bijux
COPY containers/tools/eigensoft/smartpca /usr/local/bin/smartpca
RUN chmod 0755 /usr/local/bin/smartpca /opt/eigensoft/bin/smartpca-native && \
    smartpca --version | grep -Fx 'smartpca 8.0.0' && \
    smartpca --help >/dev/null

USER 65532:65532
WORKDIR /work
ENTRYPOINT ["smartpca"]
CMD ["-h"]
