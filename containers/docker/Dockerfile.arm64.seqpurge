# VERSION_SOURCE: containers/contracts/catalog.toml
FROM ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b AS builder

ARG OCI_CREATED=governed-by-build-evidence
ARG TOOL_VERSION=2026_06
LABEL org.opencontainers.image.source="https://github.com/imgag/ngs-bits" \
      org.opencontainers.image.revision="1c7f71b1cf653d1f52c720290e5d5d2fe34adfe1" \
      org.opencontainers.image.created="${OCI_CREATED}" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.version="${TOOL_VERSION}" \
      org.opencontainers.image.tool="seqpurge" \
      org.opencontainers.image.title="SeqPurge" \
      org.opencontainers.image.base.name="ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b" \
      org.opencontainers.image.base.digest="sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b"

ENV LANG=C LC_ALL=C TZ=UTC DEBIAN_FRONTEND=noninteractive
RUN sed -i 's#http://archive.ubuntu.com/ubuntu/#https://snapshot.ubuntu.com/ubuntu/20260802T000000Z/#g; s#http://security.ubuntu.com/ubuntu/#https://snapshot.ubuntu.com/ubuntu/20260802T000000Z/#g' /etc/apt/sources.list.d/ubuntu.sources && \
    apt-get -o Acquire::https::Verify-Peer=false -o Acquire::Check-Valid-Until=false update && \
    apt-get -o Acquire::https::Verify-Peer=false install -y --no-install-recommends ca-certificates && \
    apt-get -o Acquire::Check-Valid-Until=false update && \
    apt-get install -y --no-install-recommends build-essential git libhts-dev libqt6charts6-dev libxml2-dev pkg-config qmake6 zlib1g-dev && \
    git init /opt/ngs-bits-source && \
    git -C /opt/ngs-bits-source remote add origin https://github.com/imgag/ngs-bits.git && \
    git -C /opt/ngs-bits-source fetch --depth 1 origin 1c7f71b1cf653d1f52c720290e5d5d2fe34adfe1 && \
    git -C /opt/ngs-bits-source checkout --detach FETCH_HEAD && \
    test "$(git -C /opt/ngs-bits-source rev-parse HEAD)" = 1c7f71b1cf653d1f52c720290e5d5d2fe34adfe1 && \
    git init /opt/ngs-bits-source/src/cppCORE && \
    git -C /opt/ngs-bits-source/src/cppCORE remote add origin https://github.com/imgag/cppCORE.git && \
    git -C /opt/ngs-bits-source/src/cppCORE fetch --depth 1 origin 3d3d6c3fa083285a883700b910130a70b914eeec && \
    git -C /opt/ngs-bits-source/src/cppCORE checkout --detach FETCH_HEAD && \
    test "$(git -C /opt/ngs-bits-source/src/cppCORE rev-parse HEAD)" = 3d3d6c3fa083285a883700b910130a70b914eeec && \
    git init /opt/ngs-bits-source/src/cppXML && \
    git -C /opt/ngs-bits-source/src/cppXML remote add origin https://github.com/imgag/cppXML.git && \
    git -C /opt/ngs-bits-source/src/cppXML fetch --depth 1 origin d9a47278def57b0680393dd55c0a1d6126b8255f && \
    git -C /opt/ngs-bits-source/src/cppXML checkout --detach FETCH_HEAD && \
    test "$(git -C /opt/ngs-bits-source/src/cppXML rev-parse HEAD)" = d9a47278def57b0680393dd55c0a1d6126b8255f && \
    : > /opt/ngs-bits-source/src/cppCORE/CRYPT_KEY.txt && \
    sed -i 's/$$system(cd .. && git describe --tags)/2026_06/' /opt/ngs-bits-source/src/cppCORE/cppCORE.pro && \
    mkdir -p /opt/ngs-bits-source/src/build/cppCORE /opt/ngs-bits-source/src/build/cppXML /opt/ngs-bits-source/src/build/cppNGS /opt/ngs-bits-source/src/build/SeqPurge && \
    cd /opt/ngs-bits-source/src/build/cppCORE && qmake6 ../../cppCORE/cppCORE.pro 'CONFIG-=debug' 'CONFIG+=release' && make -j"$(nproc)" && \
    cd /opt/ngs-bits-source/src/build/cppXML && qmake6 ../../cppXML/cppXML.pro 'CONFIG-=debug' 'CONFIG+=release' && make -j"$(nproc)" && \
    cd /opt/ngs-bits-source/src/build/cppNGS && qmake6 ../../cppNGS/cppNGS.pro 'CONFIG-=debug' 'CONFIG+=release' && make -j"$(nproc)" && \
    cd /opt/ngs-bits-source/src/build/SeqPurge && qmake6 ../../SeqPurge/SeqPurge.pro 'CONFIG-=debug' 'CONFIG+=release' && make -j"$(nproc)" && \
    install -m 0755 /opt/ngs-bits-source/bin/SeqPurge /usr/local/bin/seqpurge && \
    install -m 0755 /opt/ngs-bits-source/bin/libcppCORE.so* /usr/local/lib/ && \
    install -m 0755 /opt/ngs-bits-source/bin/libcppXML.so* /usr/local/lib/ && \
    install -m 0755 /opt/ngs-bits-source/bin/libcppNGS.so* /usr/local/lib/

FROM ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b
ARG OCI_CREATED=governed-by-build-evidence
ARG TOOL_VERSION=2026_06
LABEL org.opencontainers.image.source="https://github.com/imgag/ngs-bits" \
      org.opencontainers.image.revision="1c7f71b1cf653d1f52c720290e5d5d2fe34adfe1" \
      org.opencontainers.image.created="${OCI_CREATED}" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.version="${TOOL_VERSION}" \
      org.opencontainers.image.tool="seqpurge" \
      org.opencontainers.image.title="SeqPurge" \
      org.opencontainers.image.base.name="ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b" \
      org.opencontainers.image.base.digest="sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b"

ENV LANG=C LC_ALL=C TZ=UTC DEBIAN_FRONTEND=noninteractive LD_LIBRARY_PATH=/usr/local/lib QT_QPA_PLATFORM=offscreen
RUN sed -i 's#http://archive.ubuntu.com/ubuntu/#https://snapshot.ubuntu.com/ubuntu/20260802T000000Z/#g; s#http://security.ubuntu.com/ubuntu/#https://snapshot.ubuntu.com/ubuntu/20260802T000000Z/#g' /etc/apt/sources.list.d/ubuntu.sources && \
    apt-get -o Acquire::https::Verify-Peer=false -o Acquire::Check-Valid-Until=false update && \
    apt-get -o Acquire::https::Verify-Peer=false install -y --no-install-recommends ca-certificates && \
    apt-get -o Acquire::Check-Valid-Until=false update && \
    apt-get install -y --no-install-recommends libhts3 libqt6charts6 libqt6core6 libqt6gui6 libqt6network6 libqt6widgets6 libxml2 zlib1g && \
    rm -rf /var/lib/apt/lists/* && \
    useradd --system --uid 65532 --home-dir /work --create-home bijux
COPY --from=builder /usr/local/bin/seqpurge /usr/local/bin/seqpurge
COPY --from=builder /usr/local/lib/ /usr/local/lib/
RUN ldconfig && seqpurge --version | grep -F '2026_06'

USER 65532:65532
WORKDIR /work
ENTRYPOINT ["/usr/local/bin/seqpurge"]
CMD ["--help"]
