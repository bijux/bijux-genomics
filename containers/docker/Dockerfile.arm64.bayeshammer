# VERSION_SOURCE: containers/contracts/catalog.toml
FROM ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b AS builder
COPY --chmod=0555 containers/contracts/configure-apt-snapshot /usr/local/sbin/bijux-configure-apt-snapshot
ENV DEBIAN_FRONTEND=noninteractive
RUN /usr/local/sbin/bijux-configure-apt-snapshot && \
    apt-get install -y --no-install-recommends ca-certificates && \
    apt-get -o Acquire::Check-Valid-Until=false update && \
    apt-get install -y --no-install-recommends build-essential cmake curl libbz2-dev python3 zlib1g-dev
COPY containers/tools/bayeshammer/install /opt/bayeshammer-build/install
COPY containers/tools/bayeshammer/bayeshammer /usr/local/bin/bayeshammer
RUN chmod 0755 /opt/bayeshammer-build/install /usr/local/bin/bayeshammer && /opt/bayeshammer-build/install

FROM ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b
COPY --chmod=0555 containers/contracts/configure-apt-snapshot /usr/local/sbin/bijux-configure-apt-snapshot
ARG OCI_CREATED=governed-by-build-evidence
ARG TOOL_VERSION=4.2.0
LABEL org.opencontainers.image.source="https://github.com/ablab/spades" \
      org.opencontainers.image.revision="7fee3c1050a732faef8a0d93d70861015a96f44e" \
      org.opencontainers.image.created="${OCI_CREATED}" \
      org.opencontainers.image.licenses="GPL-2.0-only" \
      org.opencontainers.image.version="${TOOL_VERSION}"
LABEL org.opencontainers.image.tool="bayeshammer"
LABEL org.opencontainers.image.title="BayesHammer"
LABEL org.opencontainers.image.base.name="ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b"
LABEL org.opencontainers.image.base.digest="sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b"
LABEL io.bijux.tool.version="4.2.0"
ENV LANG=C LC_ALL=C TZ=UTC PYTHONNOUSERSITE=1
RUN /usr/local/sbin/bijux-configure-apt-snapshot && \
    apt-get install -y --no-install-recommends ca-certificates && \
    apt-get -o Acquire::Check-Valid-Until=false update && \
    apt-get install -y --no-install-recommends libbz2-1.0 libgomp1 python3 zlib1g && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* && \
    useradd --system --uid 65532 --home-dir /work --create-home bijux
COPY --from=builder /opt/spades /opt/spades
COPY containers/tools/bayeshammer/bayeshammer /usr/local/bin/bayeshammer
RUN chmod 0755 /usr/local/bin/bayeshammer && \
    bayeshammer --version | grep -Fx 'BayesHammer 4.2.0' && \
    bayeshammer --help >/dev/null

USER 65532:65532
WORKDIR /work
ENTRYPOINT ["bayeshammer"]
CMD ["--help"]
