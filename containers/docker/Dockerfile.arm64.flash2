# VERSION_SOURCE: containers/contracts/catalog.toml
FROM ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b AS builder
ENV DEBIAN_FRONTEND=noninteractive
RUN sed -i 's#http://archive.ubuntu.com/ubuntu/#https://snapshot.ubuntu.com/ubuntu/20260802T000000Z/#g; s#http://security.ubuntu.com/ubuntu/#https://snapshot.ubuntu.com/ubuntu/20260802T000000Z/#g' /etc/apt/sources.list.d/ubuntu.sources && \
    apt-get -o Acquire::https::Verify-Peer=false -o Acquire::Check-Valid-Until=false update && \
    apt-get -o Acquire::https::Verify-Peer=false install -y --no-install-recommends ca-certificates && \
    apt-get -o Acquire::Check-Valid-Until=false update && \
    apt-get install -y --no-install-recommends curl gcc make zlib1g-dev && \
    curl --fail --location --proto '=https' --tlsv1.2 --output /opt/flash2.tar.gz https://codeload.github.com/dstreett/FLASH2/tar.gz/64826f4574b11b3c0ae7460826f30be16f49c3ea && \
    echo 'da5aa6c5791c69cf254f8d9b817392be79a74d6c3384fbcf6c32fcd392b76ae8  /opt/flash2.tar.gz' | sha256sum -c - && \
    tar --extract --gzip --file /opt/flash2.tar.gz --directory /opt && \
    make --directory /opt/FLASH2-64826f4574b11b3c0ae7460826f30be16f49c3ea -j2 && \
    install -d -m 0755 /opt/flash2/bin && \
    install -m 0755 /opt/FLASH2-64826f4574b11b3c0ae7460826f30be16f49c3ea/flash2 /opt/flash2/bin/flash2-native

FROM ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b
ARG OCI_CREATED=governed-by-build-evidence
ARG TOOL_VERSION=2.2.00
LABEL org.opencontainers.image.source="https://github.com/dstreett/FLASH2" \
      org.opencontainers.image.revision="64826f4574b11b3c0ae7460826f30be16f49c3ea" \
      org.opencontainers.image.created="${OCI_CREATED}" \
      org.opencontainers.image.licenses="GPL-3.0-or-later" \
      org.opencontainers.image.version="${TOOL_VERSION}"
LABEL org.opencontainers.image.tool="flash2"
LABEL org.opencontainers.image.title="FLASH2"
LABEL org.opencontainers.image.base.name="ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b"
LABEL org.opencontainers.image.base.digest="sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b"
ENV LANG=C LC_ALL=C TZ=UTC DEBIAN_FRONTEND=noninteractive
RUN sed -i 's#http://archive.ubuntu.com/ubuntu/#https://snapshot.ubuntu.com/ubuntu/20260802T000000Z/#g; s#http://security.ubuntu.com/ubuntu/#https://snapshot.ubuntu.com/ubuntu/20260802T000000Z/#g' /etc/apt/sources.list.d/ubuntu.sources && \
    apt-get -o Acquire::https::Verify-Peer=false -o Acquire::Check-Valid-Until=false update && \
    apt-get -o Acquire::https::Verify-Peer=false install -y --no-install-recommends ca-certificates && \
    apt-get -o Acquire::Check-Valid-Until=false update && \
    apt-get install -y --no-install-recommends zlib1g && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* && \
    useradd --system --uid 65532 --home-dir /work --create-home bijux
COPY --from=builder /opt/flash2 /opt/flash2
COPY containers/tools/flash2/flash2 /usr/local/bin/flash2
RUN chmod 0755 /usr/local/bin/flash2 /opt/flash2/bin/flash2-native && \
    flash2 --version | grep -Fx 'flash2 2.2.00' && \
    flash2 --help >/dev/null

USER 65532:65532
WORKDIR /work
ENTRYPOINT ["flash2"]
CMD ["--help"]
