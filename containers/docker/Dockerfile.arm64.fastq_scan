# VERSION_SOURCE: containers/contracts/catalog.toml
FROM ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b AS builder

ARG OCI_CREATED=governed-by-build-evidence
ARG TOOL_VERSION=1.0.1
LABEL org.opencontainers.image.source="https://github.com/rpetit3/fastq-scan" \
      org.opencontainers.image.revision="966991c58bd44cbf7644851b7118f7d06146f3c5" \
      org.opencontainers.image.created="${OCI_CREATED}" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.version="${TOOL_VERSION}" \
      org.opencontainers.image.tool="fastq_scan" \
      org.opencontainers.image.title="fastq-scan" \
      org.opencontainers.image.base.name="ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b" \
      org.opencontainers.image.base.digest="sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b"

ENV LANG=C LC_ALL=C TZ=UTC DEBIAN_FRONTEND=noninteractive
RUN sed -i 's#http://archive.ubuntu.com/ubuntu/#https://snapshot.ubuntu.com/ubuntu/20260802T000000Z/#g; s#http://security.ubuntu.com/ubuntu/#https://snapshot.ubuntu.com/ubuntu/20260802T000000Z/#g' /etc/apt/sources.list.d/ubuntu.sources && \
    apt-get -o Acquire::https::Verify-Peer=false -o Acquire::Check-Valid-Until=false update && \
    apt-get -o Acquire::https::Verify-Peer=false install -y --no-install-recommends ca-certificates && \
    apt-get -o Acquire::Check-Valid-Until=false update && \
    apt-get install -y --no-install-recommends curl g++ make && \
    mkdir -p /opt/fastq-scan-source && \
    curl --fail --location --silent --show-error --output /opt/fastq-scan-source/source.tar.gz \
      https://github.com/rpetit3/fastq-scan/archive/966991c58bd44cbf7644851b7118f7d06146f3c5.tar.gz && \
    echo '74a665f4550a98bb0565de47cc17772d8372a9777c4dc845b959090363fe778e  /opt/fastq-scan-source/source.tar.gz' | sha256sum --check --strict && \
    tar --extract --gzip --file /opt/fastq-scan-source/source.tar.gz --directory /opt/fastq-scan-source --strip-components=1 && \
    make --directory /opt/fastq-scan-source && \
    install -m 0755 /opt/fastq-scan-source/fastq-scan /usr/local/libexec-fastq-scan

FROM ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b
ARG OCI_CREATED=governed-by-build-evidence
ARG TOOL_VERSION=1.0.1
LABEL org.opencontainers.image.source="https://github.com/rpetit3/fastq-scan" \
      org.opencontainers.image.revision="966991c58bd44cbf7644851b7118f7d06146f3c5" \
      org.opencontainers.image.created="${OCI_CREATED}" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.version="${TOOL_VERSION}" \
      org.opencontainers.image.tool="fastq_scan" \
      org.opencontainers.image.title="fastq-scan" \
      org.opencontainers.image.base.name="ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b" \
      org.opencontainers.image.base.digest="sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b"

ENV LANG=C LC_ALL=C TZ=UTC DEBIAN_FRONTEND=noninteractive
RUN sed -i 's#http://archive.ubuntu.com/ubuntu/#https://snapshot.ubuntu.com/ubuntu/20260802T000000Z/#g; s#http://security.ubuntu.com/ubuntu/#https://snapshot.ubuntu.com/ubuntu/20260802T000000Z/#g' /etc/apt/sources.list.d/ubuntu.sources && \
    apt-get -o Acquire::https::Verify-Peer=false -o Acquire::Check-Valid-Until=false update && \
    apt-get -o Acquire::https::Verify-Peer=false install -y --no-install-recommends ca-certificates gzip && \
    rm -rf /var/lib/apt/lists/* && \
    useradd --system --uid 65532 --home-dir /work --create-home bijux
COPY --from=builder /usr/local/libexec-fastq-scan /usr/local/libexec-fastq-scan
COPY containers/tools/fastq_scan/fastq_scan /usr/local/bin/fastq_scan
RUN chmod 0755 /usr/local/bin/fastq_scan && fastq_scan --version | grep -F 'fastq-scan 1.0.1'

USER 65532:65532
WORKDIR /work
ENTRYPOINT ["/usr/local/bin/fastq_scan"]
CMD ["--help"]
