# VERSION_SOURCE: containers/contracts/catalog.toml
FROM ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b
COPY --chmod=0555 containers/contracts/configure-apt-snapshot /usr/local/sbin/bijux-configure-apt-snapshot
ARG OCI_CREATED=governed-by-build-evidence
ARG TOOL_VERSION=0.12.1
LABEL org.opencontainers.image.source="https://github.com/s-andrews/FastQC" \
      org.opencontainers.image.revision="e7ef390bf10382f60786bdd0cf28abd4f8683ffd" \
      org.opencontainers.image.created="${OCI_CREATED}" \
      org.opencontainers.image.licenses="GPL-3.0-only" \
      org.opencontainers.image.version="${TOOL_VERSION}"
LABEL org.opencontainers.image.tool="fastqc"
LABEL org.opencontainers.image.title="FastQC"
LABEL org.opencontainers.image.base.name="ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b"
LABEL org.opencontainers.image.base.digest="sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b"
ENV LANG=C LC_ALL=C TZ=UTC DEBIAN_FRONTEND=noninteractive

RUN /usr/local/sbin/bijux-configure-apt-snapshot && \
    apt-get install -y --no-install-recommends ca-certificates && \
    apt-get -o Acquire::Check-Valid-Until=false update && \
    apt-get install -y --no-install-recommends default-jre-headless fontconfig fonts-dejavu-core libharfbuzz0b perl && \
    apt-get install -y --no-install-recommends curl unzip && \
    curl --fail --location --proto '=https' --tlsv1.2 --output /opt/fastqc.zip https://www.bioinformatics.babraham.ac.uk/projects/fastqc/fastqc_v0.12.1.zip && \
    echo '5f4dba8780231a25a6b8e11ab2c238601920c9704caa5458d9de559575d58aa7  /opt/fastqc.zip' | sha256sum -c - && \
    unzip -q /opt/fastqc.zip -d /opt && \
    chmod 0755 /opt/FastQC/fastqc && \
    rm -f /opt/fastqc.zip && \
    apt-get purge -y --auto-remove curl unzip && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* && \
    useradd --system --uid 65532 --home-dir /work --create-home bijux
COPY containers/tools/fastqc/fastqc /usr/local/bin/fastqc
RUN chmod 0755 /usr/local/bin/fastqc && \
    fastqc --version | grep -Fx 'FastQC v0.12.1' && \
    fastqc --help >/dev/null

USER 65532:65532
WORKDIR /work
ENTRYPOINT ["fastqc"]
CMD ["--help"]
