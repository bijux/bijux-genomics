# VERSION_SOURCE: containers/contracts/catalog.toml
FROM ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b
COPY --chmod=0555 containers/contracts/configure-apt-snapshot /usr/local/sbin/bijux-configure-apt-snapshot
COPY --chmod=0555 containers/tools/alientrimmer/alientrimmer /usr/local/bin/alientrimmer
ARG TOOL_VERSION=3.2
LABEL org.opencontainers.image.source="https://gitlab.pasteur.fr/GIPhy/AlienTrimmer" \
      org.opencontainers.image.revision="3.2" \
      org.opencontainers.image.created="governed-by-build-evidence" \
      org.opencontainers.image.licenses="GPL-3.0" \
      org.opencontainers.image.version="${TOOL_VERSION}"
LABEL org.opencontainers.image.tool="alientrimmer"
LABEL org.opencontainers.image.title="alientrimmer"
LABEL org.opencontainers.image.base.name="ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b"
LABEL org.opencontainers.image.base.digest="sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b"
LABEL io.bijux.tool.version="3.2"
ARG ALIENTRIMMER_VERSION=3.2
ARG ALIENTRIMMER_SHA256=5f28255e356253b1ff97d4940b637c7f4d7b13da62e603167c3d355a55eb0730
ENV DEBIAN_FRONTEND=noninteractive

RUN /usr/local/sbin/bijux-configure-apt-snapshot && \
    apt-get install -y --no-install-recommends ca-certificates && \
    apt-get -o Acquire::Check-Valid-Until=false update && \
    apt-get install -y --no-install-recommends \
        bash \
        curl \
        openjdk-17-jdk-headless && \
    curl --fail --location --silent --show-error "https://gitlab.pasteur.fr/GIPhy/AlienTrimmer/-/archive/${ALIENTRIMMER_VERSION}/AlienTrimmer-${ALIENTRIMMER_VERSION}.tar.gz" \
        -o /tmp/alientrimmer.tar.gz && \
    echo "${ALIENTRIMMER_SHA256}  /tmp/alientrimmer.tar.gz" | sha256sum --check --strict && \
    tar --extract --gzip --file /tmp/alientrimmer.tar.gz --directory /opt && \
    cd "/opt/AlienTrimmer-${ALIENTRIMMER_VERSION}/src" && \
    javac AlienTrimmer.java && \
    printf 'Main-Class: AlienTrimmer\n' > MANIFEST.MF && \
    jar -cmf MANIFEST.MF AlienTrimmer.jar AlienTrimmer*.class && \
    rm -f MANIFEST.MF AlienTrimmer*.class && \
    alientrimmer --version > /tmp/alientrimmer.version && \
    grep -Fx '3.2' /tmp/alientrimmer.version && \
    alientrimmer --help > /tmp/alientrimmer.help && \
    grep -F 'AlienTrimmer v3.2' /tmp/alientrimmer.help && \
    ln -sf /usr/local/bin/alientrimmer /usr/local/bin/AlienTrimmer && \
    rm -f /tmp/alientrimmer.tar.gz /tmp/alientrimmer.version /tmp/alientrimmer.help && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /data
ENTRYPOINT ["/usr/local/bin/alientrimmer"]
CMD ["--help"]
