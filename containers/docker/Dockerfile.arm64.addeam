# VERSION_SOURCE: containers/contracts/catalog.toml

FROM ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b

ARG OCI_CREATED=governed-by-build-evidence
ARG TOOL_VERSION=1.0.0
LABEL org.opencontainers.image.source="https://github.com/LouisPwr/AdDeam" \
      org.opencontainers.image.revision="8122b9a99d560ef8ea8abdd5b1aacccd00ea0cdd" \
      org.opencontainers.image.created="${OCI_CREATED}" \
      org.opencontainers.image.licenses="GPL-3.0-only" \
      org.opencontainers.image.version="${TOOL_VERSION}" \
      org.opencontainers.image.tool="addeam" \
      org.opencontainers.image.title="AdDeam" \
      org.opencontainers.image.base.name="ubuntu:24.04@sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b" \
      org.opencontainers.image.base.digest="sha256:cd1dba651b3080c3686ecf4e3c4220f026b521fb76978881737d24f200828b2b"

ENV DEBIAN_FRONTEND=noninteractive \
    PATH=/opt/addeam-venv/bin:/usr/local/bin:/usr/bin:/bin \
    LANG=C \
    LC_ALL=C \
    TZ=UTC \
    PYTHONNOUSERSITE=1

COPY containers/tools/addeam/requirements.lock /opt/addeam-build/requirements.lock
COPY containers/tools/addeam/bam2prof-offline-build.patch /opt/addeam-build/bam2prof-offline-build.patch
COPY containers/tools/addeam/profile-execution.patch /opt/addeam-build/profile-execution.patch
COPY containers/tools/addeam/install /opt/addeam-build/install
COPY containers/tools/addeam/addeam /usr/local/bin/addeam

RUN sed -i 's#http://archive.ubuntu.com/ubuntu/#https://snapshot.ubuntu.com/ubuntu/20260802T000000Z/#g; s#http://security.ubuntu.com/ubuntu/#https://snapshot.ubuntu.com/ubuntu/20260802T000000Z/#g' /etc/apt/sources.list.d/ubuntu.sources && \
    apt-get -o Acquire::https::Verify-Peer=false -o Acquire::Check-Valid-Until=false update && \
    apt-get -o Acquire::https::Verify-Peer=false install -y --no-install-recommends ca-certificates && \
    apt-get -o Acquire::Check-Valid-Until=false update && \
    apt-get install -y --no-install-recommends build-essential curl libbz2-dev libcurl4-openssl-dev libgsl-dev liblzma-dev libncurses-dev libssl-dev patch python3 python3-pip python3-venv zlib1g-dev && \
    chmod 0755 /opt/addeam-build/install /usr/local/bin/addeam && \
    /opt/addeam-build/install && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /data
ENTRYPOINT ["/usr/local/bin/addeam"]
CMD ["--help"]
